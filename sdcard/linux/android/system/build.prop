# /system/build.prop -- Android3DS
#
# init's start_property_service() loads this file (PROP_PATH_SYSTEM_BUILD in
# bionic/libc/include/sys/_system_properties.h) before starting any service.
# Until 2026-08-04 the file simply did not exist, so every ro.build.*,
# ro.product.*, ro.sf.* and dalvik.vm.* property in the system read back as
# the empty string. On a real device this file is generated by the AOSP build
# system from the product makefiles; this is the hand-written equivalent for
# this port.
#
# Anything set here is a read-only property: set once at boot, never changed.

# --- Build identity -------------------------------------------------------
# API level 5 is Android 2.0 (Eclair) -- the AOSP tag this whole tree is
# checked out at is android-2.0_r1. Framework code compares against
# Build.VERSION.SDK_INT constantly; leaving it 0 makes every
# "if (SDK_INT >= ...)" branch take the wrong path.
#
# N3DS_RELEASE_ALPHA_1 (#327): the first named release. "Build number" in
# Settings > About phone is ro.build.display.id (Build.DISPLAY); the short
# release tag "a1" is the incremental, as AOSP puts its build tag there.
# ro.build.version.release stays the plain "2.0": the WebKit user agent and
# third-party apps parse it as a version number.
ro.build.id=ECLAIR
ro.build.display.id=Android3DS Alpha 1 (a1)
ro.build.version.incremental=a1
ro.build.version.sdk=5
ro.build.version.codename=REL
ro.build.version.release=2.0
ro.build.date=Thu Oct  1 2026
ro.build.date.utc=0
ro.build.type=eng
ro.build.user=android3ds
ro.build.host=wsl
ro.build.tags=test-keys
ro.build.product=n3ds
ro.build.description=n3ds-eng 2.0 ECLAIR a1 test-keys
ro.build.fingerprint=Nintendo/n3ds/n3ds/n3ds:2.0/ECLAIR/a1:eng/test-keys
ro.n3ds.release=Alpha 1

# --- Product identity -----------------------------------------------------
ro.product.model=New Nintendo 3DS XL
ro.product.brand=Nintendo
ro.product.name=n3ds
ro.product.device=n3ds
ro.product.board=n3ds
ro.product.manufacturer=Nintendo
ro.product.locale.language=en
ro.product.locale.region=US
ro.board.platform=ctr
ro.product.cpu.abi=armeabi
ro.product.cpu.abi2=armeabi

# libhardware's hw_get_module() looks for
# /system/lib/hw/<name>.<ro.hardware>.so, then .<ro.product.board>.so,
# .<ro.board.platform>.so, .<ro.arch>.so, and finally .default.so. Naming the
# hardware here is what lets a 3DS-specific HAL (gralloc, lights, sensors) be
# picked over a generic one.
ro.hardware=n3ds
ro.arch=arm
ro.kernel.qemu=0

# --- Display --------------------------------------------------------------
# The Android UI targets the bottom screen: 320x240 physical, ~3.33in
# diagonal.  Use Eclair's canonical mdpi bucket (160): every shipped framework
# drawable is mdpi, and the legacy Java Bitmap wrapper on this ARMv6 port
# reports zero dimensions on the 120/160 rescale path.  That made zygote,
# StatusBar and AudioService fail on otherwise valid PNGs.  At 160 the assets
# are consumed at native size and the real ARM resource preload is clean.
ro.sf.lcd_density=160

# --- Dalvik ---------------------------------------------------------------
# 16 MB is the stock Eclair heap cap and matches what the boot log already
# reports ("Memory class: 16"). This device has 256 MB, but nothing here
# needs a bigger heap yet and a larger cap makes GC pauses worse, not better,
# on a 268 MHz ARM11.
dalvik.vm.heapsize=16m
dalvik.vm.execution-mode=int:fast

# --- Development ----------------------------------------------------------
# This is an engineering build of a hardware port; treat it as one.
# ro.secure=0 keeps adbd (when it exists) running as root and relaxes the
# framework's own permission asserts; ro.debuggable=1 makes every process
# debuggable and enables the dumpstate/debuggerd paths.
ro.secure=0
ro.debuggable=1
ro.allow.mock.location=1
# N3DS_ADB_ALWAYS_ROOT: adbd is started unconditionally by init.rc's own
# "class default" service now, not gated behind this property; kept non-zero
# so any code that still reads it back sees ADB as enabled.
service.adb.tcp.port=5555

# No setup wizard exists in this image; without this the framework can sit
# waiting for a provisioning activity that will never resolve.
ro.setupwizard.mode=DISABLED

# --- Radio / telephony ----------------------------------------------------
# No modem exists. Pointing the RIL at the no-op reference implementation
# stops TelephonyRegistry/PhoneFactory from blocking on a socket that will
# never accept.
rild.libpath=/system/lib/libreference-ril.so
ro.radio.noril=1
keyguard.no_require_sim=true
wifi.interface=wlan0

