+	memset((void *)VRAM_BASE, 0, VRAM_SIZE);
+
 	DebugClear();
 
 	Debug("-- FIRM Linux loader by xerpi --");
@@ -69,13 +97,16 @@ int main(int argc, char *argv[])
 		wait_any_key_poweroff();
 	}
 
-	if (!load_file(LINUXIMAGE_FILENAME, ZIMAGE_ADDR)) {
