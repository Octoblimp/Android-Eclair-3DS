diff --git a/common/linux_config.h b/common/linux_config.h
index f5f08c019efec36a8e4fb6cb811f5f6923997f15..eafc61434227b9f23aef8f99327859752453c81d 100644
--- a/common/linux_config.h
+++ b/common/linux_config.h
@@ -1,7 +1,31 @@
 /* Linux settings */
 #define DTB_ADDR         (0x20000000)
 #define ZIMAGE_ADDR      (0x20008000)
-#define INITRAMFS_ADDR   (0x27800000)
+/*
+ * The initramfs used to sit at 0x27800000, i.e. the last 8 MiB of the ARM9's
+ * FCRAM window, which is also what the DTS advertised as the initrd region.
+ * That silently became a hard limit: the ARM9's MPU (arm9/source/start.S,
+ * region 5 = 0x20000035) maps FCRAM as 0x20000000 + 128 MiB, so the first
+ * byte written at 0x28000000 is a background-region access and data-aborts
+ * mid-way through the SD read. An 11.2 MiB initramfs did exactly that.
+ *
+ * Load it low instead. Everything below is fixed and known:
+ *
+ *   0x20000000  DTB                     (~8.5 KiB)
+ *   0x20008000  zImage                  (~4.4 MiB compressed, ~12.6 MiB after
+ *                                        self-decompression, plus bss)
+ *   0x21000000  loader scratch buffer   (BUFFER_ADDRESS, 1 MiB)
+ *   0x22000000  initramfs               <- here, 80 MiB of headroom
+ *   0x27000000  ARM9 loader stack top   (start.S: mov sp, #0x27000000)
+ *   0x28000000  end of the ARM9 MPU window
+ *
+ * The ceiling is the loader's own descending stack, not the MPU wall, so the
+ * usable window is 0x22000000..0x27000000. main.c refuses to load anything
+ * bigger rather than corrupting itself.
+ */
+#define INITRAMFS_ADDR     (0x22000000)
+#define ARM9_STACK_BOTTOM  (0x27000000)
+#define INITRAMFS_MAX_SIZE (ARM9_STACK_BOTTOM - INITRAMFS_ADDR)
 #define MACHINE_NUMBER   (0xFFFFFFFF)
 #define ARM9LINUXFW_ADDR (0x08080000)
 #define SYNC_ADDR        (0x1FFFFFF0)
