 		}
@@ -85,12 +116,31 @@ int main(int argc, char *argv[])
 	}
 
 	dtb_filename = is_lgr() ? KTR_DTB_FILENAME : CTR_DTB_FILENAME;
-	if (!load_file(dtb_filename, DTB_ADDR)) {
+	if (!load_file(dtb_filename, DTB_ADDR, 0)) {
 		Debug("Failed to load %s", dtb_filename);
 		goto error;
 	}
 
-	if (!load_file(ARM9LINUXFW_FILENAME, ARM9LINUXFW_ADDR)) {
+	/* Tell the kernel where the initramfs actually ended up. Doing this
+	   here rather than in the DTS is what keeps the two from drifting
+	   apart as the image grows. */
+	if (initramfs_size) {
+		if (fdt_patch_initrd((void *)DTB_ADDR, INITRAMFS_ADDR,
+				     INITRAMFS_ADDR + initramfs_size)) {
+			Debug("initrd: %08X - %08X", INITRAMFS_ADDR,
+			      INITRAMFS_ADDR + initramfs_size);
+		} else {
+			/* Not fatal: the DTS still carries a default window,
+			   but it is a fixed size and this image may outgrow
+			   it, so say so loudly. */
+			DebugColor(COLOR_RED, "Could not patch initrd range "
+				   "into the DTB!");
+			DebugColor(COLOR_RED, "    falling back to the DTS "
+				   "default");
