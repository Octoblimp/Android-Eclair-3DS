+static int
+wmi_scanComplete_rx(struct wmi_t *wmip, u8 *datap, int len)
+{
+    WMI_SCAN_COMPLETE_EVENT *ev;
+    int scan_status = 0;
+
+    ev = (WMI_SCAN_COMPLETE_EVENT *)datap;
+    /* The Nintendo image sends an empty SCAN_COMPLETE payload.  Reading
+     * ev->status unconditionally consumed bytes beyond the event and could
+     * turn a successful scan into a random error. */
+    if (len >= (int)sizeof(*ev))
+        scan_status = (int)ev->status;
+
+    if (scan_status == 0) {
+        wlan_refresh_inactive_nodes(&wmip->wmi_scan_table);
+    }
+    A_WMI_SCANCOMPLETE_EVENT(wmip->wmi_devt, scan_status);
+    is_probe_ssid = false;
+
+    return 0;
+}
