-		}
 
 		iowrite32(*(ww++), pxi->regs + REG_PXI_TX);
 
@@ -99,12 +162,9 @@ static int pxi_txrx(struct pxi_host *pxi, const u32 *ww, int nw, u32 *wr,
 	}
 
 	while (nr > 0) { // recv
