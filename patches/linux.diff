+/*
+ * N3DS_TWD_PERIPHCLK
+ *
+ * The MPCore private timer counts PERIPHCLK, which is half the ARM11 core
+ * clock.  The device tree's refclk (134 MHz) is PERIPHCLK at the CTR
+ * 268 MHz clock, but on a New 3DS firm_linux_loader's upclock() switches
+ * the cores to 804 MHz (LGR2, PDN_LGR_SOCMODE 5) or 536 MHz (LGR1, mode 3)
+ * before Linux starts, and the timer speeds up with them.  Taking the
+ * refclk rate at face value made every jiffy, sleep, timeout and the whole
+ * monotonic clock run 3x fast on the KTR: the CSND sample counter read as
+ * "1/3 rate", the MIC FIFO delivered 2723 words/s at a divider that makes
+ * 8180, recordings played back a third of their real pitch, and 500 ms
+ * long-press timeouts lasted 167 ms.  Read the mode the loader left and
+ * scale by it.
+ */
+#define N3DS_PDN_LGR_SOCMODE	0x10141300
+
+static unsigned long twd_n3ds_scale(unsigned long rate)
+{
+	void __iomem *reg;
+	unsigned int mult;
+	u16 mode;
+
+	if (!of_machine_is_compatible("nintendo,ktr"))
+		return rate;
+
+	reg = ioremap(N3DS_PDN_LGR_SOCMODE, 2);
+	if (!reg) {
+		pr_warn("smp_twd: cannot map PDN_LGR_SOCMODE, keeping %lu Hz (N3DS_TWD_PERIPHCLK)\n",
+			rate);
+		return rate;
+	}
+	mode = readw_relaxed(reg);
+	iounmap(reg);
+
+	switch (mode & 7) {
+	case 3:			/* LGR1 upclocked: 536 MHz */
+		mult = 2;
+		break;
+	case 4:
+	case 5:			/* LGR2 upclocked: 804 MHz */
+		mult = 3;
+		break;
+	default:		/* 268 MHz */
+		mult = 1;
+		break;
+	}
+
+	pr_info("smp_twd: PDN_LGR_SOCMODE 0x%04x -> ARM11 at %u MHz, local timer at %lu Hz rather than the %lu Hz refclk (N3DS_TWD_PERIPHCLK)\n",
+		mode, 268 * mult, rate * mult, rate);
+	return rate * mult;
