diff --git a/drivers/platform/nintendo3ds/ctr_lcd.c b/drivers/platform/nintendo3ds/ctr_lcd.c
new file mode 100644
index 0000000000000000000000000000000000000000..b61f4b01cdcdc3b8f833cb860e401594602f10a7
--- /dev/null
+++ b/drivers/platform/nintendo3ds/ctr_lcd.c
@@ -0,0 +1,275 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ *  ctr_lcd.c - Nintendo 3DS bottom screen (PDC1) framebuffer flip driver
+ *
+ *  The bottom LCD is driven by the "PDC1" block at 0x10400500 (see
+ *  3dbrew "GPU/External Registers").  mach-ctr's nintendo3ds_bottom_setup_fb()
+ *  already programs the scanout A-buffer pair: Framebuffer A first
+ *  (offset 0x68) = FB_BOT_1, Framebuffer A second (offset 0x6C) =
+ *  FB_BOT_2, format 0x80301, stride 720, and leaves framebuffer select
+ *  (offset 0x78) at 0 so FB_BOT_1 is displayed.
+ *
+ *  Framebuffer select bit 0 of offset 0x78 is the "next framebuffer to
+ *  display (after VBlank)" latch: the hardware applies it at the next
+ *  VBlank, so alternating it between 0 and 1 gives artifact-free
+ *  double buffering on the bottom screen without the GPU command
+ *  processor that userland GSP normally uses.  This driver exposes
+ *  exactly that flip plus a VBlank wait, as a small misc device that
+ *  Android's gralloc opens at boot.
+ *
+ *  VBlank interrupt: raw ARM11 interrupt 0x2B (= GIC SPI 0x0B in the
+ *  device tree, this port's SPI mapping adds 0x20 to reach the raw
+ *  interrupt number -- same convention as the dsp node's raw 0x4A).
+ *  The PDC1 VBlank IRQ mask lives in PDC control (offset 0x74 bit 9,
+ *  0 = enabled) and the V interrupt timing window in offset 0x40
+ *  (assert when VCount == low u16, deassert when VCount == high u16,
+ *  both < VTotal; the interrupt itself fires at HCount == 0).  VTotal
+ *  is read from offset 0x24 so the timing window rides the real frame
+ *  period instead of a guessed one.
+ */
+
+#define DRIVER_NAME "3ds-lcd"
+#define pr_fmt(fmt) DRIVER_NAME ": " fmt
+
+#include <linux/init.h>
+#include <linux/fs.h>
+#include <linux/io.h>
+#include <linux/interrupt.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+#include <linux/spinlock.h>
+
+/* PDC1 register map (offsets from 0x10400500) */
+#define CTR_LCD_VTOTAL		0x24
+#define CTR_LCD_V_INTR_TIMING	0x40
+#define CTR_LCD_PDC_CTRL	0x74
+#define CTR_LCD_FB_SELECT	0x78
+
+/* PDC control bits */
+#define CTR_LCD_CTRL_DISPLAY	BIT(0)
+#define CTR_LCD_CTRL_HBLANK_MASK	BIT(8)
+#define CTR_LCD_CTRL_VBLANK_MASK	BIT(9)
+
+/* Framebuffer select and status bits */
+#define CTR_LCD_SEL_NEXT_FB	BIT(0)
+#define CTR_LCD_SEL_CURRENT_FB	BIT(4)
+#define CTR_LCD_SEL_VBLANK_IRQ	BIT(17)
+
+#define CTR_LCD_IOCTL_MAGIC	0x9c
+#define CTR_LCD_IO_FLIP		_IO(CTR_LCD_IOCTL_MAGIC, 0x01)
+#define CTR_LCD_IO_WAIT_VBLANK	_IO(CTR_LCD_IOCTL_MAGIC, 0x02)
+#define CTR_LCD_IO_GET_SELECT	_IOR(CTR_LCD_IOCTL_MAGIC, 0x03, unsigned int)
+
+/*
+ * How long WAIT_VBLANK may sleep before giving up.  The PDC1 VBlank
+ * interrupt is genuinely useful for tear-free flips but has proven
+ * unreliable in long boots, so no caller may ever block on it without
+ * bound -- SurfaceFlinger's first fb_post happens during its own init,
+ * before it registers with servicemanager, so an endless wait there wedges
+ * the whole boot.  Callers treat -ETIMEDOUT as "flip anyway, no tear sync".
+ */
+#define CTR_LCD_VBLANK_WAIT_MS	50
+
+struct ctr_lcd {
+	void __iomem *base;
+	int irq;
+	struct miscdevice misc;
+	struct wait_queue_head vblank_wait;
+	/* incremented by the IRQ handler on every VBlank */
+	unsigned long vblank_count;
+};
+
+static inline u32 ctr_lcd_read(struct ctr_lcd *lcd, unsigned int reg)
+{
+	return ioread32(lcd->base + reg);
+}
+
+static inline void ctr_lcd_write(struct ctr_lcd *lcd, unsigned int reg, u32 val)
+{
+	iowrite32(val, lcd->base + reg);
+}
+
+static irqreturn_t ctr_lcd_irq(int irq, void *data)
+{
+	struct ctr_lcd *lcd = data;
+	u32 status;
+
+	status = ctr_lcd_read(lcd, CTR_LCD_FB_SELECT);
+	if (!(status & CTR_LCD_SEL_VBLANK_IRQ))
+		return IRQ_NONE;
+
+	/* Acknowledge by writing 1 back to the VBlank status bit (3dbrew:
+	 * "Write 1 to acknowledge").  Bit 0 (next framebuffer) must be
+	 * preserved -- it holds the pending flip. */
+	ctr_lcd_write(lcd, CTR_LCD_FB_SELECT,
+		      status | CTR_LCD_SEL_VBLANK_IRQ);
+
+	lcd->vblank_count++;
+	wake_up_interruptible(&lcd->vblank_wait);
+	return IRQ_HANDLED;
+}
+
+static long ctr_lcd_ioctl(struct file *file, unsigned int cmd,
+			  unsigned long arg)
+{
+	struct ctr_lcd *lcd = file->private_data;
+	u32 select;
+	int ret = 0;
+
+	switch (cmd) {
+	case CTR_LCD_IO_FLIP:
+		/* Toggle the "next framebuffer after VBlank" latch.  The
+		 * hardware applies it at the following VBlank. */
+		select = ctr_lcd_read(lcd, CTR_LCD_FB_SELECT);
+		select ^= CTR_LCD_SEL_NEXT_FB;
+		ctr_lcd_write(lcd, CTR_LCD_FB_SELECT, select);
+		break;
+
+	case CTR_LCD_IO_WAIT_VBLANK: {
+		unsigned long seen = lcd->vblank_count;
+		long rem = wait_event_interruptible_timeout(
+				lcd->vblank_wait,
+				lcd->vblank_count != seen,
+				msecs_to_jiffies(CTR_LCD_VBLANK_WAIT_MS));
+		/* 0 = timed out without seeing a VBlank, negative = woken by a
+		 * signal.  Either way the caller proceeds unsynchronised. */
+		if (rem == 0)
+			ret = -ETIMEDOUT;
+		else if (rem < 0)
+			ret = (int)rem;
+		break;
+	}
+
+	case CTR_LCD_IO_GET_SELECT:
+		select = ctr_lcd_read(lcd, CTR_LCD_FB_SELECT);
+		if (copy_to_user((void __user *)arg, &select, sizeof(select)))
+			ret = -EFAULT;
+		break;
+
+	default:
+		ret = -ENOTTY;
+		break;
+	}
+
+	return ret;
+}
+
+static int ctr_lcd_open(struct inode *inode, struct file *file)
+{
+	struct ctr_lcd *lcd = container_of(file->private_data,
+					   struct ctr_lcd, misc);
+
+	file->private_data = lcd;
+	return 0;
+}
+
+static const struct file_operations ctr_lcd_fops = {
+	.owner		= THIS_MODULE,
+	.open		= ctr_lcd_open,
+	.unlocked_ioctl	= ctr_lcd_ioctl,
+};
+
+static int ctr_lcd_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct ctr_lcd *lcd;
+	u32 vtotal, ctrl;
+	int ret;
+
+	lcd = devm_kzalloc(dev, sizeof(*lcd), GFP_KERNEL);
+	if (!lcd)
+		return -ENOMEM;
+
+	lcd->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(lcd->base))
+		return PTR_ERR(lcd->base);
+
+	lcd->irq = platform_get_irq(pdev, 0);
+	if (lcd->irq < 0)
+		return lcd->irq;
+
+	init_waitqueue_head(&lcd->vblank_wait);
+
+	/* Program the V interrupt timing window to assert once per frame at the
+	 * end of VCount.  VTotal is read from hardware so the window tracks the
+	 * real frame period; both window edges must be strictly inside VTotal
+	 * or the interrupt never fires.  The window is kept several lines wide
+	 * on purpose: at one line it only fired for a short stretch of every
+	 * boot and then missed for seconds at a time (observed counts implied a
+	 * rate that decayed toward a few Hz), which made the old unbounded
+	 * WAIT_VBLANK a near-permanent hang. */
+	vtotal = ctr_lcd_read(lcd, CTR_LCD_VTOTAL);
+	if (vtotal > 8) {
+		ctr_lcd_write(lcd, CTR_LCD_V_INTR_TIMING,
+			      (vtotal - 1) << 16 | (vtotal - 8));
+		dev_info(dev, "VTotal=%u, VBlank IRQ window [%u,%u)\n",
+			 vtotal, vtotal - 8, vtotal - 1);
+	} else {
+		dev_warn(dev, "unexpected VTotal=%u, VBlank IRQ not armed\n",
+			 vtotal);
+	}
+
+	/* Unmask the VBlank IRQ in PDC control.  Read-modify-write so the
+	 * display-enable bit (and anything else) is left alone. */
+	ctrl = ctr_lcd_read(lcd, CTR_LCD_PDC_CTRL);
+	ctrl |= CTR_LCD_CTRL_DISPLAY;
+	ctrl &= ~CTR_LCD_CTRL_VBLANK_MASK;
+	ctr_lcd_write(lcd, CTR_LCD_PDC_CTRL, ctrl);
+
+	ret = devm_request_irq(dev, lcd->irq, ctr_lcd_irq, IRQF_TRIGGER_RISING,
+			       DRIVER_NAME, lcd);
+	if (ret) {
+		dev_err(dev, "failed to request irq %d (%d)\n", lcd->irq, ret);
+		return ret;
+	}
+
+	lcd->misc.minor = MISC_DYNAMIC_MINOR;
+	lcd->misc.name = "ctr_lcd";
+	lcd->misc.fops = &ctr_lcd_fops;
+	lcd->misc.parent = dev;
+
+	ret = misc_register(&lcd->misc);
+	if (ret) {
+		dev_err(dev, "failed to register misc device (%d)\n", ret);
+		return ret;
+	}
+
+	platform_set_drvdata(pdev, lcd);
+	dev_info(dev, "PDC1 flip driver ready (irq %d)\n", lcd->irq);
+	return 0;
+}
+
+static int ctr_lcd_remove(struct platform_device *pdev)
+{
+	struct ctr_lcd *lcd = platform_get_drvdata(pdev);
+
+	misc_deregister(&lcd->misc);
+	return 0;
+}
+
+static const struct of_device_id ctr_lcd_of_match[] = {
+	{ .compatible = "nintendo," DRIVER_NAME },
+	{},
+};
+MODULE_DEVICE_TABLE(of, ctr_lcd_of_match);
+
+static struct platform_driver ctr_lcd_driver = {
+	.probe		= ctr_lcd_probe,
+	.remove		= ctr_lcd_remove,
+	.driver		= {
+		.name		= DRIVER_NAME,
+		.owner		= THIS_MODULE,
+		.of_match_table	= of_match_ptr(ctr_lcd_of_match),
+	},
+};
+
+module_platform_driver(ctr_lcd_driver);
+
+MODULE_DESCRIPTION("Nintendo 3DS bottom screen (PDC1) framebuffer flip driver");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform:" DRIVER_NAME);
