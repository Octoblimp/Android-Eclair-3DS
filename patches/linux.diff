diff --git a/arch/arm/boot/dts/nintendo3ds.dtsi b/arch/arm/boot/dts/nintendo3ds.dtsi
old mode 100755
new mode 100644
index 1b30e3045b80b5a0c3599c5f33a275846b8898a8..3c8b633af4b1c059695c98acae1ee29db1e0b7b7
--- a/arch/arm/boot/dts/nintendo3ds.dtsi
+++ b/arch/arm/boot/dts/nintendo3ds.dtsi
@@ -8,6 +8,55 @@ / {
 	#address-cells = <1>;
 	#size-cells = <1>;
 
+	/*
+	 * Persistent crash record.
+	 *
+	 * This machine has exactly one console (fbcon on the top screen, 50x30
+	 * characters) and a crash is well over 100 physical lines, so the part
+	 * of an oops that matters has always scrolled away before it can be
+	 * photographed. Writing it to the SD card does not work either: by the
+	 * time the kernel is oopsing, the userspace script that would do the
+	 * writing is exactly what is dying.
+	 *
+	 * ramoops solves both: the kernel itself writes the oops record and a
+	 * rolling copy of the console into a fixed RAM window, with no
+	 * filesystem, no scheduler and no userspace involved. dump_bootlog.sh
+	 * then copies /sys/fs/pstore to the SD card on the *following* boot.
+	 *
+	 * Address: the last MiB of the *CTR* FCRAM window (0x20000000 + 128
+	 * MiB). Deliberately chosen to be valid on both models -- KTR has 256
+	 * MiB, so 0x27f00000 is real RAM there too, and this .dtsi is shared.
+	 * Nothing else lives here: the initramfs moved to 0x22000000 (see the
+	 * linux,initrd-start comment in the per-model .dts files), and
+	 * firm_linux_loader writes nothing above it.
+	 *
+	 * No `no-map` and no `unbuffered`: the region stays in the kernel
+	 * linear map and ramoops memremap()s it write-back, i.e. with the same
+	 * memory type. Two live mappings of one physical page with *different*
+	 * memory types is UNPREDICTABLE on ARMv6 and already cost this port a
+	 * long crash hunt once (mach-ctr's Device-memory ioremap() of fb1 over
+	 * simplefb's write-combining mapping) -- do not "optimise" this into
+	 * an uncached mapping without re-reading that.
+	 */
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		ramoops@27f00000 {
+			compatible = "ramoops";
+			reg = <0x27f00000 0x100000>;	/* 1 MiB */
+			record-size  = <0x00020000>;	/* 128K per oops   */
+			console-size = <0x00040000>;	/* 256K console    */
+			pmsg-size    = <0x00020000>;	/* 128K userspace  */
+			ftrace-size  = <0>;
+			/* Default is KMSG_DUMP_OOPS, which covers oops *and*
+			 * panic. Left implicit rather than hardcoded so it
+			 * tracks the driver. */
+		};
+	};
+
+	/* Top screen -- stays fb0 so the fbcon debug console keeps working. */
 	display: framebuffer@18000000 {
 		compatible = "simple-framebuffer";
 		reg = <0x18000000 (400*240*3)>;
@@ -17,7 +66,37 @@ display: framebuffer@18000000 {
 		format = "r8g8b8";
 	};
 
-	soc {
+	/*
+	 * Bottom screen -- fb1, the display Android's UI targets (it is the
+	 * touchscreen, so it is the right primary display for Android even
+	 * though it is not fb0).
+	 *
+	 * Address: FB_BOT_1 from mach-ctr/include/mach/platform.h, which is
+	 * VRAM_BASE + 4 * FB_TOP_SIZE = 0x18000000 + 4*(400*240*3) = 0x18119400.
+	 * mach-ctr's ctr_dt_init_machine() already programs PDC1 to scan out
+	 * this buffer (nintendo3ds_bottom_setup_fb), so it is live before
+	 * simplefb ever probes.
+	 *
+	 * Like the top screen the surface is rotated 90 degrees relative to the
+	 * panel: the physical LCD is 320x240 but the framebuffer is 240 wide by
+	 * 320 tall, stride 240*3 -- matching bottom_lcd.c's addressing,
+	 *     dst = fb + ((BOT_HEIGHT - y - 1) + x * BOT_HEIGHT) * 3.
+	 *
+	 * No memory-region conflict with mach-ctr's own mapping of the same
+	 * buffer: simplefb uses a bare ioremap_wc() and never calls
+	 * request_mem_region().
+	 */
+	display_bottom: framebuffer@18119400 {
+		compatible = "simple-framebuffer";
+		reg = <0x18119400 (320*240*3)>;
+		width = <240>;
+		height = <320>;
+		stride = <(240*3)>;
+		format = "r8g8b8";
+	};
+
+
+	soc: soc {
 		#address-cells = <1>;
 		#size-cells = <1>;
 		ranges;
@@ -61,6 +140,15 @@ nwm: sdhc-controller@10122000 {
 
 			cap-sdio-irq;
 			cap-sd-highspeed;
+			/* Phase 2 (WiFi bring-up): the AR6014G WiFi chip is
+			 * permanently attached on this controller, not a
+			 * hot-pluggable card -- tell the MMC core to probe
+			 * it at boot instead of waiting for a card-detect
+			 * event that will never come. */
+			non-removable;
+			/* Per 3dbrew: GPIO3_DATA2 bit 0 (0x10147028, gpio4
+			 * below) is the WiFi chip's power enable line. */
+			wifi-enable-gpios = <&gpio4 0 GPIO_ACTIVE_HIGH>;
 		};
 
 		gpio0: gpio-controller@10147000 {
@@ -136,6 +224,16 @@ gpio4: gpio-controller@10147028 {
 			#gpio-cells = <2>;
 		};
 
+		pica200: gpu@10400000 {
+			compatible = "nintendo,3ds-pica200";
+			reg = <0x10400000 0x2000>;
+			interrupts = <GIC_SPI 0x08 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 0x09 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 0x0C IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 0x0D IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "psc0", "psc1", "ppf", "p3d";
+		};
+
 		/* I2C blocks */
 		i2c1: i2c@10161000 {
 			#address-cells = <1>;
@@ -171,7 +269,7 @@ mcuintc: interrupt-controller@10 {
 					#address-cells = <1>;
 					#interrupt-cells = <2>;
 
-					interrupts-extended = <&gpio3 9 IRQ_TYPE_EDGE_FALLING>;
+					interrupts-extended = <&gpio3 9 IRQ_TYPE_LEVEL_LOW>;
 				};
 
 				mcu-charger@a {
@@ -179,6 +277,13 @@ mcu-charger@a {
 					reg = <0x0A>;
 				};
 
+
+				/* N3DS_WIFI_LED_REGMAP_STATE: dedicated yellow indicator. */
+				mcu-wifi-led@2a {
+					compatible = "nintendo,3dsmcu-wifi-led";
+					reg = <0x2A>;
+				};
+
 				mcu-led@2d {
 					compatible = "nintendo,3dsmcu-led";
 					reg = <0x2D>;
@@ -194,13 +299,17 @@ mcu-accel@40 {
 					reg = <0x40>;
 				};
 
-				pwroff_reg: poweroff-regulator@20 {
-					compatible = "nintendo,3dsmcu-regulator";
-					regulator-name = "Power off";
-
+				mcu_poweroff: poweroff@20 {
+					compatible = "nintendo,3dsmcu-poweroff";
 					reg = <0x20>;
-					on = <0x00>;
-					off = <0x01>;
+					value = <0x01>;
+					/* The dedicated driver writes while IRQs are
+					 * still enabled via pm_power_off_prepare(), then
+					 * retries through the adapter's atomic callback
+					 * if the board survives to machine_power_off().
+					 * The generic regulator-poweroff consumer never
+					 * probed on this platform, leaving pm_power_off
+					 * NULL and making RB_POWER_OFF silently return. */
 				};
 
 				reboot_reg: reset-regulator@20 {
@@ -271,11 +380,10 @@ tsc: tsc@0 {
 				spi-max-frequency = <16777216>;
 
 				touch: touchscreen {
-					compatible = "nintendo,3dstsc-touch";
-					touchscreen-size-x = <4096>;
-					touchscreen-size-y = <4096>;
-					touchscreen-inverted-y;
-					touchscreen-swapped-x-y;
+					compatible = "nintendo,android3ds-touchscreen";
+					/* Driver reports final Android 320x240 coordinates. */
+					touchscreen-size-x = <320>;
+					touchscreen-size-y = <240>;
 				};
 			};
 		};
@@ -299,12 +407,29 @@ spi3: spi@10160800 {
 
 			interrupts = <GIC_SPI 0x36 IRQ_TYPE_EDGE_RISING>;
 
-			flash: nvram@1 {
-				compatible = "jedec,spi-nor";
-				reg = <1>;
-
-				spi-max-frequency = <524288>;
-			};
+			/*
+			 * cs1 on this bus is NOT a generic JEDEC SPI-NOR
+			 * chip -- that was this project's original guess,
+			 * and it produced "spi-nor spi2.1: unrecognized
+			 * JEDEC id bytes: 20 58 0c 00 00 00" on every boot
+			 * (Linux's mtd spi-nor core correctly rejecting a
+			 * device that doesn't speak its protocol) plus a
+			 * failed probe that left the SPI block in a bad
+			 * state for whatever ran next on this bus.
+			 *
+			 * Cross-referencing GBATEK's 3DS SPI device table
+			 * and fastboot3DS's spiDevTable[] (both independently
+			 * agree): this is the WiFi module's small (32Kbit)
+			 * calibration/config NVRAM -- MAC address, AP list,
+			 * DS-profile data -- not bulk storage, and not
+			 * JEDEC-RDID-compatible even though it accepts
+			 * similar-looking ST-style opcodes. It needs its own
+			 * driver speaking that specific protocol, which
+			 * doesn't exist yet (WiFi bring-up is parked --
+			 * see docs/HANDOFF.md). Deliberately no node/driver
+			 * bound to cs1 here until that happens, so nothing
+			 * misprobes it.
+			 */
 		};
 
 		pxi: virtio-bridge@10163000 {
@@ -317,6 +442,89 @@ pxi: virtio-bridge@10163000 {
 				<GIC_SPI 0x33 IRQ_TYPE_EDGE_RISING>;
 		};
 
+		/* N3DS_CAM_CAPTURE. GBATEK "3DS Video CAM Registers": port 0
+		 * registers at 0x10120000 (internal + outer-right sensors), port 1
+		 * at 0x10121000 (outer-left; the reg-name "registers-mirror" is
+		 * historical -- it is a second register file, not an alias), and
+		 * each port's pixel FIFO read window at 0x10320000 / 0x10321000.
+		 * Y2R control block 0x10102000 (unused by the driver) and
+		 * CFG11_CAMERA_CNT 0x10141224 bit0 = 16 MHz camera clock. The pdn
+		 * byte is handed over as its own reg entry exactly as the dsp node
+		 * does for 0x10141230; syscon maps with devm_ioremap and takes no
+		 * region, so the two do not collide.
+		 *
+		 * i2c buses, in the driver's order: i2c1 (GBATEK bus 0) carries
+		 * the internal (0x3d) and outer-right (0x3c) sensors, i2c2 (bus 1)
+		 * the outer-left one (0x3c).
+		 *
+		 * IRQs are the 3dbrew ARM11 numbers 0x48/0x49/0x4B minus 0x20.
+		 */
+		cam: cam@10120000 {
+			compatible = "nintendo,3ds-cam";
+			reg = <0x10120000 0x1000>,
+			      <0x10102000 0x1000>,
+			      <0x10141224 0x4>,
+			      <0x10121000 0x1000>,
+			      <0x10320000 0x1000>,
+			      <0x10321000 0x1000>;
+			reg-names = "registers", "y2r", "pdn", "registers-mirror",
+				    "fifo0", "fifo1";
+			interrupts = <GIC_SPI 0x28 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 0x29 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 0x2B IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "bus0", "bus1", "y2r";
+			nintendo,i2c-bus = <&i2c1>, <&i2c2>;
+			status = "okay";
+		};
+
+		/*
+		 * CSND: the SoC PCM sample player (32 DMA channels reading FCRAM
+		 * by physical address, straight into the I2S bus).  This is the
+		 * audio path that does not go through the DSP at 0x10203000 --
+		 * see the header of ctr_csnd.c for why that one is parked.
+		 *
+		 * The extra reg entries are single registers inside blocks that
+		 * belong to nobody: I2S1_CNT/I2S2_CNT at 0x10145000, the I2S
+		 * clock gate PDN_I2S_CNT at 0x10141220 (the byte next door to
+		 * the cam and dsp PDN bytes above), and CFG11_SPI_CNT at
+		 * 0x101401C0 which selects the new SPI interface the codec
+		 * hangs off.  Mapped with devm_ioremap and no region request,
+		 * for the same reason the cam and dsp nodes do it: the pages
+		 * are shared.
+		 *
+		 * nintendo,codec points at the TSC because the touchscreen
+		 * controller and the audio codec are one chip.  ctr_tsc.c
+		 * already owns the SPI link and publishes the regmap; this
+		 * driver borrows it rather than opening a second connection,
+		 * and never resets the chip (that would undo the touchscreen
+		 * configuration).
+		 */
+		csnd: csnd@10103000 {
+			compatible = "nintendo,3ds-csnd";
+			reg = <0x10103000 0x1000>,
+			      <0x10145000 0x4>,
+			      <0x10141220 0x1>,
+			      <0x101401c0 0x2>;
+			reg-names = "csnd", "i2s", "pdn-i2s", "cfg11-spi";
+			nintendo,codec = <&tsc>;
+			status = "okay";
+		};
+
+		dsp: dsp@10203000 {
+			compatible = "nintendo,3ds-dsp";
+			reg = <0x10203000 0x1000>,
+			      <0x1ff00000 0x80000>,
+			      <0x10141230 0x4>,
+			      <0x10140000 0x10>;
+			reg-names = "registers", "wram", "pdn", "sharedwram";
+
+			/* DSP General Interrupt (semaphore + cmd/reply
+			 * register status change) -- see 3dbrew ARM11
+			 * Interrupts, raw ID 0x4A. */
+			interrupts = <GIC_SPI 0x2A IRQ_TYPE_EDGE_RISING>;
+		};
+
+
 		timer: twd-timer@17e00600 {
 			compatible = "arm,arm11mp-twd-timer";
 			reg = <0x17E00600 0x20>;
@@ -404,11 +612,6 @@ cpuclk: refclk268mhz {
 		clock-output-names = "3ds:refclk268mhz";
 	};
 
-	poweroff: poweroff {
-		compatible = "regulator-poweroff";
-		cpu-supply = <&pwroff_reg>;
-	};
-
 	mcu_buttons {
 		compatible = "gpio-keys";
 		interrupt-parent = <&mcuintc>;
diff --git a/arch/arm/boot/dts/nintendo3ds_ctr.dts b/arch/arm/boot/dts/nintendo3ds_ctr.dts
index 283751c11f1fdf22dfd436ed65b77d601e78bdce..22e95ee36341a0773b82ef1ba074513bc92fa606 100644
--- a/arch/arm/boot/dts/nintendo3ds_ctr.dts
+++ b/arch/arm/boot/dts/nintendo3ds_ctr.dts
@@ -37,10 +37,62 @@ cpu@1 {
 	};
 
 	chosen {
-		bootargs = "keep_bootcon fbcon=rotate:1 fbcon=font:VGA8x8";
-		// At the end of the fcram
-		linux,initrd-start = <0x27800000>;
-		linux,initrd-end = <0x28000000>; // 8 MiB
+		/*
+		 * 2026-08-05: dropped `dyndbg="+p;file unwind.c -p;..."` and
+		 * `initcall_debug`. The leading bare `+p` in a dyndbg string is
+		 * not "default verbosity" -- it matches *every* pr_debug() call
+		 * site in the kernel and turns them all on; the three `-p`
+		 * clauses after it only switched three files back off again.
+		 * The result was a firehose: every dmesg capture this project
+		 * has taken is ~100% kobject_uevent/fill_kobj_path spam, so the
+		 * 256 KB log buffer had already wrapped away every crash by the
+		 * time anything could be dumped, and each of those lines also
+		 * costs an fbcon render into VRAM on a 268 MHz core (userspace
+		 * did not start until t=115s).
+		 *
+		 * 2026-08-05 (later): `oops=panic` REMOVED, `panic=0` kept.
+		 *
+		 * oops=panic was added when photographing the console was the
+		 * only way to read a crash, so freezing the machine was the
+		 * only way to stop the evidence scrolling away. ramoops (see
+		 * the reserved-memory node in nintendo3ds.dtsi) removes that
+		 * constraint: the kernel now writes the oops record and a
+		 * rolling copy of the console into RAM by itself, and
+		 * dump_bootlog.sh copies /sys/fs/pstore to the SD card on the
+		 * next boot. Killing the machine to preserve a crash is no
+		 * longer necessary.
+		 *
+		 * Stopping also costs real information. Every DataAbort this
+		 * port has captured is a *user*-mode fault (__dabt_usr); with
+		 * oops=panic gone, those kill only the faulting task and the
+		 * system carries on, so the boot keeps making progress and a
+		 * later, more informative failure still gets a chance to
+		 * happen. oops=panic turned each of them into a whole-machine
+		 * stop and threw that away.
+		 *
+		 * panic=0 stays: on a *genuine* panic there is nothing left to
+		 * learn from continuing, and rebooting would only lose the
+		 * screen. 0 means never reboot.
+		 *
+		 * N3DS_CTR_DUAL_CORE: Old 3DS exposes exactly two ARM11
+		 * MPCore application CPUs (cpu@0 and cpu@1). The separate ARM946
+		 * remains owned by firm_linux_loader/arm9linuxfw and is not a Linux
+		 * SMP CPU. CPU1 now uses the repaired boot-ROM SGI EOI path shared
+		 * with KTR, so the former maxcpus=1 safety limit is removed.
+		 */
+		bootargs = "ignore_loglevel no_console_suspend loglevel=8 panic=0 print-fatal-signals=1 user_debug=24 lowmemorykiller.debug_level=2 vt.global_cursor_default=0 fbcon=rotate:1 fbcon=font:VGA8x8 consoleblank=0";
+		// Must match INITRAMFS_ADDR in firm_linux_loader's
+		// common/linux_config.h. It used to sit at the very end of
+		// fcram (0x27800000, 8 MiB), which turned into a silent hard
+		// limit: the ARM9 loader's MPU only maps 0x20000000 + 128 MiB,
+		// so an initramfs larger than 8 MiB data-aborted the ARM9 part
+		// way through the SD read.
+		//
+		// linux,initrd-end below is only a fallback -- the loader
+		// rewrites it with the real size of initramfs.cpio.gz, so the
+		// two can no longer drift apart as the image grows.
+		linux,initrd-start = <0x22000000>;
+		linux,initrd-end = <0x22c00000>; // 12 MiB fallback
 	};
 };
 
diff --git a/arch/arm/boot/dts/nintendo3ds_ktr.dts b/arch/arm/boot/dts/nintendo3ds_ktr.dts
index ee5677c8f12574cf1cd85055ca6b88e8d9367f89..0cd48afe1d2caf0ab439ceb64e83fb2d1643bf03 100644
--- a/arch/arm/boot/dts/nintendo3ds_ktr.dts
+++ b/arch/arm/boot/dts/nintendo3ds_ktr.dts
@@ -49,9 +49,150 @@ cpu@3 {
 	};
 
 	chosen {
-		bootargs = "keep_bootcon fbcon=rotate:1 fbcon=font:VGA8x8";
-		// At the end of the CTR fcram
-		linux,initrd-start = <0x27800000>;
-		linux,initrd-end = <0x28000000>; // 8 MiB
+		/* See nintendo3ds_ctr.dts for why dyndbg/initcall_debug are
+		 * gone, why oops=panic was removed once ramoops existed, and
+		 * why panic=0 stays. Keep the two models' bootargs identical.
+		 *
+		 * maxcpus=1 was the supported safety configuration until the
+		 * CPU1 boot-ROM SGI EOI repair described at the end of this history.
+		 *
+		 * History, so nobody re-runs this experiment a third time:
+		 *
+		 *  - 4-core: the boot wedges. CPUs 0, 2 and 3 each spin in
+		 *    flush_tlb_page() -> on_each_cpu_mask(wait=1) waiting for
+		 *    a TLB-flush IPI acknowledgement, while CPU1 stays
+		 *    completely silent. ARM11 MPCore has no hardware TLB
+		 *    broadcast (tlb_ops_need_broadcast() is true because
+		 *    MMFR3[15:12] == 0), so *every* user TLB flush is a
+		 *    synchronous cross-CPU IPI round trip -- one core that
+		 *    stops taking interrupts wedges all the others. The three
+		 *    backtraces that repeat forever on the top screen
+		 *    (wp_page_reuse, flush_tlb_page, rcu_gp_kthread) are that
+		 *    one bug reported three ways, not three bugs.
+		 *
+		 *  - maxcpus=1 (2026-08-05): with only CPU0 online,
+		 *    on_each_cpu_mask() has no remote CPU to wait for and
+		 *    degenerates to a local flush, so that path cannot
+		 *    execute. This produced the furthest boot this project
+		 *    has ever reached: real Dalvik bootstrap classloading, a
+		 *    successful JNI_CreateJavaVM, a boot animation on screen,
+		 *    and complete boot_log/logcat captures.
+		 *
+		 *  - 2026-08-05 (much later): maxcpus=1 was removed again on
+		 *    the reasoning that the 120s hung-task stalls seen under
+		 *    it were SD/FAT write-path latency and therefore not an
+		 *    IPI problem. That reasoning was right about the *hung
+		 *    tasks* and wrong about the *removal*: the two are
+		 *    separate failures. The very next 4-core boot regressed
+		 *    hard -- the three IPI backtraces came straight back,
+		 *    with no boot animation and no capture files at all.
+		 *
+		 * Whoever fixes SMP: the asymmetry to explain is why CPU1
+		 * specifically goes deaf. CPU1 is the only core released
+		 * through the *bootrom's* core1 stub (start.S writes its
+		 * entry to 0x1FFFFFDC and sends SGI 1); cores 2 and 3 are
+		 * released by firm_linux_loader's own core23_entry(), which
+		 * explicitly acks and EOIs its SGI, and they demonstrably
+		 * work. 2026-08-13: smp_start now EOIs and drains CPU1's
+		 * boot-ROM SGI before entering Linux, matching the working 2/3 path.
+		 * A later isolated page-fault crash must not be used to disable the
+		 * otherwise hardware-proven four-core KTR configuration. */
+		bootargs = "ignore_loglevel no_console_suspend loglevel=8 panic=0 print-fatal-signals=1 user_debug=24 lowmemorykiller.debug_level=2 vt.global_cursor_default=0 fbcon=rotate:1 fbcon=font:VGA8x8 consoleblank=0";
+		// Must match INITRAMFS_ADDR in firm_linux_loader's
+		// common/linux_config.h. It used to sit at the end of the *CTR*
+		// fcram (0x27800000, 8 MiB) so a single address served both
+		// models, but that turned into a silent hard limit: the ARM9
+		// loader's MPU maps only 0x20000000 + 128 MiB regardless of
+		// model, so an initramfs larger than 8 MiB data-aborted the
+		// ARM9 part way through the SD read.
+		//
+		// linux,initrd-end below is only a fallback -- the loader
+		// rewrites it with the real size of initramfs.cpio.gz, so the
+		// two can no longer drift apart as the image grows.
+		linux,initrd-start = <0x22000000>;
+		linux,initrd-end = <0x22c00000>; // 12 MiB fallback
+	};
+};
+
+/*
+ * New3DS runs its ARM11 cores at 804 MHz (3x Old3DS's 268 MHz), not the
+ * 268 MHz nintendo3ds.dtsi's shared cpuclk node describes -- that node was
+ * never actually overridden for this model. No driver currently consumes
+ * cpuclk (loops_per_jiffy is calibrated fresh at boot against the
+ * TWD/refclk, not against this node), so this alone was not a functional
+ * bug, but it was wrong, and it's cheap to make it stop being wrong for
+ * whatever future code (cpufreq, /sys frequency reporting) ends up reading
+ * it. The actual clock switch happens in hardware, in firm_linux_loader's
+ * arm11/source/smp.c (enable_cores23() -> set_socmode() -> upclock()),
+ * before Linux ever starts.
+ */
+&cpuclk {
+	clock-mult = <6>;
+	clock-output-names = "3ds:refclk804mhz";
+};
+
+/*
+ * New3DS-only: a real ARM CoreLink L2C-310 (PL310-family), 2 MB / 16-way,
+ * confirmed via GBATEK's "3DS Config: L2C-310" page (register-level detail,
+ * matching the standard ARM TRM). It is NOT hardware-transparent -- GBATEK
+ * documents an explicit required init sequence (invalidate all ways, wait,
+ * then enable) done through this MMIO block, not CP15 instructions. Before
+ * this node existed, CONFIG_CACHE_L2X0 was off and nothing in Linux ever
+ * touched this controller: firm_linux_loader's enable_fcram_l2() only pokes
+ * the PDN power/clock-gate bit (PDN_LGR_CNT), which brings the block up
+ * electrically but does not run the L2C-310's own enable sequence, and
+ * without CONFIG_CACHE_L2X0 no outer-cache maintenance op (flush/clean/inval)
+ * generic Linux code performs was ever reaching it. Whether that alone
+ * explains this project's New3DS-mode instability is unconfirmed on
+ * hardware, but a powered-on-but-Linux-unmanaged cache sitting in the
+ * coherency path is exactly the kind of thing that produces intermittent,
+ * hard-to-reproduce corruption rather than a clean, deterministic failure --
+ * consistent with what's been observed. Standard "arm,pl310-cache" binding;
+ * the mainline arch/arm/mm/cache-l2x0.c driver's normal invalidate+enable
+ * path applies unmodified.
