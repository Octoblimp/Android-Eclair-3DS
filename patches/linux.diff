+ *
+ *  This file used to be a bring-up probe that swept registers and walked
+ *  control bits in search of a start bit, because the CAM block was believed
+ *  to be undocumented (3dbrew's page is a stub). It is not undocumented:
+ *  GBATEK documents it under "3DS Video CAM Registers (Camera Input)", and
+ *  documents the MT9V113 sensor's init sequence under "DSi Aptina Camera
+ *  Initialization". The bring-up history is in git; what follows is the
+ *  capture path those two sections describe.
+ *
+ *  Why every earlier capture came back empty: the sensor's parallel output
+ *  was never switched on. The MT9V113 reaches SEQ_STATE 3 (preview) with its
+ *  pixel bus still tri-stated; RESET_AND_MISC_CONTROL bit 9 is what drives
+ *  it, and nothing here ever set it. And the pixels were never going to show
+ *  up in the port registers anyway -- they arrive through a separate FIFO
+ *  window at 0x10320000 (port 0) / 0x10321000 (port 1).
+ *
+ *  Hardware, as used below:
+ *
+ *    port regs  CAM0 0x10120000 (internal + outer right sensors share it),
+ *               CAM1 0x10121000 (outer left sensor)
+ *      +000 CAM_CNT   bit4 must be 1, bit15 transfer enable; bits 2, 3 and
+ *                     13 must stay 0; bit14 is the CDMA request (unused here)
+ *      +004 CAM_STAT  bits 0-10 FIFO fill level, bit15 overrun. After an
+ *                     overrun no more data arrives until it is cleared.
+ *      +006           bit15 (write, with transfer disabled) clears overrun
+ *      +010/+014      trimming window; GBATEK finds it has no effect on 3DS
+ *    FIFO       0x80-byte read window. Consecutive reads must come from
+ *               increasing addresses (the hardware pops on bit 2 toggling);
+ *               a fixed address returns the same word forever. YUYV data.
+ *    sensors    MT9V113, i2c bus 0 (DT i2c1): 7-bit 0x3d internal, 0x3c
+ *               outer right; i2c bus 1 (DT i2c2): 0x3c outer left.
+ *
+ *  Capture is PIO. The CDMA (PL330) could do this, but the dmaengine API has
+ *  no way to express "read 0x80 bytes incrementing, then rewind the source",
+ *  and the FIFO read rule makes a fixed-address transfer useless. So a
+ *  SCHED_FIFO kthread drains the FIFO while a stream is running.
+ *
+ *  Framing. There is no frame-start marker in the data. What there is, is
+ *  vertical blanking: between frames the FIFO runs dry for milliseconds,
+ *  while inside a frame it never pauses longer than a line. A frame is
+ *  therefore "the first width*height*2 bytes after a gap". Anything left
+ *  over before the next gap is discarded, a frame cut short by a gap is
+ *  dropped, and both are counted -- the measured gap-to-gap size is the one
+ *  number that says whether the sensor is sending what we asked for.
+ *
+ *  Data rate. The FIFO holds ~10 KB, well under a millisecond of a line
+ *  burst, so how fast PIO can drain it decides whether frames survive. The
+ *  sensor's PLL post-divider (P1) sets the pixel clock; the driver starts at
+ *  pll_p1 and, if frames keep overrunning, raises P1 itself and remembers
+ *  the value that worked for that resolution class. Every step is logged.
+ *
+ *  Frame rate (N3DS_CAM_FRAME_RATE). #314 previewed at 0.7-1.6 fps indoors.
+ *  It streamed at P1 1, which is half the DSi's pixel clock, and it left
+ *  AE_MAX_INDEX at its power-on 0x18. That lets auto-exposure integrate for
+ *  24 flicker zones of ~212 rows each, against a 704-row frame, and the
+ *  sensor stretches the frame to fit. The measured gap-to-gap period, 1.41 s,
+ *  is that stretch. Now P1 is 0 at 320x240 and AE is capped at ae_max_index.
+ *
+ *  Restart (N3DS_CAM_RECEIVER_RESET). In #314 only the first stream ever
+ *  received data. After one STOP, every later START left the sensor saying
+ *  SEQ_STATE 3 with its parallel port on, while the receiver sat at
+ *  CNT=8013 STAT=0000 forever. The receiver only ever saw a CAM_CNT bit 4
+ *  0->1 edge once, at probe, and GBATEK guesses that bit is a reset. So every
+ *  START now pulses it. A stream that still gets nothing escalates, one step
+ *  every 2 s, and logs which step brought the data back.
+ *
+ *  Userspace: /dev/ctr_cam. ioctl START {camera, width, height} configures
+ *  the sensor and starts streaming; read() returns the newest complete YUYV
+ *  frame (blocking, one frame per call); STOP and close() park the sensor.
+ *  The only user is mediaserver's CameraHardwareN3ds HAL.
+ *
+ *  Every early return below prints first. The DSP driver cost a whole
+ *  session because its probe could fail in total silence.
+ */
+
+#define DRIVER_NAME "3ds-cam"
+#define pr_fmt(fmt) DRIVER_NAME ": " fmt
+
+#include <linux/io.h>
+#include <linux/init.h>
+#include <linux/delay.h>
+#include <linux/bitops.h>
+#include <linux/of.h>
+#include <linux/i2c.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/platform_device.h>
+#include <linux/mod_devicetable.h>
+#include <linux/miscdevice.h>
+#include <linux/fs.h>
+#include <linux/uaccess.h>
+#include <linux/vmalloc.h>
+#include <linux/kthread.h>
+#include <linux/sched.h>
+#include <linux/wait.h>
+#include <linux/spinlock.h>
+#include <linux/mutex.h>
+#include <linux/ktime.h>
+
+/* ---- userspace ABI; CameraHardwareN3ds.cpp carries a copy ---------------- */
+
+#define CTR_CAM_OUTER_RIGHT	0	/* Android's "back" camera */
+#define CTR_CAM_INNER		1	/* self-facing */
+#define CTR_CAM_OUTER_LEFT	2
+#define CTR_CAM_COUNT		3
+
+struct ctr_cam_config {
+	__u32 camera;
+	__u32 width;
+	__u32 height;
+	__u32 flags;		/* reserved, must be 0 */
+};
+
+struct ctr_cam_stats {
+	__u32 frames;		/* complete frames delivered */
+	__u32 short_frames;	/* frames a gap cut short, dropped */
+	__u32 overruns;
+	__u32 last_gap_bytes;	/* bytes between the last two gaps */
+	__u32 max_fifo;		/* highest CAM_STAT fill level seen */
+	__u32 p1;		/* sensor PLL post-divider in use */
+	__u64 words;		/* FIFO words read, total */
+};
+
+#define CTR_CAM_IOC_START	_IOW('c', 0x01, struct ctr_cam_config)
+#define CTR_CAM_IOC_STOP	_IO('c', 0x02)
+#define CTR_CAM_IOC_STATS	_IOR('c', 0x03, struct ctr_cam_stats)
+
+/* ---- hardware ------------------------------------------------------------ */
+
+/* CFG11_CAMERA_CNT, 0x10141224: bit0 = 16 MHz camera clock. */
+#define PDN_CAM_CLOCK_ENABLE	BIT(0)
+
+#define CAM_CNT			0x000
+#define  CAM_CNT_MUST_BE_1	BIT(4)
+#define  CAM_CNT_XFER		BIT(15)
+#define CAM_STAT		0x004
+#define  CAM_STAT_FILL		0x07ff
+#define  CAM_STAT_OVERRUN	BIT(15)
+#define CAM_CTL2		0x006
+#define  CAM_CTL2_CLR_OVERRUN	BIT(15)
+#define CAM_TRIM_X0		0x010
+#define CAM_TRIM_Y0		0x012
+#define CAM_TRIM_X1		0x014
+#define CAM_TRIM_Y1		0x016
+
+#define CAM_FIFO_WINDOW		0x80
+
+#define CAM_MAX_WIDTH		640
+#define CAM_MAX_HEIGHT		480
+#define CAM_BUF_BYTES		(CAM_MAX_WIDTH * CAM_MAX_HEIGHT * 2)
+
+/* FIFO empty this long = vertical blanking. A line is ~50-200 us. */
+#define CAM_GAP_NS		(3 * NSEC_PER_MSEC)
+#define CAM_REPORT_NS		(10ULL * NSEC_PER_SEC)
+#define CAM_NODATA_NS		(2ULL * NSEC_PER_SEC)
+#define CAM_OVERRUN_SLOWDOWN	3	/* consecutive overruns, no frame between */
+#define CAM_P1_MAX		7
+#define CAM_RECOVERY_STEPS	3
+#define CAM_QVGA_BYTES		(320 * 240 * 2)
+
+#define MT9V113_CHIP_VERSION		0x2280
+#define MT9V113_REG_CHIP_VERSION	0x0000
+#define MT9V113_REG_STANDBY_CONTROL	0x0018
+#define  MT9V113_STANDBY		BIT(0)
+#define  MT9V113_STANDBY_DONE		BIT(14)
+#define MT9V113_REG_RESET_MISC		0x001a
+#define  MT9V113_PARALLEL_ENABLE	BIT(9)
+#define MT9V113_REG_CORE_301A		0x301a
+#define  MT9V113_CORE_AWAKE		BIT(2)
+#define MT9V113_REG_MCU_ADDRESS		0x098c
+#define MT9V113_REG_MCU_DATA_0		0x0990
+#define MT9V113_VAR_SEQ_CMD		0xa103
+#define MT9V113_VAR_SEQ_STATE		0xa104
+#define MT9V113_SEQ_CMD_REFRESH		5
+#define MT9V113_SEQ_CMD_REFRESH_MODE	6
+#define MT9V113_VAR_AE_MAX_INDEX	0xa20c
+#define MT9V113_VAR_AE_INDEX		0xa21b
+#define MT9V113_VAR_AE_VIRTGAIN		0xa21c
+#define MT9V113_REG_PLL_CONTROL		0x0014
+#define MT9V113_REG_CLOCKS_CONTROL	0x0016
+
+#define CAM_SENSOR_WAIT_MS	500
+
+/* ---- tunables ------------------------------------------------------------ */
+
+static uint pll_p1;
+module_param(pll_p1, uint, 0644);
+MODULE_PARM_DESC(pll_p1,
+		 "initial MT9V113 PLL P1 post-divider up to 320 wide (0 = DSi timing, fastest); raised automatically on overrun");
+
+/* 640 wide is 4x the bytes per line: PIO needs the slower clock from the start. */
+static uint pll_p1_vga = 1;
+module_param(pll_p1_vga, uint, 0644);
+MODULE_PARM_DESC(pll_p1_vga,
+		 "initial MT9V113 PLL P1 post-divider above 320 wide; raised automatically on overrun");
+
+static uint cnt_bits = CAM_CNT_MUST_BE_1;
+module_param(cnt_bits, uint, 0644);
+MODULE_PARM_DESC(cnt_bits, "CAM_CNT value used while streaming, less bit 15");
+
+/* MODE_SENSOR_READ_MODE: bit0 mirrors X, bit1 flips Y. DSi values. */
+static uint read_mode_inner = 0x24;
+module_param(read_mode_inner, uint, 0644);
+MODULE_PARM_DESC(read_mode_inner, "MT9V113 read mode for the internal camera");
+
+static uint read_mode_outer = 0x25;
+module_param(read_mode_outer, uint, 0644);
+MODULE_PARM_DESC(read_mode_outer, "MT9V113 read mode for the outer cameras");
+
+/*
+ * AE_MAX_INDEX: how many flicker zones auto-exposure may integrate for.
+ * GBATEK: the DSi's 6 leaves pictures nearly black indoors, and the power-on
+ * 0x18 is much brighter at the cost of frame rate. On hardware (#314) that
+ * cost was a 1 fps preview, so 12 halves the worst case.
+ * 0 leaves the power-on value.
+ */
+static uint ae_max_index = 12;
+module_param(ae_max_index, uint, 0644);
+MODULE_PARM_DESC(ae_max_index,
+		 "MT9V113 AE_MAX_INDEX (6 = DSi, dark but fast; 0x18 = power-on, bright but ~1 fps indoors; 0 = leave)");
+
+/* ---- state --------------------------------------------------------------- */
+
+struct ctr_cam_sensor {
+	const char *name;
+	struct i2c_adapter *adap;
+	u16 addr;
+	u8 port;
+	bool inner;
+	bool present;
+	bool active;
+};
+
+struct ctr_cam_port {
+	void __iomem *regs;
+	void __iomem *fifo;
+};
+
+struct ctr_cam {
+	struct device *dev;
+	void __iomem *pdn;
+	struct ctr_cam_port port[2];
+	struct ctr_cam_sensor sensor[CTR_CAM_COUNT];
+	struct miscdevice misc;
+
+	struct mutex lock;		/* open, ioctl, release */
+	bool opened;
+
+	/* Stream configuration; changed only with the thread stopped. */
+	struct task_struct *thread;
+	int cur;			/* streaming camera, -1 = none */
+	u32 width, height, frame_bytes;
+	u8 p1;
+	u8 p1_learned[2];		/* [0] <= 320 wide, [1] larger */
+	bool streaming;
+
+	/* Triple buffer: the thread fills, read() takes the newest. */
+	void *buf[3];
+	int fill, ready, user;
+	u32 ready_seq, user_seq, ready_len;
+	spinlock_t buf_lock;
+	wait_queue_head_t frame_wq;
+
+	/* Framing, owned by the thread. */
+	u32 pos;			/* bytes in buf[fill] */
+	u32 since_gap;			/* bytes read since the last gap */
+	u32 win;			/* FIFO window read offset */
+	bool need_gap;
+	bool gapless;
+	unsigned int consec_overruns;
+	unsigned int gaps_logged;
+	u64 last_data_ns;
+
+	struct ctr_cam_stats stats;	/* thread writes, STATS ioctl reads */
+};
+
+/* ---- MT9V113 over i2c ----------------------------------------------------- */
+
+static int ctr_cam_sensor_read(struct i2c_adapter *adap, u16 addr, u16 reg,
+			       u16 *out)
+{
+	u8 tx[2] = { reg >> 8, reg & 0xff };
+	u8 rx[2] = { 0x00, 0x00 };
+	struct i2c_msg msgs[2] = {
+		{ .addr = addr, .flags = 0,        .len = 2, .buf = tx },
+		{ .addr = addr, .flags = I2C_M_RD, .len = 2, .buf = rx },
+	};
+	int ret = i2c_transfer(adap, msgs, 2);
+
+	if (ret != 2)
+		return ret < 0 ? ret : -EIO;
+	*out = (rx[0] << 8) | rx[1];
+	return 0;
+}
+
+static int ctr_cam_sensor_write(struct i2c_adapter *adap, u16 addr, u16 reg,
+				u16 val)
+{
+	u8 tx[4] = { reg >> 8, reg & 0xff, val >> 8, val & 0xff };
+	struct i2c_msg msg = {
+		.addr = addr, .flags = 0, .len = 4, .buf = tx,
+	};
+	int ret = i2c_transfer(adap, &msg, 1);
+
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	return 0;
+}
+
+/*
+ * A sequence of sensor operations that stops at the first i2c error and
+ * remembers it, so the init lists below read like GBATEK's. Waits that time
+ * out only warn: the DSi carries on regardless, and so do we.
+ */
+struct apt {
+	struct ctr_cam *cam;
+	struct ctr_cam_sensor *s;
+	int err;
+};
+
+static u16 apt_rd(struct apt *a, u16 reg)
+{
+	u16 val = 0;
+
+	if (a->err)
+		return 0;
+	a->err = ctr_cam_sensor_read(a->s->adap, a->s->addr, reg, &val);
+	if (a->err)
+		dev_err(a->cam->dev, "%s: read R0x%04x failed (%d)\n",
+			a->s->name, reg, a->err);
+	return val;
+}
+
+static void apt_wr(struct apt *a, u16 reg, u16 val)
+{
+	if (a->err)
+		return;
+	a->err = ctr_cam_sensor_write(a->s->adap, a->s->addr, reg, val);
+	if (a->err)
+		dev_err(a->cam->dev, "%s: write R0x%04x=0x%04x failed (%d)\n",
+			a->s->name, reg, val, a->err);
+}
+
+static void apt_set(struct apt *a, u16 reg, u16 bits)
+{
+	u16 val = apt_rd(a, reg);
+
+	apt_wr(a, reg, val | bits);
+}
+
+static void apt_clr(struct apt *a, u16 reg, u16 bits)
+{
+	u16 val = apt_rd(a, reg);
+
+	apt_wr(a, reg, val & ~bits);
+}
+
+static void apt_wait(struct apt *a, u16 reg, u16 mask, bool set,
+		     const char *what)
+{
+	unsigned long end = jiffies + msecs_to_jiffies(CAM_SENSOR_WAIT_MS);
+	u16 val;
+
+	for (;;) {
+		val = apt_rd(a, reg);
+		if (a->err || !!(val & mask) == set)
+			return;
+		if (time_after(jiffies, end))
+			break;
+		usleep_range(1000, 2000);
+	}
+	dev_warn(a->cam->dev, "%s: %s: R0x%04x still 0x%04x after %d ms\n",
+		 a->s->name, what, reg, val, CAM_SENSOR_WAIT_MS);
+}
+
+static void apt_mcu_wr(struct apt *a, u16 var, u16 val)
+{
+	apt_wr(a, MT9V113_REG_MCU_ADDRESS, var);
+	apt_wr(a, MT9V113_REG_MCU_DATA_0, val);
+}
+
+static u16 apt_mcu_rd(struct apt *a, u16 var)
+{
+	apt_wr(a, MT9V113_REG_MCU_ADDRESS, var);
+	return apt_rd(a, MT9V113_REG_MCU_DATA_0);
+}
+
+static void apt_mcu_set(struct apt *a, u16 var, u16 bits)
+{
+	u16 val = apt_mcu_rd(a, var);
+
+	apt_mcu_wr(a, var, val | bits);
+}
+
+/* The sensor firmware clears SEQ_CMD once it has taken the command. */
+static void apt_seq(struct apt *a, u16 cmd)
+{
+	unsigned long end = jiffies + msecs_to_jiffies(CAM_SENSOR_WAIT_MS);
+	u16 val;
+
+	apt_mcu_wr(a, MT9V113_VAR_SEQ_CMD, cmd);
+	for (;;) {
+		val = apt_mcu_rd(a, MT9V113_VAR_SEQ_CMD);
+		if (a->err || !(val & 0x0f))
+			return;
+		if (time_after(jiffies, end))
+			break;
+		usleep_range(1000, 2000);
+	}
+	dev_warn(a->cam->dev, "%s: SEQ_CMD %u not taken after %d ms (0x%04x)\n",
+		 a->s->name, cmd, CAM_SENSOR_WAIT_MS, val);
+}
+
+/*
+ * GBATEK "aptina_code_list_init" followed by "aptina_code_list_activate",
+ * with context A sized to the request instead of the DSi's 256x192, and
+ * the PLL post-divider taken from the caller.
+ */
+static int ctr_cam_sensor_start(struct ctr_cam *cam, struct ctr_cam_sensor *s,
+				u32 width, u32 height, u8 p1)
+{
+	struct apt a = { .cam = cam, .s = s };
+	bool inner = s->inner;
+	u16 read_mode = inner ? read_mode_inner : read_mode_outer;
+	u16 state;
+
+	/* reset */
+	apt_wr(&a, 0x001a, 0x0003);
+	apt_wr(&a, 0x001a, 0x0000);
+	usleep_range(1000, 2000);
+
+	/* wakeup */
+	apt_wr(&a, 0x0018, 0x4028);
+	apt_wr(&a, 0x001e, 0x0201);
+	apt_wr(&a, 0x0016, 0x42df);
+	apt_wait(&a, MT9V113_REG_STANDBY_CONTROL, MT9V113_STANDBY_DONE, false,
+		 "wakeup");
+	apt_wait(&a, MT9V113_REG_CORE_301A, MT9V113_CORE_AWAKE, true,
+		 "wakeup (core)");
+
+	apt_mcu_wr(&a, 0x02f0, 0x0000);
+	apt_mcu_wr(&a, 0x02f2, 0x0210);
+	apt_mcu_wr(&a, 0x02f4, 0x001a);
+	apt_mcu_wr(&a, 0x2145, 0x02f4);
+	apt_mcu_wr(&a, 0xa134, 0x0001);
+	apt_mcu_set(&a, 0xa115, 0x0002);	/* SEQ_CAP_MODE: video */
+
+	/* YUV, luma first: Y0 Cb Y1 Cr, i.e. YUYV in memory */
+	apt_mcu_wr(&a, 0x2755, 0x0002);		/* MODE_OUTPUT_FORMAT_A */
+	apt_mcu_wr(&a, 0x2757, 0x0002);		/* MODE_OUTPUT_FORMAT_B */
+
+	/* PLL */
+	apt_wr(&a, 0x0014, 0x2145);
+	apt_wr(&a, 0x0010, 0x0111);
+	apt_wr(&a, 0x0012, p1 & 0x0f);
+	apt_wr(&a, 0x0014, 0x244b);
+	apt_wr(&a, 0x0014, 0x304b);
+	apt_wait(&a, 0x0014, BIT(15), true, "PLL lock");
+	apt_clr(&a, 0x0014, 0x0001);		/* leave bypass */
+
+	/* context A = what we stream; B stays the DSi's 640x480 */
+	apt_mcu_wr(&a, 0x2703, width);
+	apt_mcu_wr(&a, 0x2705, height);
+	apt_mcu_wr(&a, 0x2707, 0x0280);
+	apt_mcu_wr(&a, 0x2709, 0x01e0);
+
+	apt_mcu_wr(&a, 0x2715, 0x0001);
+	apt_mcu_wr(&a, 0x2719, 0x001a);
+	apt_mcu_wr(&a, 0x271b, 0x006b);
+	apt_mcu_wr(&a, 0x271d, 0x006b);
+	apt_mcu_wr(&a, 0x271f, 0x02c0);
+	apt_mcu_wr(&a, 0x2721, 0x034b);
+	if (ae_max_index)
+		apt_mcu_wr(&a, MT9V113_VAR_AE_MAX_INDEX, ae_max_index & 0xff);
+	apt_mcu_wr(&a, 0x272b, 0x0001);
+	apt_mcu_wr(&a, 0x272f, 0x001a);
+	apt_mcu_wr(&a, 0x2731, 0x006b);
+	apt_mcu_wr(&a, 0x2733, 0x006b);
+	apt_mcu_wr(&a, 0x2735, 0x02c0);
+	apt_mcu_wr(&a, 0x2737, 0x034b);
+
+	apt_set(&a, 0x3210, 0x0008);
+	apt_mcu_wr(&a, 0xa208, 0x0000);
+	apt_mcu_wr(&a, 0xa24c, 0x0020);
+	apt_mcu_wr(&a, 0xa24f, 0x0070);
+	apt_mcu_wr(&a, 0x2717, read_mode);	/* MODE_SENSOR_READ_MODE_A */
+	apt_mcu_wr(&a, 0x272d, read_mode);	/* MODE_SENSOR_READ_MODE_B */
+	apt_mcu_wr(&a, 0xa202, inner ? 0x22 : 0x00);	/* AE window */
+	apt_mcu_wr(&a, 0xa203, inner ? 0xbb : 0xff);
+	apt_set(&a, 0x0016, 0x0020);
+	apt_mcu_wr(&a, 0xa115, 0x0072);
+	apt_mcu_wr(&a, 0xa11f, 0x0001);
+	apt_wr(&a, 0x326c, inner ? 0x0900 : 0x1000);
+	apt_mcu_wr(&a, 0xab22, inner ? 0x0001 : 0x0002);
+	apt_seq(&a, MT9V113_SEQ_CMD_REFRESH_MODE);
+	apt_seq(&a, MT9V113_SEQ_CMD_REFRESH);
+
+	/* activate */
+	apt_clr(&a, MT9V113_REG_STANDBY_CONTROL, MT9V113_STANDBY);
+	apt_wait(&a, MT9V113_REG_STANDBY_CONTROL, MT9V113_STANDBY_DONE, false,
+		 "wakeup");
+	apt_wait(&a, MT9V113_REG_CORE_301A, MT9V113_CORE_AWAKE, true,
+		 "wakeup (core)");
+	apt_set(&a, MT9V113_REG_RESET_MISC, MT9V113_PARALLEL_ENABLE);
+
+	state = apt_mcu_rd(&a, MT9V113_VAR_SEQ_STATE);
+	if (a.err) {
+		dev_err(cam->dev, "%s: sensor start failed (%d)\n", s->name,
+			a.err);
+		return a.err;
+	}
+
+	s->active = true;
+	dev_info(cam->dev, "%s: sensor streaming %ux%u, P1 %u, SEQ_STATE %u, read mode 0x%02x, AE max index %u (N3DS_CAM_FRAME_RATE)\n",
+		 s->name, width, height, p1, state, read_mode, ae_max_index);
+	return 0;
+}
+
+/* GBATEK "aptina_code_list_deactivate": off the shared bus, into standby. */
+static void ctr_cam_sensor_park(struct ctr_cam *cam, struct ctr_cam_sensor *s)
+{
+	struct apt a = { .cam = cam, .s = s };
+
+	apt_clr(&a, MT9V113_REG_RESET_MISC, MT9V113_PARALLEL_ENABLE);
+	apt_set(&a, MT9V113_REG_STANDBY_CONTROL, MT9V113_STANDBY);
+	apt_wait(&a, MT9V113_REG_STANDBY_CONTROL, MT9V113_STANDBY_DONE, true,
+		 "standby");
+	apt_wait(&a, MT9V113_REG_CORE_301A, MT9V113_CORE_AWAKE, false,
+		 "standby (core)");
+	s->active = false;
+	if (a.err)
+		dev_warn(cam->dev, "%s: park failed (%d)\n", s->name, a.err);
+}
+
+/* ---- receiver ------------------------------------------------------------- */
+
+static inline u32 ctr_cam_fifo_word(struct ctr_cam_port *p, u32 *win)
+{
+	u32 w = readl_relaxed(p->fifo + *win);
+
+	*win = (*win + 4) & (CAM_FIFO_WINDOW - 1);
+	return w;
+}
+
+static void ctr_cam_fifo_flush(struct ctr_cam_port *p, u32 *win)
+{
+	unsigned int guard = 0x4000;
+	u16 n;
+
+	while (guard && (n = readw(p->regs + CAM_STAT) & CAM_STAT_FILL)) {
+		while (n-- && guard--)
+			ctr_cam_fifo_word(p, win);
+	}
+}
+
+static void ctr_cam_port_stop(struct ctr_cam_port *p, u32 *win)
+{
+	writew(readw(p->regs + CAM_CNT) & ~CAM_CNT_XFER, p->regs + CAM_CNT);
+	ctr_cam_fifo_flush(p, win);
+	writew(readw(p->regs + CAM_CTL2) | CAM_CTL2_CLR_OVERRUN,
+	       p->regs + CAM_CTL2);
+}
+
+/*
+ * GBATEK on CAM_CNT bit 4: "MUST be 1, else data transfer hangs, maybe
+ * reset?". Pulse it low with transfers off so the receiver drops whatever
+ * frame state a STOP left it in. Called with the sensor parked or before its
+ * init list, never mid-stream.
+ */
+static void ctr_cam_port_reset(struct ctr_cam_port *p, u32 *win)
+{
+	writew(0, p->regs + CAM_CNT);
+	usleep_range(1000, 2000);
+	writew(CAM_CNT_MUST_BE_1, p->regs + CAM_CNT);
+	usleep_range(1000, 2000);
+	ctr_cam_fifo_flush(p, win);
+	writew(readw(p->regs + CAM_CTL2) | CAM_CTL2_CLR_OVERRUN,
+	       p->regs + CAM_CTL2);
+}
+
+static void ctr_cam_port_start(struct ctr_cam *cam, struct ctr_cam_port *p)
+{
+	u16 cnt = cnt_bits & ~CAM_CNT_XFER;
+
+	writew(cnt, p->regs + CAM_CNT);
+	ctr_cam_fifo_flush(p, &cam->win);
+	writew(readw(p->regs + CAM_CTL2) | CAM_CTL2_CLR_OVERRUN,
+	       p->regs + CAM_CTL2);
+
+	/* Full-frame trim window, in case the trimming does do something. */
+	writew(0, p->regs + CAM_TRIM_X0);
+	writew(0, p->regs + CAM_TRIM_Y0);
+	writew((cam->width - 2) & 0x3fe, p->regs + CAM_TRIM_X1);
+	writew((cam->height - 1) & 0x1ff, p->regs + CAM_TRIM_Y1);
+
+	writew(cnt | CAM_CNT_XFER, p->regs + CAM_CNT);
+}
+
+static void ctr_cam_reset_framing(struct ctr_cam *cam)
+{
+	cam->pos = 0;
+	cam->since_gap = 0;
+	cam->need_gap = true;
+	cam->consec_overruns = 0;
+	cam->last_data_ns = ktime_get_ns();
+}
+
+static void ctr_cam_deliver(struct ctr_cam *cam)
+{
+	spin_lock(&cam->buf_lock);
+	swap(cam->fill, cam->ready);
+	cam->ready_len = cam->frame_bytes;
+	cam->ready_seq++;
+	spin_unlock(&cam->buf_lock);
+	wake_up_interruptible(&cam->frame_wq);
+
+	cam->stats.frames++;
+	cam->consec_overruns = 0;
+	cam->pos = 0;
+	cam->need_gap = !cam->gapless;
+}
+
+static void ctr_cam_gap(struct ctr_cam *cam)
+{
+	cam->stats.last_gap_bytes = cam->since_gap;
+	if (cam->gaps_logged < 4) {
+		cam->gaps_logged++;
+		dev_info(cam->dev, "%s: frame gap after %u bytes (a %ux%u frame is %u)\n",
+			 cam->sensor[cam->cur].name, cam->since_gap,
+			 cam->width, cam->height, cam->frame_bytes);
+	}
+	if (!cam->need_gap && cam->pos)
+		cam->stats.short_frames++;
+	cam->since_gap = 0;
+	cam->pos = 0;
+	cam->need_gap = false;
+}
+
+static void ctr_cam_drain(struct ctr_cam *cam, struct ctr_cam_port *p,
+			  unsigned int n)
+{
+	cam->since_gap += n * 4;
+	cam->stats.words += n;
+
+	while (n) {
+		u32 *dst;
+		unsigned int take, i;
+
+		if (cam->need_gap) {
+			while (n--)
+				ctr_cam_fifo_word(p, &cam->win);
+			break;
+		}
+
+		take = min_t(unsigned int, n, (cam->frame_bytes - cam->pos) / 4);
+		dst = cam->buf[cam->fill] + cam->pos;
+		for (i = 0; i < take; i++)
+			dst[i] = ctr_cam_fifo_word(p, &cam->win);
+		cam->pos += take * 4;
+		n -= take;
+
+		if (cam->pos == cam->frame_bytes)
+			ctr_cam_deliver(cam);
+	}
+
+	if (cam->need_gap && !cam->gapless &&
+	    cam->since_gap > 2 * cam->frame_bytes) {
+		dev_warn(cam->dev,
+			 "%s: no inter-frame gap in %u bytes; framing by byte count from here on\n",
+			 cam->sensor[cam->cur].name, cam->since_gap);
+		cam->gapless = true;
+		cam->need_gap = false;
+		cam->pos = 0;
+	}
+}
+
+static void ctr_cam_overrun(struct ctr_cam *cam, struct ctr_cam_port *p)
+{
+	struct ctr_cam_sensor *s = &cam->sensor[cam->cur];
+
+	ctr_cam_port_stop(p, &cam->win);
+	cam->stats.overruns++;
+
+	if (++cam->consec_overruns >= CAM_OVERRUN_SLOWDOWN &&
+	    cam->p1 < CAM_P1_MAX) {
+		cam->p1++;
+		cam->p1_learned[cam->width > 320] = cam->p1;
+		cam->stats.p1 = cam->p1;
+		dev_warn(cam->dev,
+			 "%s: %u overruns without a frame; slowing the pixel clock to P1 %u\n",
+			 s->name, cam->consec_overruns, cam->p1);
+		ctr_cam_sensor_start(cam, s, cam->width, cam->height, cam->p1);
+		cam->consec_overruns = 0;
+	} else if (cam->consec_overruns == CAM_OVERRUN_SLOWDOWN * 4) {
+		dev_warn(cam->dev,
+			 "%s: still overrunning at P1 %u; PIO cannot keep up or the receiver is misconfigured\n",
+			 s->name, cam->p1);
+	}
+
+	ctr_cam_reset_framing(cam);
+	ctr_cam_port_start(cam, p);
+}
+
+static void ctr_cam_report_nodata(struct ctr_cam *cam, struct ctr_cam_port *p)
+{
+	struct ctr_cam_sensor *s = &cam->sensor[cam->cur];
+	struct apt a = { .cam = cam, .s = s };
+	u16 misc, standby, state, pll, clocks;
+
+	misc = apt_rd(&a, MT9V113_REG_RESET_MISC);
+	standby = apt_rd(&a, MT9V113_REG_STANDBY_CONTROL);
+	state = apt_mcu_rd(&a, MT9V113_VAR_SEQ_STATE);
+	pll = apt_rd(&a, MT9V113_REG_PLL_CONTROL);
+	clocks = apt_rd(&a, MT9V113_REG_CLOCKS_CONTROL);
+	dev_warn(cam->dev,
+		 "%s: no FIFO data 2 s after start: CNT=%04x STAT=%04x +006=%04x; sensor R0x001a=%04x R0x0018=%04x SEQ_STATE=%u PLL=%04x CLK=%04x (i2c %d)\n",
+		 s->name, readw(p->regs + CAM_CNT), readw(p->regs + CAM_STAT),
+		 readw(p->regs + CAM_CTL2), misc, standby, state, pll, clocks,
+		 a.err);
+}
+
+/*
+ * N3DS_CAM_RECEIVER_RESET, the escalation. Each step is tried after 2 s
+ * without a byte:
+ *   1. reset the receiver, leaving the sensor streaming
+ *   2. park and restart the sensor, and reset the receiver in between
+ *   3. step 2 again, after cycling the camera clock (CFG11_CAMERA_CNT)
+ */
+static void ctr_cam_recover(struct ctr_cam *cam, struct ctr_cam_port *p,
+			    unsigned int step)
+{
+	struct ctr_cam_sensor *s = &cam->sensor[cam->cur];
+
+	dev_warn(cam->dev, "%s: no-data recovery step %u: %s\n", s->name, step,
+		 step == 1 ? "receiver reset" :
+		 step == 2 ? "sensor restart + receiver reset" :
+			     "camera clock cycle + sensor restart + receiver reset");
+
+	ctr_cam_port_stop(p, &cam->win);
+	if (step >= 2)
+		ctr_cam_sensor_park(cam, s);
+	if (step >= 3) {
+		iowrite8(ioread8(cam->pdn) & ~PDN_CAM_CLOCK_ENABLE, cam->pdn);
+		usleep_range(5000, 6000);
+		iowrite8(ioread8(cam->pdn) | PDN_CAM_CLOCK_ENABLE, cam->pdn);
+		usleep_range(5000, 6000);
+	}
+	ctr_cam_port_reset(p, &cam->win);
+	if (step >= 2)
+		ctr_cam_sensor_start(cam, s, cam->width, cam->height, cam->p1);
+	ctr_cam_reset_framing(cam);
+	ctr_cam_port_start(cam, p);
+}
+
+static int ctr_cam_thread(void *data)
+{
+	struct ctr_cam *cam = data;
+	struct ctr_cam_sensor *s = &cam->sensor[cam->cur];
+	struct ctr_cam_port *p = &cam->port[s->port];
+	u64 started = ktime_get_ns();
+	u64 next_report = started + CAM_REPORT_NS;
+	u64 next_recovery = started + CAM_NODATA_NS;
+	u32 frames_at_report = 0;
+	unsigned int recovery = 0;
+	bool seen_data = false;
+	/*
+	 * Without high-res timers a sleep here is a whole tick (1 ms). Above
+	 * 320x240 the FIFO fills faster than that, so inside a frame the
+	 * thread spins instead. It only spins for the frame's active lines.
+	 */
+	bool spin = cam->frame_bytes > CAM_QVGA_BYTES;
+
+	/*
+	 * #314 ran at sched_set_fifo_low(), where every other RT thread
+	 * preempted it; its 8 overruns in 140 s came at a FIFO peak of 480
+	 * units out of 1280.
+	 */
+	sched_set_fifo(current);
+
+	while (!kthread_should_stop()) {
+		u16 stat = readw_relaxed(p->regs + CAM_STAT);
+		unsigned int n = stat & CAM_STAT_FILL;
+		u64 now;
+
+		if (stat & CAM_STAT_OVERRUN) {
+			ctr_cam_overrun(cam, p);
+			continue;
+		}
+
+		if (n) {
+			if (n > cam->stats.max_fifo)
+				cam->stats.max_fifo = n;
+			ctr_cam_drain(cam, p, n);
+			cam->last_data_ns = ktime_get_ns();
+			if (!seen_data) {
+				seen_data = true;
+				dev_info(cam->dev, "%s: first FIFO data %llu ms after start (recovery steps used: %u)\n",
+					 s->name,
+					 div_u64(cam->last_data_ns - started,
+						 NSEC_PER_MSEC), recovery);
+			}
+			continue;
+		}
+
+		now = ktime_get_ns();
+		if (cam->since_gap) {
+			if (now - cam->last_data_ns > CAM_GAP_NS) {
+				ctr_cam_gap(cam);
+			} else if (spin) {
+				udelay(10);
+				continue;
+			}
+		}
+
+		if (!seen_data && now > next_recovery) {
+			if (!recovery)
+				ctr_cam_report_nodata(cam, p);
+			if (recovery < CAM_RECOVERY_STEPS)
+				ctr_cam_recover(cam, p, ++recovery);
+			next_recovery = recovery < CAM_RECOVERY_STEPS ?
+					ktime_get_ns() + CAM_NODATA_NS : U64_MAX;
+			continue;
+		}
+
+		/* Only between frames: the i2c reads below take milliseconds. */
+		if (now > next_report && !cam->since_gap) {
+			struct apt a = { .cam = cam, .s = s };
+			u32 frames = cam->stats.frames;
+			u16 ae_index = apt_mcu_rd(&a, MT9V113_VAR_AE_INDEX);
+			u16 ae_gain = apt_mcu_rd(&a, MT9V113_VAR_AE_VIRTGAIN);
+
+			dev_info(cam->dev,
+				 "%s: %u frames (%u in 10 s), %u short, %u overruns, last gap-to-gap %u bytes (want %u), FIFO peak %u, P1 %u, AE index %u (max %u) gain 0x%02x (i2c %d)\n",
+				 s->name, frames,
+				 frames - frames_at_report,
+				 cam->stats.short_frames, cam->stats.overruns,
+				 cam->stats.last_gap_bytes, cam->frame_bytes,
+				 cam->stats.max_fifo, cam->p1, ae_index,
+				 ae_max_index, ae_gain, a.err);
+			frames_at_report = frames;
+			next_report = ktime_get_ns() + CAM_REPORT_NS;
+		}
+
+		usleep_range(100, 200);
+	}
+	return 0;
+}
+
+/* ---- stream control (cam->lock held) ------------------------------------- */
+
+static void ctr_cam_stream_stop(struct ctr_cam *cam)
+{
+	struct ctr_cam_sensor *s;
+
+	if (cam->cur < 0)
+		return;
+	s = &cam->sensor[cam->cur];
+
+	if (cam->thread) {
+		kthread_stop(cam->thread);
+		cam->thread = NULL;
+	}
+	ctr_cam_port_stop(&cam->port[s->port], &cam->win);
+	ctr_cam_sensor_park(cam, s);
+
+	spin_lock(&cam->buf_lock);
+	cam->streaming = false;
+	spin_unlock(&cam->buf_lock);
+	wake_up_interruptible(&cam->frame_wq);
+
+	dev_info(cam->dev, "%s: stopped after %u frames, %u short, %u overruns\n",
+		 s->name, cam->stats.frames, cam->stats.short_frames,
+		 cam->stats.overruns);
+	cam->cur = -1;
+}
+
+static int ctr_cam_stream_start(struct ctr_cam *cam,
+				const struct ctr_cam_config *cfg)
+{
+	struct ctr_cam_sensor *s;
+	struct task_struct *t;
+	unsigned int i;
+	int ret;
+
+	if (cfg->camera >= CTR_CAM_COUNT || cfg->flags)
+		return -EINVAL;
+	if (cfg->width < 16 || cfg->width > CAM_MAX_WIDTH || (cfg->width & 1) ||
+	    cfg->height < 16 || cfg->height > CAM_MAX_HEIGHT)
+		return -EINVAL;
+
+	s = &cam->sensor[cfg->camera];
+	if (!s->present) {
+		dev_err(cam->dev, "%s: not present, cannot stream\n", s->name);
+		return -ENODEV;
+	}
+	if (!cam->port[s->port].fifo) {
+		dev_err(cam->dev, "%s: port %u FIFO not mapped\n", s->name,
+			s->port);
+		return -ENODEV;
+	}
+
+	ctr_cam_stream_stop(cam);
+
+	/* The internal and outer-right sensors share CAM0's pixel bus. */
+	for (i = 0; i < CTR_CAM_COUNT; i++)
+		if (i != cfg->camera && cam->sensor[i].active &&
+		    cam->sensor[i].port == s->port)
+			ctr_cam_sensor_park(cam, &cam->sensor[i]);
+
+	cam->cur = cfg->camera;
+	cam->width = cfg->width;
+	cam->height = cfg->height;
+	cam->frame_bytes = cfg->width * cfg->height * 2;
+	cam->p1 = max_t(u8, cam->p1_learned[cam->width > 320],
+			min_t(uint, cam->width > 320 ? pll_p1_vga : pll_p1,
+			      CAM_P1_MAX));
+	cam->gapless = false;
+	cam->gaps_logged = 0;
+	memset(&cam->stats, 0, sizeof(cam->stats));
+	cam->stats.p1 = cam->p1;
+
+	/* N3DS_CAM_RECEIVER_RESET: before the sensor drives the bus again. */
+	ctr_cam_port_reset(&cam->port[s->port], &cam->win);
+
+	ret = ctr_cam_sensor_start(cam, s, cam->width, cam->height, cam->p1);
+	if (ret) {
+		ctr_cam_sensor_park(cam, s);
+		cam->cur = -1;
+		return ret;
+	}
+
+	spin_lock(&cam->buf_lock);
+	cam->user_seq = cam->ready_seq;
+	cam->streaming = true;
+	spin_unlock(&cam->buf_lock);
+
+	ctr_cam_reset_framing(cam);
+	ctr_cam_port_start(cam, &cam->port[s->port]);
+
+	t = kthread_run(ctr_cam_thread, cam, "ctr_cam%u", cfg->camera);
+	if (IS_ERR(t)) {
+		dev_err(cam->dev, "stream thread failed: %ld\n", PTR_ERR(t));
+		ctr_cam_port_stop(&cam->port[s->port], &cam->win);
+		ctr_cam_sensor_park(cam, s);
+		cam->streaming = false;
+		cam->cur = -1;
+		return PTR_ERR(t);
+	}
+	cam->thread = t;
+	return 0;
+}
+
+/* ---- /dev/ctr_cam --------------------------------------------------------- */
+
+static struct ctr_cam *ctr_cam_from_file(struct file *f)
+{
+	return container_of(f->private_data, struct ctr_cam, misc);
+}
+
+static int ctr_cam_open(struct inode *inode, struct file *f)
+{
+	struct ctr_cam *cam = ctr_cam_from_file(f);
+	unsigned int i;
+	int ret = 0;
+
+	mutex_lock(&cam->lock);
+	if (cam->opened) {
+		ret = -EBUSY;
+		goto out;
+	}
+	for (i = 0; i < 3; i++) {
+		cam->buf[i] = vzalloc(CAM_BUF_BYTES);
+		if (!cam->buf[i]) {
+			while (i--) {
+				vfree(cam->buf[i]);
+				cam->buf[i] = NULL;
+			}
+			ret = -ENOMEM;
+			goto out;
+		}
+	}
+	cam->fill = 0;
+	cam->ready = 1;
+	cam->user = 2;
+	cam->ready_seq = cam->user_seq = 0;
+	cam->ready_len = 0;
+	cam->opened = true;
+out:
+	mutex_unlock(&cam->lock);
+	return ret;
+}
+
+static int ctr_cam_release(struct inode *inode, struct file *f)
+{
+	struct ctr_cam *cam = ctr_cam_from_file(f);
+	unsigned int i;
+
+	mutex_lock(&cam->lock);
+	ctr_cam_stream_stop(cam);
+	for (i = 0; i < 3; i++) {
+		vfree(cam->buf[i]);
+		cam->buf[i] = NULL;
+	}
+	cam->opened = false;
+	mutex_unlock(&cam->lock);
+	return 0;
+}
+
+static bool ctr_cam_frame_waiting(struct ctr_cam *cam)
+{
+	bool ret;
+
+	spin_lock(&cam->buf_lock);
+	ret = cam->ready_seq != cam->user_seq || !cam->streaming;
+	spin_unlock(&cam->buf_lock);
+	return ret;
+}
+
+/* One call, one frame: the newest complete one not yet returned. */
+static ssize_t ctr_cam_read(struct file *f, char __user *ubuf, size_t len,
+			    loff_t *ppos)
+{
+	struct ctr_cam *cam = ctr_cam_from_file(f);
+	long left;
+	u32 n;
+
+	if (!(f->f_flags & O_NONBLOCK)) {
+		left = wait_event_interruptible_timeout(cam->frame_wq,
+				ctr_cam_frame_waiting(cam), 2 * HZ);
+		if (left < 0)
+			return left;
+		if (!left)
+			return -ETIMEDOUT;
+	}
+
+	spin_lock(&cam->buf_lock);
+	if (!cam->streaming) {
+		spin_unlock(&cam->buf_lock);
+		return -EIO;
+	}
+	if (cam->ready_seq == cam->user_seq) {
+		spin_unlock(&cam->buf_lock);
+		return -EAGAIN;
+	}
+	swap(cam->ready, cam->user);
+	cam->user_seq = cam->ready_seq;
+	n = cam->ready_len;
+	spin_unlock(&cam->buf_lock);
+
+	if (len < n)
+		return -EINVAL;
+	if (copy_to_user(ubuf, cam->buf[cam->user], n))
+		return -EFAULT;
+	return n;
+}
+
+static long ctr_cam_ioctl(struct file *f, unsigned int cmd, unsigned long arg)
+{
+	struct ctr_cam *cam = ctr_cam_from_file(f);
+	struct ctr_cam_config cfg;
+	struct ctr_cam_stats st;
+	long ret;
+
+	switch (cmd) {
+	case CTR_CAM_IOC_START:
+		if (copy_from_user(&cfg, (void __user *)arg, sizeof(cfg)))
+			return -EFAULT;
+		mutex_lock(&cam->lock);
+		ret = ctr_cam_stream_start(cam, &cfg);
+		mutex_unlock(&cam->lock);
+		return ret;
+	case CTR_CAM_IOC_STOP:
+		mutex_lock(&cam->lock);
+		ctr_cam_stream_stop(cam);
+		mutex_unlock(&cam->lock);
+		return 0;
+	case CTR_CAM_IOC_STATS:
+		st = cam->stats;
+		if (copy_to_user((void __user *)arg, &st, sizeof(st)))
+			return -EFAULT;
+		return 0;
+	}
+	return -ENOTTY;
+}
+
+static const struct file_operations ctr_cam_fops = {
+	.owner		= THIS_MODULE,
+	.open		= ctr_cam_open,
+	.release	= ctr_cam_release,
+	.read		= ctr_cam_read,
+	.unlocked_ioctl	= ctr_cam_ioctl,
+	.llseek		= noop_llseek,
+};
+
+/* ---- probe ---------------------------------------------------------------- */
+
+static void ctr_cam_identify(struct ctr_cam *cam, struct ctr_cam_sensor *s)
+{
+	u16 id = 0;
+	int ret;
+
+	if (!s->adap) {
+		dev_info(cam->dev, "%s: no i2c bus in the DT, skipped\n",
+			 s->name);
+		return;
+	}
+
+	ret = ctr_cam_sensor_read(s->adap, s->addr, MT9V113_REG_CHIP_VERSION,
+				  &id);
+	if (ret) {
+		dev_info(cam->dev, "%s: no answer at 7-bit 0x%02x (%d)\n",
+			 s->name, s->addr, ret);
+		return;
+	}
+	s->present = true;
+	dev_info(cam->dev, "%s: chip id 0x%04x%s\n", s->name, id,
+		 id == MT9V113_CHIP_VERSION ? " (MT9V113)" : " (unexpected)");
+
+	/* Whatever the last owner left running, get it off the pixel bus. */
+	ctr_cam_sensor_park(cam, s);
+}
+
+static void __iomem *ctr_cam_map(struct platform_device *pdev,
+				 const char *name, phys_addr_t fallback)
+{
+	struct ctr_cam *cam = platform_get_drvdata(pdev);
+	struct resource *res;
+	void __iomem *p;
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, name);
+	if (res)
+		return devm_ioremap_resource(&pdev->dev, res);
+	if (!fallback)
+		return IOMEM_ERR_PTR(-ENODEV);
+
+	/* A DTB older than this driver: map the documented address. */
+	dev_info(cam->dev, "no \"%s\" reg in the DT, mapping %pa\n", name,
+		 &fallback);
+	p = devm_ioremap(&pdev->dev, fallback, 0x1000);
+	return p ? p : IOMEM_ERR_PTR(-ENOMEM);
+}
+
+static struct i2c_adapter *ctr_cam_bus(struct ctr_cam *cam, int index)
+{
+	struct device_node *node;
+	struct i2c_adapter *adap;
+
+	node = of_parse_phandle(cam->dev->of_node, "nintendo,i2c-bus", index);
+	if (!node)
+		return NULL;
+	adap = of_get_i2c_adapter_by_node(node);
+	of_node_put(node);
+	return adap ? adap : ERR_PTR(-EPROBE_DEFER);
+}
+
+static void ctr_cam_put_buses(struct ctr_cam *cam)
+{
+	/* Sensors 0 and 1 share one adapter reference. */
+	if (cam->sensor[0].adap)
+		i2c_put_adapter(cam->sensor[0].adap);
+	if (cam->sensor[2].adap)
+		i2c_put_adapter(cam->sensor[2].adap);
+}
+
+static int ctr_cam_probe(struct platform_device *pdev)
+{
+	struct ctr_cam *cam;
+	struct i2c_adapter *bus0, *bus1;
+	unsigned int i;
+	int ret;
+
+	cam = devm_kzalloc(&pdev->dev, sizeof(*cam), GFP_KERNEL);
+	if (!cam)
+		return -ENOMEM;
+
+	cam->dev = &pdev->dev;
+	cam->cur = -1;
+	mutex_init(&cam->lock);
+	spin_lock_init(&cam->buf_lock);
+	init_waitqueue_head(&cam->frame_wq);
+	platform_set_drvdata(pdev, cam);
+
+	cam->port[0].regs = ctr_cam_map(pdev, "registers", 0);
+	cam->pdn = ctr_cam_map(pdev, "pdn", 0);
+	cam->port[1].regs = ctr_cam_map(pdev, "registers-mirror", 0x10121000);
+	cam->port[0].fifo = ctr_cam_map(pdev, "fifo0", 0x10320000);
+	cam->port[1].fifo = ctr_cam_map(pdev, "fifo1", 0x10321000);
+	if (IS_ERR(cam->port[0].regs) || IS_ERR(cam->pdn) ||
+	    IS_ERR(cam->port[1].regs) || IS_ERR(cam->port[0].fifo) ||
+	    IS_ERR(cam->port[1].fifo)) {
+		dev_err(cam->dev, "register map failed: cam %d pdn %d cam1 %d fifo0 %d fifo1 %d\n",
+			PTR_ERR_OR_ZERO(cam->port[0].regs),
+			PTR_ERR_OR_ZERO(cam->pdn),
+			PTR_ERR_OR_ZERO(cam->port[1].regs),
+			PTR_ERR_OR_ZERO(cam->port[0].fifo),
+			PTR_ERR_OR_ZERO(cam->port[1].fifo));
+		return -ENODEV;
+	}
+
+	bus0 = ctr_cam_bus(cam, 0);
+	bus1 = ctr_cam_bus(cam, 1);
+	if (IS_ERR(bus0) || IS_ERR(bus1)) {
+		/*
+		 * N3DS_CAM_I2C_PROBE_DEFER: nothing orders this driver after
+		 * the i2c controllers, and on hardware it wins the race.
+		 */
+		if (!IS_ERR_OR_NULL(bus0))
+			i2c_put_adapter(bus0);
+		if (!IS_ERR_OR_NULL(bus1))
+			i2c_put_adapter(bus1);
+		dev_info(cam->dev, "i2c bus not registered yet; deferring probe\n");
+		return -EPROBE_DEFER;
+	}
+
+	cam->sensor[CTR_CAM_OUTER_RIGHT] = (struct ctr_cam_sensor) {
+		.name = "outer-right", .adap = bus0, .addr = 0x78 >> 1,
+		.port = 0,
+	};
+	cam->sensor[CTR_CAM_INNER] = (struct ctr_cam_sensor) {
+		.name = "inner", .adap = bus0, .addr = 0x7a >> 1,
+		.port = 0, .inner = true,
+	};
+	cam->sensor[CTR_CAM_OUTER_LEFT] = (struct ctr_cam_sensor) {
+		.name = "outer-left", .adap = bus1, .addr = 0x78 >> 1,
+		.port = 1,
+	};
+
+	iowrite8(ioread8(cam->pdn) | PDN_CAM_CLOCK_ENABLE, cam->pdn);
+	usleep_range(1000, 2000);
+	if (!(ioread8(cam->pdn) & PDN_CAM_CLOCK_ENABLE))
+		dev_warn(cam->dev, "CFG11_CAMERA_CNT clock enable did not stick\n");
+
+	for (i = 0; i < 2; i++) {
+		writew(CAM_CNT_MUST_BE_1, cam->port[i].regs + CAM_CNT);
+		ctr_cam_port_stop(&cam->port[i], &cam->win);
+	}
+
+	for (i = 0; i < CTR_CAM_COUNT; i++)
+		ctr_cam_identify(cam, &cam->sensor[i]);
+
+	cam->misc.minor = MISC_DYNAMIC_MINOR;
+	cam->misc.name = "ctr_cam";
+	cam->misc.fops = &ctr_cam_fops;
+	cam->misc.mode = 0660;
+	ret = misc_register(&cam->misc);
+	if (ret) {
+		dev_err(cam->dev, "misc_register failed: %d\n", ret);
+		ctr_cam_put_buses(cam);
+		return ret;
+	}
+
+	dev_info(cam->dev,
+		 "capture driver ready (N3DS_CAM_CAPTURE): outer-right %s, inner %s, outer-left %s; /dev/ctr_cam\n",
+		 cam->sensor[0].present ? "yes" : "NO",
+		 cam->sensor[1].present ? "yes" : "NO",
+		 cam->sensor[2].present ? "yes" : "NO");
+	return 0;
+}
+
+static int ctr_cam_remove(struct platform_device *pdev)
+{
+	struct ctr_cam *cam = platform_get_drvdata(pdev);
+
+	misc_deregister(&cam->misc);
+	ctr_cam_put_buses(cam);
+	iowrite8(ioread8(cam->pdn) & ~PDN_CAM_CLOCK_ENABLE, cam->pdn);
+	return 0;
+}
+
+static const struct of_device_id ctr_cam_of_match[] = {
+	{ .compatible = "nintendo,3ds-cam" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ctr_cam_of_match);
+
+static struct platform_driver ctr_cam_driver = {
+	.probe = ctr_cam_probe,
+	.remove = ctr_cam_remove,
+	.driver = {
+		.name = DRIVER_NAME,
+		.of_match_table = ctr_cam_of_match,
+	},
+};
+
+/* Same registration diagnostic as ctr_dsp.c: a capture with no 3ds-cam line
+ * at all must be able to distinguish "never registered" from "registered but
+ * the DT node never bound". */
+static int __init ctr_cam_init(void)
+{
+	int ret = platform_driver_register(&ctr_cam_driver);
+
+	pr_info("driver registered: %d (probe follows only if a nintendo,3ds-cam node bound)\n",
+		ret);
+	return ret;
+}
+
+static void __exit ctr_cam_exit(void)
+{
+	platform_driver_unregister(&ctr_cam_driver);
+}
+
+module_init(ctr_cam_init);
+module_exit(ctr_cam_exit);
+
+MODULE_DESCRIPTION("Nintendo 3DS camera capture driver");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform:" DRIVER_NAME);
diff --git a/drivers/platform/nintendo3ds/ctr_csnd.c b/drivers/platform/nintendo3ds/ctr_csnd.c
new file mode 100644
index 0000000000000000000000000000000000000000..f04dd394df3687ca7e417e1da1e6f4e0dacf8cee
--- /dev/null
+++ b/drivers/platform/nintendo3ds/ctr_csnd.c
@@ -0,0 +1,3097 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ *  ctr_csnd.c -- Nintendo 3DS CSND PCM mixer + CTR codec analog output path.
+ *
+ *  Copyright (C) 2026 Android3DS
+ *
+ *  WHY THIS EXISTS, AND WHY IT IS NOT ctr_dsp.c
+ *  --------------------------------------------
+ *  This port spent eight kernels (#296..#307) trying to reach audio through
+ *  the Teak Lite II DSP at 0x10203000.  That work is not wasted and it is not
+ *  wrong: the handshake completes, the DSP answers, SHAREDWRAM hands over, the
+ *  reply table with its fifteen structure addresses arrives, and kernel #307
+ *  finally proved that an ARM11 store really does land in DSP data memory
+ *  ("audio frame counter at DSP byte 0x17ffe: was 0x0000, wrote 0x0004, reads
+ *  0x0004").  What it also proved is that none of it makes a sound:
+ *
+ *	3ds-dsp 10203000.dsp: DSP frame counter still 0x0004 500ms after being
+ *	set to 4 and kicked: the core answered but will not mix
+ *
+ *  The remaining gap is the undocumented contents of the fifteen structures --
+ *  i.e. the whole of Nintendo's DSP mixer ABI -- and there is no reference
+ *  implementation of it anywhere outside a disassembly.
+ *
+ *  The DSP is not the only way to move PCM on this SoC, and it is not even the
+ *  low-level one.  CSND (0x10103000) is a plain 32-channel DMA sample player
+ *  that reads FCRAM by physical address and feeds the I2S bus directly.  It
+ *  needs no firmware, no mailbox, no pipes and no structures: four register
+ *  writes and a start bit.  The only reason this project reached for the DSP
+ *  first is that libctru talks to a *service*, so the register-level story was
+ *  invisible.
+ *
+ *  The user supplied a bare-metal implementation from the Aurora3DS project
+ *  that is verified to produce sound on this exact hardware (Audio11.c,
+ *  Codec11.c), and this file is a faithful port of it.  Three pieces:
+ *
+ *    1. the CTR codec analog output bring-up (originally profi200's libn3ds
+ *       source/arm11/drivers/codec.c), reached here over SPI;
+ *    2. the SoC I2S controller at 0x10145000;
+ *    3. CSND itself.
+ *
+ *  THE ONE TRAP WORTH READING BEFORE TOUCHING THIS
+ *  -----------------------------------------------
+ *  The per-channel period register at +0x02 is 16-bit, write-only, and holds
+ *  the *two's complement* of the divider: reload = (0x10000 - timer) & 0xFFFF,
+ *  where timer = 0x3FEC3FC / rate.  libctru packs the same number as
+ *  `timer << 16` -- that is its *service argument* format, not a register
+ *  image.  Writing libctru's packing here would push the divider into a
+ *  discarded upper halfword and start the channel on whatever period the
+ *  previous sound left behind.  The reload must also be written *before* the
+ *  start bit, for the same reason.
+ *
+ *  WHERE THE CODEC LIVES
+ *  ---------------------
+ *  It is the same chip as the touchscreen.  ctr_tsc.c already owns it: it
+ *  drives the TSC2117 over spi@10142800 and publishes a regmap whose register
+ *  numbering is exactly (page << 7 | index), which is the codec's own
+ *  addressing.  So this driver does not open a second SPI connection, does not
+ *  reset the chip (that would blow away the touchscreen configuration
+ *  tsc/touch.c installed), and does not poke the SPI block behind the SPI
+ *  core's back.  It takes the regmap by phandle and writes codec pages 0, 100
+ *  and 101 -- which tsc/touch.c never touches, it lives on pages 0x67 and
+ *  0xFB -- so the two coexist.
+ *
+ *  WHAT USERSPACE GETS
+ *  -------------------
+ *  /dev/eac: write 16-bit little-endian stereo PCM and it plays.  That is the
+ *  device node Android's AudioHardwareGeneric opens, so when libaudio and
+ *  AudioFlinger are eventually built for this port (neither is in the image
+ *  today -- there is no audio stack in userspace at all yet) the bridge is
+ *  already there.  Until then the boot tone is the proof.
+ */
+
+#define DRIVER_NAME "3ds-csnd"
+#define pr_fmt(fmt) DRIVER_NAME ": " fmt
+
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/hrtimer.h>
+#include <linux/jiffies.h>
+#include <linux/io.h>
+#include <linux/ktime.h>
+#include <linux/math64.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/spi/spi.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+
+/* ------------------------------------------------------------------ *
+ * CSND registers (offsets from 0x10103000)
+ * ------------------------------------------------------------------ */
+
+/* Master control: bits 0-15 volume, bit16 mute (0 = unmuted), bit30 "normal",
+ * bit31 allow channel register writes -- without bit31 every channel write
+ * below is silently dropped. */
+#define CSND_MAIN		0x000
+#define CSND_MAIN_VAL		(0x8000u | (1u << 30) | (1u << 31))
+
+#define CSND_CH(n)		(0x400 + (n) * 0x20)
+#define CSND_CH_CNT(n)		(CSND_CH(n) + 0x00)	/* u16 */
+#define CSND_CH_TIMER(n)	(CSND_CH(n) + 0x02)	/* u16, write-only */
+#define CSND_CH_VOL(n)		(CSND_CH(n) + 0x04)	/* u32 volR | volL<<16 */
+#define CSND_CH_SAD(n)		(CSND_CH(n) + 0x0c)	/* u32 phys addr */
+#define CSND_CH_SIZE(n)		(CSND_CH(n) + 0x10)	/* u32 bytes */
+#define CSND_CH_LOOP(n)		(CSND_CH(n) + 0x14)	/* u32 phys addr */
+
+#define CH_LINEAR_INTERP	(1u << 6)
+#define CH_REPEAT_LOOP		(1u << 10)
+#define CH_REPEAT_ONESHOT	(2u << 10)
+#define CH_FORMAT_PCM16		(1u << 12)
+#define CH_ENABLE		(1u << 14)
+#define CH_START		(1u << 15)
+
+#define CSND_CHANNEL		0	/* channel 0, mono, both speakers */
+
+/* libctru's CSND_TIMER(n), with libctru's clamp.  Masking instead of clamping
+ * would silently wrap any rate below ~1023 Hz into a wildly wrong divider. */
+#define CSND_TIMER_MIN		0x0042u
+#define CSND_TIMER_MAX		0xFFFFu
+#define CSND_TIMER_BASE		0x3FEC3FCu
+
+/* ------------------------------------------------------------------ *
+ * I2S controller (0x10145000) -- libn3ds include/arm11/drivers/i2s.h
+ * ------------------------------------------------------------------ */
+#define I2S1_CNT		0x00	/* u16 */
+#define I2S2_CNT		0x02	/* u16 */
+
+#define I2S1_DSP_VOL(v)		((v) & 0x3Fu)		/* 32 == 100% */
+#define I2S1_LGY_VOL(v)		(((v) & 0x3Fu) << 6)	/* 32 == 100% */
+#define I2S1_FREQ_32KHZ		0u
+#define I2S1_FREQ_47KHZ		(1u << 13)
+#define I2S1_MCLK1_16MHZ	(1u << 14)
+#define I2S1_EN			(1u << 15)
+/* N3DS_MIC_REAL: SNDEXCNT bit 12, "Enable Microphone timing".
+ * Writable only while bit 31 (I2S2_EN) is still clear, which is why
+ * codec_init() writes I2S1_CNT before I2S2_CNT.  Do not reorder. */
+#define I2S1_MIC_TIMING		(1u << 12)
+
+#define I2S2_FREQ_47KHZ		(1u << 13)
+#define I2S2_MCLK2_16MHZ	(1u << 14)
+#define I2S2_EN			(1u << 15)
+
+/* PDN_I2S_CNT (0x10141220, u8) and CFG11_SPI_CNT (0x101401C0, u16).  Both are
+ * single registers inside blocks nobody owns, handed over as their own reg
+ * entries and mapped with devm_ioremap (no region request), exactly the way
+ * the dsp and cam nodes take PDN_DSP_CNT / PDN_CAM_CNT. */
+#define PDN_I2S_CLK2_EN		(1u << 1)
+#define CFG11_SPI_CNT_ALL	0x7u
+
+/* ------------------------------------------------------------------ *
+ * CTR codec registers, numbered the way ctr_tsc.c's regmap numbers them:
+ * (page << 7) | index.
+ * ------------------------------------------------------------------ */
+#define CDC(page, idx)		((((page) & 0xFFu) << 7) | ((idx) & 0x7Fu))
+
+#define CDC_0_2			CDC(0, 2)	/* device ID    */
+#define CDC_0_3			CDC(0, 3)	/* device rev   */
+#define CDC_DAC_NDAC		CDC(0, 11)
+#define CDC_GPI_PIN		CDC(0, 57)
+#define CDC_DAC_PATH		CDC(0, 63)
+#define CDC_DAC_VOL		CDC(0, 64)
+
+#define CDC_100_34		CDC(100, 34)
+#define CDC_100_37		CDC(100, 37)
+#define CDC_100_67		CDC(100, 67)
+#define CDC_HEADSET		CDC(100, 69)
+#define CDC_100_118		CDC(100, 118)
+#define CDC_100_119		CDC(100, 119)
+#define CDC_100_120		CDC(100, 120)
+#define CDC_100_122		CDC(100, 122)
+#define CDC_100_124		CDC(100, 124)
+
+#define CDC_101_10		CDC(101, 10)
+#define CDC_101_11		CDC(101, 11)
+#define CDC_101_12		CDC(101, 12)
+#define CDC_101_17		CDC(101, 17)
+#define CDC_101_18		CDC(101, 18)
+#define CDC_101_19		CDC(101, 19)
+#define CDC_101_22		CDC(101, 22)
+#define CDC_101_23		CDC(101, 23)
+#define CDC_101_27		CDC(101, 27)
+#define CDC_101_28		CDC(101, 28)
+#define CDC_101_119		CDC(101, 119)
+#define CDC_101_122		CDC(101, 122)
+
+/* Neutral stand-ins for the per-console HWCAL calibration block, which this
+ * port has no reader for.  Same values Aurora3DS shipped. */
+#define CAL_DRIVER_GAIN_HP	1u
+#define CAL_DRIVER_GAIN_SP	1u
+#define CAL_ANALOG_VOL_HP	0u
+#define CAL_ANALOG_VOL_SP	0u
+
+/* ------------------------------------------------------------------ *
+ * Driver state
+ * ------------------------------------------------------------------ */
+
+/* 256 KiB of PCM16 mono: 2.97 s at 44.1 kHz.  Large enough that a scheduling
+ * hiccup on a 268 MHz core does not underrun, small enough to be a rounding
+ * error against 128 MiB of FCRAM. */
+#define RING_BYTES		(256 * 1024)
+#define RING_SAMPLES		(RING_BYTES / 2)
+
+/*
+ * N3DS_AUDIO_LATENCY: the ring is 2.97 s at 44.1 kHz, and until kernel #310
+ * the write path let AudioFlinger fill all of it before a single sample was
+ * heard -- PREFILL_SAMPLES was RING_SAMPLES/4 (0.74 s) and ctr_csnd_free()
+ * offered the whole remaining ring as free space.  A UI sound therefore
+ * played somewhere between one and four seconds after the event that caused
+ * it, and AudioFlinger logged "write blocked for ~1024 msecs" whenever the
+ * ring did fill (that is this driver's own wait timeout, not a stall).
+ *
+ * The fix is not a smaller ring -- CSND loops over the physical buffer and a
+ * short one underruns into stale audio -- it is a smaller *lead*: keep the
+ * DMA ring at 256 KiB but never let the writer get more than LEAD_MS ahead of
+ * the play cursor, and start the channel after only PREFILL_MS.  Both are
+ * module parameters because the right number depends on how badly Dalvik
+ * starves the AudioFlinger mixer thread on a 268 MHz core, and that is a
+ * hardware question.
+ */
+#define LEAD_MS_DEFAULT		200
+#define PREFILL_MS_DEFAULT	80
+
+/* Stop the channel this long after the last byte should have been consumed,
+ * so a silent stream does not sit looping over stale samples forever. */
+#define DRAIN_MARGIN_MS		250
+/* N3DS_CSND_HW_CURSOR: how far into the silence after a stream's last
+ * sample the cursor must be before the drain stops the channel. */
+#define STOP_TAIL_MS		40
+
+/* N3DS_CSND_OUTPUT_REARM: how often a running stream re-checks the analog
+ * output stage, and how many times per boot it may bring it back up before
+ * concluding the check itself is wrong and standing down. */
+#define OUTMON_MS		100
+#define OUTMON_MAX_REARMS	20
+#define OUT_REGS		8
+
+/* N3DS_MIC_RAW: FIFO words kept from the start of each recording and printed
+ * once it has ended -- the one piece of evidence that needs no theory. */
+#define MIC_RAW_WORDS		64
+
+struct ctr_csnd {
+	struct device		*dev;
+	void __iomem		*csnd;
+	void __iomem		*i2s;
+	void __iomem		*pdn_i2s;
+	void __iomem		*cfg11_spi;
+
+	struct regmap		*codec;
+	bool			codec_ok;
+
+	/* DMA ring, read by CSND from physical memory */
+	void			*ring;
+	dma_addr_t		ring_phys;
+
+	struct miscdevice	misc;
+	struct mutex		lock;
+	wait_queue_head_t	wq;
+	struct delayed_work	drain;
+	struct delayed_work	outmon;		/* N3DS_CSND_OUTPUT_REARM */
+
+	bool			running;
+	ktime_t			t0;		/* when playback started */
+	u64			written;	/* mono samples ever written */
+	u32			wpos;		/* ring write cursor, samples */
+	u32			rate;
+	u32			underruns;	/* this stream (N3DS_CSND_STREAM_STATS) */
+	u64			skipped;	/* samples resync jumped over */
+	u32			peak;		/* largest |sample| this stream */
+	/* N3DS_CSND_HW_CURSOR: channel 0's SAD register reads back the DMA
+	 * play address while the channel runs -- the real play cursor. */
+	u32			hw_last;	/* last cursor, ring samples */
+	u64			hw_played;	/* samples the hardware consumed */
+	ktime_t			hw_moved;	/* when the cursor last moved */
+	bool			hw_dead;	/* cursor unusable: estimate */
+	u64			zeroed_to;	/* silence guard ahead of written */
+	u32			trim;		/* N3DS_CSND_RATE_TRIM, permille */
+
+	/*
+	 * N3DS_CSND_OUTPUT_REARM: the output-stage registers as codec_init()
+	 * left them, read back rather than assumed, and how often a running
+	 * stream has found them changed.
+	 */
+	int			out_base[OUT_REGS];
+	bool			out_base_ok;
+	u32			rearms;		/* since boot */
+
+	/*
+	 * N3DS_BOOT_SOUND: who owns the channel.  There is one CSND channel
+	 * and one ring, so two writers cannot share them; the first to put a
+	 * sample in claims the channel and keeps it until the stream drains.
+	 *
+	 * Without this, mediaserver truncated the power-on sound.
+	 * AudioHardwareGeneric opens /dev/eac from its constructor, init
+	 * declares mediaserver next to the boot sound, and open() used to stop
+	 * the channel and memset the ring unconditionally -- so the clip
+	 * restarted from wherever the writer had reached and was heard from
+	 * its middle.
+	 */
+	struct file		*owner;
+	/*
+	 * ...and whether that fd has since been closed.  cs->owner is only
+	 * ever compared, never dereferenced, but a struct file is slab
+	 * memory and the allocator hands the most recently freed object
+	 * back first.  Once the owner closes, the very next open() of this
+	 * device can be given the same address; without this flag that new
+	 * opener is mistaken for the owner and writes straight into the
+	 * tail of a clip that has not finished playing.  A closed owner
+	 * matches nobody -- it only keeps the claim alive until the drain.
+	 */
+	bool			owner_closed;
+	u32			dropped;	/* non-owner writes discarded */
+	/* N3DS_CSND_WHOLE_WRITES: the owner's bytes past its last whole frame */
+	u8			carry[4];
+	u32			carry_n;
+	/* N3DS_CSND_FLAG_TRACE: p100.37 as the outmon tick saw it change */
+	u8			fl_val[8];
+	u32			fl_ms[8];
+	u32			fl_n;
+
+	/* N3DS_MIC_CAPTURE: input side.  Independent of the output side --
+	 * AudioHardwareGeneric shares one fd between them. */
+	struct mutex		cap_lock;
+	bool			cap_on;
+	ktime_t			cap_t0;		/* when capture started */
+	u64			cap_delivered;	/* mono samples handed out */
+	bool			cap_warned;	/* one-line banner said once */
+	bool			mic_fe_done;	/* codec_mic_frontend() ran */
+	void __iomem		*mic;		/* MIC block */
+
+	/*
+	 * N3DS_MIC_REAL: the FIFO holds 32 samples, 3.9 ms at 8180 Hz, and a
+	 * recorder asks for 20 ms at a time -- so the FIFO cannot be drained from
+	 * read().  A timer drains it into this ring instead.
+	 *
+	 * Single producer (cap_timer), single consumer (read()), so no lock: the
+	 * producer owns cap_head, the consumer owns cap_tail, and the two are
+	 * published to each other with release/acquire.  Both are free-running and
+	 * masked at use, so neither ever needs wrapping.
+	 */
+	struct hrtimer		cap_timer;
+	s16			*cap_ring;
+	u32			cap_head;	/* producer */
+	u32			cap_tail;	/* consumer */
+	unsigned long		cap_last_read;	/* jiffies; drives the idle stop */
+	bool			cap_hw_on;	/* owned by cap_timer only */
+	u32			cap_overruns;	/* FIFO overran, samples lost */
+	u32			cap_ring_full;	/* consumer too slow */
+	u32			cap_underruns;	/* consumer starved, padded */
+	bool			cap_seen_data;	/* first-sample banner printed */
+	u32			cap_dry_ticks;	/* ticks with an empty FIFO */
+
+	/*
+	 * N3DS_MIC_FULL_READS: read() sleeps on cap_wq until the ring holds the
+	 * whole buffer it was asked for; mic_drain() wakes it once cap_want
+	 * samples are queued, not on every tick.
+	 */
+	wait_queue_head_t	cap_wq;
+	u32			cap_want;
+	bool			cap_starved;	/* dead-man pad reported, this recording */
+
+	/* N3DS_MIC_STATS: live samples (before resampling) since the recording
+	 * started */
+	u32			st_n, st_zero, st_ffff, st_steps;
+	s32			st_min, st_max;
+	s64			st_sum;
+	u64			st_abs;
+	s16			st_prev;
+
+	/*
+	 * N3DS_MIC_PROBE: what the block really delivers, measured rather than
+	 * assumed.  All of it is owned by cap_timer.  The pr_* counters restart
+	 * with the block (start, overrun, rate change); the cap_* decisions they
+	 * produce last for the recording and start from the documented format.
+	 */
+	int			cap_idx;	/* MIC_CNT rate divider in use */
+	bool			cap_idx_auto;	/* divider already re-chosen */
+	u8			cap_live;	/* MIC_LIVE_* */
+	s8			cap_shift;	/* MIC_LIVE_SLOT: LSB position */
+	u32			cap_in_rate;	/* live samples per second */
+	u32			cap_probes;	/* probes completed */
+	u32			cap_restarts;	/* block restarts */
+	u32			rs_step;	/* Q16 input samples per output */
+	u32			rs_pos;		/* Q16, from rs_prev */
+	s16			rs_prev;
+
+	ktime_t			pr_t0;
+	u32			pr_words;
+	bool			pr_done;
+	u32			pr_lo_dead, pr_hi_dead, pr_same;
+	u32			pr_ones[32];	/* bit k set */
+	u32			pr_nsign[32];	/* bit k != bit 31 */
+	u32			pr_eq[32];	/* bit k == bit k+1 (k < 31) */
+	/* the decision's evidence, kept for the park-time report */
+	u32			pd_words, pd_ms, pd_wps, pd_meas;
+	u32			pd_lo_dead, pd_hi_dead, pd_same;
+	char			pd_ones[33], pd_nsign[33], pd_eq[32];
+
+	u32			raw[MIC_RAW_WORDS];	/* first words, N3DS_MIC_RAW */
+	u32			raw_n;
+};
+
+/*
+ * N3DS_CSND_HW_CURSOR / N3DS_CSND_RATE_TRIM: both OFF since #320.  SAD moves
+ * at exactly one third of the real play rate, so neither is a sample counter
+ * -- #319 trimmed the divider to 334/1000 on that reading and every sound
+ * came out 3x fast and high ("Audio sounded normal before", the user,
+ * 2026-09-30).  The stock 0x3FEC3FC/rate divider and the elapsed-time
+ * estimate are right.  Kept as parameters only so the evidence can be
+ * re-taken; never default either back on.
+ */
+static int hw_cursor;
+module_param(hw_cursor, int, 0644);
+MODULE_PARM_DESC(hw_cursor, "account playback by the CSND SAD register (1) or by elapsed time (0, default -- SAD runs at 1/3 rate)");
+
+static int rate_trim;
+module_param(rate_trim, int, 0444);
+MODULE_PARM_DESC(rate_trim, "measure channel 0's rate from SAD at probe and trim the divider (default 0 -- SAD runs at 1/3 rate, trimming makes audio 3x fast)");
+
+static int boot_tone;		/* off: the chime proved the path, see HANDOFF 2026-09-12 */
+module_param(boot_tone, int, 0644);
+MODULE_PARM_DESC(boot_tone, "play a short tone at probe to prove the path (default off)");
+
+static int tone_hz = 660;
+module_param(tone_hz, int, 0644);
+MODULE_PARM_DESC(tone_hz, "boot tone frequency in Hz");
+
+/*
+ * N3DS_MIC_CAPTURE: on by default since kernel #310.  It is read-only, costs
+ * half a second of probe time, and it is the only thing in the tree that can
+ * tell a sample register in the MIC block apart from a control register --
+ * which is the single piece of missing information between this driver and
+ * real microphone input.
+ */
+static int mic_survey;		/* the block is documented now; off by default */
+module_param(mic_survey, int, 0644);
+MODULE_PARM_DESC(mic_survey,
+	"read-only probe of the MIC block at 0x10162000 at boot (default on)");
+
+/*
+ * N3DS_CSND_QUIET_FINISH: the five end-of-stream lines (stats, ch0 block, play
+ * cursor, p100.37 trace, output stage vs init) were #318-#320's evidence for
+ * the cut-off boot sound, which #320 fixed.  On every healthy stream since
+ * they have read "0 underruns ... 0 re-arms this boot -- same as init", and
+ * with ignore_loglevel they all scroll the top-screen console.  They now
+ * print only when something is actually wrong -- an underrun, a dropped
+ * foreign write, an output-stage re-arm, or a register that differs from
+ * init -- or when stream_evidence=1 asks for them.
+ */
+static bool stream_evidence;
+module_param(stream_evidence, bool, 0644);
+MODULE_PARM_DESC(stream_evidence,
+	"log the full end-of-stream evidence for every long stream (default off: only anomalies, N3DS_CSND_QUIET_FINISH)");
+
+static int pcm_rate = 44100;
+module_param(pcm_rate, int, 0644);
+MODULE_PARM_DESC(pcm_rate, "sample rate of the PCM written to /dev/eac");
+
+static int lead_ms = LEAD_MS_DEFAULT;
+module_param(lead_ms, int, 0644);
+MODULE_PARM_DESC(lead_ms,
+	"how far ahead of the play cursor the writer may queue, in ms "
+	"(output latency; raise it if audio breaks up)");
+
+static int prefill_ms = PREFILL_MS_DEFAULT;
+module_param(prefill_ms, int, 0644);
+MODULE_PARM_DESC(prefill_ms,
+	"how much must be buffered before the channel starts, in ms");
+
+/*
+ * N3DS_MIC_REAL: which MIC_CNT rate divider to use.  3 is F/4 = 8180 Hz with
+ * the 32.73 kHz I2S clock codec_init() selects, which is the closest rate to
+ * the 8000 Hz AudioStreamInGeneric insists on and the one that fills the
+ * 32-sample FIFO slowest.  0..2 are 32730 / 16360 / 10910 Hz and are here for
+ * measuring the block, not for recording -- capture resamples to 8000 either
+ * way, and the faster the rate the sooner a late timer tick costs audio.
+ *
+ * This is where each recording starts.  If N3DS_MIC_PROBE measures fewer
+ * than 6000 live samples a second here, it picks a faster divider once.
+ */
+static int mic_rate_idx = 3;
+module_param(mic_rate_idx, int, 0644);
+MODULE_PARM_DESC(mic_rate_idx,
+	"MIC_CNT rate divider 0..3 (F/1..F/4 of the 32.73 kHz I2S clock); "
+	"3 = 8180 Hz, the default");
+
+/*
+ * SNDEXCNT bit 12, "Enable Microphone timing".  GBATEK says the microphone
+ * needs bit 31 plus one or both of bit 15 / bit 12, and bit 15 has always
+ * been set here for the DAC.  Setting bit 12 as well is the documented belt
+ * and braces -- but it shares a register with a speaker path that is
+ * hardware-confirmed working, so it is a parameter rather than a constant: if
+ * analog OUTPUT ever regresses, boot with ctr_csnd.mic_i2s_timing=0 before
+ * suspecting anything else in this file.
+ */
+static int mic_i2s_timing = 1;
+module_param(mic_i2s_timing, int, 0644);
+MODULE_PARM_DESC(mic_i2s_timing,
+	"set SNDEXCNT bit 12 (mic timing) alongside bit 15 (default on)");
+
+/*
+ * N3DS_MIC_CLOCK_32K: I2S line 2 -- the microphone's line -- runs at the
+ * same 32.73 kHz as line 1.
+ *
+ * Every kernel up to #316 copied libn3ds and put line 2 at 47.61 kHz, on
+ * both the SoC side (I2S2_CNT bit 13) and the codec side (p100.124 bit 0).
+ * libn3ds is open_agb_firm's library and 47.61 kHz is the GBA's rate; the
+ * native 3DS microphone rates are all 32.73 kHz-based.  The #316 recording
+ * (mictest.wav) shows the mismatch bit by bit: in every FIFO word the same
+ * nine bit pairs are always equal -- 16 captured bits for every 11 the
+ * codec sent, which is exactly 47.61 / 32.73.  The MIC block was shifting
+ * on the 47.61 kHz clock while the ADC's data came at 32.73 kHz, so each
+ * sample was smeared across the word at a phase that moved on every
+ * restart: static at any gain.
+ *
+ * The parameter restores the old clock, for bisecting only.
+ */
+static int i2s2_47k;
+module_param(i2s2_47k, int, 0444);
+MODULE_PARM_DESC(i2s2_47k,
+	"run I2S line 2 at 47.61 kHz as kernels up to #316 did (default off)");
+
+/* ------------------------------------------------------------------ *
+ * CSND
+ * ------------------------------------------------------------------ */
+
+static u32 csnd_timer(u32 rate)
+{
+	u32 t = rate ? (CSND_TIMER_BASE / rate) : CSND_TIMER_MAX;
+
+	if (t < CSND_TIMER_MIN)
+		t = CSND_TIMER_MIN;
+	if (t > CSND_TIMER_MAX)
+		t = CSND_TIMER_MAX;
+	return t;
+}
+
+static void csnd_stop(struct ctr_csnd *cs)
+{
+	iowrite16(0, cs->csnd + CSND_CH_CNT(CSND_CHANNEL));
+	wmb(); /* the stop must land before anything reprograms the channel */
+}
+
+/*
+ * Start channel 0 on `bytes` of PCM at physical address `phys`.
+ * fmt is CH_FORMAT_PCM16 or 0 (8-bit unsigned).
+ */
+static void csnd_play(struct ctr_csnd *cs, dma_addr_t phys, u32 bytes,
+		      u32 rate, u32 fmt, bool loop)
+{
+	u32 timer = csnd_timer(rate);
+	u32 reload;
+	u16 cnt;
+
+	/* N3DS_CSND_RATE_TRIM: the divider correction ctr_csnd_rate_check()
+	 * measured at probe; 1000 (or 0, before it ran) is none. */
+	if (cs->trim && cs->trim != 1000) {
+		timer = (u32)div_u64((u64)timer * cs->trim + 500, 1000);
+		timer = clamp(timer, CSND_TIMER_MIN, CSND_TIMER_MAX);
+	}
+	reload = (0x10000u - timer) & 0xFFFFu;
+
+	csnd_stop(cs);
+
+	iowrite32(0x80008000u, cs->csnd + CSND_CH_VOL(CSND_CHANNEL));
+	iowrite32((u32)phys, cs->csnd + CSND_CH_SAD(CSND_CHANNEL));
+	iowrite32(bytes, cs->csnd + CSND_CH_SIZE(CSND_CHANNEL));
+	iowrite32((u32)phys, cs->csnd + CSND_CH_LOOP(CSND_CHANNEL));
+
+	/* Before the start bit.  See the header comment. */
+	iowrite16((u16)reload, cs->csnd + CSND_CH_TIMER(CSND_CHANNEL));
+	wmb();
+
+	cnt = CH_START | CH_ENABLE | CH_LINEAR_INTERP | fmt |
+	      (loop ? CH_REPEAT_LOOP : CH_REPEAT_ONESHOT);
+	iowrite16(cnt, cs->csnd + CSND_CH_CNT(CSND_CHANNEL));
+	wmb();
+}
+
+static int csnd_init(struct ctr_csnd *cs)
+{
+	u32 back;
+
+	iowrite32(CSND_MAIN_VAL, cs->csnd + CSND_MAIN);
+	wmb();
+	back = ioread32(cs->csnd + CSND_MAIN);
+
+	/*
+	 * If this does not stick, every channel write below is a no-op and no
+	 * amount of codec work will make a sound -- say so in those words
+	 * rather than leaving a silent boot to be re-diagnosed from scratch.
+	 */
+	if (back != CSND_MAIN_VAL)
+		dev_warn(cs->dev,
+			 "CSND master control did not stick: wrote 0x%08x, reads 0x%08x -- channel writes will be ignored\n",
+			 CSND_MAIN_VAL, back);
+	else
+		dev_info(cs->dev, "CSND master control 0x%08x accepted\n", back);
+
+	return back == CSND_MAIN_VAL ? 0 : -EIO;
+}
+
+/*
+ * Dump channel 0's whole 32-byte register block twice, a beat apart, while a
+ * sound is playing.  GBATEK does not document a current-position register for
+ * CSND and libctru gets the position from a service-maintained shared-memory
+ * block rather than from hardware, so the only way to find out whether one
+ * exists is to look at what moves.  If a field advances between the two rows,
+ * that is the play cursor -- and with it /dev/eac can stop estimating the read
+ * pointer from elapsed time.  Costs 60 ms, once, at probe.
+ */
+static void csnd_probe_position_register(struct ctr_csnd *cs)
+{
+	u32 a[8], b[8];
+	int i;
+
+	for (i = 0; i < 8; i++)
+		a[i] = ioread32(cs->csnd + CSND_CH(CSND_CHANNEL) + i * 4);
+	msleep(60);
+	for (i = 0; i < 8; i++)
+		b[i] = ioread32(cs->csnd + CSND_CH(CSND_CHANNEL) + i * 4);
+
+	dev_info(cs->dev,
+		 "CSND ch0 t+0ms : %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		 a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7]);
+	dev_info(cs->dev,
+		 "CSND ch0 t+60ms: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		 b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]);
+
+	for (i = 0; i < 8; i++) {
+		if (a[i] != b[i])
+			dev_info(cs->dev,
+				 "CSND ch0 +%02x moved while playing: %08x -> %08x (candidate play cursor)\n",
+				 i * 4, a[i], b[i]);
+	}
+}
+
+/* ------------------------------------------------------------------ *
+ * CTR codec, over ctr_tsc.c's regmap
+ * ------------------------------------------------------------------ */
+
+static int cdc_write(struct ctr_csnd *cs, unsigned int reg, unsigned int val)
+{
+	int err = regmap_write(cs->codec, reg, val);
+
+	if (err)
+		dev_err(cs->dev, "codec write p%u.%u = 0x%02x failed: %d\n",
+			reg >> 7, reg & 0x7F, val, err);
+	return err;
+}
+
+static int cdc_mask(struct ctr_csnd *cs, unsigned int reg, unsigned int val,
+		    unsigned int mask)
+{
+	int err = regmap_update_bits(cs->codec, reg, mask, val);
+
+	if (err)
+		dev_err(cs->dev, "codec mask p%u.%u &= 0x%02x |= 0x%02x failed: %d\n",
+			reg >> 7, reg & 0x7F, mask, val, err);
+	return err;
+}
+
+static int cdc_read(struct ctr_csnd *cs, unsigned int reg)
+{
+	unsigned int v;
+	int err = regmap_read(cs->codec, reg, &v);
+
+	if (err) {
+		dev_err(cs->dev, "codec read p%u.%u failed: %d\n",
+			reg >> 7, reg & 0x7F, err);
+		return err;
+	}
+	return (int)(v & 0xFF);
+}
+
+/* DAC power-up: set both power bits and wait for the two "up" flags. */
+static void codec_power_on_dac(struct ctr_csnd *cs)
+{
+	int i, v;
+
+	cdc_mask(cs, CDC_100_118, 0xC0, 0xC0);
+	msleep(10);
+
+	for (i = 0; i < 100; i++) {
+		v = cdc_read(cs, CDC_100_37);
+		if (v < 0)
+			return;
+		if ((u8)(~v & 0x88u) == 0)
+			break;
+		msleep(1);
+	}
+	if (i == 100)
+		dev_warn(cs->dev,
+			 "DAC power flags never came up (p100.37 = 0x%02x, want bits 3 and 7)\n",
+			 v & 0xFF);
+	else
+		dev_info(cs->dev, "DAC powered after %d ms\n", i);
+}
+
+/*
+ * Full analog output bring-up, ported one-for-one from Aurora3DS's
+ * Audio11.c codec_init(), itself a port of libn3ds codec.c.  The order of
+ * these writes is load-bearing; do not tidy it.
+ *
+ * Deliberately not done here, and therefore untested: the per-console HWCAL
+ * calibration block (neutral defaults are used instead), headphone-jack
+ * detection (output is forced to the speaker), the EQ coefficient upload, and
+ * the per-unit depop pulse.
+ */
+/*
+ * N3DS_MIC_REAL: the MIC block at 0x10162000.
+ *
+ * This was carried for three kernels as "undocumented".  It is not: it is the
+ * DSi's microphone block, unchanged, and both 3dbrew ("MIC Registers") and
+ * GBATEK ("3DS Sound and Microphone", which forwards to "DSi Microphone and
+ * SoundExt") give the whole layout.  What the #311 survey saw -- +0x00 reading
+ * 0x0100 and nothing ever moving -- is exactly right for a block whose FIFO is
+ * empty and whose enable bit was never set, because the survey is read-only.
+ *
+ * Two registers:
+ *
+ *   +0x00  u16  REG_MIC_CNT
+ *   +0x04  u32  REG_MIC_DATA, a 16-word FIFO; each word is two s16 samples
+ *
+ * The sample rate is a divider of the I2S clock selected by SNDEXCNT bit 13,
+ * which codec_init() leaves at 0 = 32.73 kHz, so the four rates available here
+ * are 32730 / 16360 / 10910 / 8180 Hz.  8180 is both the closest to the 8000
+ * Hz that AudioStreamInGeneric demands and the one that fills the 32-sample
+ * FIFO slowest (3.9 ms), which is what makes polling viable at all.
+ *
+ * Three preconditions, all met before this file was touched:
+ *   - SNDEXCNT bit 31 (I2S clock) and bit 15 set   -- codec_init()
+ *   - the codec's mic path unmuted                 -- codec_power_on_adc()
+ *   - the FIFO drained before it overruns          -- mic_drain()
+ */
+#define MIC_BASE		0x10162000
+#define MIC_REGS_BYTES		8
+#define MIC_SURVEY_BYTES	32
+
+#define MIC_CNT			0x00	/* u16 */
+#define MIC_DATA		0x04	/* u32 */
+
+#define MIC_FMT_MAKE_STEREO	0u
+#define MIC_FMT_NORMAL		2u	/* one s16 per halfword, mono */
+#define MIC_FMT_NONE		3u
+#define MIC_CNT_RATE(n)		(((n) & 3u) << 2)	/* F/1 .. F/4 */
+#define MIC_CNT_FIFO_EMPTY	(1u << 8)
+#define MIC_CNT_FIFO_HALF	(1u << 9)
+#define MIC_CNT_FIFO_FULL	(1u << 10)
+#define MIC_CNT_FIFO_OVERRUN	(1u << 11)
+#define MIC_CNT_FIFO_CLEAR	(1u << 12)	/* W, needs bit 15 clear */
+#define MIC_CNT_ENABLE		(1u << 15)
+
+/*
+ * AudioStreamInGeneric fixes the capture format: 8000 Hz, mono, signed 16-bit
+ * LE, 320 bytes (160 samples, 20 ms) per read.  Those are not negotiable, so
+ * they are constants rather than parameters.  They live up here rather than
+ * beside the read path because mic_drain()'s resampler and the N3DS_MIC_STATS
+ * report need CAP_RATE.
+ */
+#define CAP_RATE		8000
+#define CAP_BYTES_PER_SAMPLE	2
+
+/* N3DS_MIC_PROBE: which part of each FIFO word carries a sample. */
+#define MIC_LIVE_LO		1	/* bits 0-15 only */
+#define MIC_LIVE_HI		2	/* bits 16-31 only */
+#define MIC_LIVE_BOTH		3	/* two samples, low half first */
+#define MIC_LIVE_SLOT		4	/* one sample at bits shift..shift+15 */
+
+/*
+ * N3DS_MIC_STATS: one line per recording, printed once it has ended.
+ * min/max/mean say whether it is DC, noise or signal; the 0000h/FFFFh counts
+ * are GBATEK's own symptom of an unpowered front end; "steps" counts samples
+ * that differ from their predecessor, so a stuck value shows as 0.
+ *
+ * Not printed while recording, and never from mic_tick() mid-stream: console
+ * output runs with interrupts off, and a long line on the rotated fbcon
+ * scrolls for tens of milliseconds -- ten times the 3.9 ms the FIFO lasts.
+ * #315 printed this every five seconds from inside the drain timer, which
+ * overran the FIFO every five seconds by construction.
+ */
+static void mic_stats_reset(struct ctr_csnd *cs)
+{
+	cs->st_n = 0;
+	cs->st_zero = 0;
+	cs->st_ffff = 0;
+	cs->st_steps = 0;
+	cs->st_min = S16_MAX;
+	cs->st_max = S16_MIN;
+	cs->st_sum = 0;
+	cs->st_abs = 0;
+}
+
+static void mic_stats_add(struct ctr_csnd *cs, s16 s)
+{
+	cs->st_n++;
+	if (s == 0)
+		cs->st_zero++;
+	else if (s == -1)
+		cs->st_ffff++;
+	if (s != cs->st_prev)
+		cs->st_steps++;
+	cs->st_prev = s;
+	cs->st_min = min_t(s32, cs->st_min, s);
+	cs->st_max = max_t(s32, cs->st_max, s);
+	cs->st_sum += s;
+	cs->st_abs += abs((s32)s);
+}
+
+/*
+ * The recording is over (the idle stop just parked the block), so the
+ * interrupts-off console write can no longer cost a sample.  cap_underruns
+ * belongs to the reader, which has stopped reading; a torn read of it only
+ * misprints a diagnostic.
+ */
+static const char *const mic_live_names[] = {
+	"none", "low half", "high half", "both halves", "slot",
+};
+
+static void mic_stats_print(struct ctr_csnd *cs)
+{
+	u32 n = cs->st_n;
+	u32 i;
+
+	if (!n)
+		return;
+	/*
+	 * N3DS_MIC_QUIET (#326): this is 27 lines at the end of every call --
+	 * stats, probe and the raw-word dump -- and with ignore_loglevel every
+	 * one scrolls the top-screen console.  The mic is fixed (#317); print it
+	 * only when the recording went wrong, or when stream_evidence=1 asks.
+	 */
+	if (!stream_evidence && !cs->cap_overruns && !cs->cap_ring_full &&
+	    !READ_ONCE(cs->cap_underruns))
+		return;
+	dev_info(cs->dev,
+		 "mic: recording ended (N3DS_MIC_STATS) -- %u ms of samples: min %d max %d mean %d mean|x| %u, %u%% 0000h, %u%% FFFFh, %u%% steps; %u FIFO overruns, %u ring-full drops, %u samples padded\n",
+		 (u32)div_u64((u64)n * 1000, max_t(u32, cs->cap_in_rate, 1)),
+		 cs->st_min, cs->st_max, (s32)div_s64(cs->st_sum, n),
+		 (u32)div_u64(cs->st_abs, n),
+		 cs->st_zero * 100 / n, cs->st_ffff * 100 / n,
+		 cs->st_steps * 100 / n,
+		 cs->cap_overruns, cs->cap_ring_full,
+		 READ_ONCE(cs->cap_underruns));
+
+	/*
+	 * N3DS_MIC_PROBE: the latest completed probe.  The bit strings run
+	 * b31 on the left to b0 on the right, one digit per bit, 0-9 for the
+	 * share of probed words (9 = 90% or more): "ones" is bit k set, "!=b31"
+	 * is bit k differing from bit 31, "==next" is bit k+1 equal to bit k
+	 * (b31..b1).  A clean 16-bit sample shows as a run of ~5s under !=b31;
+	 * a clock mismatch shows as 9s at fixed places under ==next.
+	 */
+	if (cs->cap_probes)
+		dev_info(cs->dev,
+			 "mic: probe (N3DS_MIC_PROBE) -- %u probes, %u restarts; last: %u words in %u ms = %u words/s at MIC_CNT rate %d; low half %u%% dead, high half %u%% dead, high==low %u%%; using %s shift %d, %u Hz live (measured %u) -> %u Hz\n",
+			 cs->cap_probes, cs->cap_restarts,
+			 cs->pd_words, cs->pd_ms, cs->pd_wps, cs->cap_idx,
+			 cs->pd_lo_dead, cs->pd_hi_dead, cs->pd_same,
+			 mic_live_names[cs->cap_live], cs->cap_shift,
+			 cs->cap_in_rate, cs->pd_meas, CAP_RATE);
+	else
+		dev_info(cs->dev,
+			 "mic: probe (N3DS_MIC_PROBE) -- never completed (%u restarts); used the documented format at %u Hz\n",
+			 cs->cap_restarts, cs->cap_in_rate);
+	if (cs->cap_probes)
+		dev_info(cs->dev,
+			 "mic: probe bits (N3DS_MIC_PROBE) ones %s  !=b31 %s  ==next %s\n",
+			 cs->pd_ones, cs->pd_nsign, cs->pd_eq);
+
+	for (i = 0; i + 8 <= cs->raw_n; i += 8)
+		dev_info(cs->dev,
+			 "mic: raw (N3DS_MIC_RAW) %02u: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			 i, cs->raw[i], cs->raw[i + 1], cs->raw[i + 2],
+			 cs->raw[i + 3], cs->raw[i + 4], cs->raw[i + 5],
+			 cs->raw[i + 6], cs->raw[i + 7]);
+}
+
+/* Hardware rates for SNDEXCNT.bit13 == 0, indexed by MIC_CNT bits 2-3. */
+static const u32 mic_hw_rates[4] = { 32730, 16360, 10910, 8180 };
+
+/* 16 words of FIFO is 32 samples; at 8180 Hz that is 3.91 ms to overrun.
+ * This kernel is HZ=1000 without CONFIG_HIGH_RES_TIMERS, so hrtimers expire
+ * on the 1 ms tick: a 2 ms period really ran every 2-3 ms and left ~1 ms of
+ * slack.  Polling every tick leaves ~2.9 ms. */
+#define MIC_POLL_US		1000
+/* Ticks of enabled-but-empty FIFO that make up one second. */
+#define MIC_DRY_TICKS		(1000000 / MIC_POLL_US)
+/* N3DS_MIC_FULL_READS: how late the ring may run behind the clock before
+ * read() stops waiting for the block and pads the buffer with silence. */
+#define MIC_READ_GRACE_MS	100
+/* When nobody has read for this long, stop the block and idle the timer. */
+#define MIC_IDLE_MS		400
+#define MIC_IDLE_JIFFIES	msecs_to_jiffies(MIC_IDLE_MS)
+#define MIC_IDLE_POLL_US	20000
+
+/* 5.11 has ms_to_ktime() and ns_to_ktime() but no us_to_ktime(). */
+static inline ktime_t mic_us(u32 us)
+{
+	return ns_to_ktime((u64)us * NSEC_PER_USEC);
+}
+
+/* Half a second of 8 kHz mono: enough to ride out a scheduling hiccup without
+ * letting capture latency grow without bound. */
+#define CAP_RING_SAMPLES	4096
+#define CAP_RING_MASK		(CAP_RING_SAMPLES - 1)
+/* The largest single read() waits for at most half the ring, so the wait can
+ * always be satisfied; AudioFlinger asks for 160 samples. */
+#define CAP_READ_MAX		(CAP_RING_SAMPLES / 2)
+
+/*
+ * N3DS_MIC_CAPTURE: bring up the analog capture front end.
+ *
+ * N3DS_MIC_FRONTEND: the register numbers used here before kernel #313
+ * (p1.51 MICBIAS, p1.52/54 PGA routing, p1.59 PGA gain) are the TLV320AIC32x4
+ * layout.  That is a different chip: on the CTR codec, p1.51 onwards is
+ * reserved, so MICBIAS was never powered and the PGA was never routed.
+ * GBATEK spells out the result: "The Sample Data tends to be 0000h or FFFFh
+ * if the microphone related TSC-registers aren't unmuted."
+ *
+ * The sequence below is libn3ds codec.c microphoneInit() (the 3DS OS's own
+ * CODEC init, reverse-engineered), with the HWCAL values replaced by the
+ * launch-day o3DS defaults libn3ds itself ships.  The last two writes,
+ * ADC power and ADC unmute, are GBATEK's DSi mic_enable_tsc_init_list:
+ *
+ *   p100.34 bit 2 clear   mic ADC output select
+ *   p4.8..13              1st-order IIR, 10 Hz high-pass (DC removal)
+ *   p1.48 / p1.49 = 0x40  ADC P / M terminal input, mic at 10k (mask 0xC0)
+ *   p101.51 = 3           microphone bias            (HWCAL MicrophoneBias)
+ *   p101.65 = 0           PGA gain correction, bits 0-5 (HWCAL PGA_GAIN)
+ *   p101.66 = 2           "quick charge", bits 0-1   (HWCAL QuickCharge)
+ *   p1.47 = 0x2B          MIC PGA, +21.5 dB (the 3DS value)
+ *   p1.46 = 0x03          MICBIAS = AVDD
+ *   p0.81 = 0x80          ADC channel powered
+ *   p0.82 = 0x00          ADC fine volume 0 dB, unmuted
+ *
+ * N3DS_MIC_BIAS: p1.46 is the first line of that same GBATEK list and was
+ * the one line of it #313/#314 left out.  p101.51 is the CTR-side bias
+ * trim libn3ds programs; p1.46 is the TSC's own MICBIAS power switch, and an
+ * electret capsule with no bias produces no signal at any gain.
+ */
+#define CDC_MIC_BIAS		CDC(1, 0x2E)
+#define CDC_ADC_POWER		CDC(0, 0x51)
+#define CDC_ADC_MUTE		CDC(0, 0x52)
+#define CDC_MIC_PGA		CDC(1, 0x2F)
+#define CDC_ADC_IN_P		CDC(1, 0x30)
+#define CDC_ADC_IN_M		CDC(1, 0x31)
+#define CDC_MIC_IIR		CDC(4, 8)
+#define CDC_101_51		CDC(101, 51)	/* MicrophoneBias */
+#define CDC_101_65		CDC(101, 65)	/* PGA gain correction */
+#define CDC_101_66		CDC(101, 66)	/* quick charge */
+
+#define CAL_MIC_BIAS		3u
+#define CAL_MIC_PGA_GAIN	0u
+#define CAL_MIC_QUICK_CHARGE	2u
+#define MIC_PGA_3DS		0x2Bu
+
+/* libn3ds maskWaitReg(): the analog block can take a few writes to latch. */
+static void cdc_mask_wait(struct ctr_csnd *cs, unsigned int reg,
+			  unsigned int val, unsigned int mask)
+{
+	int i, v = -1;
+
+	for (i = 0; i < 64; i++) {
+		cdc_mask(cs, reg, val, mask);
+		v = cdc_read(cs, reg);
+		if (v >= 0 && ((unsigned int)v & mask) == val)
+			return;
+	}
+	dev_warn(cs->dev, "codec p%u.%u never latched 0x%02x (reads 0x%02x)\n",
+		 reg >> 7, reg & 0x7F, val, v & 0xFF);
+}
+
+static void codec_mic_frontend(struct ctr_csnd *cs)
+{
+	/* 32737, -32737, 32705 big-endian: N0, N1, D1 of the 10 Hz high-pass. */
+	static const u8 hp10[6] = { 0x7F, 0xE1, 0x80, 0x1F, 0x7F, 0xC1 };
+	unsigned int i;
+
+	cdc_mask(cs, CDC_100_34, 0x00, 0x04);
+	for (i = 0; i < ARRAY_SIZE(hp10); i++)
+		cdc_write(cs, CDC_MIC_IIR + i, hp10[i]);
+	cdc_mask(cs, CDC_ADC_IN_P, 0x40, 0xC0);
+	cdc_mask(cs, CDC_ADC_IN_M, 0x40, 0xC0);
+	cdc_write(cs, CDC_101_51, CAL_MIC_BIAS);
+	cdc_mask_wait(cs, CDC_101_65, CAL_MIC_PGA_GAIN, 0x3F);
+	cdc_mask_wait(cs, CDC_101_66, CAL_MIC_QUICK_CHARGE, 0x03);
+	cdc_write(cs, CDC_MIC_PGA, MIC_PGA_3DS);
+	cdc_write(cs, CDC_MIC_BIAS, 0x03);
+}
+
+static void codec_power_on_adc(struct ctr_csnd *cs)
+{
+	if (!cs->codec_ok)
+		return;
+
+	/* The coefficient RAM is only safe to write with the ADC off, so the
+	 * front end is programmed once, before the first power-up. */
+	if (!cs->mic_fe_done) {
+		codec_mic_frontend(cs);
+		cs->mic_fe_done = true;
+	}
+	cdc_write(cs, CDC_ADC_POWER, 0x80);
+	cdc_write(cs, CDC_ADC_MUTE, 0x00);
+
+	dev_info(cs->dev,
+		 "codec: mic front end up (N3DS_MIC_FRONTEND) -- p0.81=0x%02x p0.82=0x%02x p1.46=0x%02x p1.47=0x%02x p1.48=0x%02x p1.49=0x%02x p101.51=0x%02x p101.65=0x%02x p101.66=0x%02x\n",
+		 cdc_read(cs, CDC_ADC_POWER) & 0xFF,
+		 cdc_read(cs, CDC_ADC_MUTE) & 0xFF,
+		 cdc_read(cs, CDC_MIC_BIAS) & 0xFF,
+		 cdc_read(cs, CDC_MIC_PGA) & 0xFF,
+		 cdc_read(cs, CDC_ADC_IN_P) & 0xFF,
+		 cdc_read(cs, CDC_ADC_IN_M) & 0xFF,
+		 cdc_read(cs, CDC_101_51) & 0xFF,
+		 cdc_read(cs, CDC_101_65) & 0xFF,
+		 cdc_read(cs, CDC_101_66) & 0xFF);
+}
+
+/*
+ * Read-only sweep of the MIC block.
+ *
+ * Deliberately limited to the first 32 bytes: that covers a control register
+ * file on every other block on this SoC, and stops well short of anything
+ * that might be a FIFO -- reading an empty FIFO can stall the bus, which is
+ * the same hazard already documented for the derived CAM FIFOs.
+ *
+ * A single dump of an undocumented block says almost nothing, which is why
+ * the original version of this never earned its keep.  What distinguishes a
+ * sample register from a control register is that it *moves*: so this reads
+ * the file once for a baseline, powers the analog front end, then samples it
+ * 64 times over half a second and reports, per halfword, how many distinct
+ * values it took and whether they only ever increased.
+ *
+ *   - a halfword that never changes is a control or status register;
+ *   - one that increases monotonically and wraps is a sample counter or a
+ *     DMA write pointer -- that is the register to pace capture against;
+ *   - one that takes many unordered values is the sample data itself, and is
+ *     what mic_data_off should be pointed at.
+ *
+ * Everything here is reads only.  Nothing is written to the MIC block, at
+ * probe or ever.
+ */
+#define MIC_PROBE_ROUNDS	64
+
+static void mic_block_survey(struct ctr_csnd *cs)
+{
+	u16 first[MIC_SURVEY_BYTES / 2];
+	u16 last[MIC_SURVEY_BYTES / 2];
+	u16 lo[MIC_SURVEY_BYTES / 2];
+	u16 hi[MIC_SURVEY_BYTES / 2];
+	unsigned int changes[MIC_SURVEY_BYTES / 2];
+	unsigned int rises[MIC_SURVEY_BYTES / 2];
+	void __iomem *mic = cs->mic;
+	int i, round;
+	int movers = 0;
+
+	if (!mic) {
+		dev_warn(cs->dev, "mic_survey: MIC block is not mapped\n");
+		return;
+	}
+
+	for (i = 0; i < MIC_SURVEY_BYTES / 2; i++) {
+		first[i] = last[i] = lo[i] = hi[i] = ioread16(mic + i * 2);
+		changes[i] = rises[i] = 0;
+	}
+
+	dev_info(cs->dev, "mic_survey: baseline at 0x%08x (before the ADC is powered)\n",
+		 MIC_BASE);
+	for (i = 0; i < MIC_SURVEY_BYTES / 2; i++)
+		dev_info(cs->dev, "mic_survey:   +0x%02x = 0x%04x\n",
+			 i * 2, first[i]);
+
+	/* Give the block something to capture. */
+	codec_power_on_adc(cs);
+	msleep(20);
+
+	for (round = 0; round < MIC_PROBE_ROUNDS; round++) {
+		for (i = 0; i < MIC_SURVEY_BYTES / 2; i++) {
+			u16 v = ioread16(mic + i * 2);
+
+			if (v != last[i]) {
+				changes[i]++;
+				if (v > last[i])
+					rises[i]++;
+			}
+			if (v < lo[i])
+				lo[i] = v;
+			if (v > hi[i])
+				hi[i] = v;
+			last[i] = v;
+		}
+		usleep_range(7000, 9000);
+	}
+
+	dev_info(cs->dev, "mic_survey: %d rounds over ~0.5 s with the ADC live\n",
+		 MIC_PROBE_ROUNDS);
+	for (i = 0; i < MIC_SURVEY_BYTES / 2; i++) {
+		const char *verdict;
+
+		if (!changes[i])
+			verdict = "static (control/status)";
+		else if (rises[i] == changes[i])
+			verdict = "MONOTONIC -- counter or DMA pointer";
+		else if (changes[i] > MIC_PROBE_ROUNDS / 2)
+			verdict = "MOVING -- candidate sample register";
+		else
+			verdict = "occasional change";
+
+		if (changes[i])
+			movers++;
+
+		dev_info(cs->dev,
+			 "mic_survey:   +0x%02x now 0x%04x  changed %u/%u  "
+			 "range 0x%04x..0x%04x  %s\n",
+			 i * 2, last[i], changes[i], (unsigned)MIC_PROBE_ROUNDS,
+			 lo[i], hi[i], verdict);
+	}
+
+	if (!movers)
+		dev_info(cs->dev,
+			 "mic_survey: nothing in the first %d bytes moves while the "
+			 "ADC is running -- the block needs a start bit this probe "
+			 "does not write, or capture is not reachable from here\n",
+			 MIC_SURVEY_BYTES);
+	else
+		dev_info(cs->dev,
+			 "mic_survey: %d halfword(s) move while the ADC runs\n",
+			 movers);
+}
+
+/* ------------------------------------------------------------------ *
+ * N3DS_MIC_REAL -- the MIC block itself
+ * ------------------------------------------------------------------ */
+
+static int mic_idx_clamp(int idx)
+{
+	return (idx < 0 || idx > 3) ? 3 : idx;
+}
+
+static u16 mic_cnt_base(struct ctr_csnd *cs)
+{
+	return (u16)(MIC_FMT_NORMAL | MIC_CNT_RATE(cs->cap_idx));
+}
+
+/* The documented rate for a divider: two s16 per FIFO word. */
+static u32 mic_nominal_rate(int idx)
+{
+	return mic_hw_rates[mic_idx_clamp(idx)];
+}
+
+/*
+ * N3DS_MIC_RESAMPLE: rs_step is Q16 input samples per 8000 Hz output sample.
+ * The clamp keeps it between 1/4 and 8: never more than four outputs per
+ * input, which is what bounds mic_drain() in softirq context.
+ */
+static void mic_set_in_rate(struct ctr_csnd *cs, u32 rate)
+{
+	rate = clamp_t(u32, rate, CAP_RATE / 4, CAP_RATE * 8);
+	cs->cap_in_rate = rate;
+	cs->rs_step = (u32)div_u64((u64)rate << 16, CAP_RATE);
+}
+
+static void mic_probe_reset(struct ctr_csnd *cs)
+{
+	cs->pr_t0 = ktime_get();
+	cs->pr_words = 0;
+	cs->pr_done = false;
+	cs->pr_lo_dead = 0;
+	cs->pr_hi_dead = 0;
+	cs->pr_same = 0;
+	memset(cs->pr_ones, 0, sizeof(cs->pr_ones));
+	memset(cs->pr_nsign, 0, sizeof(cs->pr_nsign));
+	memset(cs->pr_eq, 0, sizeof(cs->pr_eq));
+}
+
+/*
+ * Start sampling.  The order is load-bearing: the FIFO-clear bit is only
+ * honoured while the enable bit is clear, so it takes one write to disable,
+ * one to clear and one to enable.  That is also exactly the sequence for
+ * recovering from an overrun, which is why mic_hw_start() is the overrun
+ * recovery too.  Every start re-runs the probe: the words/s it measures are
+ * only true from a known empty FIFO.
+ */
+static void mic_hw_start(struct ctr_csnd *cs)
+{
+	u16 base = mic_cnt_base(cs);
+
+	if (!cs->mic)
+		return;
+
+	iowrite16(0, cs->mic + MIC_CNT);
+	iowrite16(base | MIC_CNT_FIFO_CLEAR, cs->mic + MIC_CNT);
+	iowrite16(base | MIC_CNT_ENABLE, cs->mic + MIC_CNT);
+	mic_probe_reset(cs);
+}
+
+static void mic_hw_stop(struct ctr_csnd *cs)
+{
+	if (cs->mic)
+		iowrite16(0, cs->mic + MIC_CNT);
+}
+
+/*
+ * N3DS_MIC_PROBE: measure the block instead of trusting the documentation.
+ *
+ * #316 believed GBATEK -- two s16 per FIFO word at F/4 of 32.73 kHz -- and
+ * the recording it made says otherwise on every count: words came at ~2045/s,
+ * half the documented rate, and each held one sample with filler on both
+ * sides.  That was under the 47.61 kHz line 2 clock (N3DS_MIC_CLOCK_32K), and
+ * nobody knows yet what the block delivers with the clock fixed.  So each
+ * start measures, over its first MIC_PROBE_WORDS words:
+ *
+ *   - words per second, against the monotonic clock;
+ *   - whether a half is dead (0000h/FFFFh -- filler, not a sample) or a copy
+ *     of the other half, which leaves one sample per word;
+ *   - failing that, whether the word is one sample sitting above constant
+ *     filler bits, the #316 shape, and where its LSB is;
+ *
+ * and decodes and resamples with what it found.  Until the first probe
+ * completes -- about a quarter of a second -- the documented format is used.
+ * The evidence is printed once the recording has ended (mic_stats_print).
+ */
+#define MIC_PROBE_WORDS		1024
+#define MIC_PROBE_DEAD_PCT	90
+/* 16 words of FIFO in at least 3.7 ms at the 1 ms poll: the most words per
+ * second the drain is trusted with when it picks a faster divider. */
+#define MIC_WORDS_MAX		4300
+/* Below this many live samples per second, pick a faster divider (once). */
+#define MIC_RATE_LOW		6000
+#define MIC_RATE_WANT		7500
+/* 268.111856 MHz / 8192 = 32.73 kHz, / 5632 = 47.61 kHz */
+#define MIC_SOC_CLOCK		268111856ull
+
+static void mic_probe_word(struct ctr_csnd *cs, u32 w)
+{
+	u32 ns = w ^ ((w & BIT(31)) ? ~0u : 0u);	/* bit k != bit 31 */
+	u32 eq = ~(w ^ (w >> 1));			/* bit k == bit k+1 */
+	u16 lo = w & 0xFFFF;
+	u16 hi = w >> 16;
+	int k;
+
+	if (cs->raw_n < MIC_RAW_WORDS)
+		cs->raw[cs->raw_n++] = w;
+	if (cs->pr_done)
+		return;
+
+	cs->pr_words++;
+	if (lo == 0x0000 || lo == 0xFFFF)
+		cs->pr_lo_dead++;
+	if (hi == 0x0000 || hi == 0xFFFF)
+		cs->pr_hi_dead++;
+	if (hi == lo)
+		cs->pr_same++;
+	for (k = 0; k < 32; k++) {
+		cs->pr_ones[k] += (w >> k) & 1;
+		cs->pr_nsign[k] += (ns >> k) & 1;
+		cs->pr_eq[k] += (eq >> k) & 1;
+	}
+}
+
+static u32 mic_pct(u32 part, u32 whole)
+{
+	return whole ? (u32)div_u64((u64)part * 100, whole) : 0;
+}
+
+/* b(top) .. b0 as one digit each, 0-9 for the share of words (9 = 90%+). */
+static void mic_digits(char *dst, const u32 *count, int top, u32 n)
+{
+	int k, i = 0;
+
+	for (k = top; k >= 0; k--)
+		dst[i++] = '0' + (char)min_t(u32, mic_pct(count[k], n) / 10, 9);
+	dst[i] = '\0';
+}
+
+/*
+ * Filler, not sample data: constant, a copy of the sign, or a copy of the
+ * bit above it -- the data line held at the sample's LSB, which is what the
+ * bits under the sample looked like in the #316 recording.
+ */
+static bool mic_bit_filler(struct ctr_csnd *cs, int k, u32 n)
+{
+	u32 ones = mic_pct(cs->pr_ones[k], n);
+
+	return mic_pct(cs->pr_nsign[k], n) <= 2 || ones <= 2 || ones >= 98 ||
+	       mic_pct(cs->pr_eq[k], n) >= 98;
+}
+
+static bool mic_bit_active(struct ctr_csnd *cs, int k, u32 n)
+{
+	u32 ones = mic_pct(cs->pr_ones[k], n);
+
+	return mic_pct(cs->pr_nsign[k], n) >= 15 && ones >= 10 && ones <= 90;
+}
+
+/* A measured rate, snapped to F/n of either I2S clock when within 2%. */
+static u32 mic_snap_rate(u32 meas)
+{
+	static const u32 div[2] = { 8192, 5632 };
+	u32 best = meas, best_err = meas / 50 + 1;
+	int c, n;
+
+	for (c = 0; c < 2; c++)
+		for (n = 1; n <= 32; n++) {
+			u32 r = (u32)div_u64(MIC_SOC_CLOCK, div[c] * n);
+			u32 err = r > meas ? r - meas : meas - r;
+
+			if (err < best_err) {
+				best_err = err;
+				best = r;
+			}
+		}
+	return best;
+}
+
+/* Returns true when it changed the divider and the block needs a restart. */
+static bool mic_probe_decide(struct ctr_csnd *cs)
+{
+	u32 n = cs->pr_words;
+	u64 ns = ktime_to_ns(ktime_sub(ktime_get(), cs->pr_t0));
+	u32 wps = (u32)div64_u64((u64)n * NSEC_PER_SEC, max_t(u64, ns, 1));
+	u32 lo_dead = mic_pct(cs->pr_lo_dead, n);
+	u32 hi_dead = mic_pct(cs->pr_hi_dead, n);
+	u32 same = mic_pct(cs->pr_same, n);
+	u8 live = MIC_LIVE_BOTH;
+	int shift = 0, t, k;
+	u32 meas, rate;
+	bool restart = false;
+
+	cs->pr_done = true;
+
+	/*
+	 * One sample with filler under it and sign fill over it.  This test
+	 * comes first: a quiet sample at bit 4 leaves the high half all sign
+	 * bits, which the dead-half rules below would take for "low half
+	 * live".  A real two-sample word cannot pass it: bit 0 is the low
+	 * sample's LSB, and an ADC LSB is never filler.
+	 */
+	for (t = 0; t < 16 && mic_bit_filler(cs, t, n); t++)
+		;
+	if (t > 0 && t < 16 && mic_bit_active(cs, t, n)) {
+		for (k = t + 16; k < 31; k++)
+			if (mic_pct(cs->pr_nsign[k], n) > 2)
+				break;
+		if (k >= 31) {
+			live = MIC_LIVE_SLOT;
+			shift = t;
+		}
+	}
+
+	if (live != MIC_LIVE_SLOT) {
+		if (lo_dead >= MIC_PROBE_DEAD_PCT &&
+		    hi_dead >= MIC_PROBE_DEAD_PCT)
+			live = MIC_LIVE_BOTH;	/* silence either way */
+		else if (hi_dead >= MIC_PROBE_DEAD_PCT ||
+			 same >= MIC_PROBE_DEAD_PCT)
+			live = MIC_LIVE_LO;
+		else if (lo_dead >= MIC_PROBE_DEAD_PCT)
+			live = MIC_LIVE_HI;
+	}
+
+	meas = wps * (live == MIC_LIVE_BOTH ? 2 : 1);
+	rate = mic_snap_rate(meas);
+
+	/*
+	 * Too few live samples per second to make 8000 of: pick the slowest
+	 * divider that does make them, without letting the FIFO fill faster
+	 * than the 1 ms drain can be trusted with.  Once per recording.
+	 */
+	if (!cs->cap_idx_auto && rate < MIC_RATE_LOW &&
+	    !(lo_dead >= MIC_PROBE_DEAD_PCT && hi_dead >= MIC_PROBE_DEAD_PCT)) {
+		u32 f0 = rate * (cs->cap_idx + 1);
+		u32 w0 = wps * (cs->cap_idx + 1);
+		int i, best = cs->cap_idx;
+
+		for (i = 3; i >= 0; i--) {
+			if (w0 / (i + 1) > MIC_WORDS_MAX)
+				break;
+			best = i;
+			if (f0 / (i + 1) >= MIC_RATE_WANT)
+				break;
+		}
+		cs->cap_idx_auto = true;
+		if (best != cs->cap_idx) {
+			rate = f0 / (best + 1);
+			cs->cap_idx = best;
+			restart = true;
+		}
+	}
+
+	cs->cap_live = live;
+	cs->cap_shift = (s8)shift;
+	mic_set_in_rate(cs, rate);
+	cs->cap_probes++;
+
+	cs->pd_words = n;
+	cs->pd_ms = (u32)div_u64(ns, NSEC_PER_MSEC);
+	cs->pd_wps = wps;
+	cs->pd_meas = meas;
+	cs->pd_lo_dead = lo_dead;
+	cs->pd_hi_dead = hi_dead;
+	cs->pd_same = same;
+	mic_digits(cs->pd_ones, cs->pr_ones, 31, n);
+	mic_digits(cs->pd_nsign, cs->pr_nsign, 31, n);
+	mic_digits(cs->pd_eq, cs->pr_eq, 30, n);
+	return restart;
+}
+
+/*
+ * N3DS_MIC_RESAMPLE: one live sample in, 0..4 samples out at 8000 Hz, by
+ * linear interpolation.  #316 decimated by dropping 1 sample in 45, which
+ * only works downwards and only from 8180 Hz; the probe can find the block
+ * running at half that, so this has to go both ways.  rs_pos is where the
+ * next output sits between rs_prev (0) and s (0x10000).
+ */
+static void mic_push(struct ctr_csnd *cs, s16 s, u32 *head, u32 tail)
+{
+	s32 prev = cs->rs_prev;
+
+	mic_stats_add(cs, s);
+	while (cs->rs_pos < 0x10000) {
+		s32 out = prev + (s32)(((s64)((s32)s - prev) * cs->rs_pos) >> 16);
+
+		if (*head - tail >= CAP_RING_SAMPLES) {
+			cs->cap_ring_full++;
+		} else {
+			cs->cap_ring[*head & CAP_RING_MASK] = (s16)out;
+			(*head)++;
+		}
+		cs->rs_pos += cs->rs_step;
+	}
+	cs->rs_pos -= 0x10000;
+	cs->rs_prev = s;
+}
+
+/*
+ * Move everything the FIFO has into the ring, decoded as the probe says and
+ * resampled to the 8000 Hz the caller was promised.
+ *
+ * Runs in hrtimer (softirq) context, and is bounded by the FIFO depth -- at
+ * most 17 register reads, 34 samples in and 136 out -- so it cannot become
+ * the kind of unbounded interrupt-context loop that has caused soft lockups
+ * on this board before.  MIC_CNT is re-read every iteration and the FIFO is
+ * never read while bit 8 says it is empty: an empty-FIFO read is the
+ * documented stall hazard on the derived CAM block and is assumed to apply
+ * here too.
+ */
+static void mic_drain(struct ctr_csnd *cs)
+{
+	u32 head = cs->cap_head;
+	u32 head0 = head;
+	u32 tail = smp_load_acquire(&cs->cap_tail);
+	unsigned int word;
+	u16 cnt = 0;
+
+	/* 16 words is the whole FIFO; the 17th iteration is what lets the loop
+	 * notice it has gone empty instead of exiting with data still queued. */
+	for (word = 0; word < 17; word++) {
+		u32 w;
+
+		cnt = ioread16(cs->mic + MIC_CNT);
+		if (cnt & MIC_CNT_FIFO_EMPTY)
+			break;
+
+		w = ioread32(cs->mic + MIC_DATA);
+		mic_probe_word(cs, w);
+
+		switch (cs->cap_live) {
+		case MIC_LIVE_LO:
+			mic_push(cs, (s16)(w & 0xFFFF), &head, tail);
+			break;
+		case MIC_LIVE_HI:
+			mic_push(cs, (s16)(w >> 16), &head, tail);
+			break;
+		case MIC_LIVE_SLOT:
+			mic_push(cs, (s16)(w >> cs->cap_shift), &head, tail);
+			break;
+		default:
+			mic_push(cs, (s16)(w & 0xFFFF), &head, tail);
+			mic_push(cs, (s16)(w >> 16), &head, tail);
+			break;
+		}
+	}
+
+	/*
+	 * One line, once, the first time samples actually come out of the
+	 * block, and one line if they never do.  This is the whole difference
+	 * between "the microphone does not work" and a diagnosis, and it costs
+	 * two branches per tick.
+	 */
+	if (head != head0) {
+		cs->cap_dry_ticks = 0;
+		if (!cs->cap_seen_data) {
+			cs->cap_seen_data = true;
+			dev_info(cs->dev,
+				 "mic: first samples out of the FIFO -- MIC_CNT 0x%04x, %u kept, first four %d %d %d %d\n",
+				 cnt, head - head0,
+				 cs->cap_ring[head0 & CAP_RING_MASK],
+				 cs->cap_ring[(head0 + 1) & CAP_RING_MASK],
+				 cs->cap_ring[(head0 + 2) & CAP_RING_MASK],
+				 cs->cap_ring[(head0 + 3) & CAP_RING_MASK]);
+		}
+	} else if (!cs->cap_seen_data && ++cs->cap_dry_ticks == MIC_DRY_TICKS) {
+		dev_warn(cs->dev,
+			 "mic: FIFO still empty one second after enabling -- MIC_CNT reads 0x%04x (wrote 0x%04x); the block is not sampling\n",
+			 cnt, mic_cnt_base(cs) | MIC_CNT_ENABLE);
+	}
+
+	smp_store_release(&cs->cap_head, head);
+
+	/*
+	 * N3DS_MIC_FULL_READS: wake the reader once its whole buffer is here,
+	 * rather than every tick.  A stale cap_want only defers the wake to a
+	 * later tick: the queue only grows until the reader consumes it.
+	 */
+	if (head != head0 && head - tail >= READ_ONCE(cs->cap_want))
+		wake_up(&cs->cap_wq);
+
+	/*
+	 * Overrun latches and stops sampling until the FIFO is cleared, so this
+	 * is not cosmetic: without the restart the microphone goes permanently
+	 * silent after the first missed deadline.
+	 */
+	if (cnt & MIC_CNT_FIFO_OVERRUN) {
+		cs->cap_overruns++;
+		cs->cap_restarts++;
+		mic_hw_start(cs);
+	} else if (!cs->pr_done && cs->pr_words >= MIC_PROBE_WORDS) {
+		if (mic_probe_decide(cs)) {
+			cs->cap_restarts++;
+			mic_hw_start(cs);
+		}
+	}
+}
+
+static enum hrtimer_restart mic_tick(struct hrtimer *t)
+{
+	struct ctr_csnd *cs = container_of(t, struct ctr_csnd, cap_timer);
+	u32 period_us;
+
+	/* ioremap or the ring allocation failed at probe: there is nothing to
+	 * drain and nowhere to put it, so do not come back. */
+	if (!cs->mic || !cs->cap_ring)
+		return HRTIMER_NORESTART;
+
+	if (time_after(jiffies,
+		       READ_ONCE(cs->cap_last_read) + MIC_IDLE_JIFFIES)) {
+		/*
+		 * Nobody is recording.  Park the block and back the poll right
+		 * off, rather than waking 500 times a second for the rest of the
+		 * boot because one app once opened an AudioRecord -- mediaserver
+		 * holds /dev/eac open from its constructor to shutdown, so
+		 * release() is not a reliable stop.
+		 */
+		if (cs->cap_hw_on) {
+			mic_hw_stop(cs);
+			cs->cap_hw_on = false;
+			mic_stats_print(cs);
+		}
+		period_us = MIC_IDLE_POLL_US;
+	} else {
+		if (!cs->cap_hw_on) {
+			/* A new recording: back to the documented format until
+			 * the probe says otherwise. */
+			cs->cap_idx = mic_idx_clamp(mic_rate_idx);
+			cs->cap_idx_auto = false;
+			cs->cap_live = MIC_LIVE_BOTH;
+			cs->cap_shift = 0;
+			cs->cap_probes = 0;
+			cs->cap_restarts = 0;
+			cs->raw_n = 0;
+			cs->rs_pos = 0;
+			cs->rs_prev = 0;
+			mic_set_in_rate(cs, mic_nominal_rate(cs->cap_idx));
+			cs->cap_dry_ticks = 0;
+			cs->cap_overruns = 0;
+			cs->cap_ring_full = 0;
+			mic_stats_reset(cs);
+			mic_hw_start(cs);
+			cs->cap_hw_on = true;
+		}
+		mic_drain(cs);
+		period_us = MIC_POLL_US;
+	}
+
+	hrtimer_forward_now(t, mic_us(period_us));
+	return HRTIMER_RESTART;
+}
+
+static int codec_init(struct ctr_csnd *cs)
+{
+	int id, rev, r2, r3;
+	u8 v;
+
+	/* The chip reset and the SPI bus belong to ctr_tsc.c; this is the
+	 * analog output path only. */
+
+	id = cdc_read(cs, CDC_0_2);
+	rev = cdc_read(cs, CDC_0_3);
+	if (id < 0 || rev < 0)
+		return -EIO;
+
+	dev_info(cs->dev, "CTR codec ID 0x%02x rev 0x%02x\n", id, rev);
+	if ((id == 0x00 && rev == 0x00) || (id == 0xFF && rev == 0xFF)) {
+		dev_err(cs->dev,
+			"codec ID/rev reads all-0x%02x -- the SPI link to the codec is not working, refusing to program it\n",
+			id);
+		return -ENODEV;
+	}
+
+	cdc_write(cs, CDC_100_67, 0x11);
+	cdc_mask(cs, CDC_101_119, 1, 1);
+	cdc_mask(cs, CDC_GPI_PIN, 0x66, 0x66);
+	cdc_write(cs, CDC_101_122, 1);		/* VREF */
+	cdc_mask(cs, CDC_100_34, 0x18, 0x18);	/* PLL  */
+
+	/* Force the speaker path rather than reading the headphone-jack GPIO. */
+	cdc_mask(cs, CDC_HEADSET, 0x20, 0x30);
+	cdc_mask(cs, CDC_100_67, 0x00, 0x80);
+	cdc_mask(cs, CDC_100_67, 0x80, 0x80);
+
+	/* Codec-side I2S dividers: line 1 = 32 kHz, and line 2 = 32 kHz too
+	 * (p100.124 bit 0 set; libn3ds clears it for 47 kHz).  N3DS_MIC_CLOCK_32K */
+	cdc_write(cs, CDC_DAC_NDAC, 0x87);
+	cdc_mask(cs, CDC_100_124, i2s2_47k ? 0 : 1, 1);
+
+	/* SoC I2S controller: both lines, with their MCLK and sample clocks. */
+	iowrite16(0, cs->i2s + I2S1_CNT);
+	iowrite16(0, cs->i2s + I2S2_CNT);
+	iowrite16(I2S1_EN | I2S1_MCLK1_16MHZ | I2S1_FREQ_32KHZ |
+		  (mic_i2s_timing ? I2S1_MIC_TIMING : 0) |
+		  I2S1_LGY_VOL(32) | I2S1_DSP_VOL(0), cs->i2s + I2S1_CNT);
+	iowrite16(I2S2_EN | I2S2_MCLK2_16MHZ |
+		  (i2s2_47k ? I2S2_FREQ_47KHZ : 0), cs->i2s + I2S2_CNT);
+	wmb();
+	dev_info(cs->dev,
+		 "I2S1_CNT = 0x%04x, I2S2_CNT = 0x%04x, p100.124 = 0x%02x -- line 2 at %s kHz (N3DS_MIC_CLOCK_32K)\n",
+		 ioread16(cs->i2s + I2S1_CNT), ioread16(cs->i2s + I2S2_CNT),
+		 cdc_read(cs, CDC_100_124) & 0xFF,
+		 i2s2_47k ? "47.61" : "32.73");
+
+	/* Output stage: power the DAC, unmute both lines, power the drivers. */
+	cdc_mask(cs, CDC_101_17, 0x10, 0x1C);
+	cdc_write(cs, CDC_100_122, 0);
+	cdc_write(cs, CDC_100_120, 0);
+	codec_power_on_dac(cs);
+	cdc_write(cs, CDC_101_10, 0xA);
+
+	cdc_mask(cs, CDC_DAC_PATH, 0xC0, 0xC0);	/* unmute DAC line 1 */
+	cdc_write(cs, CDC_DAC_VOL, 0);
+	cdc_mask(cs, CDC_100_119, 0, 0xC);	/* unmute DAC line 2 */
+
+	r2 = cdc_read(cs, CDC_0_2);
+	r3 = cdc_read(cs, CDC_0_3);
+	v = ((r2 & 0xFu) <= 1u && (((r3 & 0x70u) >> 4) <= 2u)) ? 0x3C : 0x1C;
+	cdc_write(cs, CDC_101_11, v);
+
+	cdc_write(cs, CDC_101_12, (CAL_DRIVER_GAIN_HP << 3) | 4);
+	cdc_write(cs, CDC_101_22, CAL_ANALOG_VOL_HP);
+	cdc_write(cs, CDC_101_23, CAL_ANALOG_VOL_HP);
+
+	cdc_mask(cs, CDC_101_17, 0xC0, 0xC0);	/* speaker driver */
+	cdc_write(cs, CDC_101_18, (CAL_DRIVER_GAIN_SP << 2) | 2);
+	cdc_write(cs, CDC_101_19, (CAL_DRIVER_GAIN_SP << 2) | 2);
+	cdc_write(cs, CDC_101_27, CAL_ANALOG_VOL_SP);
+	cdc_write(cs, CDC_101_28, CAL_ANALOG_VOL_SP);
+	msleep(38);
+
+	/* Read back one register we wrote, so "the writes went somewhere" is
+	 * a fact in the log and not an assumption. */
+	dev_info(cs->dev, "codec readback: p101.11 = 0x%02x (wrote 0x%02x)\n",
+		 cdc_read(cs, CDC_101_11) & 0xFF, v);
+
+	return 0;
+}
+
+/* ------------------------------------------------------------------ *
+ * N3DS_CSND_OUTPUT_REARM -- keep the analog output stage up
+ *
+ * On hardware (2026-09-30, #317) the power-on clip was heard as its first
+ * syllable and then nothing, while this driver logged the stream as having
+ * played in full with no underruns and no foreign writer.  Everything the
+ * driver can see said the samples reached CSND; the fault is past it.  The
+ * silence arrived at the loudest part of the clip, and MicTest playback later
+ * in the same boot was silent too, although AudioFlinger demonstrably wrote
+ * it here (two long streams finished after the recordings) -- that fits an
+ * output stage that went down and stayed down.
+ *
+ * So: record the output-stage registers codec_init() left, re-check them
+ * every OUTMON_MS while a stream is playing, and if a power bit that was set
+ * has cleared (or a mute bit that was clear has set), say so -- with the
+ * status registers that might say why -- and bring the stage back up.  Only
+ * bits compared against the init readback count, so a register that simply
+ * reads back differently from how it was written can never trigger a re-arm;
+ * and the re-arms are capped per boot.
+ * ------------------------------------------------------------------ */
+
+/*
+ * set:   bits codec_init() sets that must stay set (power);
+ * clear: bits it clears that must stay clear (mute);
+ * neither: diagnostic, printed but never acted on.
+ * The first OUT_MONITORED entries are re-read every OUTMON_MS while a stream
+ * plays; all of them are printed at init and at the end of each long stream.
+ */
+#define OUT_MONITORED		5
+static const struct {
+	unsigned int	reg;
+	u8		set;
+	u8		clear;
+	const char	*name;
+} out_regs[OUT_REGS] = {
+	{ CDC_101_17,	0xC0, 0x00, "p101.17" },	/* speaker driver power */
+	{ CDC_100_118,	0xC0, 0x00, "p100.118" },	/* DAC power */
+	{ CDC_100_37,	0x88, 0x00, "p100.37" },	/* DAC "up" flags */
+	{ CDC_DAC_PATH,	0xC0, 0x00, "p0.63" },		/* DAC line 1 on */
+	{ CDC_DAC_VOL,	0x00, 0x0C, "p0.64" },		/* DAC mute bits */
+	{ CDC(1, 32),	0x00, 0x00, "p1.32" },		/* class-D status (TSC2117 map) */
+	{ CDC_101_18,	0x00, 0x00, "p101.18" },	/* speaker driver gain */
+	{ CDC_101_27,	0x00, 0x00, "p101.27" },	/* speaker analog volume */
+};
+/* TSC2117-style sticky DAC/driver fault flags; read-to-clear there. */
+#define CDC_0_44		CDC(0, 44)
+
+static void ctr_csnd_out_read(struct ctr_csnd *cs, int *v, int n)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		v[i] = cdc_read(cs, out_regs[i].reg);
+}
+
+/* "p101.17=0xc0 p100.118=0xc0 ..." for the first n registers. */
+static void ctr_csnd_out_format(char *buf, size_t len, const int *v, int n)
+{
+	size_t at = 0;
+	int i;
+
+	buf[0] = '\0';
+	for (i = 0; i < n; i++)
+		at += scnprintf(buf + at, len - at, "%s%s=0x%02x",
+				i ? " " : "", out_regs[i].name, v[i] & 0xFF);
+}
+
+static void ctr_csnd_out_baseline(struct ctr_csnd *cs)
+{
+	char buf[160];
+	int i;
+
+	ctr_csnd_out_read(cs, cs->out_base, OUT_REGS);
+	cs->out_base_ok = true;
+	for (i = 0; i < OUT_REGS; i++)
+		if (cs->out_base[i] < 0)
+			cs->out_base_ok = false;
+	ctr_csnd_out_format(buf, sizeof(buf), cs->out_base, OUT_REGS);
+	dev_info(cs->dev,
+		 "output stage at init: %s p0.44=0x%02x%s (N3DS_CSND_OUTPUT_REARM); end-of-stream evidence %s (N3DS_CSND_QUIET_FINISH)\n",
+		 buf, cdc_read(cs, CDC_0_44) & 0xFF,
+		 cs->out_base_ok ? "" : " -- a read failed, monitor disabled",
+		 stream_evidence ? "every stream" : "anomalies only");
+}
+
+/*
+ * Per monitored register: the power bits that were set at init and are clear
+ * now, plus the mute bits that were clear at init and are set now.
+ */
+static bool ctr_csnd_out_lost(struct ctr_csnd *cs, const int *now, u8 *lost)
+{
+	bool any = false;
+	int i;
+
+	for (i = 0; i < OUT_MONITORED; i++) {
+		u8 base = (u8)cs->out_base[i];
+		u8 cur = (u8)now[i];
+
+		lost[i] = 0;
+		if (now[i] < 0)
+			continue;
+		lost[i] = (base & out_regs[i].set & (u8)~cur) |
+			  ((u8)~base & out_regs[i].clear & cur);
+		if (lost[i])
+			any = true;
+	}
+	return any;
+}
+
+static u64 ctr_csnd_played(struct ctr_csnd *cs);
+
+static void ctr_csnd_outmon_work(struct work_struct *work)
+{
+	struct ctr_csnd *cs = container_of(to_delayed_work(work),
+					   struct ctr_csnd, outmon);
+	int now[OUT_REGS];
+	u8 lost[OUT_MONITORED];
+	char was[160], is[160];
+
+	if (!READ_ONCE(cs->running))
+		return;
+
+	/* N3DS_CSND_HW_CURSOR: the cursor wraps every lap of the ring, so it
+	 * has to be sampled more often than once a lap even while no writer
+	 * or drain is asking.  This tick is that guarantee. */
+	mutex_lock(&cs->lock);
+	ctr_csnd_played(cs);
+	mutex_unlock(&cs->lock);
+
+	if (!cs->out_base_ok || !cs->codec_ok)
+		goto again;
+
+	ctr_csnd_out_read(cs, now, OUT_MONITORED);
+	/*
+	 * N3DS_CSND_FLAG_TRACE: p100.37 is the DAC/driver "powered" flag
+	 * register (0x88 at init, 0x99 after #319's boot sound -- bits 4 and 0
+	 * are the speaker drivers on the TSC2117 map).  Every change is kept
+	 * with its time into the stream and printed at the finish, so a clip
+	 * that goes quiet part-way shows whether the speaker driver dropped
+	 * out underneath it.
+	 */
+	if (now[2] >= 0 && cs->fl_n < ARRAY_SIZE(cs->fl_val) &&
+	    (!cs->fl_n || cs->fl_val[cs->fl_n - 1] != (u8)now[2])) {
+		cs->fl_val[cs->fl_n] = (u8)now[2];
+		cs->fl_ms[cs->fl_n] = (u32)ktime_to_ms(ktime_sub(ktime_get(),
+								 cs->t0));
+		cs->fl_n++;
+	}
+	if (ctr_csnd_out_lost(cs, now, lost)) {
+		if (cs->rearms >= OUTMON_MAX_REARMS) {
+			dev_warn_once(cs->dev,
+				      "output stage still dropping after %u re-arms; standing down\n",
+				      cs->rearms);
+			return;
+		}
+		cs->rearms++;
+		ctr_csnd_out_read(cs, now, OUT_REGS);
+		ctr_csnd_out_format(was, sizeof(was), cs->out_base, OUT_REGS);
+		ctr_csnd_out_format(is, sizeof(is), now, OUT_REGS);
+		dev_warn(cs->dev,
+			 "output stage dropped %lld ms into a stream -- re-arm %u (N3DS_CSND_OUTPUT_REARM)\n",
+			 ktime_to_ms(ktime_sub(ktime_get(), cs->t0)), cs->rearms);
+		dev_warn(cs->dev, "  init: %s\n", was);
+		dev_warn(cs->dev, "  now:  %s p0.44=0x%02x\n", is,
+			 cdc_read(cs, CDC_0_44) & 0xFF);
+
+		/* The codec_init() order: DAC, DAC path and volume, then the
+		 * speaker driver last. */
+		if (lost[1] || lost[2])
+			codec_power_on_dac(cs);
+		if (lost[3])
+			cdc_mask(cs, CDC_DAC_PATH, 0xC0, 0xC0);
+		if (lost[4])
+			cdc_mask(cs, CDC_DAC_VOL, 0x00, 0x0C);
+		if (lost[0] || lost[1] || lost[2])
+			cdc_mask(cs, CDC_101_17, 0xC0, 0xC0);
+
+		ctr_csnd_out_read(cs, now, OUT_MONITORED);
+		ctr_csnd_out_format(is, sizeof(is), now, OUT_MONITORED);
+		dev_info(cs->dev, "output stage after re-arm: %s\n", is);
+	}
+
+again:
+	if (READ_ONCE(cs->running))
+		mod_delayed_work(system_wq, &cs->outmon,
+				 msecs_to_jiffies(OUTMON_MS));
+}
+
+/*
+ * One line of evidence at the end of every long stream: the output stage as
+ * it is now against how init left it, and CSND channel 0's register block
+ * next to where the elapsed-time estimate says the play cursor is.  If a
+ * word in the block tracks the estimate, the hardware has a play cursor and
+ * ctr_csnd_played() can stop guessing; if it lags it, the audio is later
+ * than this driver believes and the drain is stopping it early.
+ */
+static u64 ctr_csnd_estimate(struct ctr_csnd *cs);
+
+static void ctr_csnd_finish_evidence(struct ctr_csnd *cs, u64 played)
+{
+	int now[OUT_REGS];
+	char is[160];
+	u32 ch[8];
+	u32 pos;
+	bool differs;
+	int i;
+
+	ctr_csnd_out_read(cs, now, OUT_REGS);
+	differs = memcmp(now, cs->out_base, sizeof(now)) != 0;
+
+	/* N3DS_CSND_QUIET_FINISH: a healthy stream says nothing. */
+	if (!stream_evidence && !differs && !cs->rearms && !cs->underruns &&
+	    !cs->dropped)
+		return;
+
+	dev_info(cs->dev,
+		 "stream finished: %llu samples (%llu ms) queued, started at %lld ms, peak %u, %u underruns (%llu ms skipped), %u foreign writes dropped (N3DS_CSND_STREAM_STATS)\n",
+		 cs->written,
+		 div_u64(cs->written * 1000, cs->rate),
+		 ktime_to_ms(cs->t0), cs->peak,
+		 cs->underruns,
+		 div_u64(cs->skipped * 1000, cs->rate),
+		 cs->dropped);
+
+	for (i = 0; i < 8; i++)
+		ch[i] = ioread32(cs->csnd + CSND_CH(CSND_CHANNEL) + i * 4);
+	div_u64_rem(played, RING_SAMPLES, &pos);
+	dev_info(cs->dev,
+		 "CSND ch0 at finish: %08x %08x %08x %08x %08x %08x %08x %08x; cursor phys 0x%08x\n",
+		 ch[0], ch[1], ch[2], ch[3], ch[4], ch[5], ch[6], ch[7],
+		 (u32)cs->ring_phys + pos * 2);
+	dev_info(cs->dev,
+		 "play cursor: hardware %llu samples, elapsed-time estimate %llu, divider trim %u/1000, %s (N3DS_CSND_HW_CURSOR)\n",
+		 cs->hw_played, ctr_csnd_estimate(cs), cs->trim ? cs->trim : 1000,
+		 (hw_cursor && !cs->hw_dead) ? "stopped by the hardware cursor" :
+					       "stopped by the estimate");
+
+	for (i = 0, pos = 0; i < (int)min_t(u32, cs->fl_n, ARRAY_SIZE(cs->fl_val)); i++)
+		pos += scnprintf(is + pos, sizeof(is) - pos, " 0x%02x@%ums",
+				 cs->fl_val[i], cs->fl_ms[i]);
+	dev_info(cs->dev, "p100.37 during the stream:%s (N3DS_CSND_FLAG_TRACE)\n",
+		 cs->fl_n ? is : " never read");
+
+	ctr_csnd_out_format(is, sizeof(is), now, OUT_REGS);
+	dev_info(cs->dev,
+		 "output stage at finish: %s p0.44=0x%02x, %u re-arms this boot -- %s init\n",
+		 is, cdc_read(cs, CDC_0_44) & 0xFF, cs->rearms,
+		 differs ? "DIFFERS from" : "same as");
+}
+
+/* ------------------------------------------------------------------ *
+ * Clocks that must be on before any of the above means anything
+ * ------------------------------------------------------------------ */
+static void ctr_csnd_clocks_on(struct ctr_csnd *cs)
+{
+	u16 spi_before = ioread16(cs->cfg11_spi);
+	u8 i2s_before = ioread8(cs->pdn_i2s);
+
+	iowrite16(CFG11_SPI_CNT_ALL, cs->cfg11_spi);
+	iowrite8(PDN_I2S_CLK2_EN, cs->pdn_i2s);
+	wmb();
+
+	dev_info(cs->dev,
+		 "CFG11_SPI_CNT 0x%04x -> 0x%04x, PDN_I2S_CNT 0x%02x -> 0x%02x\n",
+		 spi_before, ioread16(cs->cfg11_spi),
+		 i2s_before, ioread8(cs->pdn_i2s));
+}
+
+/* ------------------------------------------------------------------ *
+ * N3DS_CSND_RATE_TRIM
+ * ------------------------------------------------------------------ */
+
+/*
+ * Play silence on channel 0 for 200 ms at `rate` and return how fast the
+ * play cursor really moved, in thousandths of the nominal rate (0: the
+ * cursor could not be read).
+ */
+static u32 ctr_csnd_measure_rate(struct ctr_csnd *cs, u32 rate,
+				 u32 *consumed, s64 *us)
+{
+	u32 base = (u32)cs->ring_phys;
+	u32 a, b;
+	u64 expected;
+	ktime_t t0, t1;
+
+	memset(cs->ring, 0, RING_BYTES);
+	wmb();
+	csnd_play(cs, cs->ring_phys, RING_BYTES, rate, CH_FORMAT_PCM16, true);
+	t0 = ktime_get();
+	a = ioread32(cs->csnd + CSND_CH_SAD(CSND_CHANNEL));
+	msleep(200);
+	b = ioread32(cs->csnd + CSND_CH_SAD(CSND_CHANNEL));
+	t1 = ktime_get();
+	csnd_stop(cs);
+
+	*consumed = 0;
+	*us = ktime_us_delta(t1, t0);
+	if (a < base || a > base + RING_BYTES ||
+	    b < base || b > base + RING_BYTES || *us <= 0)
+		return 0;
+	*consumed = (((b - base) / 2) + RING_SAMPLES - ((a - base) / 2)) %
+		    RING_SAMPLES;
+	expected = div_u64((u64)*us * rate, USEC_PER_SEC);
+	return expected ? (u32)div_u64((u64)*consumed * 1000, expected) : 0;
+}
+
+/*
+ * #318's cursor readings say channel 0 consumes ~0.34x the rate the
+ * divider is programmed for.  If that is what the hardware really does,
+ * every sound is also ~3x slow and ~1.5 octaves low -- which would explain
+ * MicTest's "silent" playback: speech pitched down that far is below what
+ * the 3DS speakers reproduce.  Measure it once, with silence, before
+ * anything can open /dev/eac.  Correct the divider only if a second
+ * measurement proves the correction lands within 5% of nominal; otherwise
+ * leave it alone -- the hardware cursor keeps the drain honest either way.
+ */
+static void ctr_csnd_rate_check(struct ctr_csnd *cs)
+{
+	u32 rate = cs->rate ? cs->rate : (u32)pcm_rate;
+	u32 got, r, r2;
+	s64 us;
+
+	cs->trim = 1000;
+	if (!rate_trim) {
+		dev_info(cs->dev,
+			 "CSND divider: stock 0x3FEC3FC/%u, elapsed-time accounting -- SAD runs at 1/3 of the play rate, no trim (N3DS_CSND_NOMINAL_RATE)\n",
+			 rate);
+		return;
+	}
+	r = ctr_csnd_measure_rate(cs, rate, &got, &us);
+	dev_info(cs->dev,
+		 "CSND rate check: cursor moved %u samples in %lld us at %u Hz nominal = %u.%03ux (N3DS_CSND_RATE_TRIM)\n",
+		 got, us, rate, r / 1000, r % 1000);
+	if (!r) {
+		dev_warn(cs->dev, "CSND rate check: cursor unreadable; divider left as is\n");
+		return;
+	}
+	if (!rate_trim || (r >= 950 && r <= 1050))
+		return;
+	if (r < 150 || r > 4000) {
+		dev_warn(cs->dev, "CSND rate check: %u.%03ux is implausible; divider left as is\n",
+			 r / 1000, r % 1000);
+		return;
+	}
+
+	cs->trim = r;
+	r2 = ctr_csnd_measure_rate(cs, rate, &got, &us);
+	if (r2 >= 950 && r2 <= 1050) {
+		dev_info(cs->dev,
+			 "CSND rate check: divider trimmed to %u/1000 -- channel now runs %u.%03ux nominal (N3DS_CSND_RATE_TRIM)\n",
+			 cs->trim, r2 / 1000, r2 % 1000);
+	} else {
+		dev_warn(cs->dev,
+			 "CSND rate check: trimming to %u/1000 gave %u.%03ux, not 1.000x -- reverted (N3DS_CSND_RATE_TRIM)\n",
+			 cs->trim, r2 / 1000, r2 % 1000);
+		cs->trim = 1000;
+	}
+	memset(cs->ring, 0, RING_BYTES);
+}
+
+/* ------------------------------------------------------------------ *
+ * Boot tone
+ * ------------------------------------------------------------------ */
+
+/*
+ * A rising three-note arpeggio rather than a single beep: three distinct
+ * pitches are unmistakably "the driver did this" where one tone could be
+ * anything, and if only part of it comes out that is itself information.
+ */
+static u32 ctr_csnd_render_chime(struct ctr_csnd *cs, u32 rate)
+{
+	static const u32 mul[3] = { 100, 126, 150 };	/* root, ~M3, P5 */
+	s16 *buf = cs->ring;
+	u32 per_note = rate / 6;			/* ~167 ms each */
+	u32 n = 0;
+	u32 note, i;
+
+	if (per_note * 3 > RING_SAMPLES)
+		per_note = RING_SAMPLES / 3;
+
+	for (note = 0; note < 3; note++) {
+		u32 freq = (u32)tone_hz * mul[note] / 100;
+		u32 step = (freq << 16) / rate;
+		u32 phase = 0;
+
+		for (i = 0; i < per_note; i++) {
+			/* Square wave, with a linear fade-out over the last
+			 * eighth of the note so it does not click. */
+			s16 amp = 0x2800;
+
+			if (i > per_note - per_note / 8)
+				amp = (s16)((u32)amp * (per_note - i) /
+					    (per_note / 8));
+			buf[n++] = (phase & 0x8000) ? amp : (s16)-amp;
+			phase = (phase + step) & 0xFFFF;
+		}
+	}
+	return n;
+}
+
+/* ------------------------------------------------------------------ *
+ * /dev/eac
+ * ------------------------------------------------------------------ */
+
+static u32 ctr_csnd_ms_to_samples(struct ctr_csnd *cs, int ms, u32 floor_ms);
+
+/* What elapsed time and the programmed rate say CSND has consumed. */
+static u64 ctr_csnd_estimate(struct ctr_csnd *cs)
+{
+	s64 ns;
+
+	if (!cs->running)
+		return 0;
+	ns = ktime_to_ns(ktime_sub(ktime_get(), cs->t0));
+	if (ns < 0)
+		return 0;
+	return div_u64((u64)ns * cs->rate, NSEC_PER_SEC);
+}
+
+/*
+ * N3DS_CSND_HW_CURSOR -- OFF by default since #320, see hw_cursor.  The
+ * reading below was wrong: SAD runs at one third of the real rate, so the
+ * ~0.34x was SAD's own pace, not the channel's.  #319 proved it -- trimmed
+ * to 334/1000, SAD read 1.003x nominal and the speaker played 3x fast.
+ *
+ * GBATEK documents no play-position register, so this driver used to take
+ * the play cursor from the estimate above.  Build #318 read channel 0's
+ * block at the end of every stream, and SAD (+0x0c) is live: it sat inside
+ * the ring every time, and on all four streams of that boot it had covered
+ * only ~0.34x what the estimate claimed.  The power-on clip had played 714 ms
+ * -- "DRO-" -- when the estimate called it finished and the drain stopped the
+ * channel.  Nothing else was cutting it.
+ *
+ * So SAD is the cursor now: it is sampled on every write, drain and outmon
+ * tick (well inside one lap of the ring), and the laps are counted here.  If
+ * it ever reads outside the ring, or stops moving while the clock says audio
+ * should be flowing, the estimate takes over again for the rest of the boot
+ * -- a wedged register must not wedge every writer.
+ */
+static void ctr_csnd_hw_sample(struct ctr_csnd *cs)
+{
+	u32 base = (u32)cs->ring_phys;
+	u32 sad = ioread32(cs->csnd + CSND_CH_SAD(CSND_CHANNEL));
+	ktime_t now = ktime_get();
+	u32 off;
+
+	if (sad < base || sad > base + RING_BYTES) {
+		cs->hw_dead = true;
+		dev_warn(cs->dev,
+			 "CSND ch0 SAD reads 0x%08x, outside the ring at 0x%08x -- accounting by elapsed time from now on (N3DS_CSND_HW_CURSOR)\n",
+			 sad, base);
+		return;
+	}
+	off = ((sad - base) / 2) % RING_SAMPLES;
+	if (off != cs->hw_last) {
+		cs->hw_played += (off + RING_SAMPLES - cs->hw_last) %
+				 RING_SAMPLES;
+		cs->hw_last = off;
+		cs->hw_moved = now;
+	} else if (ktime_ms_delta(now, cs->hw_moved) > 500) {
+		cs->hw_dead = true;
+		dev_warn(cs->dev,
+			 "CSND ch0 SAD stuck at 0x%08x for %lld ms of playback -- accounting by elapsed time from now on (N3DS_CSND_HW_CURSOR)\n",
+			 sad, ktime_ms_delta(now, cs->hw_moved));
+	}
+}
+
+/* How many mono samples CSND has consumed since playback started. */
+static u64 ctr_csnd_played(struct ctr_csnd *cs)
+{
+	if (!cs->running)
+		return 0;
+	if (hw_cursor && !cs->hw_dead) {
+		ctr_csnd_hw_sample(cs);
+		if (!cs->hw_dead)
+			return cs->hw_played;
+	}
+	return ctr_csnd_estimate(cs);
+}
+
+/*
+ * Keep a band of silence ahead of the last written sample, so that when the
+ * channel runs past the end of a stream -- which it does for the moments
+ * between the cursor crossing the last sample and the drain stopping it --
+ * it plays silence rather than whatever was in that part of the ring one
+ * lap ago.  Never touches a sample that has not played yet.
+ */
+#define SILENCE_GUARD_MS	300
+
+static void ctr_csnd_zero_ahead(struct ctr_csnd *cs, u64 played)
+{
+	u64 want = cs->written + ctr_csnd_ms_to_samples(cs, SILENCE_GUARD_MS, 1);
+	u64 limit = played + RING_SAMPLES - 1;	/* last slot not still due */
+	u64 from = max(cs->zeroed_to, cs->written);
+	u32 pos, n, first;
+
+	if (want > limit)
+		want = limit;
+	if (from >= want)
+		return;
+	n = (u32)(want - from);
+	div_u64_rem(from, RING_SAMPLES, &pos);
+	first = min_t(u32, n, RING_SAMPLES - pos);
+	memset((s16 *)cs->ring + pos, 0, first * sizeof(s16));
+	if (n > first)
+		memset(cs->ring, 0, (n - first) * sizeof(s16));
+	cs->zeroed_to = want;
+}
+
+/*
+ * Convert a millisecond budget into samples, clamped so that a nonsense
+ * module parameter cannot exceed the physical ring or stall the writer.
+ */
+static u32 ctr_csnd_ms_to_samples(struct ctr_csnd *cs, int ms, u32 floor_ms)
+{
+	u32 rate = cs->rate ? cs->rate : 44100;
+	u64 n;
+
+	if (ms < (int)floor_ms)
+		ms = (int)floor_ms;
+	n = div_u64((u64)rate * (u32)ms, 1000);
+	if (n > RING_SAMPLES - 1)
+		n = RING_SAMPLES - 1;
+	return (u32)n;
+}
+
+/* The write-ahead budget: the audible output latency of this driver. */
+static u32 ctr_csnd_lead(struct ctr_csnd *cs)
+{
+	return ctr_csnd_ms_to_samples(cs, lead_ms, 20);
+}
+
+/* Never larger than the lead, or the channel could not start. */
+static u32 ctr_csnd_prefill(struct ctr_csnd *cs)
+{
+	u32 lead = ctr_csnd_lead(cs);
+	u32 pre = ctr_csnd_ms_to_samples(cs, prefill_ms, 5);
+
+	return pre > lead ? lead : pre;
+}
+
+static u32 ctr_csnd_free(struct ctr_csnd *cs)
+{
+	u32 lead = ctr_csnd_lead(cs);
+	u64 played;
+	u64 queued;
+
+	if (!cs->running) {
+		/* Not started yet: accept up to the lead, which is more than
+		 * the prefill, so the write that crosses the prefill mark is
+		 * never the one that blocks. */
+		if (cs->written >= lead)
+			return 0;
+		return lead - (u32)cs->written;
+	}
+
+	played = ctr_csnd_played(cs);
+	if (played >= cs->written) {
+		/*
+		 * N3DS_CSND_UNDERRUN_RESYNC: the writer fell behind and CSND
+		 * is looping over samples that have already been heard.
+		 *
+		 * This used to return the full lead and carry on writing at
+		 * the old cursor -- which is now *behind* the play position,
+		 * so everything written after an underrun landed in the part
+		 * of the ring CSND had just left.  None of it was heard until
+		 * the channel came round the 2.97 s ring again, and the drain,
+		 * which believed it had all played, usually stopped the
+		 * channel first.  One SD stall mid-clip silently deleted the
+		 * rest of the clip.
+		 *
+		 * Jump the write cursor to one prefill ahead of the play
+		 * position instead, and silence the slots CSND will cross
+		 * before it gets there, so the glitch is a short gap and the
+		 * audio after it is still heard.
+		 */
+		u32 pre = ctr_csnd_prefill(cs);
+		u64 target = played + pre;
+		u32 pos, n;
+
+		cs->underruns++;
+		cs->skipped += target - cs->written;
+		div_u64_rem(played, RING_SAMPLES, &pos);
+		n = min_t(u32, pre, RING_SAMPLES - pos);
+		memset((s16 *)cs->ring + pos, 0, n * sizeof(s16));
+		if (pre > n)
+			memset(cs->ring, 0, (pre - n) * sizeof(s16));
+		cs->written = target;
+		div_u64_rem(target, RING_SAMPLES, &cs->wpos);
+		wmb(); /* the silence must land before CSND reaches it */
+		return lead - pre;
+	}
+	queued = cs->written - played;
+	if (queued >= lead)
+		return 0;
+	return lead - (u32)queued;
+}
+
+static void ctr_csnd_start_locked(struct ctr_csnd *cs)
+{
+	cs->t0 = ktime_get();
+	cs->hw_last = 0;		/* csnd_play() starts at ring offset 0 */
+	cs->hw_played = 0;
+	cs->hw_moved = cs->t0;
+	cs->fl_n = 0;
+	cs->running = true;
+	csnd_play(cs, cs->ring_phys, RING_BYTES, cs->rate, CH_FORMAT_PCM16,
+		  true);
+	/* N3DS_CSND_OUTPUT_REARM: check the output stage now -- a stream that
+	 * starts on a speaker driver the previous one lost is otherwise
+	 * silent from its first sample -- and then for as long as it runs. */
+	mod_delayed_work(system_wq, &cs->outmon, 0);
+	dev_dbg(cs->dev, "stream started at %u Hz after %llu samples (%u ms lead)\n",
+		cs->rate, cs->written, lead_ms);
+}
+
+/*
+ * Return the ring to the state a fresh stream expects, and release the claim
+ * on the channel.  Never call this on a running channel without stopping it
+ * first: CSND would read the memset.
+ */
+static void ctr_csnd_reset_locked(struct ctr_csnd *cs)
+{
+	cs->written = 0;
+	cs->wpos = 0;
+	cs->owner = NULL;
+	cs->owner_closed = false;
+	cs->dropped = 0;
+	cs->carry_n = 0;
+	/* N3DS_CSND_STREAM_STATS: per stream.  These used to accumulate for
+	 * the whole boot, so the power-on clip's line reported every glitch
+	 * any earlier writer ever had. */
+	cs->underruns = 0;
+	cs->skipped = 0;
+	cs->peak = 0;
+	cs->zeroed_to = 0;
+	memset(cs->ring, 0, RING_BYTES);
+}
+
+static void ctr_csnd_stop_locked(struct ctr_csnd *cs)
+{
+	u64 played;
+
+	if (!cs->running)
+		return;
+
+	/*
+	 * N3DS_BOOT_SOUND: the only legitimate stop is one where every
+	 * queued sample has been played.  Anything else is a stream being
+	 * cut off, which is exactly the fault that took three kernels to
+	 * find -- so it gets a line naming the caller rather than silently
+	 * shortening the audio.  This cannot spam the log: it fires only
+	 * on a genuine truncation, and after this patch nothing in the
+	 * driver does that on the normal path.
+	 */
+	played = ctr_csnd_played(cs);
+	if (played < cs->written)
+		dev_warn(cs->dev,
+			 "stream cut off by %s: %llu of %llu samples played (%llu ms short)\n",
+			 current->comm, played, cs->written,
+			 cs->rate ? div_u64((cs->written - played) * 1000,
+					    cs->rate) : 0);
+
+	csnd_stop(cs);
+	cs->running = false;
+	ctr_csnd_reset_locked(cs);
+}
+
+static void ctr_csnd_arm_drain(struct ctr_csnd *cs);
+
+static void ctr_csnd_drain_work(struct work_struct *work)
+{
+	struct ctr_csnd *cs = container_of(to_delayed_work(work),
+					   struct ctr_csnd, drain);
+	u64 played;
+
+	mutex_lock(&cs->lock);
+	played = ctr_csnd_played(cs);
+	/* N3DS_CSND_HW_CURSOR: stop once the cursor is STOP_TAIL_MS into the
+	 * silence after the last sample, so the stream ends by itself and the
+	 * stop only ever cuts silence. */
+	if (cs->running && played < cs->written + ctr_csnd_ms_to_samples(cs, STOP_TAIL_MS, 1)) {
+		ctr_csnd_zero_ahead(cs, played);
+		/*
+		 * N3DS_BOOT_SOUND: fired early.  ctr_csnd_played() is an
+		 * estimate from the monotonic clock, so it can read short of
+		 * what was queued; the timer is also only jiffy-accurate.
+		 * This used to fall through and return, which left the
+		 * channel looping over the ring with nothing scheduled to
+		 * stop it -- and left the claim standing forever.  Re-arm
+		 * for what is left instead.
+		 */
+		ctr_csnd_arm_drain(cs);
+		mutex_unlock(&cs->lock);
+		return;
+	}
+	if (cs->running) {
+		/*
+		 * Only streams long enough to be the power-on clip rather
+		 * than a keytone are examined, and a healthy one logs nothing
+		 * (N3DS_CSND_QUIET_FINISH) -- a clip that was cut off still
+		 * reports itself, without every UI sound becoming a log entry.
+		 */
+		if (cs->rate && cs->written >= cs->rate)
+			ctr_csnd_finish_evidence(cs, played);
+		ctr_csnd_stop_locked(cs);
+	} else if (cs->owner) {
+		/* Claimed but never started: a writer that stopped short of
+		 * the prefill and walked away must not hold the channel
+		 * against everyone else for the rest of the boot. */
+		ctr_csnd_reset_locked(cs);
+	}
+	mutex_unlock(&cs->lock);
+	wake_up_interruptible(&cs->wq);
+}
+
+/* Arm the stop for just after the last queued sample should have played. */
+static void ctr_csnd_arm_drain(struct ctr_csnd *cs)
+{
+	u64 played = ctr_csnd_played(cs);
+	u64 remain = cs->written > played ? cs->written - played : 0;
+	unsigned long ms = DRAIN_MARGIN_MS;
+
+	if (cs->rate)
+		ms += div_u64(remain * 1000, cs->rate);
+	mod_delayed_work(system_wq, &cs->drain, msecs_to_jiffies(ms));
+}
+
+/*
+ * Accept 16-bit little-endian stereo PCM -- the format Android's
+ * AudioHardwareGeneric writes to /dev/eac -- and fold it to the mono stream
+ * CSND channel 0 plays into both speakers.
+ */
+static ssize_t ctr_csnd_dev_write(struct file *filp, const char __user *ubuf,
+				  size_t count, loff_t *ppos)
+{
+	struct ctr_csnd *cs = container_of(filp->private_data,
+					   struct ctr_csnd, misc);
+	size_t done = 0;
+	s16 frame[64];	/* 32 stereo frames per bounce */
+	u8 *fb = (u8 *)frame;
+	unsigned int spins = 0;
+
+	if (!cs->codec_ok)
+		return -ENODEV;
+	/*
+	 * N3DS_CSND_WHOLE_WRITES: every byte of every write() is consumed.
+	 * This used to round count down to whole frames and return 0 for
+	 * anything shorter.  glibc stdio treats a 0 return as "try again", and
+	 * busybox head flushes 1024 + 1 bytes per writev(), so #318/#319's
+	 * silent tail wrote one 1024-byte chunk and then spun on the odd byte
+	 * forever -- bootsound.sh never finished.  A frame split across writes
+	 * is carried over to the next one instead.
+	 */
+	if (!count)
+		return 0;
+
+	/*
+	 * N3DS_BOOT_SOUND: while another opener owns the channel, drop this
+	 * audio rather than interleaving it into their ring -- there is one
+	 * ring and folding a second writer into it corrupts both streams.
+	 * Pace the drop at real time so the caller neither spins nor builds a
+	 * backlog of stale buffers to dump the instant the channel frees up.
+	 * In practice the only writer this ever affects is AudioFlinger's
+	 * mixer thread during the power-on sound, and what it has to say for
+	 * those two seconds is silence.
+	 */
+	mutex_lock(&cs->lock);
+	if (cs->owner && (cs->owner != filp || cs->owner_closed)) {
+		u32 rate = cs->rate ? cs->rate : 44100;
+		unsigned long ms = (unsigned long)div_u64((u64)(count / 4) *
+							  1000, rate);
+
+		cs->dropped++;
+		mutex_unlock(&cs->lock);
+		if (ms > 200)
+			ms = 200;
+		if (ms && !(filp->f_flags & O_NONBLOCK))
+			msleep(ms);
+		return count;
+	}
+	cs->owner = filp;
+	mutex_unlock(&cs->lock);
+
+	while (done < count) {
+		size_t have, take, bytes;
+		u32 frames;
+		u32 space;
+		u32 i;
+
+		/* Per chunk: a slow but moving cursor must not use up the
+		 * give-up budget of the whole write() in its first few
+		 * chunks and then overwrite unplayed audio. */
+		spins = 0;
+
+		mutex_lock(&cs->lock);
+		have = min_t(u32, cs->carry_n, 3);
+		memcpy(fb, cs->carry, have);
+		mutex_unlock(&cs->lock);
+		take = min(count - done, sizeof(frame) - have);
+		if (copy_from_user(fb + have, ubuf + done, take))
+			return done ? done : -EFAULT;
+		bytes = have + take;
+		frames = bytes / 4;
+
+		mutex_lock(&cs->lock);
+		if (!frames) {
+			/* Less than a frame in all: keep it for next time.
+			 * The drain is armed so a claim this made still
+			 * expires if the writer never sends the rest. */
+			memcpy(cs->carry, fb, bytes);
+			cs->carry_n = bytes;
+			ctr_csnd_arm_drain(cs);
+			mutex_unlock(&cs->lock);
+			done += take;
+			continue;
+		}
+
+		/*
+		 * N3DS_AUDIO_LATENCY: block for exactly as long as the ring
+		 * needs to drain, and no longer.
+		 *
+		 * The old code slept on cs->wq with a one-second timeout.
+		 * Nothing ever wakes that queue when the play cursor advances
+		 * -- only the end-of-stream drain work does -- so every wait
+		 * ran to the timeout.  That was invisible while the lead was
+		 * the whole 2.97 s ring (the writer practically never filled
+		 * it); with a 200 ms lead the writer fills it on every sound,
+		 * and a wq that is never signalled would turn playback into a
+		 * stutter.
+		 *
+		 * ctr_csnd_played() is derived from the monotonic clock, not
+		 * from an interrupt, so the drain time is known in closed
+		 * form: sleeping it is both exact and cheaper than a wakeup.
+		 */
+		space = ctr_csnd_free(cs);
+		while (space < frames) {
+			u32 need = frames - space;
+			unsigned long us;
+
+			mutex_unlock(&cs->lock);
+			if (filp->f_flags & O_NONBLOCK)
+				return done ? done : -EAGAIN;
+
+			us = (unsigned long)div_u64((u64)need * 1000000 +
+						    cs->rate - 1, cs->rate);
+			/* One bounce is 64 frames, 1.5 ms at 44.1 kHz.  Round
+			 * very short waits up so this cannot become a spin,
+			 * and cap long ones so a wedged play cursor is still
+			 * reported as a glitch rather than hanging write(). */
+			if (us < 500)
+				us = 500;
+			if (us > 50000)
+				us = 50000;
+			usleep_range(us, us + us / 4);
+			if (signal_pending(current))
+				return done ? done : -ERESTARTSYS;
+
+			mutex_lock(&cs->lock);
+			space = ctr_csnd_free(cs);
+			if (space < frames && !cs->running) {
+				/* Cannot drain what is not playing: start now
+				 * and take the short buffer rather than
+				 * deadlock against our own prefill. */
+				ctr_csnd_start_locked(cs);
+				space = ctr_csnd_free(cs);
+			}
+			if (space < frames && ++spins > 40) {
+				dev_dbg(cs->dev,
+					"write gave up waiting for %u frames\n",
+					frames);
+				break;	/* take the glitch */
+			}
+		}
+
+		for (i = 0; i < frames; i++) {
+			s32 mono = ((s32)frame[i * 2] + (s32)frame[i * 2 + 1]) / 2;
+			u32 mag = (u32)(mono < 0 ? -mono : mono);
+
+			if (mag > cs->peak)
+				cs->peak = mag;
+			((s16 *)cs->ring)[cs->wpos] = (s16)mono;
+			cs->wpos = (cs->wpos + 1) % RING_SAMPLES;
+		}
+		cs->written += frames;
+		/* Only the last chunk of a write() can end mid-frame. */
+		memcpy(cs->carry, fb + frames * 4, bytes - frames * 4);
+		cs->carry_n = bytes - frames * 4;
+		ctr_csnd_zero_ahead(cs, ctr_csnd_played(cs));
+		/* CSND reads physical memory; the ring is dma_alloc_coherent
+		 * so there is no cache to flush, but the stores must be
+		 * visible before the channel is told about them. */
+		wmb();
+
+		if (!cs->running && cs->written >= ctr_csnd_prefill(cs))
+			ctr_csnd_start_locked(cs);
+		/* Armed even before the channel starts: the claim taken above
+		 * has to expire on its own if this writer never reaches the
+		 * prefill.  ctr_csnd_drain_work() releases it. */
+		ctr_csnd_arm_drain(cs);
+
+		mutex_unlock(&cs->lock);
+		done += take;
+	}
+
+	return done;
+}
+
+static int ctr_csnd_dev_open(struct inode *inode, struct file *filp)
+{
+	struct ctr_csnd *cs = container_of(filp->private_data,
+					   struct ctr_csnd, misc);
+
+	mutex_lock(&cs->lock);
+	/*
+	 * N3DS_BOOT_SOUND: only an unclaimed channel may be reset here.  The
+	 * unconditional stop this used to do is right for the sole-opener case
+	 * and catastrophic otherwise -- see the owner field in struct
+	 * ctr_csnd.  An open is not a claim; the first write is.
+	 */
+	if (!cs->owner && !cs->running) {
+		ctr_csnd_reset_locked(cs);
+		cs->rate = pcm_rate;
+	}
+	mutex_unlock(&cs->lock);
+	return 0;
+}
+
+static int ctr_csnd_dev_release(struct inode *inode, struct file *filp)
+{
+	struct ctr_csnd *cs = container_of(filp->private_data,
+					   struct ctr_csnd, misc);
+
+	mutex_lock(&cs->lock);
+	if (cs->owner == filp && !cs->owner_closed) {
+		if (!cs->running || ctr_csnd_played(cs) >= cs->written) {
+			/* Nothing left to hear -- wrote less than the
+			 * prefill and gave up, or it has all played out.
+			 * Hand the channel straight back instead of making
+			 * the next writer wait out a drain that is over. */
+			ctr_csnd_stop_locked(cs);
+			ctr_csnd_reset_locked(cs);
+		} else {
+			/*
+			 * N3DS_BOOT_SOUND: the writer is finished but the
+			 * DMA is not.  `cat` closes the moment the file is
+			 * written, roughly a second before the clip has
+			 * been heard, and everything the claim protects
+			 * would have ended there.  Keep the claim until the
+			 * last queued sample has played -- marked closed,
+			 * so no reopened file can inherit it by landing on
+			 * the same slab address.
+			 */
+			cs->owner_closed = true;
+		}
+	}
+	ctr_csnd_arm_drain(cs);
+	mutex_unlock(&cs->lock);
+
+	mutex_lock(&cs->cap_lock);
+	if (cs->cap_on) {
+		cs->cap_on = false;
+		wake_up(&cs->cap_wq);	/* N3DS_MIC_FULL_READS: a sleeping read() */
+		/* N3DS_MIC_REAL: stop the timer before touching MIC_CNT -- while
+		 * it runs it is the only writer of that register.  It busy-waits
+		 * rather than sleeping, and mic_tick() never takes cap_lock, so
+		 * cancelling under the mutex cannot deadlock. */
+		hrtimer_cancel(&cs->cap_timer);
+		mic_hw_stop(cs);
+		cs->cap_hw_on = false;
+		if (cs->cap_overruns || cs->cap_ring_full || cs->cap_underruns)
+			dev_info(cs->dev,
+				 "capture stopped: %u FIFO overruns, %u ring-full drops, %u samples padded\n",
+				 cs->cap_overruns, cs->cap_ring_full,
+				 cs->cap_underruns);
+		cs->cap_overruns = 0;
+		cs->cap_ring_full = 0;
+		cs->cap_underruns = 0;
+	}
+	mutex_unlock(&cs->cap_lock);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ *
+ * N3DS_MIC_CAPTURE -- input path
+ *
+ * The format AudioStreamInGeneric fixes -- 8000 Hz, mono, signed 16-bit LE,
+ * 320 bytes per read -- is CAP_RATE / CAP_BYTES_PER_SAMPLE, defined beside
+ * the MIC register map because mic_drain()'s resampler needs CAP_RATE.
+ * ------------------------------------------------------------------ */
+
+/* Samples the timer has queued that read() has not taken yet. */
+static u32 cap_queued(struct ctr_csnd *cs)
+{
+	return smp_load_acquire(&cs->cap_head) - READ_ONCE(cs->cap_tail);
+}
+
+/* When, by the monotonic clock, the n-th sample of this recording is due. */
+static ktime_t cap_due(struct ctr_csnd *cs, u64 n)
+{
+	return ktime_add_ns(cs->cap_t0, div_u64(n * NSEC_PER_SEC, CAP_RATE));
+}
+
+/*
+ * Fill n mono samples from the ring the capture timer is feeding.
+ *
+ * Underrun is padded with silence rather than short-read: AudioFlinger's
+ * RecordThread takes any non-negative count as a full buffer, so a short
+ * read hands it stale memory.  read() waits for the ring first, so a pad
+ * here only happens on the dead-man path (N3DS_MIC_FULL_READS).
+ */
+static void cap_fill(struct ctr_csnd *cs, s16 *dst, u32 n)
+{
+	u32 tail, head, have, i;
+
+	if (!cs->mic || !cs->cap_ring) {
+		if (!cs->cap_warned) {
+			cs->cap_warned = true;
+			dev_warn(cs->dev,
+				 "capture: MIC block at 0x%08x is not mapped; "
+				 "delivering paced silence at %u Hz mono\n",
+				 MIC_BASE, CAP_RATE);
+		}
+		memset(dst, 0, (size_t)n * CAP_BYTES_PER_SAMPLE);
+		return;
+	}
+
+	if (!cs->cap_warned) {
+		cs->cap_warned = true;
+		dev_info(cs->dev,
+			 "capture: MIC block documented at %u Hz (N3DS_MIC_PROBE measures it), resampled to %u Hz mono, "
+			 "whole-buffer reads (N3DS_MIC_FULL_READS) (MIC_CNT = 0x%04x)\n",
+			 mic_nominal_rate(mic_rate_idx), CAP_RATE,
+			 ioread16(cs->mic + MIC_CNT));
+	}
+
+	tail = cs->cap_tail;
+	head = smp_load_acquire(&cs->cap_head);
+	have = head - tail;
+	if (have > n)
+		have = n;
+
+	for (i = 0; i < have; i++)
+		dst[i] = cs->cap_ring[(tail + i) & CAP_RING_MASK];
+
+	smp_store_release(&cs->cap_tail, tail + have);
+
+	if (have < n) {
+		cs->cap_underruns += n - have;
+		memset(dst + have, 0,
+		       (size_t)(n - have) * CAP_BYTES_PER_SAMPLE);
+	}
+}
+
+static ssize_t ctr_csnd_dev_read(struct file *filp, char __user *ubuf,
+				 size_t count, loff_t *ppos)
+{
+	struct ctr_csnd *cs = container_of(filp->private_data,
+					   struct ctr_csnd, misc);
+	u32 want, avail;
+	ktime_t deadline;
+	s64 left_us;
+	long woke;
+	s16 *buf;
+	ssize_t ret;
+
+	if (count < CAP_BYTES_PER_SAMPLE)
+		return -EINVAL;
+
+	want = (u32)min_t(size_t, count / CAP_BYTES_PER_SAMPLE, CAP_READ_MAX);
+
+	mutex_lock(&cs->cap_lock);
+
+	if (!cs->cap_on) {
+		cs->cap_on = true;
+		codec_power_on_adc(cs);
+		/*
+		 * N3DS_MIC_CLOCK_AFTER_FRONTEND: the clock starts once the front
+		 * end is up.  #314 started it first, while the front end took
+		 * ~10 s over the broken SPI wake (N3DS_SPI_WAKE), so the first
+		 * read() owed ten seconds of samples the ring never held and
+		 * padded every one of them with zeros.
+		 */
+		cs->cap_t0 = ktime_get();
+		cs->cap_delivered = 0;
+		cs->cap_underruns = 0;
+		cs->cap_starved = false;
+		/* N3DS_MIC_REAL: the timer owns the block from here until
+		 * release().  It idles itself out when nobody reads. */
+		WRITE_ONCE(cs->cap_last_read, jiffies);
+		hrtimer_start(&cs->cap_timer, mic_us(MIC_POLL_US),
+			      HRTIMER_MODE_REL);
+	} else if (time_after(jiffies,
+			      cs->cap_last_read + MIC_IDLE_JIFFIES)) {
+		/*
+		 * N3DS_MIC_REAL: AudioHardwareGeneric keeps one fd open for the
+		 * life of mediaserver, so release() is not the end of a
+		 * recording -- a gap in read() is.  Restart the clock and throw
+		 * away whatever the ring still holds, or the first buffer of
+		 * every recording after the first is the tail of the one before.
+		 */
+		cs->cap_t0 = ktime_get();
+		cs->cap_delivered = 0;
+		cs->cap_underruns = 0;
+		cs->cap_starved = false;
+		smp_store_release(&cs->cap_tail,
+				  smp_load_acquire(&cs->cap_head));
+	}
+	WRITE_ONCE(cs->cap_last_read, jiffies);
+
+	/*
+	 * N3DS_MIC_FULL_READS: hand back exactly what was asked for, every time.
+	 *
+	 * Eclair's RecordThread ignores the count: any read() >= 0 is taken as a
+	 * full mInputBytes buffer (AudioFlinger.cpp, RecordThread::threadLoop).
+	 * #315 paced reads against the clock and returned whatever had come due
+	 * since its last 2-4 ms nap -- ~20 samples -- which AudioFlinger counted
+	 * as 160.  On hardware MicTest logged a "second" of audio every 100 ms
+	 * and 94% of the recording was stale buffer: the static.
+	 *
+	 * So the ring is the clock: sleep until it holds the whole buffer.  The
+	 * monotonic clock is only the dead-man -- if the block stops producing,
+	 * pad with silence once the buffer is MIC_READ_GRACE_MS overdue, so a
+	 * recorder still gets a real-time stream instead of a hang.
+	 */
+	deadline = ktime_add_ms(cap_due(cs, cs->cap_delivered + want),
+				MIC_READ_GRACE_MS);
+	WRITE_ONCE(cs->cap_want, want);
+	while (cap_queued(cs) < want) {
+		left_us = ktime_us_delta(deadline, ktime_get());
+		if (left_us <= 0)
+			break;		/* dead-man: pad below */
+
+		mutex_unlock(&cs->cap_lock);
+		if (filp->f_flags & O_NONBLOCK)
+			return -EAGAIN;
+		woke = wait_event_interruptible_timeout(cs->cap_wq,
+				cap_queued(cs) >= want || !READ_ONCE(cs->cap_on),
+				usecs_to_jiffies((u32)min_t(s64, left_us,
+							    USEC_PER_SEC)) ?: 1);
+		if (woke < 0)
+			return woke;	/* -ERESTARTSYS */
+		mutex_lock(&cs->cap_lock);
+		if (!cs->cap_on) {	/* released under us */
+			mutex_unlock(&cs->cap_lock);
+			return 0;
+		}
+		WRITE_ONCE(cs->cap_last_read, jiffies);
+	}
+
+	avail = want;
+	if (cap_queued(cs) >= want) {
+		/* The block set the pace, not the clock: re-anchor the clock to
+		 * it, so the dead-man deadline follows the block's own rate
+		 * instead of drifting away from it over a long recording. */
+		cs->cap_t0 = ktime_sub_ns(ktime_get(),
+			div_u64((cs->cap_delivered + want) * NSEC_PER_SEC,
+				CAP_RATE));
+	} else if (!cs->cap_starved) {
+		cs->cap_starved = true;
+		dev_warn(cs->dev,
+			 "mic: ring %u samples short of a %u-sample read, %d ms overdue -- padding with silence (N3DS_MIC_FULL_READS)\n",
+			 want - cap_queued(cs), want, MIC_READ_GRACE_MS);
+	}
+
+	buf = kmalloc((size_t)avail * CAP_BYTES_PER_SAMPLE, GFP_KERNEL);
+	if (!buf) {
+		mutex_unlock(&cs->cap_lock);
+		return -ENOMEM;
+	}
+
+	cap_fill(cs, buf, avail);
+	cs->cap_delivered += avail;
+
+	mutex_unlock(&cs->cap_lock);
+
+	if (copy_to_user(ubuf, buf, (size_t)avail * CAP_BYTES_PER_SAMPLE))
+		ret = -EFAULT;
+	else
+		ret = (ssize_t)avail * CAP_BYTES_PER_SAMPLE;
+
+	kfree(buf);
+	return ret;
+}
+
+static const struct file_operations ctr_csnd_fops = {
+	.owner		= THIS_MODULE,
+	.open		= ctr_csnd_dev_open,
+	.release	= ctr_csnd_dev_release,
+	.write		= ctr_csnd_dev_write,
+	.read		= ctr_csnd_dev_read,
+	.llseek		= no_llseek,
+};
+
+/* ------------------------------------------------------------------ *
+ * Probe
+ * ------------------------------------------------------------------ */
+
+static struct regmap *ctr_csnd_find_codec(struct ctr_csnd *cs)
+{
+	struct device_node *np;
+	struct device *cdev;
+	struct regmap *map;
+
+	np = of_parse_phandle(cs->dev->of_node, "nintendo,codec", 0);
+	if (!np) {
+		dev_err(cs->dev, "no nintendo,codec phandle\n");
+		return ERR_PTR(-EINVAL);
+	}
+
+	cdev = bus_find_device_by_of_node(&spi_bus_type, np);
+	of_node_put(np);
+	if (!cdev) {
+		/*
+		 * Nothing orders this driver after ctr_tsc.c, and on hardware
+		 * the race is real -- the same one ctr_cam.c lost against the
+		 * i2c adapter for two months.  Defer; the driver core will
+		 * come back once the codec registers.
+		 */
+		dev_info(cs->dev, "codec not registered yet; deferring probe\n");
+		return ERR_PTR(-EPROBE_DEFER);
+	}
+
+	map = dev_get_regmap(cdev, NULL);
+	put_device(cdev);
+	if (!map) {
+		dev_info(cs->dev, "codec has no regmap yet; deferring probe\n");
+		return ERR_PTR(-EPROBE_DEFER);
+	}
+	return map;
+}
+
+static void __iomem *ctr_csnd_map(struct platform_device *pdev, int idx)
+{
+	struct resource *res = platform_get_resource(pdev, IORESOURCE_MEM, idx);
+
+	if (!res)
+		return IOMEM_ERR_PTR(-ENODEV);
+	/* devm_ioremap, not devm_ioremap_resource: PDN and CFG11 are shared
+	 * blocks the dsp and cam nodes also take a single register out of, and
+	 * requesting the region would make whichever driver probes second
+	 * fail.  Same rule the dtsi already documents for those. */
+	return devm_ioremap(&pdev->dev, res->start, resource_size(res));
+}
+
+static int ctr_csnd_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct ctr_csnd *cs;
+	struct regmap *map;
+	int ret;
+
+	map = NULL;
+	cs = devm_kzalloc(dev, sizeof(*cs), GFP_KERNEL);
+	if (!cs)
+		return -ENOMEM;
+
+	cs->dev = dev;
+	cs->rate = pcm_rate;
+	mutex_init(&cs->lock);
+	init_waitqueue_head(&cs->wq);
+	INIT_DELAYED_WORK(&cs->drain, ctr_csnd_drain_work);
+	INIT_DELAYED_WORK(&cs->outmon, ctr_csnd_outmon_work);
+	platform_set_drvdata(pdev, cs);
+
+	map = ctr_csnd_find_codec(cs);
+	if (IS_ERR(map))
+		return PTR_ERR(map);
+	cs->codec = map;
+
+	cs->csnd = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(cs->csnd))
+		return PTR_ERR(cs->csnd);
+
+	cs->i2s = ctr_csnd_map(pdev, 1);
+	if (IS_ERR(cs->i2s))
+		return PTR_ERR(cs->i2s);
+	cs->pdn_i2s = ctr_csnd_map(pdev, 2);
+	if (IS_ERR(cs->pdn_i2s))
+		return PTR_ERR(cs->pdn_i2s);
+	cs->cfg11_spi = ctr_csnd_map(pdev, 3);
+	if (IS_ERR(cs->cfg11_spi))
+		return PTR_ERR(cs->cfg11_spi);
+
+	ret = dma_coerce_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret) {
+		dev_err(dev, "no 32-bit DMA mask: %d\n", ret);
+		return ret;
+	}
+
+	cs->ring = dma_alloc_coherent(dev, RING_BYTES, &cs->ring_phys,
+				      GFP_KERNEL);
+	if (!cs->ring)
+		return -ENOMEM;
+	dev_info(dev, "PCM ring: %u bytes at phys 0x%08x\n",
+		 RING_BYTES, (u32)cs->ring_phys);
+
+	ctr_csnd_clocks_on(cs);
+
+	ret = codec_init(cs);
+	if (ret) {
+		dev_err(dev, "codec bring-up failed (%d); no audio\n", ret);
+		goto err_free;
+	}
+	cs->codec_ok = true;
+	ctr_csnd_out_baseline(cs);	/* N3DS_CSND_OUTPUT_REARM */
+
+	ret = csnd_init(cs);
+	if (ret)
+		dev_warn(dev,
+			 "continuing anyway so the failure is visible in the tone below\n");
+	else
+		ctr_csnd_rate_check(cs);	/* before /dev/eac exists */
+
+	mutex_init(&cs->cap_lock);
+
+	/*
+	 * The MIC block is not a reg entry in the DT node, so it is mapped here
+	 * without requesting the region, the same way PDN_CAMERA_CNT is reached
+	 * from ctr_cam.c.  MIC_SURVEY_BYTES rather than MIC_REGS_BYTES so that
+	 * mic_survey=1 still has something to sweep.
+	 */
+	cs->mic = ioremap(MIC_BASE, MIC_SURVEY_BYTES);
+	if (!cs->mic)
+		dev_warn(dev, "MIC block at 0x%08x could not be mapped; capture will be silent\n",
+			 MIC_BASE);
+	else
+		mic_hw_stop(cs);		/* N3DS_MIC_REAL: known state */
+
+	if (mic_survey)
+		mic_block_survey(cs);
+
+	/* N3DS_MIC_REAL; the waitqueue before the timer that wakes it */
+	init_waitqueue_head(&cs->cap_wq);
+	cs->cap_want = 1;
+	hrtimer_init(&cs->cap_timer, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+	cs->cap_timer.function = mic_tick;
+	cs->cap_ring = devm_kcalloc(dev, CAP_RING_SAMPLES,
+				    sizeof(*cs->cap_ring), GFP_KERNEL);
+	if (!cs->cap_ring)
+		dev_warn(dev, "no capture ring; the microphone will be silent\n");
+
+	cs->misc.minor = MISC_DYNAMIC_MINOR;
+	cs->misc.name = "eac";
+	cs->misc.fops = &ctr_csnd_fops;
+	cs->misc.mode = 0666;
+	cs->misc.parent = dev;
+	ret = misc_register(&cs->misc);
+	if (ret) {
+		dev_err(dev, "cannot register /dev/eac: %d\n", ret);
+		goto err_free;
+	}
+
+	dev_info(dev, "CSND audio ready: /dev/eac accepts 16-bit stereo PCM at %u Hz, and returns 16-bit mono at 8000 Hz on read; writes of any size, a split frame is carried over (N3DS_CSND_WHOLE_WRITES)\n",
+		 cs->rate);
+
+	if (boot_tone) {
+		u32 n = ctr_csnd_render_chime(cs, 32000);
+
+		csnd_play(cs, cs->ring_phys, n * 2, 32000, CH_FORMAT_PCM16,
+			  false);
+		dev_info(dev,
+			 "boot chime: %u samples at 32000 Hz from phys 0x%08x, ch0 CNT reads 0x%04x\n",
+			 n, (u32)cs->ring_phys,
+			 ioread16(cs->csnd + CSND_CH_CNT(CSND_CHANNEL)));
+		csnd_probe_position_register(cs);
+	}
+
+	return 0;
+
+err_free:
+	dma_free_coherent(dev, RING_BYTES, cs->ring, cs->ring_phys);
+	return ret;
+}
+
+static int ctr_csnd_remove(struct platform_device *pdev)
+{
+	struct ctr_csnd *cs = platform_get_drvdata(pdev);
+
+	cancel_delayed_work_sync(&cs->drain);
+	cancel_delayed_work_sync(&cs->outmon);
+	hrtimer_cancel(&cs->cap_timer);		/* N3DS_MIC_REAL */
+	mic_hw_stop(cs);
+	csnd_stop(cs);
+	if (cs->codec_ok)
+		misc_deregister(&cs->misc);
+	if (cs->mic)
+		iounmap(cs->mic);
+	dma_free_coherent(&pdev->dev, RING_BYTES, cs->ring, cs->ring_phys);
+	return 0;
+}
+
+static const struct of_device_id ctr_csnd_of_match[] = {
+	{ .compatible = "nintendo," DRIVER_NAME },
+	{}
+};
+MODULE_DEVICE_TABLE(of, ctr_csnd_of_match);
+
+static struct platform_driver ctr_csnd_driver = {
+	.probe	= ctr_csnd_probe,
+	.remove	= ctr_csnd_remove,
+	.driver	= {
+		.name		= DRIVER_NAME,
+		.owner		= THIS_MODULE,
+		.of_match_table	= of_match_ptr(ctr_csnd_of_match),
+	},
+};
+module_platform_driver(ctr_csnd_driver);
+
+MODULE_DESCRIPTION("Nintendo 3DS CSND PCM mixer, CTR codec output and MIC capture");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform:" DRIVER_NAME);
diff --git a/drivers/platform/nintendo3ds/ctr_dsp.c b/drivers/platform/nintendo3ds/ctr_dsp.c
new file mode 100644
index 0000000000000000000000000000000000000000..52877f5379ff6bf754b407001494b53dbe66e1c0
--- /dev/null
+++ b/drivers/platform/nintendo3ds/ctr_dsp.c
@@ -0,0 +1,2521 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ *  ctr_dsp.c - Nintendo 3DS Teak Lite II DSP coprocessor driver
+ *
+ *  Register interface: 3dbrew.org/wiki/DSP_Registers
+ *  Firmware container format (DSP1): GBATEK, 3DS Files: sound/dsp
+ *  binary (DSP1, aka CDC)
+ */
+
+#define DRIVER_NAME "3ds-dsp"
+#define pr_fmt(fmt) DRIVER_NAME ": " fmt
+
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/init.h>
+#include <linux/delay.h>
+#include <linux/bitops.h>
+#include <linux/of.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/firmware.h>
+#include <linux/random.h>
+#include <linux/slab.h>
+#include <linux/interrupt.h>
+#include <linux/uaccess.h>
+#include <linux/miscdevice.h>
+#include <linux/mutex.h>
+#include <linux/fs.h>
+#include <asm/unaligned.h>
+#include <linux/platform_device.h>
+#include <linux/mod_devicetable.h>
+#include <uapi/linux/ctr_dsp.h>
+
+/* Horizon's DSP module accesses these registers with ARM STRH/LDRH at
+ * virtual 0x1ED03000 (physical 0x10203000). Keep every access 16-bit. */
+#define DSP_PDATA	0x00
+#define DSP_PADR	0x04
+#define DSP_PCFG	0x08
+#define DSP_PSTS	0x0C
+#define DSP_PSEM	0x10
+#define DSP_PMASK	0x14
+#define DSP_PCLEAR	0x18
+#define DSP_SEM		0x1C
+#define DSP_CMD0	0x20
+#define DSP_REP0	0x24
+#define DSP_CMD1	0x28
+#define DSP_REP1	0x2C
+#define DSP_CMD2	0x30
+#define DSP_REP2	0x34
+
+/* DSP_PCFG bits */
+#define PCFG_RESET		BIT(0)
+#define PCFG_AUTOINCREMENT	BIT(1)
+#define PCFG_READLEN_SHIFT	2
+#define PCFG_READLEN_MASK	(0x3 << PCFG_READLEN_SHIFT)
+#define  PCFG_READLEN_1WORD	(0x0 << PCFG_READLEN_SHIFT)
+#define  PCFG_READLEN_8WORD	(0x1 << PCFG_READLEN_SHIFT)
+#define  PCFG_READLEN_16WORD	(0x2 << PCFG_READLEN_SHIFT)
+#define  PCFG_READLEN_FREERUN	(0x3 << PCFG_READLEN_SHIFT)
+#define PCFG_READSTART		BIT(4)
+#define PCFG_MEMSEL_SHIFT	12
+#define PCFG_MEMSEL_MASK	(0xF << PCFG_MEMSEL_SHIFT)
+#define  PCFG_MEMSEL_DATA	(0x0 << PCFG_MEMSEL_SHIFT)
+#define  PCFG_MEMSEL_MMIO	(0x1 << PCFG_MEMSEL_SHIFT)
+#define  PCFG_MEMSEL_PROGRAM	(0x5 << PCFG_MEMSEL_SHIFT)
+
+/* DSP_PSTS bits */
+#define PSTS_READ_BUSY		BIT(0)
+#define PSTS_WRITE_BUSY		BIT(1)
+#define PSTS_RESET_BUSY		BIT(2)
+#define PSTS_READ_FIFO_FULL	BIT(5)
+#define PSTS_READ_FIFO_NOTEMPTY	BIT(6)
+#define PSTS_WRITE_FIFO_FULL	BIT(7)
+#define PSTS_WRITE_FIFO_EMPTY	BIT(8)
+#define PSTS_SEMAPHORE_IRQ	BIT(9)
+
+#define DSP_WRAM_SIZE          0x80000
+#define DSP_DATA_WRAM_OFF      0x40000
+
+/*
+ * N3DS_DSP_SHAREDWRAM_BANKS.  CFG11_SHAREDWRAM_32K_CODE<0-7> at 0x10140000
+ * and CFG11_SHAREDWRAM_32K_DATA<0-7> at 0x10140008, one byte per bank:
+ *
+ *   bits 0-1  Master
+ *   bits 2-4  Offset (slot 0..7, LSB of address in 32K units)
+ *   bit  7    Enable
+ *
+ * DSP memory is eight 32K banks of code at 0x1FF00000 and eight of data at
+ * 0x1FF40000, which is where ctr_dsp_segment_offset()'s 0x40000 data split
+ * comes from and confirms it.  Horizon's DSP sysmodule proves both the base
+ * addresses and the Master encoding:
+ *
+ *   FUN_00105528 (firmware load)  FUN_001035b4(1, bank, 1, 0) then memcpy
+ *   FUN_00106328 (just before the boot in FUN_0010303c)
+ *                                 FUN_001035b4(1, bank, 1, 1), then
+ *                                 FUN_001035b4(2, bank, 1, 1)
+ *
+ * and both write the Offset field directly at VA 0x1EC40000 / 0x1EC40008,
+ * which is Horizon's IO window (VA 0x1EC00000 = phys 0x10100000), i.e. phys
+ * 0x10140000 and 0x10140008.  FUN_001035b4 itself returns bank*0x8000 +
+ * 0x1FF00000 for type 1 and bank*0x8000 + 0x1FF40000 for type 2.
+ *
+ * So Master 0 is the ARM11 -- the state in which the sysmodule copies the
+ * firmware in -- and Master 1 is the DSP, set on every bank immediately
+ * before the core is released.  3dbrew guesses "0=ARM9?, 1=ARM11?" for this
+ * field with question marks; the two call sites above are unambiguous and
+ * win.
+ *
+ * This driver has never touched these registers.  It wrote the firmware into
+ * an aperture the ARM11 owns, verified the readback through that same
+ * ARM11-owned aperture, and then released a core whose memory was still
+ * mastered to the ARM11 -- which is exactly the observed result: every
+ * transfer lands, every readback matches, PCFG confirms the reset really is
+ * released, and the core emits nothing at all.  PSTS stays 0x0100 with bits
+ * 10-12 clear, and FUN_001040a8 waits for those bits to be *set*, so no
+ * reply ever arrived rather than one being missed.
+ */
+#define SWRAM_CODE_OFF         0x00
+#define SWRAM_DATA_OFF         0x08
+#define SWRAM_NBANKS           8
+#define SWRAM_MASTER_MASK      0x3
+#define  SWRAM_MASTER_ARM11    0x0
+#define  SWRAM_MASTER_DSP      0x1
+#define SWRAM_OFFSET_SHIFT     2
+#define SWRAM_ENABLE           BIT(7)
+#define PDN_DSP_RESET_RELEASE  BIT(0)
+#define PDN_DSP_CLOCK          BIT(1)
+
+struct ctr_dsp {
+	struct device *dev;
+	void __iomem *base;
+	void __iomem *wram;
+	void __iomem *pdn;
+	void __iomem *swram;
+	int irq;
+	const struct firmware *fw;
+	bool ready;
+	u32 pipe_base;		/* DSP data byte address, 0 = unknown */
+	u16 audio_addr[16];	/* DSP data word addresses from Initialize */
+	int audio_naddr;
+	struct mutex io_lock;
+	struct miscdevice misc;
+};
+
+static inline u16 ctr_dsp_read(struct ctr_dsp *dsp, unsigned reg)
+{
+	return ioread16(dsp->base + reg);
+}
+
+static inline void ctr_dsp_write(struct ctr_dsp *dsp, unsigned reg, u16 val)
+{
+	iowrite16(val, dsp->base + reg);
+}
+
+/*
+ * N3DS_DSP_SETTLE.
+ *
+ * Horizon separates every single access to this register block with
+ * FUN_00103e68(0x60) -- `subs r0,r0,#2 / nop / bgt`, i.e. 48 iterations of a
+ * three-instruction loop, on the order of half a microsecond.  It does this
+ * after writing PADR, after writing PCFG, after *every* PDATA word, and on
+ * both sides of the reset handshake.  This driver had none of them, and a
+ * half-configured port is exactly the sort of thing that leaves the block
+ * wedged with PSTS reporting busy forever.  udelay(1) is a comfortable
+ * superset of the real delay.
+ */
+static inline void ctr_dsp_settle(void)
+{
+	udelay(1);
+}
+
+/*
+ * Raw FIFO write: push `count` 16-bit words from `data` into DSP
+ * memory starting at word address `addr`, in the memory space
+ * selected by `memsel` (one of the PCFG_MEMSEL_* values).  The aperture at
+ * 0x1FF00000 is the fast path for DSP1 segments; this port is the fallback
+ * and the cross-check, because it is addressed the way the core addresses
+ * its own memory rather than the way the ARM11 happens to see it.
+ */
+static int ctr_dsp_fifo_write(struct ctr_dsp *dsp, u32 memsel, u32 addr,
+			       const u16 *data, size_t count)
+{
+	size_t i;
+	int timeout;
+	u16 cfg;
+
+	/*
+	 * N3DS_DSP_FIFO_WRITE_IS_FUN_00103a50.  Transcribed from the Horizon
+	 * DSP sysmodule rather than inferred:
+	 *
+	 *   strh addr,[base,#0x4]        PADR first
+	 *   delay 0x60
+	 *   ldrh r0,[base,#0x8]
+	 *   bic  r0,#0xf000              memsel only
+	 *   bic  r0,#0x2                 autoincrement only
+	 *   orr  r0,memsel / orr r0,autoinc
+	 *   strh r0,[base,#0x8]
+	 *   delay 0x60
+	 *   per word: wait while PSTS & 0x80, strh word,[base,#0x0], delay
+	 *   finally:  wait until PSTS & 0x100 set AND PSTS & 0x2 clear
+	 *
+	 * Two things this driver used to get wrong.  It rebuilt PCFG from
+	 * scratch keeping only PCFG_RESET, so READLEN, READSTART and the
+	 * reply-IRQ mask in bits 9-11 were all silently zeroed on every
+	 * segment; Horizon clears exactly the two fields it is about to set
+	 * and preserves everything else.  And it finished on FIFO-empty alone,
+	 * where Horizon also requires WRITE_BUSY to have fallen -- empty means
+	 * the last word left the FIFO, not that the block has finished
+	 * committing it.
+	 */
+	ctr_dsp_write(dsp, DSP_PADR, addr);
+	ctr_dsp_settle();
+
+	cfg = ctr_dsp_read(dsp, DSP_PCFG);
+	cfg &= ~(u16)PCFG_MEMSEL_MASK;
+	cfg &= ~(u16)PCFG_AUTOINCREMENT;
+	cfg |= memsel | PCFG_AUTOINCREMENT;
+	ctr_dsp_write(dsp, DSP_PCFG, cfg);
+	ctr_dsp_settle();
+
+	for (i = 0; i < count; i++) {
+		timeout = 1000;
+		while (ctr_dsp_read(dsp, DSP_PSTS) & PSTS_WRITE_FIFO_FULL) {
+			if (!--timeout)
+				return -ETIMEDOUT;
+			udelay(1);
+		}
+		ctr_dsp_write(dsp, DSP_PDATA, data[i]);
+		ctr_dsp_settle();
+	}
+
+	timeout = 10000;
+	for (;;) {
+		u16 sts = ctr_dsp_read(dsp, DSP_PSTS);
+
+		if ((sts & PSTS_WRITE_FIFO_EMPTY) && !(sts & PSTS_WRITE_BUSY))
+			break;
+		if (!--timeout) {
+			dev_err(dsp->dev,
+				"write port never drained: PSTS=0x%04x PCFG=0x%04x\n",
+				sts, ctr_dsp_read(dsp, DSP_PCFG));
+			return -ETIMEDOUT;
+		}
+		udelay(1);
+	}
+	return 0;
+}
+
+/*
+ * Raw FIFO read: pull `count` 16-bit words out of the DSP's own view of its
+ * memory. This is the only transport that can contradict the 0x1FF00000
+ * aperture, which is why it exists: see N3DS_DSP_FIFO_CROSSCHECK.
+ */
+static int ctr_dsp_fifo_read(struct ctr_dsp *dsp, u32 memsel, u32 addr,
+			     u16 *data, size_t count)
+{
+	size_t i, surplus;
+	int timeout;
+	u16 cfg, readlen;
+
+	/*
+	 * N3DS_DSP_FIFO_READ_IS_FUN_001038d4.  The old version of this
+	 * function was invented, and kernel #292 shows what it was worth:
+	 * "segment 0 FIFO crosscheck MISMATCH: want 4180 001e 4180 43fd got
+	 * 0000 0000 0000 0000", in a boot where the WRAM aperture readback of
+	 * the same bytes passed.  The data was in the DSP; this port just
+	 * could not fetch it.  Horizon does it like this:
+	 *
+	 *   ldrh r1,[base,#0x8] / bic #0xf000 / bic #0x2
+	 *   orr memsel, orr autoinc / strh [base,#0x8]     PCFG *first*
+	 *   delay 0x60
+	 *   strh addr,[base,#0x4]                          PADR *second*
+	 *   delay 0x60
+	 *   ldrh r0,[base,#0x8] / bic #0xc / orr readlen / orr #0x10
+	 *   strh [base,#0x8]                               one READSTART
+	 *   delay 0x60
+	 *   per word: wait until PSTS & 0x40, ldrh [base,#0x0], delay
+	 *   then drain the surplus words the burst length forced
+	 *   ldrh r0,[base,#0x8] / bic #0x10 / strh          clear READSTART
+	 *
+	 * Three differences, any one of which is enough to return zeroes.
+	 * The order of PCFG and PADR is inverted relative to a write, and we
+	 * had the write order -- so the address was latched and then the
+	 * memory selector moved underneath it.  READSTART is asserted once for
+	 * the whole burst, not re-armed per word.  And READLEN is not a free
+	 * choice: the burst is 1, 8 or 16 words, so a read of n words in the
+	 * 8-word bucket must pull 8 and throw 8 - n away, or the next transfer
+	 * starts against a port with words still queued in it.  That last one
+	 * also explains the stuck PSTS bit 2 -- the crosscheck left the read
+	 * port mid-burst, and every reset handshake after it timed out.
+	 */
+	if (count == 0)
+		return 0;
+	if (count > 16)
+		return -EINVAL;
+	if (count == 1) {
+		readlen = PCFG_READLEN_1WORD;
+		surplus = 0;
+	} else if (count <= 8) {
+		readlen = PCFG_READLEN_8WORD;
+		surplus = 8 - count;
+	} else {
+		readlen = PCFG_READLEN_16WORD;
+		surplus = 16 - count;
+	}
+
+	cfg = ctr_dsp_read(dsp, DSP_PCFG);
+	cfg &= ~(u16)PCFG_MEMSEL_MASK;
+	cfg &= ~(u16)PCFG_AUTOINCREMENT;
+	cfg |= memsel | PCFG_AUTOINCREMENT;
+	ctr_dsp_write(dsp, DSP_PCFG, cfg);
+	ctr_dsp_settle();
+
+	ctr_dsp_write(dsp, DSP_PADR, addr);
+	ctr_dsp_settle();
+
+	cfg = ctr_dsp_read(dsp, DSP_PCFG);
+	cfg &= ~(u16)PCFG_READLEN_MASK;
+	cfg |= readlen | PCFG_READSTART;
+	ctr_dsp_write(dsp, DSP_PCFG, cfg);
+	ctr_dsp_settle();
+
+	for (i = 0; i < count + surplus; i++) {
+		u16 word;
+
+		timeout = 10000;
+		while (!(ctr_dsp_read(dsp, DSP_PSTS) &
+			 PSTS_READ_FIFO_NOTEMPTY)) {
+			if (!--timeout) {
+				dev_err(dsp->dev,
+					"read port stalled at word %zu/%zu: PSTS=0x%04x PCFG=0x%04x\n",
+					i, count + surplus,
+					ctr_dsp_read(dsp, DSP_PSTS),
+					ctr_dsp_read(dsp, DSP_PCFG));
+				goto out;
+			}
+			udelay(1);
+		}
+		word = ctr_dsp_read(dsp, DSP_PDATA);
+		if (i < count)
+			data[i] = word;
+		ctr_dsp_settle();
+	}
+
+	cfg = ctr_dsp_read(dsp, DSP_PCFG);
+	ctr_dsp_write(dsp, DSP_PCFG, cfg & ~(u16)PCFG_READSTART);
+	ctr_dsp_settle();
+	return 0;
+
+out:
+	cfg = ctr_dsp_read(dsp, DSP_PCFG);
+	ctr_dsp_write(dsp, DSP_PCFG, cfg & ~(u16)PCFG_READSTART);
+	ctr_dsp_settle();
+	return -ETIMEDOUT;
+}
+
+/* DSP1 firmware container -- GBATEK "3DS Files: sound/dsp binary
+ * (DSP1, aka CDC)". Header is 0x300 bytes; segment payloads follow. */
+#define DSP1_MAGIC_OFF		0x100
+#define DSP1_MAGIC		0x31505344 /* "DSP1" little-endian u32 */
+#define DSP1_FILESIZE_OFF	0x104
+#define DSP1_NUM_SEGMENTS_OFF	0x10E
+#define DSP1_MAX_SEGMENTS	10
+#define DSP1_SEGTABLE_OFF	0x120
+#define DSP1_SEGENTRY_SIZE	0x30
+#define DSP1_HEADER_SIZE	0x300
+
+struct dsp1_segment {
+	u32 file_offset;
+	u32 target_addr;   /* in 16-bit words */
+	u32 size;           /* bytes */
+	u8  area_type;      /* 0/1 = Program memory, 2 = Data memory */
+};
+
+/*
+ * Where a segment lives in the DSP's own address space: a word address plus
+ * the memory-space selector for the FIFO port. Program memory is two banks
+ * that ctr_dsp_segment_offset() flattens at byte 0 and byte 0x20000, so the
+ * flat word address of bank 1 starts at 0x10000.
+ */
+/*
+ * Log all sixteen CFG11_SHAREDWRAM bytes.  At probe this captures the state
+ * Boot11/Luma3DS left the banks in, which is the ground truth for what
+ * "the ARM11 owns this bank" looks like on real hardware -- the aperture
+ * demonstrably works in that state, so whatever is read here is by
+ * definition a working ARM11 mapping.
+ */
+static void ctr_dsp_swram_dump(struct ctr_dsp *dsp, const char *when)
+{
+	u8 c[SWRAM_NBANKS], d[SWRAM_NBANKS];
+	int i;
+
+	if (!dsp->swram)
+		return;
+
+	for (i = 0; i < SWRAM_NBANKS; i++) {
+		c[i] = ioread8(dsp->swram + SWRAM_CODE_OFF + i);
+		d[i] = ioread8(dsp->swram + SWRAM_DATA_OFF + i);
+	}
+
+	dev_info(dsp->dev,
+		 "SHAREDWRAM %s: code %02x %02x %02x %02x %02x %02x %02x %02x data %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		 when, c[0], c[1], c[2], c[3], c[4], c[5], c[6], c[7],
+		 d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7]);
+}
+
+static void ctr_dsp_swram_rmw(void __iomem *reg, u8 master)
+{
+	u8 v = ioread8(reg);
+
+	v &= ~(u8)SWRAM_MASTER_MASK;
+	v |= master & SWRAM_MASTER_MASK;
+	v |= SWRAM_ENABLE;
+	iowrite8(v, reg);
+}
+
+/*
+ * Hand every code and data bank to `master`, read-modify-write, which is how
+ * the sysmodule does it too: FUN_001035b4 is "*bank &= 0xfffc | master" and
+ * FUN_00106328 is "*bank &= 0xe3 | slot << 2".  Deliberately only the Master
+ * field moves.  The Offset field is left exactly as Boot11/Luma3DS set it,
+ * because that arrangement is already proven to work -- the driver
+ * memset_io()s the whole 0x80000 aperture and then reads segment 0 back at
+ * the offset ctr_dsp_segment_offset() computed, and that readback matches.
+ * Rewriting the slots to identity would be assuming what the existing state
+ * already demonstrates, with nothing to gain if the assumption were wrong.
+ *
+ * Enable is forced on, which is the one bit this does assert: FUN_001035b4's
+ * second function-pointer call passes 1, and a bank the DSP cannot see is
+ * indistinguishable from the failure being debugged.  The probe-time dump
+ * records the prior value, so if forcing it turns out to matter the log says
+ * what it was.
+ */
+static void ctr_dsp_swram_set_master(struct ctr_dsp *dsp, u8 master)
+{
+	int i;
+
+	if (!dsp->swram)
+		return;
+
+	for (i = 0; i < SWRAM_NBANKS; i++) {
+		ctr_dsp_swram_rmw(dsp->swram + SWRAM_CODE_OFF + i, master);
+		ctr_dsp_swram_rmw(dsp->swram + SWRAM_DATA_OFF + i, master);
+	}
+	wmb();
+	ctr_dsp_settle();
+}
+
+static u32 ctr_dsp_segment_memsel(const struct dsp1_segment *seg)
+{
+	return seg->area_type == 2 ? PCFG_MEMSEL_DATA : PCFG_MEMSEL_PROGRAM;
+}
+
+static u32 ctr_dsp_segment_word_addr(const struct dsp1_segment *seg)
+{
+	if (seg->area_type < 2 && (seg->area_type & 1))
+		return seg->target_addr + 0x10000;
+	return seg->target_addr;
+}
+
+static int ctr_dsp_segment_offset(const struct dsp1_segment *seg, u32 *offset)
+{
+	u64 value;
+
+	if (seg->area_type > 2)
+		return -EINVAL;
+	value = (u64)seg->target_addr * 2;
+	if (seg->area_type < 2)
+		value += (seg->area_type & 1) ? 0x20000 : 0;
+	else
+		value += DSP_DATA_WRAM_OFF;
+	if (value > DSP_WRAM_SIZE || seg->size > DSP_WRAM_SIZE - value)
+		return -EINVAL;
+	*offset = value;
+	return 0;
+}
+
+/*
+ * Parse and sanity-check a DSP1 firmware image (typically dumped from
+ * a real console as dspfirm.cdc, since Nintendo never published this
+ * as a standalone redistributable blob -- see docs/ for the
+ * extraction procedure). Parsing is side-effect free; the caller only
+ * touches hardware after every segment has passed file and WRAM bounds checks.
+ */
+static int ctr_dsp_parse_firmware(struct ctr_dsp *dsp,
+				   const struct firmware *fw,
+				   struct dsp1_segment *segs, int *nsegs)
+{
+	u32 magic, filesize;
+	u8 num_segments;
+	int i;
+
+	if (fw->size < DSP1_HEADER_SIZE) {
+		dev_err(dsp->dev, "firmware too small (%zu bytes)\n",
+			fw->size);
+		return -EINVAL;
+	}
+
+	magic = get_unaligned_le32(fw->data + DSP1_MAGIC_OFF);
+	if (magic != DSP1_MAGIC) {
+		dev_err(dsp->dev, "bad DSP1 magic 0x%08x\n", magic);
+		return -EINVAL;
+	}
+
+	filesize = get_unaligned_le32(fw->data + DSP1_FILESIZE_OFF);
+	if (filesize != fw->size) {
+		dev_warn(dsp->dev,
+			 "header filesize 0x%x != actual %zu, continuing\n",
+			 filesize, fw->size);
+	}
+
+	num_segments = fw->data[DSP1_NUM_SEGMENTS_OFF];
+	if (num_segments < 1 || num_segments > DSP1_MAX_SEGMENTS) {
+		dev_err(dsp->dev, "bad segment count %u\n", num_segments);
+		return -EINVAL;
+	}
+
+	for (i = 0; i < num_segments; i++) {
+		const u8 *e = fw->data + DSP1_SEGTABLE_OFF +
+			      i * DSP1_SEGENTRY_SIZE;
+		struct dsp1_segment *s = &segs[i];
+
+		s->file_offset = get_unaligned_le32(e + 0x00);
+		s->target_addr = get_unaligned_le32(e + 0x04);
+		s->size        = get_unaligned_le32(e + 0x08);
+		s->area_type   = e[0x0F];
+
+		if (s->file_offset > fw->size || s->size > fw->size - s->file_offset ||
+		    ctr_dsp_segment_offset(s, &magic)) {
+			dev_err(dsp->dev,
+				"segment %d out of bounds (off=0x%x target=0x%x sz=0x%x area=%u)\n",
+				i, s->file_offset, s->target_addr, s->size, s->area_type);
+			return -EINVAL;
+		}
+
+		dev_info(dsp->dev,
+			 "segment %d: %s, target=0x%05x words, size=0x%x bytes\n",
+			 i, s->area_type == 2 ? "Data" : "Program",
+			 s->target_addr, s->size);
+	}
+
+	*nsegs = num_segments;
+	return 0;
+}
+
+/*
+ * N3DS_DSP_BUS_LIVENESS.
+ *
+ * The first version of this probe wrote a pattern to DSP_PADR and read it
+ * back, on the assumption that PADR is a plain read/write address latch.  The
+ * kernel #291 capture says otherwise: PADR read 0x0000 for every pattern,
+ * both before and after power-on, while in the same boot PSTS returned
+ * 0x0100/0x0104 and PCFG returned 0x0000/0x5003/0x0003 -- values the driver
+ * had itself just written.  So the register file answers perfectly well and
+ * DSP_PADR is simply write-only.  The old probe was a false alarm printed at
+ * dev_err on every boot; do not restore it.
+ *
+ * PCFG is the register the capture proves is readable, so test that instead.
+ * READLEN is the safe field to toggle: it only has an effect during a
+ * PCFG_READSTART transfer, and there is none in flight here.  The original
+ * value is restored before returning.
+ */
+static void ctr_dsp_bus_liveness(struct ctr_dsp *dsp, const char *when)
+{
+	u16 saved = ctr_dsp_read(dsp, DSP_PCFG);
+	u16 probe = (saved & ~PCFG_READLEN_MASK) | PCFG_READLEN_16WORD;
+	u16 back;
+
+	ctr_dsp_write(dsp, DSP_PCFG, probe);
+	back = ctr_dsp_read(dsp, DSP_PCFG);
+	ctr_dsp_write(dsp, DSP_PCFG, saved);
+
+	if (back != probe)
+		/*
+		 * N3DS_DSP_LIVENESS_BEFORE_POWER_IS_EXPECTED: kernel #292 prints
+		 * this at probe, before ctr_dsp_power_on() has run, where the
+		 * block is still clock-gated and every register reads 0x0000.
+		 * That is not a fault, so it is not dev_err.  The call sited
+		 * after power-on is the one that means anything, and in the
+		 * same capture it reports the register file answering.
+		 */
+		dev_info(dsp->dev,
+			 "PCFG liveness %s: wrote 0x%04x read 0x%04x (block not powered yet?)\n",
+			 when, probe, back);
+	else
+		dev_info(dsp->dev,
+			 "PCFG liveness %s: register file answers (0x%04x)\n",
+			 when, back);
+}
+
+static int ctr_dsp_wait_reset(struct ctr_dsp *dsp)
+{
+	int timeout = 100000;
+
+	while (ctr_dsp_read(dsp, DSP_PSTS) & PSTS_RESET_BUSY) {
+		if (!--timeout) {
+			/*
+			 * N3DS_DSP_WAIT_RESET_DIAGNOSTIC: this used to return
+			 * -ETIMEDOUT silently.  ctr_dsp_release_and_wait()
+			 * calls it before the boot-reply loop, so a boot that
+			 * died here produced exactly the same -110 as one
+			 * that died waiting for a reply -- except that no
+			 * "boot reply N/3 timed out" line was ever printed.
+			 * The 2026-09-11 capture has precisely that shape:
+			 * -110 with no reply line, ~380ms after the upload,
+			 * which is this loop's duration and not the reply
+			 * loop's.  So the core was never even released.
+			 */
+			dev_err(dsp->dev,
+				"reset-busy never cleared: PSTS=0x%04x PCFG=0x%04x PDN=0x%02x\n",
+				ctr_dsp_read(dsp, DSP_PSTS),
+				ctr_dsp_read(dsp, DSP_PCFG),
+				ioread8(dsp->pdn));
+			return -ETIMEDOUT;
+		}
+		udelay(1);
+	}
+	return 0;
+}
+
+/*
+ * N3DS_DSP_ENTER_RESET_IS_FUN_0010406c.
+ *
+ * The previous revision of this function was called
+ * N3DS_DSP_RESET_IS_A_LEVEL and it inverted the wait, on the theory that
+ * PSTS bit 2 was a level mirror of PCFG bit 0 that could never clear by
+ * itself.  That theory was built from three sample pairs in the #291
+ * capture and it is wrong.  Horizon is unambiguous:
+ *
+ *   ldrh r0,[base,#0x8] / tst r0,#0x1 / bne return     already in reset
+ *   ldrh r0,[base,#0x8] / orr r0,#0x1 / strh
+ *   delay 0x60
+ *   loop: ldrh r0,[base,#0xc] / tst r0,#0x4 / bne loop
+ *
+ * `bne loop` spins *while* bit 2 is set: assert the reset, then wait for
+ * reset-busy to fall.  The original driver had this right.
+ *
+ * The #292 capture settles it on hardware too.  With PCFG=0x0001 -- reset
+ * asserted, nothing else -- PSTS read 0x0100, bit 2 already clear, so the
+ * reset had completed and the inverted loop simply burned its 1000
+ * iterations and printed a warning about hardware that was behaving
+ * correctly.  Bit 2 only stuck high later, at PCFG=0x0003 and 0x5003, after
+ * the invented FIFO read left the port mid-burst; see
+ * N3DS_DSP_FIFO_READ_IS_FUN_001038d4.  It is a busy flag, and something
+ * really was busy.
+ */
+static int ctr_dsp_enter_reset(struct ctr_dsp *dsp)
+{
+	u16 cfg = ctr_dsp_read(dsp, DSP_PCFG);
+	int timeout = 100000;
+
+	if (cfg & PCFG_RESET)
+		return 0;
+
+	ctr_dsp_write(dsp, DSP_PCFG, cfg | PCFG_RESET);
+	ctr_dsp_settle();
+
+	while (ctr_dsp_read(dsp, DSP_PSTS) & PSTS_RESET_BUSY) {
+		if (!--timeout) {
+			dev_err(dsp->dev,
+				"reset-busy never fell after asserting reset: PSTS=0x%04x PCFG=0x%04x\n",
+				ctr_dsp_read(dsp, DSP_PSTS),
+				ctr_dsp_read(dsp, DSP_PCFG));
+			return -ETIMEDOUT;
+		}
+		udelay(1);
+	}
+	return 0;
+}
+
+static void ctr_dsp_power_on(struct ctr_dsp *dsp)
+{
+	u8 value = ioread8(dsp->pdn);
+	u8 held, released;
+
+	/* PDN_DSP_CNT: enable the clock, hold active-low reset, then release. */
+	iowrite8((value | PDN_DSP_CLOCK) & ~PDN_DSP_RESET_RELEASE, dsp->pdn);
+	udelay(1); /* comfortably exceeds the documented 0x30 ARM11 cycles */
+	held = ioread8(dsp->pdn);
+	iowrite8(value | PDN_DSP_CLOCK | PDN_DSP_RESET_RELEASE, dsp->pdn);
+	udelay(1);
+	released = ioread8(dsp->pdn);
+
+	/*
+	 * N3DS_DSP_PDN_READBACK: no capture has ever confirmed that these
+	 * two writes land.  ctr_cam.c does the equivalent readback on
+	 * PDN_CAMERA_CNT and that one reports 00 -> 01, so the pattern is
+	 * known to be informative on this SoC.  If PDN_DSP_CNT reads back
+	 * unchanged, the block is still gated and everything downstream --
+	 * the zero FIFO crosscheck, a stuck reset-busy, a missing reply --
+	 * is a consequence rather than a cause.
+	 */
+	dev_info(dsp->dev,
+		 "PDN_DSP_CNT: %02x -> %02x (clock on, reset held) -> %02x (reset released)\n",
+		 value, held, released);
+	if (!(released & PDN_DSP_CLOCK))
+		dev_warn(dsp->dev,
+			 "PDN_DSP_CLOCK did not stick; the block may be gated elsewhere\n");
+
+	dev_info(dsp->dev, "after power-on: PSTS=0x%04x PCFG=0x%04x\n",
+		 ctr_dsp_read(dsp, DSP_PSTS), ctr_dsp_read(dsp, DSP_PCFG));
+	ctr_dsp_bus_liveness(dsp, "after power-on");
+}
+
+/* ------------------------------------------------------------------ pipes */
+
+/*
+ * N3DS_DSP_PIPES.  Transcribed from the ARM11 `dsp` sysmodule disassembly in
+ * scratch/dsp-code-analysis/corpus/.  Nothing below is guessed.
+ *
+ * The DSP exposes eight bidirectional pipes.  Their descriptors live in the
+ * DSP's own *data* memory, in a table whose base address the core hands the
+ * ARM11 exactly once: as the first mailbox-2 word after the three boot
+ * replies.  FUN_00106648, the sysmodule's DSP event thread, is the only place
+ * that says so:
+ *
+ *   if (base == 0)  base = FUN_001040a8(2) << 1;     the first REP2 ever
+ *   else          { v = FUN_001040a8(2);             every later REP2 is
+ *                   pipe = v >> 1; dir = v & 1; }    a slot notification
+ *
+ * That word is a DSP *word* address, hence the << 1 to reach bytes.  This
+ * driver has never read it, which is why it has never had pipes: it took the
+ * three boot replies and stopped listening exactly one word too early.
+ *
+ * Descriptor at base + pipe*0x14 + dir*10, as u16[5] (FUN_001037f0):
+ *   [0] buffer base, in DSP data *words*    [1] buffer size, bytes
+ *   [2] read pointer                        [3] write pointer
+ *   [4] low byte = slot = pipe*2 + dir
+ * Both pointers carry a wrap parity in bit 15 and a byte offset in bits 0-14,
+ * which is what makes "empty" (pointers equal, parity included) different
+ * from "full" (offsets equal, parity differing).  dir 0 is DSP->ARM11, dir 1
+ * is ARM11->DSP.
+ *
+ * All of this goes through the PADR/PDATA port rather than the WRAM aperture,
+ * and has to: once ctr_dsp_swram_set_master() hands the banks to the DSP the
+ * ARM11 no longer masters that memory, so the aperture is dead to us for the
+ * rest of the boot.  The port is the only transport left.
+ */
+#define DSP_NPIPES		8
+#define DSP_PIPE_STRIDE		0x14
+#define DSP_PIPE_DIR_STRIDE	10
+#define DSP_PIPE_WRAP		0x8000
+
+/* Bounded FUN_001040a8: PSTS bit (n+10) set means REPn holds a word. */
+static int ctr_dsp_recv_data(struct ctr_dsp *dsp, int n, u16 *out,
+			     unsigned int timeout_us)
+{
+	while (!(ctr_dsp_read(dsp, DSP_PSTS) & BIT(n + 10))) {
+		if (!timeout_us--)
+			return -ETIMEDOUT;
+		udelay(1);
+	}
+	*out = ctr_dsp_read(dsp, DSP_REP0 + n * 8);
+	return 0;
+}
+
+/* Bounded FUN_001040e0: PSTS bit (n+13) set means CMDn is still full. */
+static int ctr_dsp_send_data(struct ctr_dsp *dsp, int n, u16 val,
+			     unsigned int timeout_us)
+{
+	while (ctr_dsp_read(dsp, DSP_PSTS) & BIT(n + 13)) {
+		if (!timeout_us--)
+			return -ETIMEDOUT;
+		udelay(1);
+	}
+	ctr_dsp_write(dsp, DSP_CMD0 + n * 8, val);
+	ctr_dsp_settle();
+	return 0;
+}
+
+/*
+ * Read DSP data space at a DSP *byte* address.  FUN_0010331c masks the
+ * address to 0x1ffff and halves it to reach a word address; the burst length
+ * is a property of the port, not a free choice, so chunk to 16 words.
+ */
+static int ctr_dsp_dmem_read(struct ctr_dsp *dsp, u32 byte_addr,
+			     u16 *buf, size_t words)
+{
+	size_t done = 0;
+
+	while (done < words) {
+		size_t chunk = min_t(size_t, words - done, 16);
+		int ret;
+
+		ret = ctr_dsp_fifo_read(dsp, PCFG_MEMSEL_DATA,
+					((byte_addr + done * 2) & 0x1ffff) >> 1,
+					buf + done, chunk);
+		if (ret)
+			return ret;
+		done += chunk;
+	}
+	return 0;
+}
+
+static int ctr_dsp_pipe_fetch(struct ctr_dsp *dsp, unsigned int pipe,
+			      unsigned int dir, u16 desc[5])
+{
+	if (!dsp->pipe_base || pipe >= DSP_NPIPES || dir > 1)
+		return -EINVAL;
+	return ctr_dsp_dmem_read(dsp,
+				 dsp->pipe_base + pipe * DSP_PIPE_STRIDE +
+				 dir * DSP_PIPE_DIR_STRIDE, desc, 5);
+}
+
+/*
+ * FUN_0010366c, including the operator precedence that makes it correct: the
+ * mask covers the whole sum, so the wrap parity's 0x8000 cancels in both
+ * branches and the wrapped case falls out as size - read + write.
+ */
+static u32 ctr_dsp_pipe_readable(const u16 desc[5])
+{
+	u32 base = ((u16)(desc[2] ^ desc[3]) > 0x7fff) ? desc[1] : 0;
+
+	return (base + desc[3] - desc[2]) & 0x7fff;
+}
+
+/*
+ * N3DS_DSP_DMEM_READ_BYTES.  ctr_dsp_dmem_read() works in whole words because
+ * the port does; pipe pointers are byte-granular and are under no obligation
+ * to land on a word boundary, so the pipe layer needs a byte-addressed view
+ * of the same transport.  Horizon splits exactly this way -- odd head, whole
+ * words, odd tail -- in FUN_0010331c.
+ */
+static int ctr_dsp_dmem_read_bytes(struct ctr_dsp *dsp, u32 byte_addr,
+				   void *dst, size_t nbytes)
+{
+	u8 *p = dst;
+	u16 w;
+	int ret;
+
+	if (nbytes && (byte_addr & 1)) {
+		ret = ctr_dsp_dmem_read(dsp, byte_addr & ~1u, &w, 1);
+		if (ret)
+			return ret;
+		*p++ = w >> 8;
+		byte_addr++;
+		nbytes--;
+	}
+	while (nbytes >= 2) {
+		u16 tmp[16];
+		size_t words = min_t(size_t, nbytes / 2, ARRAY_SIZE(tmp));
+		size_t i;
+
+		ret = ctr_dsp_dmem_read(dsp, byte_addr, tmp, words);
+		if (ret)
+			return ret;
+		for (i = 0; i < words; i++) {
+			*p++ = tmp[i] & 0xff;
+			*p++ = tmp[i] >> 8;
+		}
+		byte_addr += words * 2;
+		nbytes -= words * 2;
+	}
+	if (nbytes) {
+		ret = ctr_dsp_dmem_read(dsp, byte_addr, &w, 1);
+		if (ret)
+			return ret;
+		*p = w & 0xff;
+	}
+	return 0;
+}
+
+/*
+ * N3DS_DSP_DMEM_WRITE_IS_FUN_0010321c.  The mirror of ctr_dsp_dmem_read(),
+ * and the piece this driver has never had: every transfer so far has been
+ * ARM11 -> DSP over the 0x1FF00000 aperture, which dies at the SHAREDWRAM
+ * handover, or DSP -> ARM11 over this port.  Writing DSP memory *after* the
+ * handover has no other route, and the pipe protocol cannot work without it:
+ * advancing a pipe pointer means storing two bytes into a descriptor that
+ * lives in DSP data space.
+ *
+ * Odd ends are read-modify-written a word at a time (FUN_00102f24) so a
+ * byte-granular pointer never clobbers its neighbour.  The source is walked
+ * byte-wise rather than cast to u16 * because callers hand us packed
+ * messages, not aligned arrays.
+ */
+static int ctr_dsp_dmem_write_words(struct ctr_dsp *dsp, u32 byte_addr,
+				    const u16 *buf, size_t words)
+{
+	size_t done = 0;
+
+	while (done < words) {
+		size_t chunk = min_t(size_t, words - done, 16);
+		int ret;
+
+		ret = ctr_dsp_fifo_write(dsp, PCFG_MEMSEL_DATA,
+					 ((byte_addr + done * 2) & 0x1ffff) >> 1,
+					 buf + done, chunk);
+		if (ret)
+			return ret;
+		done += chunk;
+	}
+	return 0;
+}
+
+static int ctr_dsp_dmem_write_byte(struct ctr_dsp *dsp, u32 byte_addr, u8 val)
+{
+	u32 word_addr = byte_addr & ~1u;
+	u16 w;
+	int ret;
+
+	ret = ctr_dsp_dmem_read(dsp, word_addr, &w, 1);
+	if (ret)
+		return ret;
+	if (byte_addr & 1)
+		w = (w & 0x00ff) | ((u16)val << 8);
+	else
+		w = (w & 0xff00) | val;
+	return ctr_dsp_dmem_write_words(dsp, word_addr, &w, 1);
+}
+
+static int ctr_dsp_dmem_write(struct ctr_dsp *dsp, u32 byte_addr,
+			      const void *src, size_t nbytes)
+{
+	const u8 *p = src;
+	int ret;
+
+	if (nbytes && (byte_addr & 1)) {
+		ret = ctr_dsp_dmem_write_byte(dsp, byte_addr, *p);
+		if (ret)
+			return ret;
+		byte_addr++;
+		p++;
+		nbytes--;
+	}
+	while (nbytes >= 2) {
+		u16 tmp[16];
+		size_t words = min_t(size_t, nbytes / 2, ARRAY_SIZE(tmp));
+		size_t i;
+
+		for (i = 0; i < words; i++)
+			tmp[i] = p[i * 2] | ((u16)p[i * 2 + 1] << 8);
+		ret = ctr_dsp_dmem_write_words(dsp, byte_addr, tmp, words);
+		if (ret)
+			return ret;
+		byte_addr += words * 2;
+		p += words * 2;
+		nbytes -= words * 2;
+	}
+	if (nbytes)
+		return ctr_dsp_dmem_write_byte(dsp, byte_addr, *p);
+	return 0;
+}
+
+/*
+ * N3DS_DSP_PIPE_NOTIFY_IS_FUN_001031bc.  The end of every real transfer, in
+ * the order Horizon does it: store the pointer we advanced back into the
+ * descriptor in DSP memory -- the read pointer at +4 for dir 0, the write
+ * pointer at +6 for dir 1 -- and then hand the slot number to the core on
+ * mailbox 2.  Without the writeback the DSP never learns the buffer moved;
+ * without the SendData it is never woken to look.
+ *
+ * This driver did neither until now, which is the whole reason every pointer
+ * in the table reads back as zero: the table is not stale, it is untouched.
+ * The DSP does not speak first.
+ */
+static int ctr_dsp_pipe_notify(struct ctr_dsp *dsp, const u16 desc[5])
+{
+	unsigned int slot = desc[4] & 0xff;
+	unsigned int pipe = (slot >> 1) & (DSP_NPIPES - 1);
+	unsigned int dir = slot & 1;
+	u32 off = dsp->pipe_base + pipe * DSP_PIPE_STRIDE +
+		  dir * DSP_PIPE_DIR_STRIDE + (dir ? 6 : 4);
+	u16 ptr = dir ? desc[3] : desc[2];
+	int ret;
+
+	ret = ctr_dsp_dmem_write(dsp, off, &ptr, sizeof(ptr));
+	if (ret) {
+		dev_warn(dsp->dev,
+			 "pipe %u dir %u: pointer writeback to 0x%05x failed: %d\n",
+			 pipe, dir, off, ret);
+		return ret;
+	}
+	return ctr_dsp_send_data(dsp, 2, slot, 100000);
+}
+
+/*
+ * N3DS_DSP_PIPE_READ_IS_FUN_00103698.  The consuming read: the same walk as
+ * the peek below, but the advanced read pointer is written back and the slot
+ * is announced, so the core can refill the buffer.  Returns bytes copied.
+ *
+ * The limit rule and the pointer advance are transcribed, not inferred.  Same
+ * wrap parity means the writer has not lapped us, so readable data ends at
+ * the write pointer; different parity means it lapped, so readable data runs
+ * to the end of the buffer and continues on the next pass.  Reaching the end
+ * exactly flips the parity and resets the offset -- which is why the advance
+ * is `~ptr & 0x8000` and not an arithmetic modulo.
+ */
+static int ctr_dsp_pipe_read(struct ctr_dsp *dsp, unsigned int pipe,
+			     unsigned int dir, void *out, size_t len)
+{
+	u16 desc[5];
+	u8 *dst = out;
+	size_t got = 0;
+	bool moved = false;
+	int ret;
+
+	ret = ctr_dsp_pipe_fetch(dsp, pipe, dir, desc);
+	if (ret)
+		return ret;
+
+	while (got < len) {
+		u16 diff = desc[2] ^ desc[3];
+		u32 roff, limit, chunk;
+
+		if (!diff)
+			break;				/* empty */
+		limit = (diff < DSP_PIPE_WRAP) ? (desc[3] & 0x7fff) : desc[1];
+		roff = desc[2] & 0x7fff;
+		if (limit <= roff || limit > desc[1])
+			break;				/* not self-consistent */
+		chunk = min_t(u32, limit - roff, len - got);
+
+		ret = ctr_dsp_dmem_read_bytes(dsp, (u32)desc[0] * 2 + roff,
+					      dst + got, chunk);
+		if (ret)
+			return ret;
+		got += chunk;
+		moved = true;
+
+		if (roff + chunk < desc[1])
+			desc[2] += chunk;
+		else
+			desc[2] = ~desc[2] & DSP_PIPE_WRAP;
+	}
+
+	if (moved) {
+		ret = ctr_dsp_pipe_notify(dsp, desc);
+		if (ret)
+			return ret;
+	}
+	return got;
+}
+
+/*
+ * N3DS_DSP_PIPE_WRITE_IS_FUN_00105ed8.  The structural mirror of the read:
+ * full is `(rd ^ wr) == 0x8000` where empty was `(rd ^ wr) == 0`, and the
+ * writable span ends at the buffer end while the parities match and at the
+ * read pointer once they do not.  Returns bytes accepted.
+ */
+static int ctr_dsp_pipe_write(struct ctr_dsp *dsp, unsigned int pipe,
+			      unsigned int dir, const void *in, size_t len)
+{
+	u16 desc[5];
+	const u8 *src = in;
+	size_t put = 0;
+	bool moved = false;
+	int ret;
+
+	ret = ctr_dsp_pipe_fetch(dsp, pipe, dir, desc);
+	if (ret)
+		return ret;
+
+	while (put < len) {
+		u16 diff = desc[2] ^ desc[3];
+		u32 woff, limit, chunk;
+
+		if (diff == DSP_PIPE_WRAP)
+			break;				/* full */
+		limit = (diff < DSP_PIPE_WRAP) ? desc[1] : (desc[2] & 0x7fff);
+		woff = desc[3] & 0x7fff;
+		if (limit <= woff || limit > desc[1])
+			break;				/* not self-consistent */
+		chunk = min_t(u32, limit - woff, len - put);
+
+		ret = ctr_dsp_dmem_write(dsp, (u32)desc[0] * 2 + woff,
+					 src + put, chunk);
+		if (ret)
+			return ret;
+		put += chunk;
+		moved = true;
+
+		if (woff + chunk < desc[1])
+			desc[3] += chunk;
+		else
+			desc[3] = ~desc[3] & DSP_PIPE_WRAP;
+	}
+
+	if (moved) {
+		ret = ctr_dsp_pipe_notify(dsp, desc);
+		if (ret)
+			return ret;
+	}
+	return put;
+}
+
+/*
+ * FUN_00103698 reduced to a single non-blocking pass, and deliberately a
+ * *peek*: the read pointer is advanced only in our local copy and never
+ * written back, and no slot notification is sent.  Horizon consumes here, and
+ * will once there is a consumer; for bring-up, consuming would destroy the
+ * evidence and would also mean writing to DSP memory over a path that has not
+ * yet been shown to read from it.  Returns bytes copied.
+ */
+static int ctr_dsp_pipe_peek(struct ctr_dsp *dsp, unsigned int pipe,
+			     unsigned int dir, u16 *out, size_t len)
+{
+	u16 desc[5];
+	size_t got = 0;
+	int ret;
+
+	ret = ctr_dsp_pipe_fetch(dsp, pipe, dir, desc);
+	if (ret)
+		return ret;
+
+	while (got < len) {
+		u32 roff, limit, avail, chunk;
+		u16 diff = desc[2] ^ desc[3];
+
+		if (!diff)
+			break;		/* empty */
+		limit = (diff < DSP_PIPE_WRAP) ? (desc[3] & 0x7fff) : desc[1];
+		roff = desc[2] & 0x7fff;
+		if (limit <= roff)
+			break;		/* descriptor not self-consistent */
+		avail = limit - roff;
+		chunk = min_t(u32, avail, len - got) & ~1u;
+		if (!chunk)
+			break;
+
+		ret = ctr_dsp_dmem_read(dsp, (u32)desc[0] * 2 + roff,
+					out + got / 2, chunk / 2);
+		if (ret)
+			return ret;
+		got += chunk;
+
+		if (roff + chunk < desc[1])
+			desc[2] += chunk;
+		else
+			desc[2] = ~desc[2] & DSP_PIPE_WRAP;
+	}
+	return got;
+}
+
+/*
+ * Everything we can learn about the pipes without touching them.  This is the
+ * first boot on this port where any of it is reachable, so it is worth
+ * printing in full once: a plausible table here means the data-space port
+ * works after the SHAREDWRAM handover, which is the single fact the whole
+ * audio path depends on.
+ */
+static void ctr_dsp_pipes_report(struct ctr_dsp *dsp)
+{
+	unsigned int pipe;
+	int live = 0;
+
+	for (pipe = 0; pipe < DSP_NPIPES; pipe++) {
+		unsigned int dir;
+
+		for (dir = 0; dir < 2; dir++) {
+			u16 d[5];
+
+			if (ctr_dsp_pipe_fetch(dsp, pipe, dir, d))
+				continue;
+			if (!d[0] && !d[1] && !d[2] && !d[3])
+				continue;	/* unused slot */
+			live++;
+			dev_info(dsp->dev,
+				 "pipe %u dir %u: buf 0x%05x size %u rd 0x%04x wr 0x%04x slot 0x%02x readable %u\n",
+				 pipe, dir, (u32)d[0] * 2, d[1], d[2], d[3],
+				 d[4] & 0xff, ctr_dsp_pipe_readable(d));
+		}
+	}
+
+	if (!live) {
+		dev_warn(dsp->dev,
+			 "pipe table at 0x%05x reads as all zero -- either the base is wrong or the data-space port is not answering\n",
+			 dsp->pipe_base);
+		return;
+	}
+
+	{
+		u16 buf[8] = { 0 };	/* printed in full below; never show stack */
+		int n = ctr_dsp_pipe_peek(dsp, 2, 0, buf, sizeof(buf));
+
+		if (n < 0)
+			dev_warn(dsp->dev, "pipe 2 peek failed: %d\n", n);
+		else if (n == 0)
+			dev_info(dsp->dev, "pipe 2 dir 0 is empty\n");
+		else
+			dev_info(dsp->dev,
+				 "pipe 2 dir 0, %d bytes: %04x %04x %04x %04x %04x %04x %04x %04x\n",
+				 n, buf[0], buf[1], buf[2], buf[3],
+				 buf[4], buf[5], buf[6], buf[7]);
+	}
+}
+
+
+/*
+ * N3DS_DSP_AUDIO_HANDSHAKE.  The missing half of the conversation.
+ *
+ * Every boot so far has ended with all sixteen pipe descriptors reading
+ * `rd 0x0000 wr 0x0000`, and that was read as a failure -- a table that had
+ * not been filled in, or a port that was not answering.  It is neither.  The
+ * table is correct and the port works: the base is 0x0193e, the eight
+ * descriptors occupy 0xa0 bytes, and the sixteen 128-byte buffers follow
+ * contiguously from 0x019de, which is exactly what the firmware would lay out
+ * and not something a broken read could invent.  The pointers are zero
+ * because nothing has ever been written to a pipe.
+ *
+ * The core does not speak first.  Horizon's dsp::DSP service opens the audio
+ * path by writing a fixed four-byte message to pipe 2 in the ARM11 -> DSP
+ * direction, whose first byte is the requested state:
+ *
+ *   0 Initialize   1 Shutdown   2 Wakeup   3 Sleep
+ *
+ * Initialize is the one that makes the firmware answer.  It replies on pipe 2
+ * dir 0 with a u16 count followed by that many DSP data-word addresses, one
+ * per audio structure -- frame_counter, source_configurations,
+ * source_statuses, adpcm_coefficients, dsp_configuration, dsp_status,
+ * final_samples, intermediate_mix_samples, compressor, dsp_debug and five
+ * more the emulators have never named.  Everything the audio path needs to
+ * say afterwards is said through those addresses, so this reply is the gate
+ * on all of it.
+ *
+ * Corroborated from both ends: the sysmodule's IPC dispatcher patches bytes
+ * 2-3 of a pipe-2 message before handing it to WriteProcessPipe, which only
+ * makes sense for a short fixed-size message; and Azahar's HLE rejects any
+ * pipe-2 write that is not exactly four bytes long.
+ */
+#define DSP_AUDIO_INITIALIZE	0
+#define DSP_AUDIO_SHUTDOWN	1
+#define DSP_AUDIO_WAKEUP	2
+#define DSP_AUDIO_SLEEP		3
+
+#define DSP_AUDIO_PIPE		2
+
+/*
+ * N3DS_DSP_AUDIO_FLAGS.  The four bytes are not a state byte and three pads.
+ * FUN_00104b28, the sysmodule's WriteProcessPipe dispatcher, overwrites bytes
+ * 2-3 of every pipe-2 message (and bytes 6-7 of every pipe-3 message) with a
+ * u16 it caches at 0x00109002:
+ *
+ *   0x00104f64  ldr r12,[0x1054b0]   ; -> 0x00109002
+ *               ldrh r12,[r12,#0x0]
+ *               strh r12,[r2,#0x2]   ; r2 = the caller's buffer
+ *
+ * and FUN_00100700, the only writer of that global, sets it at module init to
+ * 2 or 0 and nothing else:
+ *
+ *   0x0010074c  bl 0x00100ce8        ; one cached console property, a byte
+ *               cmp r0,#0x0
+ *               movne r0,#0x2
+ *               strh r0,[r4,#0x2]    ; r4 = 0x00109000
+ *
+ * So the message is { u16 state, u16 flags } and a real console sends flags 0
+ * or flags 2.  Which one depends on a property this driver cannot query --
+ * the answer comes back over an IPC to a service that does not exist here --
+ * so the value is a parameter rather than a constant, and the handshake tries
+ * the other one rather than assuming.
+ */
+#define DSP_AUDIO_FLAGS_A	0
+#define DSP_AUDIO_FLAGS_B	2
+
+/*
+ * N3DS_DSP_SEM_KICK.  The step this port has never taken.
+ *
+ * libctru's ndspInitialize() -- the reference implementation of exactly this
+ * handshake, vendored under scratch/pica-research/libctru -- writes the pipe
+ * and then immediately sets the ARM11-to-DSP semaphore:
+ *
+ *	DSP_SetSemaphoreMask(0x2000);
+ *	u16 val = resume ? 2 : 0;
+ *	DSP_WriteProcessPipe(2, &val, 4);
+ *	DSP_SetSemaphore(0x4000);		// <- this
+ *	ndspWaitForIrq(U64_MAX);
+ *
+ * DSP_SetSemaphore writes PSEM, and PSEM is a different channel from the
+ * mailbox: the mailbox word tells the firmware's pipe layer that a descriptor
+ * moved, and the pipe layer is what consumed our four bytes in the last
+ * capture -- rd walked 0x0000, 0x0004, 0x0008, 0x000c through three messages
+ * while ctr_dsp_pipe_notify() demonstrably writes back only wr.  The audio
+ * task sits one level above that, blocked on the semaphore, and nothing in
+ * the last three builds has ever set it.  A task that is never woken cannot
+ * answer, which is the whole of the symptom we have been chasing.
+ *
+ * 0x4000 rather than some other bit because that is the bit the audio task
+ * waits on; the value is libctru's, not a guess.
+ */
+#define DSP_SEM_AUDIO		0x4000
+
+static void ctr_dsp_audio_kick(struct ctr_dsp *dsp, const char *why)
+{
+	ctr_dsp_write(dsp, DSP_PSEM, DSP_SEM_AUDIO);
+	ctr_dsp_settle();
+	dev_info(dsp->dev, "DSP semaphore kick 0x%04x (%s)\n",
+		 DSP_SEM_AUDIO, why);
+}
+
+static int ctr_dsp_audio_msg(struct ctr_dsp *dsp, u8 state, u16 flags,
+			     const char *name)
+{
+	u8 msg[4] = { state, 0, flags & 0xff, flags >> 8 };
+	int ret;
+
+	ret = ctr_dsp_pipe_write(dsp, DSP_AUDIO_PIPE, 1, msg, sizeof(msg));
+	if (ret < 0) {
+		dev_warn(dsp->dev, "audio %s not written: %d\n", name, ret);
+		return ret;
+	}
+	if (ret != sizeof(msg)) {
+		dev_warn(dsp->dev,
+			 "audio %s short write: %d of %zu bytes (pipe full?)\n",
+			 name, ret, sizeof(msg));
+		return -EIO;
+	}
+	dev_info(dsp->dev, "audio %s (flags %u) written to pipe %d dir 1\n",
+		 name, flags, DSP_AUDIO_PIPE);
+	ctr_dsp_audio_kick(dsp, name);
+	return 0;
+}
+
+/*
+ * FUN_00106648's service loop, bounded and without the interrupt.  Every
+ * mailbox-2 word the core sends after the pipe-table base is a slot number,
+ * pipe * 2 + dir, meaning "that descriptor moved"; the semaphore is a
+ * separate wakeup that has to be cleared through PCLEAR or it stays latched.
+ *
+ * Deliberately polled rather than driven off GIC_SPI 0x2A.  PMASK has never
+ * been programmed on this port, so requesting the interrupt before the mask
+ * is known-good risks a storm during probe, and the one shell into this
+ * device is adb over the network.  The interrupt is what a streaming path
+ * will need; it is not what this handshake needs.
+ */
+static int ctr_dsp_audio_drain(struct ctr_dsp *dsp, unsigned int first_us)
+{
+	int drained = 0;
+	int i;
+
+	for (i = 0; i < 16; i++) {
+		u16 slot, sem;
+
+		sem = ctr_dsp_read(dsp, DSP_SEM);
+		if (sem) {
+			ctr_dsp_write(dsp, DSP_PCLEAR, sem);
+			ctr_dsp_settle();
+			dev_info(dsp->dev, "DSP semaphore 0x%04x\n", sem);
+		}
+
+		if (ctr_dsp_recv_data(dsp, 2, &slot, i ? 20000 : first_us))
+			break;
+		drained++;
+		dev_info(dsp->dev,
+			 "DSP notified slot 0x%02x (pipe %u dir %u)\n",
+			 slot & 0xff, (slot >> 1) & (DSP_NPIPES - 1), slot & 1);
+	}
+	return drained;
+}
+
+/*
+ * Read whatever the core left on pipe 2 dir 0 and print it in full.  The
+ * first word is the structure count; the rest are DSP data-*word* addresses,
+ * which is why they all sit above 0x8000 -- the audio structures live in the
+ * upper half of data space, the pipes down at 0x0c9f in the lower.  Anything
+ * without bit 15 set would mean the reply is not what we think it is, so say
+ * so rather than quietly indexing off it later.
+ */
+static int ctr_dsp_audio_reply(struct ctr_dsp *dsp)
+{
+	u16 reply[16];
+	unsigned int waited = 0;
+	int n, i, count, want;
+
+	/*
+	 * Two reads, not one, because libctru does it in two and the reason is
+	 * not stylistic: the count word and the address list behind it need not
+	 * become readable in the same instant.  A single block read that caught
+	 * only the count would return 2 -- a positive number, indistinguishable
+	 * from success to every caller above -- and the handshake would walk on
+	 * to the frame check with an empty address table and nothing to say.
+	 */
+	n = ctr_dsp_pipe_read(dsp, DSP_AUDIO_PIPE, 0, reply, sizeof(reply));
+	if (n < 0) {
+		dev_warn(dsp->dev, "audio reply unreadable: %d\n", n);
+		return n;
+	}
+	if (n < 2)
+		return n;
+
+	count = reply[0];
+	if (count < 0 || count > (int)ARRAY_SIZE(reply) - 1) {
+		dev_warn(dsp->dev,
+			 "audio reply claims %d structures, clamping to %zu\n",
+			 count, ARRAY_SIZE(reply) - 1);
+		count = ARRAY_SIZE(reply) - 1;
+	}
+	want = count * 2;
+
+	while (n - 2 < want && waited < 200) {
+		int more = ctr_dsp_pipe_read(dsp, DSP_AUDIO_PIPE, 0,
+					     (u8 *)reply + n, want - (n - 2));
+
+		if (more > 0) {
+			n += more;
+			continue;
+		}
+		msleep(20);
+		waited += 20;
+	}
+	if (n - 2 < want)
+		dev_warn(dsp->dev,
+			 "audio reply truncated: %d of %d address bytes after %ums\n",
+			 n - 2, want, waited);
+
+	dev_info(dsp->dev,
+		 "audio reply: %d bytes, %d structure addresses\n", n, count);
+
+	dsp->audio_naddr = 0;
+	for (i = 1; i * 2 < n && (size_t)(i - 1) < ARRAY_SIZE(dsp->audio_addr); i++) {
+		dev_info(dsp->dev, "  struct %2d: DSP data word 0x%04x%s\n",
+			 i - 1, reply[i],
+			 (reply[i] & 0x8000) ? "" : "  <- no bit15, unexpected");
+		dsp->audio_addr[i - 1] = reply[i];
+		dsp->audio_naddr = i;
+	}
+
+	/*
+	 * ndspInitialize() sets the semaphore a second time after it has read
+	 * the address list, and only then declares the DSP ready.  The first
+	 * kick wakes the task; this one tells it the host is done reading and
+	 * it may start mixing -- which is precisely the transition
+	 * ctr_dsp_audio_start() is about to arm and then watch.
+	 */
+	if (dsp->audio_naddr)
+		ctr_dsp_audio_kick(dsp, "reply consumed");
+	return n;
+}
+
+/*
+ * N3DS_DSP_AUDIO_START.  #305 got the reply.  This is what libctru does with
+ * it, and what #305 did not do at all.
+ *
+ * ndspInitialize() does not stop once the structure addresses are in hand.
+ * Its last lines are these:
+ *
+ *   DSP_SetSemaphore(0x4000);
+ *   frameCount = 0;
+ *   ndspFrameId = 4;
+ *   ndspSetCounter(0, 4);          // *(vu16 *)ndspVars[0][0] = 4
+ *   ndspFrameId++;
+ *   svcSignalEvent(dspSem);
+ *
+ * ndspSetCounter is a *store* into DSP data memory at the address structure 0
+ * named, and structure 0 is the frame counter.  #305 only ever loaded that
+ * word: it watched a counter nobody had started, and reported -- correctly --
+ * "core answered but is not mixing".  The counter is not a status word the
+ * firmware owns.  It is the ARM11's half of a two-party handshake, and the
+ * firmware will not run the mixer against a partner that has never announced a
+ * frame id.  Four is the id libctru opens with; the value is arbitrary but the
+ * write is not.
+ *
+ * The poll underneath is the measurement, not the mixer.  A finished driver
+ * has to keep answering every frame -- ndspThreadMain() updates the master and
+ * channel structures, stores the next id, signals, and repeats about every
+ * 4.888 ms -- and that needs structure layouts we have not laid out yet.  But
+ * a firmware that is mixing bumps this counter off its own clock, so half a
+ * second of watching separates "the audio pipeline is running" from "the core
+ * is still asleep" without writing a single sample, and which of those is true
+ * decides the shape of everything after it.
+ *
+ * The readback earns its two lines on its own.  No build has ever proven that
+ * an ARM11 store into DSP data memory lands.  ctr_dsp_pipe_notify() writes the
+ * pipe write pointer through this same port and the DSP's behaviour implies
+ * those stores worked, but an implication is not a word read back.
+ */
+#define DSP_AUDIO_FRAME_ID              4
+#define DSP_AUDIO_POLL_STEP_MS          5
+#define DSP_AUDIO_POLL_MS               500
+
+static void ctr_dsp_audio_start(struct ctr_dsp *dsp)
+{
+	unsigned int i, steps = DSP_AUDIO_POLL_MS / DSP_AUDIO_POLL_STEP_MS;
+	u16 val, prev, first;
+	int moved = 0;
+	u32 addr;
+
+	if (dsp->audio_naddr < 1)
+		return;
+
+	addr = (u32)dsp->audio_addr[0] * 2;
+
+	if (ctr_dsp_dmem_read(dsp, addr, &first, 1)) {
+		dev_warn(dsp->dev,
+			 "frame counter at DSP byte 0x%05x unreadable; audio start skipped\n",
+			 addr);
+		return;
+	}
+
+	val = DSP_AUDIO_FRAME_ID;
+	if (ctr_dsp_dmem_write_words(dsp, addr, &val, 1)) {
+		dev_warn(dsp->dev,
+			 "frame counter store to DSP byte 0x%05x failed; audio start skipped\n",
+			 addr);
+		return;
+	}
+	if (ctr_dsp_dmem_read(dsp, addr, &val, 1)) {
+		dev_warn(dsp->dev,
+			 "frame counter readback failed; audio start skipped\n");
+		return;
+	}
+
+	dev_info(dsp->dev,
+		 "audio frame counter at DSP byte 0x%05x: was 0x%04x, wrote 0x%04x, reads 0x%04x -- ARM11 stores into DSP data memory %s\n",
+		 addr, first, (u16)DSP_AUDIO_FRAME_ID, val,
+		 val == DSP_AUDIO_FRAME_ID ? "LAND" : "DO NOT LAND");
+
+	ctr_dsp_audio_kick(dsp, "frame counter armed");
+
+	prev = val;
+	for (i = 0; i < steps; i++) {
+		msleep(DSP_AUDIO_POLL_STEP_MS);
+		if (ctr_dsp_dmem_read(dsp, addr, &val, 1))
+			break;
+		if (val == prev)
+			continue;
+		moved++;
+		if (moved <= 8)
+			dev_info(dsp->dev,
+				 "DSP frame counter 0x%04x -> 0x%04x at %ums\n",
+				 prev, val,
+				 (i + 1) * DSP_AUDIO_POLL_STEP_MS);
+		prev = val;
+	}
+
+	if (moved)
+		dev_info(dsp->dev,
+			 "DSP frame counter advanced %d times in %ums: the audio pipeline is MIXING\n",
+			 moved, DSP_AUDIO_POLL_MS);
+	else
+		dev_warn(dsp->dev,
+			 "DSP frame counter still 0x%04x %ums after being set to 4 and kicked: the core answered but will not mix\n",
+			 prev, DSP_AUDIO_POLL_MS);
+}
+
+/*
+ * N3DS_DSP_AUDIO_EVIDENCE.  Three observations the old handshake never made.
+ *
+ * A descriptor snapshot is the only way to tell an acknowledged message from
+ * an ignored one: the DSP advances the read pointer of pipe 2 dir 1 in its
+ * own memory when it consumes, and that pointer is two bytes in a table we
+ * can already read.  Printing it before and after each message costs one
+ * word-sized port read and settles the question outright.
+ */
+/*
+ * N3DS_DSP_PIPE_BUFFER_READBACK.  The pipe buffers themselves, read straight
+ * out of DSP data memory at the address the descriptor names, bypassing every
+ * pointer the two sides disagree about.  `at` is a byte offset into the
+ * buffer; the caller passes the cursor it cares about.
+ */
+static void ctr_dsp_pipe_buffer_dump(struct ctr_dsp *dsp, unsigned int pipe,
+				     unsigned int dir, u16 at, size_t nbytes,
+				     const char *what)
+{
+	u8 buf[16];
+	u16 d[5];
+	u32 addr;
+
+	if (nbytes > sizeof(buf))
+		nbytes = sizeof(buf);
+
+	if (ctr_dsp_pipe_fetch(dsp, pipe, dir, d)) {
+		dev_warn(dsp->dev, "pipe %u dir %u %s: descriptor unreadable\n",
+			 pipe, dir, what);
+		return;
+	}
+
+	addr = (u32)d[0] * 2 + (at & 0x7fff);
+	if (ctr_dsp_dmem_read_bytes(dsp, addr, buf, nbytes)) {
+		dev_warn(dsp->dev,
+			 "pipe %u dir %u %s: buffer at 0x%05x unreadable\n",
+			 pipe, dir, what, addr);
+		return;
+	}
+
+	dev_info(dsp->dev, "pipe %u dir %u %s: DSP byte 0x%05x = %*ph\n",
+		 pipe, dir, what, addr, (int)nbytes, buf);
+}
+
+static void ctr_dsp_pipe_snapshot(struct ctr_dsp *dsp, unsigned int pipe,
+				  unsigned int dir, const char *when)
+{
+	u16 d[5];
+
+	if (ctr_dsp_pipe_fetch(dsp, pipe, dir, d)) {
+		dev_warn(dsp->dev, "pipe %u dir %u %s: descriptor unreadable\n",
+			 pipe, dir, when);
+		return;
+	}
+	dev_info(dsp->dev,
+		 "pipe %u dir %u %s: rd 0x%04x wr 0x%04x readable %u\n",
+		 pipe, dir, when, d[2], d[3], ctr_dsp_pipe_readable(d));
+}
+
+/*
+ * The audio structures live at DSP data word 0x8000 and up -- that is what
+ * the bit-15 addresses in the reply are, and it is the region the firmware
+ * mixes into whether or not anyone is listening.  If those words are not all
+ * zero, the audio task has run at least once and the missing piece is the
+ * reply path; if they never change, it has not.
+ */
+static void ctr_dsp_shared_dump(struct ctr_dsp *dsp, const char *when)
+{
+	u16 w[8];
+
+	if (ctr_dsp_dmem_read(dsp, 0x10000, w, ARRAY_SIZE(w))) {
+		dev_warn(dsp->dev, "audio shared region %s: unreadable\n", when);
+		return;
+	}
+	dev_info(dsp->dev,
+		 "audio shared region (DSP word 0x8000) %s: %04x %04x %04x %04x %04x %04x %04x %04x\n",
+		 when, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+}
+
+/*
+ * Wait for a reply the way something that expects one would: keep draining
+ * mailbox 2 (every word of it, not just the first), keep re-reading the
+ * descriptor, and only give up on a clock.  The old code read the pipe once,
+ * milliseconds after the message went out, which cannot distinguish a core
+ * that will never answer from one that answers on its next audio frame --
+ * and an audio frame here is 5 ms of samples, not microseconds.
+ *
+ * Returns whatever ctr_dsp_audio_reply() returned, or 0 if nothing arrived.
+ */
+static int ctr_dsp_audio_wait_reply(struct ctr_dsp *dsp, unsigned int ms)
+{
+	unsigned int waited = 0;
+	u16 last_rd = 0xffff, last_wr = 0xffff;
+
+	for (;;) {
+		u16 d[5];
+
+		ctr_dsp_audio_drain(dsp, 2000);
+
+		if (ctr_dsp_pipe_fetch(dsp, DSP_AUDIO_PIPE, 0, d) == 0) {
+			if (d[2] != last_rd || d[3] != last_wr) {
+				dev_info(dsp->dev,
+					 "pipe %d dir 0 moved at %ums: rd 0x%04x wr 0x%04x readable %u\n",
+					 DSP_AUDIO_PIPE, waited, d[2], d[3],
+					 ctr_dsp_pipe_readable(d));
+				last_rd = d[2];
+				last_wr = d[3];
+			}
+			if (ctr_dsp_pipe_readable(d))
+				return ctr_dsp_audio_reply(dsp);
+		}
+
+		if (waited >= ms)
+			return 0;
+		msleep(20);
+		waited += 20;
+	}
+}
+
+static void ctr_dsp_audio_handshake(struct ctr_dsp *dsp)
+{
+	int n;
+
+	if (!dsp->pipe_base)
+		return;
+
+	ctr_dsp_shared_dump(dsp, "before Initialize");
+
+	if (ctr_dsp_audio_msg(dsp, DSP_AUDIO_INITIALIZE,
+			      DSP_AUDIO_FLAGS_A, "Initialize"))
+		return;
+	/*
+	 * The acknowledgement we care about is not the mailbox word, it is the
+	 * read pointer of the pipe we just wrote.  If the DSP consumed the
+	 * message, rd catches up with wr here; if it did not, wr has moved and
+	 * rd has not, and the next message would stack up behind this one.
+	 */
+	ctr_dsp_audio_drain(dsp, 500000);
+	ctr_dsp_pipe_snapshot(dsp, DSP_AUDIO_PIPE, 1, "after Initialize");
+	/*
+	 * Offset 0, not the write cursor: the pipe started empty, so the
+	 * message we just sent begins at the top of the buffer whether or not
+	 * the DSP has since consumed it and moved the read pointer past it.
+	 * Expect 00 00 00 00 for Initialize -- which is why the second read
+	 * below, taken after Wakeup, is the one that proves the write path:
+	 * Wakeup is state 2, and a buffer that reads back 02 is a buffer the
+	 * ARM demonstrably wrote.
+	 */
+	ctr_dsp_pipe_buffer_dump(dsp, DSP_AUDIO_PIPE, 1, 0, 8,
+				 "buffer after Initialize");
+	ctr_dsp_pipe_buffer_dump(dsp, DSP_AUDIO_PIPE, 0, 0, 16,
+				 "buffer after Initialize");
+	n = ctr_dsp_audio_wait_reply(dsp, 1000);
+
+	/*
+	 * One escalation, and only one.  If the firmware came up in its low
+	 * power state it acknowledges Initialize without producing the address
+	 * list, and Wakeup is the documented way out of that.  If neither
+	 * produces a reply then the state machine is not where we think it is,
+	 * and the next step is evidence, not more messages.
+	 */
+	if (n <= 0) {
+		if (ctr_dsp_audio_msg(dsp, DSP_AUDIO_WAKEUP,
+				      DSP_AUDIO_FLAGS_A, "Wakeup"))
+			return;
+		ctr_dsp_audio_drain(dsp, 500000);
+		ctr_dsp_pipe_snapshot(dsp, DSP_AUDIO_PIPE, 1, "after Wakeup");
+		ctr_dsp_pipe_buffer_dump(dsp, DSP_AUDIO_PIPE, 1, 0, 8,
+					 "buffer after Wakeup");
+		n = ctr_dsp_audio_wait_reply(dsp, 1000);
+	}
+
+	/*
+	 * The last thing that is still a transcription rather than a guess: the
+	 * same Initialize, with the flags halfword the sysmodule would have
+	 * patched in on the other kind of console.  If this one answers, the
+	 * message body was the whole problem and the transport was never at
+	 * fault; if it does not, flags are ruled out for good and the next
+	 * capture is about the core, not the wire.
+	 */
+	if (n <= 0) {
+		if (ctr_dsp_audio_msg(dsp, DSP_AUDIO_INITIALIZE,
+				      DSP_AUDIO_FLAGS_B, "Initialize"))
+			return;
+		ctr_dsp_audio_drain(dsp, 500000);
+		ctr_dsp_pipe_snapshot(dsp, DSP_AUDIO_PIPE, 1,
+				      "after Initialize flags 2");
+		ctr_dsp_pipe_buffer_dump(dsp, DSP_AUDIO_PIPE, 1, 0, 8,
+					 "buffer after Initialize flags 2");
+		n = ctr_dsp_audio_wait_reply(dsp, 1000);
+		if (n > 0)
+			dev_info(dsp->dev,
+				 "audio replied only at flags 2; the flags halfword is required on this unit\n");
+	}
+
+	if (n <= 0) {
+		dev_warn(dsp->dev,
+			 "no audio reply on pipe %d dir 0 after Initialize, Wakeup and Initialize flags 2; pipe transport is proven, the audio state machine is not\n",
+			 DSP_AUDIO_PIPE);
+		/*
+		 * Everything that could still be true, printed once.  The
+		 * descriptor table says whether the core answered on a pipe
+		 * nobody was watching -- eight of the sixteen have never been
+		 * looked at after a message -- and the shared region says
+		 * whether the audio task ever ran at all.  Between them the
+		 * next capture picks the branch instead of guessing at it.
+		 */
+		ctr_dsp_pipes_report(dsp);
+		ctr_dsp_pipe_buffer_dump(dsp, DSP_AUDIO_PIPE, 0, 0, 16,
+					 "reply buffer, pointers ignored");
+		ctr_dsp_shared_dump(dsp, "after Initialize and Wakeup");
+		return;
+	}
+
+	ctr_dsp_audio_start(dsp);
+}
+
+static int ctr_dsp_release_and_wait(struct ctr_dsp *dsp, u16 reply_irq_mask,
+				    bool wait_boot_replies)
+{
+	u16 cfg;
+	int reg, timeout, discard;
+
+	/*
+	 * N3DS_DSP_RELEASE_IS_FUN_00107294.  The whole prologue, transcribed:
+	 *
+	 *   loop: ldrh r1,[base,#0xc] / tst r1,#0x4 / bne loop   wait_reset
+	 *   ldrh r0,[base,#0x8] / tst r0,#0x1 / beq skip
+	 *     ldrh r2,[base,#0x8] / bic r2,#0xe00 / strh          drop IRQ mask
+	 *     strh #0,[base,#0x10]                                PSEM  = 0
+	 *     strh #0xffff,[base,#0x18]                           PCLEAR
+	 *     delay 0x60
+	 *     ldrh [base,#0x24] / ldrh [base,#0x2c] / ldrh [base,#0x34]
+	 *     delay 0x60                                          drain REP0-2
+	 *   skip:
+	 *   ldrh r0,[base,#0x8] / orr r0,mask lsl #9 / strh
+	 *   delay 0x60
+	 *   ldrh r0,[base,#0x8] / bic r0,#0x1 / strh              release
+	 *   delay 0x60
+	 *
+	 * The wait comes *first*, before anything else, which is where this
+	 * driver originally had it.  Kernel #292 moved it after a write of
+	 * `cfg & 0xf1ff` that was described in the comment as clearing the
+	 * reset -- but 0xf1ff preserves bit 0, so it never cleared anything,
+	 * and the log proves it: "reset-busy never cleared: PSTS=0x0104
+	 * PCFG=0x5003".  Reset still asserted, exactly as before the change.
+	 * The reorder was a no-op dressed up as a fix.  Restored to Horizon's
+	 * order, and the three REP reads Horizon performs -- which this driver
+	 * never did -- are now here too: a reply left sitting in REP0 from a
+	 * previous attempt would otherwise satisfy the boot-reply wait below
+	 * with stale data.
+	 */
+	if (ctr_dsp_wait_reset(dsp))
+		return -ETIMEDOUT;
+
+	cfg = ctr_dsp_read(dsp, DSP_PCFG);
+	if (cfg & PCFG_RESET) {
+		ctr_dsp_write(dsp, DSP_PCFG, cfg & 0xf1ff);
+		ctr_dsp_write(dsp, DSP_PSEM, 0);
+		ctr_dsp_write(dsp, DSP_PCLEAR, 0xffff);
+		ctr_dsp_settle();
+		ctr_dsp_read(dsp, DSP_REP0);
+		ctr_dsp_read(dsp, DSP_REP1);
+		ctr_dsp_read(dsp, DSP_REP2);
+		ctr_dsp_settle();
+	}
+
+	cfg = ctr_dsp_read(dsp, DSP_PCFG);
+	cfg |= (reply_irq_mask & 7) << 9;
+	ctr_dsp_write(dsp, DSP_PCFG, cfg);
+	wmb();
+	ctr_dsp_settle();
+
+	cfg = ctr_dsp_read(dsp, DSP_PCFG);
+	ctr_dsp_write(dsp, DSP_PCFG, cfg & ~(u16)PCFG_RESET);
+	ctr_dsp_settle();
+
+	/*
+	 * N3DS_DSP_PMASK_IS_FUN_0010388c.  Horizon writes PMASK *after* the
+	 * release returns, not before it:
+	 *
+	 *   bl 0x00107294            release (this function, up to here)
+	 *   ldr r0,[r8,#0x68] / mvn r0,r0 / uxth r0
+	 *   bl 0x0010388c            strh r0,[base,#0x14] / delay 0x60
+	 *
+	 * and the value is the *complement* of the reply mask, which for the
+	 * mask of 0 this driver uses is 0xffff either way -- so this is an
+	 * ordering fix, not a value fix.  Writing an interrupt mask while the
+	 * core is still held in reset is the kind of half-configured port
+	 * state the settle delays exist to avoid.
+	 */
+	ctr_dsp_write(dsp, DSP_PMASK, (u16)~reply_irq_mask);
+	ctr_dsp_settle();
+
+	if (!wait_boot_replies)
+		return 0;
+	for (reg = 0; reg < 3; reg++) {
+		discard = 64;
+again:
+		timeout = 500000;
+		/*
+		 * Re-verified 2026-09-07 directly against the raw disassembly
+		 * of the recovered DSP function FUN_001040a8 (see
+		 * scratch/dsp-code-analysis/corpus/disassembly/001040a8_FUN_001040a8.txt):
+		 *
+		 *   001040a8  ldr  r1, [0x1040dc]
+		 *   001040ac  mov  r2, #1
+		 *   001040b0  mov  r2, r2, lsl r0
+		 *   001040b8  ldrh r3, [r1,#0xc]      ; r3 = PSTS
+		 *   001040bc  tst  r3, r2, lsl #0xa   ; test bit (r0+10)
+		 *   001040c0  beq  0x001040b8         ; loop WHILE the bit is 0
+		 *   001040c4  ...                     ; only then read REPn
+		 *
+		 * That is "spin while clear, proceed once set" -- the DSP sets
+		 * the bit to hand a reply to the ARM; there is no separate
+		 * ARM-side "wait for clear" step anywhere in this function. The
+		 * previous revision of this comment asserted the opposite
+		 * (wait for the bit to go back to 0) while citing this same
+		 * function as its evidence, which was a misreading: it
+		 * contradicts the disassembly above and reintroduces the
+		 * original -ETIMEDOUT/-110 boot failure, since a "wait for
+		 * clear" loop here never actually waits for the DSP's reply.
+		 * Restored to match FUN_001040a8 exactly.
+		 */
+		while (!(ctr_dsp_read(dsp, DSP_PSTS) & BIT(reg + 10))) {
+			if (!--timeout) {
+				/* N3DS_DSP_BOOT_TIMEOUT_DIAGNOSTICS: every prior
+				 * capture of this failure recorded only the bare
+				 * -110 return value, with no register state to
+				 * tell which of the 3 expected replies never
+				 * arrived or whether the DSP looked alive at all
+				 * at the moment we gave up. */
+				dev_err(dsp->dev,
+					"boot reply %d/3 timed out: PSTS=0x%04x PSEM=0x%04x PCFG=0x%04x\n",
+					reg, ctr_dsp_read(dsp, DSP_PSTS),
+					ctr_dsp_read(dsp, DSP_PSEM),
+					ctr_dsp_read(dsp, DSP_PCFG));
+				return -ETIMEDOUT;
+			}
+			udelay(1);
+		}
+		{
+			/*
+			 * N3DS_DSP_REPLY_IS_RETRIED_NOT_FATAL.  Horizon's boot
+			 * sequence FUN_0010303c does not treat a reply other
+			 * than 1 as an error -- it calls FUN_001040a8 again:
+			 *
+			 *   0078: cpy r0,r4 / bl 0x001040a8
+			 *   0080: cmp r0,#0x1
+			 *   0088: bne 0x00103078        <- go round again
+			 *   008c: add r0,r4,#1 ...      <- only then next reg
+			 *
+			 * so a non-1 word is a reply the ARM is expected to
+			 * discard and keep waiting through, not a protocol
+			 * violation.  Returning -EIO here would fail a boot
+			 * that Horizon would have completed.  Bounded, because
+			 * unlike Horizon we cannot afford to hang probe.
+			 */
+			u16 rep = ctr_dsp_read(dsp, DSP_REP0 + reg * 8);
+
+			if (rep != 1) {
+				dev_info(dsp->dev,
+					 "boot reply %d/3 was 0x%04x, not 1; waiting again\n",
+					 reg, rep);
+				if (--discard > 0) {
+					udelay(1);
+					goto again;
+				}
+				dev_err(dsp->dev,
+					"boot reply %d/3 never returned 1\n",
+					reg);
+				return -EIO;
+			}
+		}
+		udelay(1);
+	}
+	return 0;
+}
+
+/*
+ * Push one segment into DSP memory. `use_fifo` picks the transport: the
+ * ARM11-side aperture (fast, but only correct if our idea of the aperture
+ * layout matches the core's) or the DSP_PADR/DSP_PDATA port (slow, but
+ * addressed in the core's own word addresses).
+ */
+static int ctr_dsp_write_segment(struct ctr_dsp *dsp,
+				 const struct dsp1_segment *seg,
+				 const void *data, u32 size, bool use_fifo)
+{
+	u32 offset;
+	int ret;
+
+	if (!use_fifo) {
+		ret = ctr_dsp_segment_offset(seg, &offset);
+		if (ret)
+			return ret;
+		memcpy_toio(dsp->wram + offset, data, size);
+		return 0;
+	}
+
+	/* Odd trailing bytes cannot exist in a 16-bit word machine's image,
+	 * and silently dropping one would desynchronise every later word. */
+	if (size & 1)
+		return -EINVAL;
+	return ctr_dsp_fifo_write(dsp, ctr_dsp_segment_memsel(seg),
+				  ctr_dsp_segment_word_addr(seg),
+				  (const u16 *)data, size / 2);
+}
+
+static int ctr_dsp_upload_firmware_once(struct ctr_dsp *dsp,
+					const struct dsp1_segment *segs,
+					int nsegs, bool use_fifo)
+{
+	u8 special[0x214];
+	u32 offset, special_addr, special_size;
+	u8 special_area, flags;
+	int i, ret;
+
+	/*
+	 * N3DS_DSP_UPLOAD_WITH_THE_CORE_RELEASED.
+	 *
+	 * Kernel #293 is the capture that settles this.  On the second boot
+	 * attempt the driver wrote segment 0 through the DSP_PADR/DSP_PDATA
+	 * port -- the write drained cleanly, PSTS reporting WRITE_FIFO_EMPTY
+	 * with WRITE_BUSY clear -- and then read the same words back through
+	 * the same port, at the same word address, in the same memory space,
+	 * and got 0000 0000 0000 0000.  A port that writes and reads the same
+	 * address and disagrees with itself is not an addressing bug, and it
+	 * kills the "the aperture is mapped somewhere else" theory outright:
+	 * the aperture was not involved in that attempt at all.
+	 *
+	 * The one thing both attempts had in common is that every port access
+	 * happened with PCFG_RESET asserted, because this function used to
+	 * enter reset before uploading anything.  Horizon never does that.
+	 * Every port access in the sysmodule -- FUN_00102f24, FUN_0010321c --
+	 * runs with the core released; the only functions that touch PCFG bit
+	 * 0 at all are FUN_0010406c (assert) and FUN_00107294 (release), and
+	 * the boot sequence FUN_0010303c calls them back to back with no
+	 * upload in between, because the firmware is already in DSP memory by
+	 * the time it runs.  Holding the core in reset stops the memory
+	 * arrays being clocked: reads return zeroes and the block is left
+	 * mid-transfer, which is also where the stuck PSTS bit 2 comes from.
+	 * #293 shows bit 2 rising during the upload and never falling again,
+	 * so the 180 ms wait in ctr_dsp_release_and_wait() was waiting on
+	 * damage this function had already done.
+	 *
+	 * So: port traffic happens with the core running, and the reset is
+	 * pulsed afterwards.  That is Horizon's order, and it is the only
+	 * order in which the port has ever been observed to work.
+	 *
+	 * The aperture is the exception, and deliberately so.  It is a plain
+	 * ARM11 window into DSP RAM rather than a transfer engine, and #293
+	 * proves it works with the reset asserted -- "segment 0 WRAM readback
+	 * OK" was captured in exactly that state.  Whether it still works
+	 * with the core released is unknown and untested, and there is a real
+	 * possibility it does not, because a running core owning its own
+	 * memory is the obvious reason for a window like this to be gated.
+	 * So the aperture path keeps the state it is known good in and only
+	 * the port path moves.  Changing both at once would have thrown away
+	 * the one transfer in this driver that has ever demonstrably worked.
+	 */
+	ctr_dsp_power_on(dsp);
+	if (!use_fifo) {
+		ret = ctr_dsp_enter_reset(dsp);
+		if (ret)
+			return ret;
+	}
+	/*
+	 * Take every bank for the ARM11 before touching the aperture, the way
+	 * FUN_00105528 does with FUN_001035b4(type, bank, 1, 0).  On the port
+	 * path this is unproven either way -- the port reaches DSP memory
+	 * through the core's own addressing, so it may want the DSP to own
+	 * the banks -- but the port is only the fallback, and leaving both
+	 * paths in the same state keeps the aperture result interpretable.
+	 */
+	ctr_dsp_swram_set_master(dsp, SWRAM_MASTER_ARM11);
+
+	dev_info(dsp->dev, "uploading %d segments over the %s\n", nsegs,
+		 use_fifo ? "DSP_PADR/DSP_PDATA port" : "WRAM aperture");
+	memset_io(dsp->wram, 0, DSP_WRAM_SIZE);
+	for (i = 0; i < nsegs; i++) {
+		ret = ctr_dsp_write_segment(dsp, &segs[i],
+					    dsp->fw->data + segs[i].file_offset,
+					    segs[i].size, use_fifo);
+		if (ret)
+			goto fail_reset;
+	}
+
+	/* N3DS_DSP_UPLOAD_READBACK_DIAGNOSTICS: every boot-reply timeout so
+	 * far only tells us the DSP core never signals back -- it says
+	 * nothing about whether the memcpy_toio() above actually landed in
+	 * DSP-visible WRAM. Read segment 0 straight back through the same
+	 * __iomem mapping and compare, so a corrupted/bypassed transfer is
+	 * distinguishable from a core that received good code but never
+	 * started running it. */
+	if (nsegs > 0 && !use_fifo) {
+		u32 chk = min_t(u32, segs[0].size, 64);
+		u8 rb[64];
+
+		ret = ctr_dsp_segment_offset(&segs[0], &offset);
+		if (!ret) {
+			memcpy_fromio(rb, dsp->wram + offset, chk);
+			if (memcmp(rb, dsp->fw->data + segs[0].file_offset, chk))
+				dev_err(dsp->dev,
+					"segment 0 WRAM readback mismatch (first %u bytes)\n",
+					chk);
+			else
+				dev_info(dsp->dev,
+					 "segment 0 WRAM readback OK (first %u bytes)\n",
+					 chk);
+		}
+	}
+
+	flags = dsp->fw->data[0x10f];
+	if (flags & 2) {
+		special_area = dsp->fw->data[0x10d];
+		special_addr = get_unaligned_le32(dsp->fw->data + 0x110);
+		special_size = get_unaligned_le32(dsp->fw->data + 0x114);
+		if (special_size > sizeof(special)) {
+			ret = -EINVAL;
+			goto fail_reset;
+		}
+		{
+			struct dsp1_segment generated = {
+				.target_addr = special_addr,
+				.size = special_size,
+				.area_type = special_area,
+			};
+
+			ret = ctr_dsp_segment_offset(&generated, &offset);
+			if (ret)
+				goto fail_reset;
+			get_random_bytes(special, special_size);
+			ret = ctr_dsp_write_segment(dsp, &generated, special,
+						    special_size, use_fifo);
+			memzero_explicit(special, sizeof(special));
+		}
+		if (ret)
+			goto fail_reset;
+	}
+
+	/*
+	 * Now pulse the core: assert PCFG_RESET and wait for reset-busy to
+	 * fall (FUN_0010406c), then release it (FUN_00107294).
+	 * N3DS_DSP_RESET_PULSE_IS_ADJACENT.  For the aperture path the reset
+	 * is already asserted and FUN_0010406c returns immediately in that
+	 * case -- "tst r0,#0x1 / bne return" -- so this is a no-op there and
+	 * the real assert for the port path.
+	 */
+	/*
+	 * Hand the banks to the DSP, then pulse the core.  This is the step
+	 * the driver has been missing: FUN_00106328 runs both
+	 * FUN_001035b4(1, bank, 1, 1) and FUN_001035b4(2, bank, 1, 1) loops
+	 * and only then calls FUN_0010303c, which asserts and releases the
+	 * reset.  A core released while the ARM11 still masters its memory
+	 * has nothing to fetch.
+	 *
+	 * The dump afterwards is the check: these are plain CFG11 bytes and
+	 * reading them back is safe, so if the written values do not stick
+	 * the log says so directly rather than leaving another boot-reply
+	 * timeout to interpret.  The aperture is deliberately *not* read
+	 * after the handover -- reading WRAM the ARM11 no longer owns is the
+	 * kind of access that raises an imprecise external abort on this SoC.
+	 */
+	ctr_dsp_swram_set_master(dsp, SWRAM_MASTER_DSP);
+	ctr_dsp_swram_dump(dsp, "after handover to the DSP");
+
+	ret = ctr_dsp_enter_reset(dsp);
+	if (ret)
+		goto fail_reset;
+	dev_info(dsp->dev, "entered reset: PSTS=0x%04x PCFG=0x%04x\n",
+		 ctr_dsp_read(dsp, DSP_PSTS), ctr_dsp_read(dsp, DSP_PCFG));
+
+	ret = ctr_dsp_release_and_wait(dsp, 0, flags & 1);
+	if (ret)
+		goto fail_reset;
+	dsp->ready = true;
+	dev_info(dsp->dev, "firmware uploaded and boot replies accepted\n");
+
+	/*
+	 * N3DS_DSP_FIFO_CROSSCHECK, moved here from before the reset pulse.
+	 * It reads DSP memory through the core's own port and compares it
+	 * with the image we uploaded, which is the one check that can tell a
+	 * bad transfer from a core that got good code and never ran it.  It
+	 * belongs after the boot, not before it: this is a port access, and a
+	 * port access only means anything with the core released.  Run in
+	 * reset, as it was in #291-#293, it returned zeroes every time and
+	 * left the read port mid-burst with PSTS bit 2 stuck, which then made
+	 * every later reset handshake time out.  The diagnostic was causing
+	 * the failure it was there to explain.
+	 */
+	/*
+	 * N3DS_DSP_CROSSCHECK_IS_DATA_SPACE.  #296 checked segs[0], which is a
+	 * *Program* segment, and reported
+	 *
+	 *   post-boot FIFO crosscheck MISMATCH: want 4180 001e 4180 43fd
+	 *                                        got 0000 0000 0000 0000
+	 *
+	 * on a boot where the core demonstrably ran that same code -- it sent
+	 * all three boot replies.  So the code was there; the read was not
+	 * reading it.  PCFG_MEMSEL_PROGRAM (5) is a guess this driver has
+	 * never had a way to check, and Horizon never reads program space
+	 * through this port at all: FUN_0010331c, its only DSP-memory reader,
+	 * passes memsel 0 unconditionally, and PCFG_MEMSEL_DATA is 0.
+	 *
+	 * Point the check at a Data segment instead.  That tests the exact
+	 * path the pipes need and the only one the sysmodule vouches for, and
+	 * it stops reporting a mismatch that says nothing about the firmware.
+	 */
+	{
+		int ci = -1, i;
+
+		for (i = 0; i < nsegs; i++) {
+			if (segs[i].area_type == 2 && segs[i].size >= 2) {
+				ci = i;
+				break;
+			}
+		}
+		if (ci < 0) {
+			dev_info(dsp->dev,
+				 "no data segment to crosscheck against\n");
+		} else {
+			u16 want[8], got[8];
+			u32 words = min_t(u32, segs[ci].size / 2,
+					  ARRAY_SIZE(want));
+
+			memcpy(want, dsp->fw->data + segs[ci].file_offset,
+			       words * 2);
+			ret = ctr_dsp_fifo_read(dsp, PCFG_MEMSEL_DATA,
+						ctr_dsp_segment_word_addr(&segs[ci]),
+						got, words);
+			if (ret)
+				dev_warn(dsp->dev,
+					 "post-boot data crosscheck unreadable: %d\n",
+					 ret);
+			else if (memcmp(want, got, words * 2))
+				dev_warn(dsp->dev,
+					 "post-boot data crosscheck MISMATCH seg %d: want %04x %04x %04x %04x got %04x %04x %04x %04x\n",
+					 ci, want[0], want[1], want[2], want[3],
+					 got[0], got[1], got[2], got[3]);
+			else
+				dev_info(dsp->dev,
+					 "post-boot data crosscheck OK (seg %d, %u words)\n",
+					 ci, words);
+			ret = 0;
+		}
+	}
+
+	/*
+	 * N3DS_DSP_PIPE_BASE.  One more mailbox-2 word after the three boot
+	 * replies; see the FUN_00106648 transcript above ctr_dsp_recv_data().
+	 * Not fatal if it never arrives -- the core has booted either way, and
+	 * saying so plainly beats failing a probe that otherwise succeeded.
+	 */
+	{
+		u16 base;
+
+		ret = ctr_dsp_recv_data(dsp, 2, &base, 500000);
+		if (ret) {
+			dev_warn(dsp->dev,
+				 "no pipe-table base after the boot replies (%d); pipes unavailable\n",
+				 ret);
+			dsp->pipe_base = 0;
+			ret = 0;
+		} else {
+			dsp->pipe_base = (u32)base << 1;
+			dev_info(dsp->dev,
+				 "pipe table base: REP2=0x%04x -> DSP data byte 0x%05x\n",
+				 base, dsp->pipe_base);
+			ctr_dsp_pipes_report(dsp);
+			ctr_dsp_audio_handshake(dsp);
+		}
+	}
+	return 0;
+
+fail_reset:
+	ctr_dsp_enter_reset(dsp);
+	/*
+	 * Give the banks back to the ARM11 on the way out.  The FIFO-port
+	 * retry re-runs this whole function and memset_io()s the aperture
+	 * first, which would fault or silently do nothing against banks the
+	 * DSP still owns.
+	 */
+	ctr_dsp_swram_set_master(dsp, SWRAM_MASTER_ARM11);
+	return ret;
+}
+
+/*
+ * N3DS_DSP_UPLOAD_FALLBACK: the aperture path is the one Horizon uses and is
+ * ~200x faster, so keep trying it first; but a boot-reply timeout means the
+ * core did not execute what we believe we wrote, and re-running the identical
+ * transfer over the identical mapping cannot change that. Fall back once to
+ * the FIFO port, which reaches DSP memory by the core's own addressing.
+ */
+static int ctr_dsp_upload_firmware(struct ctr_dsp *dsp,
+				   const struct dsp1_segment *segs, int nsegs)
+{
+	int ret = ctr_dsp_upload_firmware_once(dsp, segs, nsegs, false);
+
+	if (ret != -ETIMEDOUT)
+		return ret;
+
+	dev_warn(dsp->dev,
+		 "aperture upload did not boot the core, retrying over the FIFO port\n");
+	ret = ctr_dsp_upload_firmware_once(dsp, segs, nsegs, true);
+	if (!ret)
+		dev_info(dsp->dev, "FIFO-port upload booted the core\n");
+	return ret;
+}
+
+static int ctr_dsp_open(struct inode *inode, struct file *filp)
+{
+	struct miscdevice *misc = filp->private_data;
+	struct ctr_dsp *dsp = container_of(misc, struct ctr_dsp, misc);
+
+	/* No per-open state: every opener shares the one DSP instance
+	 * through dsp->io_lock, mirroring the single-owner FIFO port the
+	 * hardware exposes. Readiness is re-checked per ioctl, not here, so
+	 * a caller can still poll CTR_DSP_IOC_GET_READY before dsp->ready
+	 * becomes true. */
+	filp->private_data = dsp;
+	return 0;
+}
+
+static int ctr_dsp_release(struct inode *inode, struct file *filp)
+{
+	return 0;
+}
+
+/*
+ * CTR_DSP_IOC_POKE_WORDS/CTR_DSP_IOC_GET_READY: a generic memory-poke
+ * transport over the documented DSP_PDATA/PADR/PCFG FIFO port
+ * (ctr_dsp_fifo_write() above). This ioctl does not know, and does not
+ * claim to know, the resident DSP1 firmware's PCM/audio buffer address or
+ * command protocol -- see include/uapi/linux/ctr_dsp.h for the evidence
+ * boundary. Any real hardware access is gated on dsp->ready (the firmware
+ * boot handshake in ctr_dsp_upload_firmware() having completed); if the
+ * DSP never became ready this returns -ENODEV and never crashes or hangs
+ * the caller.
+ */
+static long ctr_dsp_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
+{
+	struct ctr_dsp *dsp = filp->private_data;
+	void __user *argp = (void __user *)arg;
+	struct ctr_dsp_poke *poke;
+	u32 memsel, ready;
+	int ret;
+
+	if (_IOC_TYPE(cmd) != CTR_DSP_IOC_MAGIC)
+		return -ENOTTY;
+
+	switch (cmd) {
+	case CTR_DSP_IOC_GET_READY:
+		ready = READ_ONCE(dsp->ready) ? 1 : 0;
+		if (copy_to_user(argp, &ready, sizeof(ready)))
+			return -EFAULT;
+		return 0;
+
+	case CTR_DSP_IOC_POKE_WORDS:
+		if (!READ_ONCE(dsp->ready))
+			return -ENODEV;
+
+		poke = kmalloc(sizeof(*poke), GFP_KERNEL);
+		if (!poke)
+			return -ENOMEM;
+		if (copy_from_user(poke, argp, sizeof(*poke))) {
+			ret = -EFAULT;
+			goto out_free;
+		}
+		if (poke->count > CTR_DSP_POKE_MAX_WORDS) {
+			ret = -EINVAL;
+			goto out_free;
+		}
+		switch (poke->memsel) {
+		case CTR_DSP_MEMSEL_DATA:
+			memsel = PCFG_MEMSEL_DATA;
+			break;
+		case CTR_DSP_MEMSEL_PROGRAM:
+			memsel = PCFG_MEMSEL_PROGRAM;
+			break;
+		default:
+			ret = -EINVAL;
+			goto out_free;
+		}
+		if ((u64)poke->addr + poke->count > DSP_WRAM_SIZE / 2) {
+			ret = -EINVAL;
+			goto out_free;
+		}
+
+		mutex_lock(&dsp->io_lock);
+		if (!dsp->ready)
+			ret = -ENODEV;
+		else
+			ret = ctr_dsp_fifo_write(dsp, memsel, poke->addr,
+						 poke->words, poke->count);
+		mutex_unlock(&dsp->io_lock);
+out_free:
+		kfree(poke);
+		return ret;
+
+	default:
+		return -ENOTTY;
+	}
+}
+
+static const struct file_operations ctr_dsp_fops = {
+	.owner		= THIS_MODULE,
+	.open		= ctr_dsp_open,
+	.release	= ctr_dsp_release,
+	.unlocked_ioctl	= ctr_dsp_ioctl,
+	.llseek		= no_llseek,
+};
+
+static int ctr_dsp_probe(struct platform_device *pdev)
+{
+	int ret;
+	u32 psts;
+	struct ctr_dsp *dsp;
+	struct dsp1_segment segs[DSP1_MAX_SEGMENTS];
+	int nsegs;
+
+	dsp = devm_kzalloc(&pdev->dev, sizeof(*dsp), GFP_KERNEL);
+	if (!dsp)
+		return -ENOMEM;
+
+	dsp->dev = &pdev->dev;
+
+	/* N3DS_DSP_PROBE_DIAGNOSTICS: every one of the four resource
+	 * acquisitions below used to return its errno with no message at all,
+	 * so a probe that aborted here was indistinguishable in a dmesg
+	 * capture from a driver that was never built or never bound -- and we
+	 * burned a hardware round-trip on exactly that ambiguity. Each failure
+	 * now names the resource and the errno. Note dev_err() is correct even
+	 * this early: the struct device is fully initialised by the platform
+	 * core before probe is ever called. */
+	dsp->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(dsp->base)) {
+		dev_err(dsp->dev, "reg 0 (registers) map failed: %ld\n",
+			PTR_ERR(dsp->base));
+		return PTR_ERR(dsp->base);
+	}
+	dsp->wram = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(dsp->wram)) {
+		dev_err(dsp->dev, "reg 1 (wram) map failed: %ld\n",
+			PTR_ERR(dsp->wram));
+		return PTR_ERR(dsp->wram);
+	}
+	dsp->pdn = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(dsp->pdn)) {
+		dev_err(dsp->dev, "reg 2 (pdn) map failed: %ld\n",
+			PTR_ERR(dsp->pdn));
+		return PTR_ERR(dsp->pdn);
+	}
+
+	/*
+	 * Optional so that a kernel built from this tree still probes against
+	 * an older DTB; without it the bank handover simply does not happen
+	 * and the DSP behaves exactly as it did before #296, which is a
+	 * legible failure rather than a probe abort.
+	 */
+	dsp->swram = devm_platform_ioremap_resource(pdev, 3);
+	if (IS_ERR(dsp->swram)) {
+		dev_warn(dsp->dev,
+			 "reg 3 (sharedwram) map failed: %ld -- DSP WRAM banks will not be handed over, update the DTB\n",
+			 PTR_ERR(dsp->swram));
+		dsp->swram = NULL;
+	}
+
+	dsp->irq = platform_get_irq(pdev, 0);
+	if (dsp->irq < 0) {
+		dev_err(dsp->dev, "no interrupt: %d\n", dsp->irq);
+		return dsp->irq;
+	}
+
+	psts = ctr_dsp_read(dsp, DSP_PSTS);
+	ctr_dsp_swram_dump(dsp, "at probe");
+	ctr_dsp_bus_liveness(dsp, "at probe, before power-on");
+	dev_info(dsp->dev, "DSP_PSTS=0x%04x (reset_busy=%d)\n",
+		 psts, !!(psts & PSTS_RESET_BUSY));
+
+	mutex_init(&dsp->io_lock);
+	/* Register the /dev node unconditionally, independent of whether
+	 * firmware upload below succeeds: userspace must be able to open it
+	 * and poll CTR_DSP_IOC_GET_READY (which reflects dsp->ready) rather
+	 * than infer DSP state from the node's mere existence. */
+	dsp->misc.minor = MISC_DYNAMIC_MINOR;
+	dsp->misc.name = "ctr_dsp0";
+	dsp->misc.fops = &ctr_dsp_fops;
+	dsp->misc.parent = &pdev->dev;
+	ret = misc_register(&dsp->misc);
+	if (ret)
+		return ret;
+
+	/* Firmware is optional at this stage (not yet uploaded to
+	 * hardware -- see file header). Missing firmware is not a
+	 * probe failure. */
+	ret = request_firmware(&dsp->fw, "3ds/dspfirm.cdc", dsp->dev);
+	if (ret) {
+		dev_info(dsp->dev,
+			 "no dspfirm.cdc available (%d), audio unavailable\n",
+			 ret);
+		platform_set_drvdata(pdev, dsp);
+		return 0;
+	}
+
+	ret = ctr_dsp_parse_firmware(dsp, dsp->fw, segs, &nsegs);
+	if (ret) {
+		release_firmware(dsp->fw);
+		dsp->fw = NULL;
+		misc_deregister(&dsp->misc);
+		return ret;
+	}
+
+	ret = ctr_dsp_upload_firmware(dsp, segs, nsegs);
+	if (ret) {
+		/* N3DS_DSP_NODE_SURVIVES_BOOT_FAILURE: a failed handshake is
+		 * not a probe failure -- see the /dev-node comment above.
+		 * dsp->ready is already false (never set), so
+		 * CTR_DSP_IOC_GET_READY reports the true state and
+		 * CTR_DSP_IOC_POKE_WORDS still refuses with -ENODEV. Tearing
+		 * the node down here (the previous behavior) meant
+		 * /dev/ctr_dsp0 never existed on any boot, since the boot
+		 * handshake has never once succeeded on real hardware --
+		 * exactly the "infer state from the node's mere existence"
+		 * failure mode the comment above was written to avoid. */
+		dev_err(dsp->dev, "firmware upload/boot failed: %d\n", ret);
+		release_firmware(dsp->fw);
+		dsp->fw = NULL;
+	}
+
+	platform_set_drvdata(pdev, dsp);
+	return 0;
+}
+
+static int ctr_dsp_remove(struct platform_device *pdev)
+{
+	struct ctr_dsp *dsp = platform_get_drvdata(pdev);
+
+	misc_deregister(&dsp->misc);
+	if (dsp->ready)
+		ctr_dsp_enter_reset(dsp);
+	if (dsp->fw)
+		release_firmware(dsp->fw);
+	return 0;
+}
+
+static const struct of_device_id ctr_dsp_of_match[] = {
+	{ .compatible = "nintendo," DRIVER_NAME },
+	{},
+};
+MODULE_DEVICE_TABLE(of, ctr_dsp_of_match);
+
+static struct platform_driver ctr_dsp_driver = {
+	.probe		= ctr_dsp_probe,
+	.remove		= ctr_dsp_remove,
+
+	.driver		= {
+		.name	= DRIVER_NAME,
+		.owner	= THIS_MODULE,
+		.of_match_table = of_match_ptr(ctr_dsp_of_match),
+	},
+};
+
+/* N3DS_DSP_REGISTER_DIAGNOSTIC: see the probe-diagnostic comment above.
+ * A capture with no 3ds-dsp line at all cannot distinguish "driver never
+ * registered" from "registered but the DT node never bound". This does. */
+static int __init ctr_dsp_init(void)
+{
+	int ret = platform_driver_register(&ctr_dsp_driver);
+
+	pr_info("3ds-dsp: driver registered: %d (probe follows only if a "
+		"nintendo,3ds-dsp node bound)\n", ret);
+	return ret;
+}
+
+static void __exit ctr_dsp_exit(void)
+{
+	platform_driver_unregister(&ctr_dsp_driver);
+}
+
+module_init(ctr_dsp_init);
+module_exit(ctr_dsp_exit);
+
+MODULE_FIRMWARE("3ds/dspfirm.cdc");
+MODULE_DESCRIPTION("Nintendo 3DS DSP (Teak Lite II) coprocessor driver");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform:" DRIVER_NAME);
