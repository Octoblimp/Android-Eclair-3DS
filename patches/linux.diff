 {
 	csd_lock_wait(csd);
@@ -509,7 +642,7 @@ int smp_call_function_single(int cpu, smp_call_func_t func, void *info,
 	err = generic_exec_single(cpu, csd);
 
 	if (wait)
-		csd_lock_wait(csd);
+		csd_lock_wait_cpu(csd, cpu);
 
 	put_cpu();
 
@@ -686,7 +819,7 @@ static void smp_call_function_many_cond(const struct cpumask *mask,
 			call_single_data_t *csd;
 
 			csd = per_cpu_ptr(cfd->csd, cpu);
-			csd_lock_wait(csd);
+			csd_lock_wait_cpu(csd, cpu);
 		}
 	}
 }
