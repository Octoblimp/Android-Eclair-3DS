+    host_app_area.wmi_protocol_ver = WMI_PROTOCOL_VERSION;
+    if (ar6000_WriteDataDiag(ar->arHifDevice, address,
+                             (u8 *)&host_app_area,
+                             sizeof(struct host_app_area_s)) != 0)
+    {
+        return A_ERROR;
+    }
+
+    return 0;
+}
