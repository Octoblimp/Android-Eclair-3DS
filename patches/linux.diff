-		}
 
 		*(wr++) = ioread32(pxi->regs + REG_PXI_RX);
 
@@ -115,7 +175,7 @@ static int pxi_txrx(struct pxi_host *pxi, const u32 *ww, int nw, u32 *wr,
 	}
 
