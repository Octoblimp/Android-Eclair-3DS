+/* mailbox recv message polling */
+int DevPollMboxMsgRecv(struct ar6k_device *pDev,
+                            u32 *pLookAhead,
+                            int          TimeoutMS)
+{
+    int status = 0;
+    int      timeout = TimeoutMS/DELAY_PER_INTERVAL_MS;
+    u32      poll_count = 0;
+
+    A_ASSERT(timeout > 0);
+
+    AR_DEBUG_PRINTF(ATH_DEBUG_ERR,
+        ("AR6002 HTC poll begin timeout=%dms pending_events=%p\n",
+         TimeoutMS, pDev->GetPendingEventsFunc));
+
+    while (true) {
+
+        poll_count++;
+
+        if (pDev->GetPendingEventsFunc != NULL) {
+
+            struct hif_pending_events_info events;
+
+#ifdef THREAD_X
+			events.Polling =1;
+#endif
+
+            /* the HIF layer uses a special mechanism to get events, do this
+             * synchronously */
+            status = pDev->GetPendingEventsFunc(pDev->HIFDevice,
+                                            &events,
+                                            NULL);
+            if (status)
+            {
+                AR_DEBUG_PRINTF(ATH_DEBUG_ERR,
+                    ("AR6002 HTC pending-events read failed poll=%u status=%d\n",
+                     poll_count, status));
+                break;
+            }
+
+            if (poll_count == 1 || (poll_count % 50) == 0) {
+                AR_DEBUG_PRINTF(ATH_DEBUG_ERR,
+                    ("AR6002 HTC pending-events poll=%u events=0x%08x "
+                     "lookahead=0x%08x bytes=%u\n",
+                     poll_count, events.Events, events.LookAhead,
+                     events.AvailableRecvBytes));
+            }
+
+            if (events.Events & HIF_RECV_MSG_AVAIL)
+            {
+                    /*  there is a message available, the lookahead should be valid now */
+                *pLookAhead = events.LookAhead;
+
+                AR_DEBUG_PRINTF(ATH_DEBUG_ERR,
+                    ("AR6002 HTC pending-events found mailbox message poll=%u "
+                     "lookahead=0x%08x\n", poll_count, *pLookAhead));
+
+                break;
+            }
+        } else {
+
+                /* this is the standard HIF way.... */
+                /* load the register table */
+            status = HIFReadWrite(pDev->HIFDevice,
+                                  HOST_INT_STATUS_ADDRESS,
+                                  (u8 *)&pDev->IrqProcRegisters,
+                                  AR6K_IRQ_PROC_REGS_SIZE,
+                                  HIF_RD_SYNC_BYTE_INC,
+                                  NULL);
+
+            if (status){
+                AR_DEBUG_PRINTF(ATH_DEBUG_ERR,
+                    ("AR6002 HTC poll HIF read failed poll=%u status=%d\n",
+                     poll_count, status));
+                break;
+            }
+
+            if (poll_count == 1 || (poll_count % 50) == 0) {
+                AR_DEBUG_PRINTF(ATH_DEBUG_ERR,
+                    ("AR6002 HTC poll=%u regs host=0x%02x cpu=0x%02x err=0x%02x "
+                     "counter=0x%02x frame=0x%02x lookahead_valid=0x%02x "
+                     "lookahead0=0x%08x\n",
+                     poll_count,
+                     pDev->IrqProcRegisters.host_int_status,
+                     pDev->IrqProcRegisters.cpu_int_status,
+                     pDev->IrqProcRegisters.error_int_status,
+                     pDev->IrqProcRegisters.counter_int_status,
+                     pDev->IrqProcRegisters.mbox_frame,
+                     pDev->IrqProcRegisters.rx_lookahead_valid,
+                     pDev->IrqProcRegisters.rx_lookahead[HTC_MAILBOX]));
+            }
+
+                /* check for MBOX data and valid lookahead */
+            if (pDev->IrqProcRegisters.host_int_status & (1 << HTC_MAILBOX)) {
+                if (pDev->IrqProcRegisters.rx_lookahead_valid & (1 << HTC_MAILBOX))
+                {
+                    /* mailbox has a message and the look ahead is valid */
+                    *pLookAhead = pDev->IrqProcRegisters.rx_lookahead[HTC_MAILBOX];
+                    AR_DEBUG_PRINTF(ATH_DEBUG_ERR,
+                        ("AR6002 HTC poll found mailbox message poll=%u lookahead=0x%08x\n",
+                         poll_count, *pLookAhead));
+                    break;
+                }
+            }
+
+        }
+
+        timeout--;
+
+        if (timeout <= 0) {
+            AR_DEBUG_PRINTF(ATH_DEBUG_ERR,
+                ("AR6002 HTC poll timeout polls=%u last_regs host=0x%02x "
+                 "cpu=0x%02x err=0x%02x counter=0x%02x frame=0x%02x "
+                 "lookahead_valid=0x%02x lookahead0=0x%08x pending_events=%p\n",
+                 poll_count,
+                 pDev->IrqProcRegisters.host_int_status,
+                 pDev->IrqProcRegisters.cpu_int_status,
+                 pDev->IrqProcRegisters.error_int_status,
+                 pDev->IrqProcRegisters.counter_int_status,
+                 pDev->IrqProcRegisters.mbox_frame,
+                 pDev->IrqProcRegisters.rx_lookahead_valid,
+                 pDev->IrqProcRegisters.rx_lookahead[HTC_MAILBOX],
+                 pDev->GetPendingEventsFunc));
+            status = A_ERROR;
+
+                /* check if the target asserted */
+            if ( pDev->IrqProcRegisters.counter_int_status & AR6K_TARGET_DEBUG_INTR_MASK) {
+                    /* target signaled an assert, process this pending interrupt
+                     * this will call the target failure handler */
+                DevServiceDebugInterrupt(pDev);
+            }
+
+            break;
+        }
+
+            /* delay a little  */
+        A_MDELAY(DELAY_PER_INTERVAL_MS);
+        AR_DEBUG_PRINTF(ATH_DEBUG_RECV,("  Retry Mbox Poll : %d \n",timeout));
+    }
+
+    AR_DEBUG_PRINTF(ATH_DEBUG_ERR,
+        ("AR6002 HTC poll end status=%d polls=%u\n", status, poll_count));
+
+    return status;
+}
