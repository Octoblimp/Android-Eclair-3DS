index 1b6070bf97bb01f76cea0a7a51bee0c59f3c15ec..d77df9f6c91fc48cb7f0c9b02042d1a4ec9cde8d 100644
--- a/kernel/smp.c
+++ b/kernel/smp.c
@@ -228,6 +228,139 @@ static __always_inline void csd_lock_wait(call_single_data_t *csd)
 }
 #endif
 
+/*
+ * 3DS port: name the CPU that is not answering a cross-CPU IPI.
+ *
+ * Upstream already has exactly this in CONFIG_CSD_LOCK_WAIT_DEBUG, but that
+ * option carries `depends on 64BIT` and cannot be turned on here: it records
+ * the target CPU in `struct __call_single_node`'s `u16 src, dst`, which are
+ * themselves #ifdef CONFIG_64BIT, because adding them on 32-bit would grow
+ * call_single_data_t from 16 to 20 bytes and its `__aligned(sizeof(...))`
+ * would become __aligned(20) -- not a power of two, so it would not even
+ * compile.
+ *
+ * We do not need ->dst at all. Both places that wait synchronously
+ * (smp_call_function_single() and smp_call_function_many_cond()) already
+ * have the destination CPU in a local variable; passing it in sidesteps the
+ * whole 64-bit-only struct problem.
+ *
+ * Why this matters on this machine: every stall this port has captured is a
+ * CPU spinning here, reached via
+ *     __dabt_usr -> do_page_fault -> handle_mm_fault
+ *       -> ptep_set_access_flags -> flush_tlb_page -> on_each_cpu_mask(wait=1)
+ * ARM11 MPCore has no hardware TLB maintenance broadcast
+ * (tlb_ops_need_broadcast() is true because MMFR3[15:12] == 0), so *every*
+ * user TLB flush is a synchronous IPI round trip to the other cores. If one
+ * core stops answering interrupts, all the others pile up in this spin with
+ * preemption disabled -- which is also why rcu_sched then reports itself
+ * starved. The plain spin gives no clue which core went quiet, so this
+ * prints it, plus what that core is running (dump_cpu_task() reads the
+ * remote runqueue's curr; it needs no cooperation from the stuck CPU).
+ *
+ * Reports are capped so a persistent stall cannot flood the 50-column
+ * console or wrap the log buffer away from the first, most useful one.
+ */
+#define CSD_STUCK_FIRST_NS	(10ULL * NSEC_PER_SEC)
+#define CSD_STUCK_AGAIN_NS	(30ULL * NSEC_PER_SEC)
+#define CSD_STUCK_MAX_REPORTS	12
+
+static atomic_t csd_stuck_reports = ATOMIC_INIT(0);
+
+/* N3DS_CSD_IPI_PROGRESS_RECOVERY: the integrated ARM11 MPCore GIC has
+ * now produced a hardware trace in which a synchronous TLB callback stays
+ * queued while another CPU waits forever in smp_call_function_many().
+ *
+ * A duplicate call-function SGI is harmless: the per-CPU llist owns the work
+ * and an extra handler simply finds it empty. Re-kick the named target after
+ * 1 ms, broadcast every 16 retries to survive a bad logical GIC target map,
+ * and drain this CPU's own queue to break reciprocal cross-call waits. */
+#define CSD_IPI_RETRY_NS	(1ULL * NSEC_PER_MSEC)
+#define CSD_IPI_BROADCAST_RETRIES	16
+
+static noinline void csd_lock_wait_cpu_slow(call_single_data_t *csd, int cpu)
+{
+	u64 ts0 = sched_clock();
+	u64 next = ts0 + CSD_STUCK_FIRST_NS;
+	u64 next_retry = ts0 + CSD_IPI_RETRY_NS;
+	unsigned int retries = 0;
+	unsigned int spins = 0;
+	bool reported = false;
+	u64 now;
+
+	while (READ_ONCE(csd->node.u_flags) & CSD_FLAG_LOCK) {
+		/* If two CPUs are synchronously waiting on one another, neither
+		 * should depend on a second interrupt edge to run already-queued
+		 * local work. Match the IPI handler's IRQ-disabled contract. */
+		if (unlikely(!llist_empty(this_cpu_ptr(&call_single_queue)))) {
+			unsigned long flags;
+
+			local_irq_save(flags);
+			flush_smp_call_function_queue(false);
+			local_irq_restore(flags);
+			if (!(READ_ONCE(csd->node.u_flags) & CSD_FLAG_LOCK))
+				break;
+		}
+
+		cpu_relax();
+
+		/* sched_clock() is far too heavy for every iteration of a
+		 * spin that normally completes in microseconds. */
+		if (++spins & 0xff)
+			continue;
+
+		now = sched_clock();
+		if (now >= next_retry) {
+			arch_send_call_function_single_ipi(cpu);
+			retries++;
+			if (!(retries % CSD_IPI_BROADCAST_RETRIES))
+				arch_send_call_function_ipi_mask(cpu_online_mask);
+			next_retry = now + CSD_IPI_RETRY_NS;
+		}
+
+		if (now < next)
+			continue;
+		next = now + CSD_STUCK_AGAIN_NS;
+
+		if (atomic_inc_return(&csd_stuck_reports) > CSD_STUCK_MAX_REPORTS)
+			continue;
+
+		reported = true;
+		pr_alert("csd: CPU%d stuck %llums on CPU%d retries=%u\n",
+			 raw_smp_processor_id(),
+			 div_u64(now - ts0, NSEC_PER_MSEC), cpu, retries);
+		pr_alert("csd: fn=%pS\n", READ_ONCE(csd->func));
+		dump_cpu_task(cpu);
+		/*
+		 * N3DS_CSD_SUMMARY_LAST: the 2026-09-30 Browser hang was
+		 * photographed with only the tail of dump_cpu_task() on the
+		 * 50x30 top-screen console -- the two lines above, which name
+		 * both CPUs and the function, had already scrolled off.  Print
+		 * the waiter's own stack (which path needed the IPI), then
+		 * repeat the one line that matters last, so it is at the bottom
+		 * of the screen in any photo.
+		 */
+		dump_stack();
+		pr_alert("csd: SUMMARY CPU%d waits %llums on CPU%d fn=%ps retries=%u (N3DS_CSD_SUMMARY_LAST)\n",
+			 raw_smp_processor_id(),
+			 div_u64(now - ts0, NSEC_PER_MSEC), cpu,
+			 READ_ONCE(csd->func), retries);
+	}
+
+	if (unlikely(reported)) {
+		pr_alert("csd: CPU%d unstuck after %llums (CPU%d ran it)\n",
+			 raw_smp_processor_id(),
+			 div_u64(sched_clock() - ts0, NSEC_PER_MSEC), cpu);
+		atomic_set(&csd_stuck_reports, 0);
+	}
+}
+
+static __always_inline void csd_lock_wait_cpu(call_single_data_t *csd, int cpu)
+{
+	if (unlikely(READ_ONCE(csd->node.u_flags) & CSD_FLAG_LOCK))
+		csd_lock_wait_cpu_slow(csd, cpu);
+	smp_acquire__after_ctrl_dep();
+}
