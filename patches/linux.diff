+static int
+ar6000_gpio_register_get(struct net_device *dev,
+                         u32 gpioreg_id)
+{
+    struct ar6_softc *ar = (struct ar6_softc *)ar6k_priv(dev);
+
+    *((volatile bool *)&gpio_data_available) = false;
