diff --git a/drivers/power/reset/regulator-poweroff.c b/drivers/power/reset/regulator-poweroff.c
index f697088e0ad1aad2d25baa2df5f2b87343d494b7..4abd12bab4e5c4e223644406e95860a4de414fab 100644
--- a/drivers/power/reset/regulator-poweroff.c
+++ b/drivers/power/reset/regulator-poweroff.c
@@ -25,12 +25,59 @@ static struct regulator *cpu_regulator;
 
 static void regulator_poweroff_do_poweroff(void)
 {
+	int ret = 0;
+
+	/*
+	 * Breadcrumbs for the "board is still alive TIMEOUT_MS later" case --
+	 * this is the only diagnostic available for it, since
+	 * machine_power_off() has already disabled IRQs and the caller
+	 * (ctr_poweroff.sh) has already unmounted the SD card by this point,
+	 * so nothing after this line can be persisted to disk anymore. Read
+	 * these off the screen/a photo, not dmesg -- add
+	 * "console=tty0 earlyprintk" style capture if that ever gets too
+	 * hard to eyeball.
+	 */
+	pr_emerg("regulator-poweroff: cpu_regulator=%p is_enabled=%d\n",
+		 cpu_regulator,
+		 cpu_regulator ? regulator_is_enabled(cpu_regulator) : -1);
+
 	if (cpu_regulator && regulator_is_enabled(cpu_regulator))
-		regulator_force_disable(cpu_regulator);
+		ret = regulator_force_disable(cpu_regulator);
+	else
+		pr_emerg("regulator-poweroff: force_disable NOT called (no regulator, or already reported off)\n");
+
+	/*
+	 * Original upstream code silently ignored this. On this platform the
+	 * "regulator" is really an i2c write to the console's MCU, and the
+	 * caller (machine_power_off()) has already disabled IRQs, so a
+	 * transfer that fails here needs to say so -- see the irqs_disabled()
+	 * fallback in ctr_i2c.c's ctr_i2c_wait_busy() for why that used to be
+	 * silently unreliable.
+	 */
+	pr_emerg("regulator-poweroff: force_disable returned %d\n", ret);
 
 	/* give it some time */
 	mdelay(TIMEOUT_MS);
 
+	pr_emerg("regulator-poweroff: still alive %dms after the MCU write -- power was NOT cut\n",
+		 TIMEOUT_MS);
+
+	/*
+	 * If we reach here, the board did not power off, and
+	 * machine_power_off() (arch/arm/kernel/reboot.c) is about to return
+	 * to its caller with IRQs still disabled -- its local_irq_disable()
+	 * is never paired with a re-enable on this failure path, because
+	 * upstream assumes pm_power_off() never returns. Left alone, this
+	 * CPU can never take another timer tick and the system hard-hangs
+	 * (no further scheduling, no further console flushes), which is
+	 * indistinguishable from "the button did nothing" and requires a
+	 * physical battery pull to recover from. Re-enable IRQs so a failed
+	 * attempt is at least recoverable/debuggable instead of a guaranteed
+	 * hang; the physical power button remains the real fallback either
+	 * way.
+	 */
+	local_irq_enable();
+
 	WARN_ON(1);
 }
 
