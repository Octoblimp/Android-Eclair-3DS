@@ -223,6 +223,19 @@ ENTRY(vfp_save_state)
 	@ r0 - save location
 	@ r1 - FPEXC
 	DBGSTR1	"save VFP state %p", r0
+	@ N3DS_VFP11_EX_SAVE: VFP11 raises exceptions imprecisely, so a
+	@ thread can be switched out with FPEXC.EX set -- and in that state
+	@ the FSTMIAD below is itself bounced as an undefined instruction.
+	@ Since 5.11 a kernel-mode undef is fatal, and this one is taken in
+	@ __schedule with IRQs off: the #318/#319 Browser page-load hang
+	@ (Oops at vfp_save_state+0x0 from vfp_notifier, every other CPU
+	@ then stuck on its TLB-flush IPI).  Do what vfp_support_entry does:
+	@ enable VFP and clear EX before touching the registers.  r1 keeps
+	@ EX, so the saved FPEXC does too and the exception is still handled
+	@ when the thread next uses VFP; FPINST/FPINST2 read the same after.
+	bic	r2, r1, #FPEXC_EX
+	orr	r2, r2, #FPEXC_EN
+	VFPFMXR	FPEXC, r2
 	VFPFSTMIA r0, r2		@ save the working registers
 	VFPFMRX	r2, FPSCR		@ current status
 	tst	r1, #FPEXC_EX		@ is there additional state to save?
