+/*
+ * Nintendo 3DS port: last abort seen by do_DataAbort()/do_PrefetchAbort(),
+ * so the crash summary at the end of __die() can restate the faulting address
+ * even though the "Unable to handle kernel ... at virtual address" line that
+ * normally carries it has long since scrolled off the framebuffer console.
+ * Plain stores with no locking on purpose: this is diagnostic-only, is written
+ * on every abort (including the ordinary demand-paging ones), and must not
+ * cost a barrier on the page-fault fast path. A concurrent abort on another
+ * CPU can race and win, which is acceptable for a post-mortem hint.
+ */
+static unsigned long arm_abort_addr;
+static unsigned int arm_abort_fsr;
+static bool arm_abort_prefetch;
+
+void arm_note_abort(unsigned long addr, unsigned int fsr, bool prefetch)
+{
+	arm_abort_addr = addr;
+	arm_abort_fsr = fsr;
+	arm_abort_prefetch = prefetch;
+}
+
+/*
+ * A one-screenful recap of everything an oops report puts *above* the
+ * backtrace, printed last so it is what survives on a console that cannot
+ * show a whole oops at once. Deliberately one short line per fact: the 3DS
+ * console is 50 columns, so anything longer wraps and costs another row.
+ */
+static void arm_crash_summary(const char *str, int err, struct pt_regs *regs,
+			      struct task_struct *tsk)
+{
+	pr_emerg("8<--- crash summary ---\n");
+	pr_emerg("C: %s fsr=%08x\n", str, err);
+	pr_emerg("C: %cABT addr=%08lx fsr=%08x\n",
+		 arm_abort_prefetch ? 'P' : 'D', arm_abort_addr, arm_abort_fsr);
+	pr_emerg("C: pc=%08lx %pS\n", regs->ARM_pc, (void *)regs->ARM_pc);
+	pr_emerg("C: lr=%08lx %pS\n", regs->ARM_lr, (void *)regs->ARM_lr);
+	pr_emerg("C: sp=%08lx psr=%08lx\n", regs->ARM_sp, regs->ARM_cpsr);
+	pr_emerg("C: cpu=%d irqs=%s %s\n", raw_smp_processor_id(),
+		 interrupts_enabled(regs) ? "on" : "off",
+		 user_mode(regs) ? "usr" : "svc");
+	pr_emerg("C: pid=%d comm=%.*s\n", task_pid_nr(tsk), TASK_COMM_LEN,
+		 tsk->comm);
+	pr_emerg("--->8--- end summary ---\n");
+}
+
 static int __die(const char *str, int err, struct pt_regs *regs)
 {
 	struct task_struct *tsk = current;
@@ -297,6 +342,8 @@ static int __die(const char *str, int err, struct pt_regs *regs)
 		dump_instr(KERN_EMERG, regs);
 	}
 
+	arm_crash_summary(str, err, regs, tsk);
+
 	return 0;
 }
 
