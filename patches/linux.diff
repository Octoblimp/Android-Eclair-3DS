+static void
+delHifDevice(struct hif_device * device)
+{
+    AR_DEBUG_ASSERT(device!= NULL);
+    AR_DEBUG_PRINTF(ATH_DEBUG_TRACE, ("AR6000: delHifDevice; 0x%p\n", device));
+    kfree(device->dma_buffer);
+    kfree(device);
