+		compatible = "arm,pl310-cache";
+		reg = <0x17E10000 0x1000>;
+		cache-unified;
+		cache-level = <2>;
+		cache-size = <0x200000>;
+		cache-sets = <4096>;
+		cache-line-size = <32>;
+		/*
+		 * Disabled again 2026-08-05 (yet later same day): re-enabling
+		 * this node alongside the CONFIG_CPU_SW_DOMAIN_PAN disable was
+		 * hardware-tested and the crash came back. These are two
+		 * SEPARATE bugs, not one bug with two candidate causes -- the
+		 * domain-PAN disable is a real, independent fix (kept) and
+		 * this node is a real, independent second problem (disabled
+		 * again here). The comment below ("that clears the L2C-310 of
+		 * suspicion") was wrong: it only showed the domain-PAN bug can
+		 * reproduce with L2C-310 off, not that L2C-310 is innocent.
+		 * See docs/HANDOFF.md's 2026-08-05 (yet later) entry. Do not
+		 * re-enable without new hardware evidence that isolates this
+		 * node specifically (domain-PAN fix alone vs. L2C-310 alone
+		 * vs. both together, each tested separately).
+		 *
+		 * Re-enabled 2026-08-05 (later same day): the 2026-08-05
+		 * disable above was tested on hardware and did NOT fix the
+		 * crash -- video3.mp4/exception2.jpg from the very next boot
+		 * show the *same* DataAbort family (now in wp_page_copy's
+		 * ptep_clear_flush instead of wp_page_reuse, but identical
+		 * "faults on the instruction immediately after a
+		 * flush_tlb_page-calling function returns" signature) with
+		 * this node fully disabled. That clears the L2C-310 of
+		 * suspicion -- see docs/HANDOFF.md's 2026-08-05 follow-up
+		 * entry for the full re-analysis and the CONFIG_CPU_SW_DOMAIN_PAN
+		 * fix applied instead. Leaving this enabled; if a future
+		 * regression genuinely traces back here, reopen with fresh
+		 * evidence rather than reflexively disabling again.
+		 */
+		status = "okay";
 	};
 };
