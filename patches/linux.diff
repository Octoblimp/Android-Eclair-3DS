index 145606dc52db1e5214a2080c113643cc1eeba0db..420376936a0588834940c77a9d7bd402968aacf2 100644
--- a/drivers/block/virtio_blk.c
+++ b/drivers/block/virtio_blk.c
@@ -71,9 +71,30 @@ struct virtio_blk {
 	struct virtio_blk_vq *vqs;
 };
 
+/*
+ * N3DS_VIRTBLK_IO_RETRY: on this machine the "virtio" block device is not a
+ * software device -- it is a real SD card behind a homebrew ARM9 firmware and
+ * the PXI FIFO bridge. A marginal transfer therefore surfaces here as
+ * VIRTIO_BLK_S_IOERR, and upstream virtio_blk ends such a request
+ * immediately, with no retry, because virtio devices are normally reliable.
+ *
+ * That single unretried error is fatal: virtio-blk is the only storage in the
+ * system, so filemap_fault() turns the resulting -EIO into VM_FAULT_SIGBUS and
+ * kills whatever touched the page. A read failure on one page of one jar is
+ * enough to kill zygote and end the boot, with no error path anywhere.
+ *
+ * Give the request the bounded retry every real storage driver has (mmc_blk
+ * and SCSI both do this). Each Linux-level retry re-runs the ARM9 firmware's
+ * own recovery -- which drops the SD clock to half rate after the first
+ * failure and stays there -- so the attempts are not merely repeated, they get
+ * progressively more conservative.
+ */
+#define VIRTBLK_N3DS_MAX_RETRIES	4
+
 struct virtblk_req {
 	struct virtio_blk_outhdr out_hdr;
 	u8 status;
+	u8 n3ds_retries;
 	struct scatterlist sg[];
 };
 
@@ -163,6 +184,31 @@ static inline void virtblk_request_done(struct request *req)
 {
 	struct virtblk_req *vbr = blk_mq_rq_to_pdu(req);
 
+	/*
+	 * N3DS_VIRTBLK_IO_RETRY. Requests carrying a special payload are skipped:
+	 * the payload buffer is freed below and re-preparing one would leak it.
+	 * The device does not advertise discard/write-zeroes, so in practice this
+	 * only ever sees ordinary reads, writes and flushes.
+	 */
+	if (virtblk_result(vbr) == BLK_STS_IOERR &&
+	    !(req->rq_flags & RQF_SPECIAL_PAYLOAD) &&
+	    vbr->n3ds_retries < VIRTBLK_N3DS_MAX_RETRIES) {
+		unsigned long delay_ms = 10UL * ++vbr->n3ds_retries;
+
+		pr_warn_ratelimited("virtio_blk: I/O error, retry %u/%u sector %llu\n",
+				    vbr->n3ds_retries, VIRTBLK_N3DS_MAX_RETRIES,
+				    (unsigned long long)blk_rq_pos(req));
+
+		blk_mq_requeue_request(req, false);
+		blk_mq_delay_kick_requeue_list(req->q, delay_ms);
+		return;
+	}
+
+	if (virtblk_result(vbr) == BLK_STS_IOERR)
+		pr_err_ratelimited("virtio_blk: I/O error at sector %llu after %u retries\n",
+				   (unsigned long long)blk_rq_pos(req),
+				   vbr->n3ds_retries);
+
 	if (req->rq_flags & RQF_SPECIAL_PAYLOAD) {
 		kfree(page_address(req->special_vec.bv_page) +
 		      req->special_vec.bv_offset);
@@ -230,6 +276,11 @@ static blk_status_t virtio_queue_rq(struct blk_mq_hw_ctx *hctx,
 
 	BUG_ON(req->nr_phys_segments + 2 > vblk->sg_elems);
 
+	if (!(req->rq_flags & RQF_DONTPREP)) {
+		vbr->n3ds_retries = 0;
+		req->rq_flags |= RQF_DONTPREP;
+	}
+
 	switch (req_op(req)) {
 	case REQ_OP_READ:
 	case REQ_OP_WRITE:
