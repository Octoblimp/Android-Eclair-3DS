diff --git a/include/linux/uapi/android_alarm.h b/include/linux/uapi/android_alarm.h
new file mode 100644
index 0000000000000000000000000000000000000000..42e458f58cab27b9120fb2c6d20a7d9b9e99a7c2
--- /dev/null
+++ b/include/linux/uapi/android_alarm.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* drivers/rtc/uapi/android_alarm.h
+ *
+ * Copyright (C) 2006-2007 Google, Inc.
+ *
+ * Ported from android-goldfish-2.6.29. Wire ABI real Eclair code opens
+ * /dev/alarm and ioctl()s against -- ioctl numbers and the timespec wire
+ * size (8 bytes on this 32-bit target, struct old_timespec32 here vs.
+ * struct timespec originally, but _IOW() only cares about sizeof()) must
+ * not change. See port_alarm_driver.py for the full rationale.
+ */
+#ifndef _UAPI_ANDROID_ALARM_H
+#define _UAPI_ANDROID_ALARM_H
+
+#include <linux/ioctl.h>
+#include <linux/time32.h>
+
+enum android_alarm_type {
+	/* return code bit numbers or set alarm arg */
+	ANDROID_ALARM_RTC_WAKEUP,
+	ANDROID_ALARM_RTC,
+	ANDROID_ALARM_ELAPSED_REALTIME_WAKEUP,
+	ANDROID_ALARM_ELAPSED_REALTIME,
+	ANDROID_ALARM_SYSTEMTIME,
+
+	ANDROID_ALARM_TYPE_COUNT,
+
+	/* return code bit numbers */
+	/* ANDROID_ALARM_TIME_CHANGE = 16 */
+};
+
+enum android_alarm_return_flags {
+	ANDROID_ALARM_RTC_WAKEUP_MASK = 1U << ANDROID_ALARM_RTC_WAKEUP,
+	ANDROID_ALARM_RTC_MASK = 1U << ANDROID_ALARM_RTC,
+	ANDROID_ALARM_ELAPSED_REALTIME_WAKEUP_MASK =
+				1U << ANDROID_ALARM_ELAPSED_REALTIME_WAKEUP,
+	ANDROID_ALARM_ELAPSED_REALTIME_MASK =
+				1U << ANDROID_ALARM_ELAPSED_REALTIME,
+	ANDROID_ALARM_SYSTEMTIME_MASK = 1U << ANDROID_ALARM_SYSTEMTIME,
+	ANDROID_ALARM_TIME_CHANGE_MASK = 1U << 16
+};
+
+/* Disable alarm */
+#define ANDROID_ALARM_CLEAR(type)           _IO('a', 0 | ((type) << 4))
+
+/* Ack last alarm and wait for next */
+#define ANDROID_ALARM_WAIT                  _IO('a', 1)
+
+#define ALARM_IOW(c, type, size)            _IOW('a', (c) | ((type) << 4), size)
+/* Set alarm */
+#define ANDROID_ALARM_SET(type)             ALARM_IOW(2, type, struct old_timespec32)
+#define ANDROID_ALARM_SET_AND_WAIT(type)    ALARM_IOW(3, type, struct old_timespec32)
+#define ANDROID_ALARM_GET_TIME(type)        ALARM_IOW(4, type, struct old_timespec32)
+#define ANDROID_ALARM_SET_RTC               _IOW('a', 5, struct old_timespec32)
+#define ANDROID_ALARM_BASE_CMD(cmd)         (cmd & ~(_IOC(0, 0, 0xf0, 0)))
+#define ANDROID_ALARM_IOCTL_TO_TYPE(cmd)    (_IOC_NR(cmd) >> 4)
+
+#endif
diff --git a/include/linux/wakelock.h b/include/linux/wakelock.h
new file mode 100644
index 0000000000000000000000000000000000000000..ead4b3194d0bad42d5c96dbbf43903a0b3dc832e
--- /dev/null
+++ b/include/linux/wakelock.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* include/linux/wakelock.h
+ *
+ * Copyright (C) 2007-2008 Google, Inc.
+ *
+ * Ported from android-goldfish-2.6.29 as a compat shim over the mainline
+ * wakeup_source API (struct wake_lock now just wraps a
+ * struct wakeup_source *) -- see port_wakelock_earlysuspend.py for the
+ * full rationale. The old WAKE_LOCK_IDLE/WAKE_LOCK_SUSPEND distinction is
+ * NOT preserved; both types prevent suspend the same way here.
+ */
+#ifndef _LINUX_WAKELOCK_H
+#define _LINUX_WAKELOCK_H
+
+#include <linux/device.h>
+#include <linux/pm_wakeup.h>
+
+enum {
+	WAKE_LOCK_SUSPEND, /* Prevent suspend */
+	WAKE_LOCK_IDLE,    /* Historically: prevent low power idle only.
+			    * Not distinguished from WAKE_LOCK_SUSPEND by
+			    * this shim -- see port notes. */
+	WAKE_LOCK_TYPE_COUNT
+};
+
+struct wake_lock {
+	struct wakeup_source	*ws;
+};
+
+void wake_lock_init(struct wake_lock *lock, int type, const char *name);
+void wake_lock_destroy(struct wake_lock *lock);
+void wake_lock(struct wake_lock *lock);
+void wake_lock_timeout(struct wake_lock *lock, long timeout);
+void wake_unlock(struct wake_lock *lock);
+
+/* Non-zero if currently held (unexpired). */
+int wake_lock_active(struct wake_lock *lock);
+
+/* Approximated via pm_wakeup_pending() -- see port notes. Original
+ * semantics (exact per-type active/timeout introspection across every
+ * wake_lock in the system) aren't reproducible from outside the
+ * wakeup_source core. */
+long has_wake_lock(int type);
+
+#endif
diff --git a/include/uapi/linux/ctr_dsp.h b/include/uapi/linux/ctr_dsp.h
new file mode 100644
index 0000000000000000000000000000000000000000..39e2c75c1c9b383ea384691ad7cfeb1c41e665a3
--- /dev/null
+++ b/include/uapi/linux/ctr_dsp.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_LINUX_CTR_DSP_H
+#define _UAPI_LINUX_CTR_DSP_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+#define CTR_DSP_IOC_MAGIC 'D'
+#define CTR_DSP_ABI_VERSION 1
+
+/*
+ * Mirrors DSP_PCFG's MEMSEL field (ctr_dsp.c). Only the two spaces the
+ * kernel driver already understands from the DSP1 segment table (program
+ * and data memory) are exposed here -- MMIO passthrough is deliberately not
+ * part of this ABI.
+ */
+#define CTR_DSP_MEMSEL_DATA    0
+#define CTR_DSP_MEMSEL_PROGRAM 5
+
+/*
+ * CTR_DSP_IOC_POKE_WORDS pushes raw 16-bit words into DSP WRAM through the
+ * documented DSP_PDATA/PADR/PCFG FIFO port (ctr_dsp_fifo_write() in
+ * ctr_dsp.c), which is a direct, evidence-grounded implementation of the
+ * register bits 3dbrew documents for that port.
+ *
+ * This ioctl does NOT know, and does not claim to know, what the resident
+ * DSP1 firmware (dspfirm.cdc) does with any given (memsel, addr) target --
+ * no PCM/audio pipe address or command protocol has been recovered from
+ * this project's disassembly corpus (scratch/dsp-code-analysis/corpus).
+ * It is a generic memory-poke primitive, gated on the firmware boot
+ * handshake (ctr_dsp_probe()'s dsp->ready) having already succeeded, and
+ * nothing more. Treat any caller that assumes a specific address plays
+ * audio as unproven until real hardware confirms it.
+ */
+#define CTR_DSP_POKE_MAX_WORDS 4096
+
+struct ctr_dsp_poke {
+	__u32 memsel;			/* CTR_DSP_MEMSEL_* */
+	__u32 addr;			/* word address within that space */
+	__u32 count;			/* words used in `words`, <= CTR_DSP_POKE_MAX_WORDS */
+	__u32 reserved;
+	__u16 words[CTR_DSP_POKE_MAX_WORDS];
+};
+
+/* Returns -ENODEV via the ioctl's return code if the DSP never reached
+ * dsp->ready (i.e. the firmware boot handshake in ctr_dsp_upload_firmware()
+ * never completed) -- this is expected on any tree without a working DSP
+ * and must never crash or hang the caller. */
+#define CTR_DSP_IOC_POKE_WORDS _IOW(CTR_DSP_IOC_MAGIC, 0x01, struct ctr_dsp_poke)
+#define CTR_DSP_IOC_GET_READY  _IOR(CTR_DSP_IOC_MAGIC, 0x02, __u32)
+
+#endif
diff --git a/include/uapi/linux/ctr_pica.h b/include/uapi/linux/ctr_pica.h
