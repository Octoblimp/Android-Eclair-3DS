+static int
+ar6000_gpio_register_set(struct net_device *dev,
+                         u32 gpioreg_id,
+                         u32 value)
+{
+    struct ar6_softc *ar = (struct ar6_softc *)ar6k_priv(dev);
+
+    gpio_ack_received = false;
+    return wmi_gpio_register_set(ar->arWmi, gpioreg_id, value);
