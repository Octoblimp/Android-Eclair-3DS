diff --git a/drivers/platform/nintendo3ds/ctr_i2c.c b/drivers/platform/nintendo3ds/ctr_i2c.c
index efff834e0ee22c70158cc5ebef7872464450221e..96d908ba70d61ba31a3846f4df466f16352a0953 100644
--- a/drivers/platform/nintendo3ds/ctr_i2c.c
+++ b/drivers/platform/nintendo3ds/ctr_i2c.c
@@ -18,6 +18,7 @@
 #include <linux/module.h>
 #include <linux/interrupt.h>
 #include <linux/platform_device.h>
+#include <linux/platform_data/ctr_i2c.h>
 
 /* CNT register bits */
 #define I2C_CNT_LAST	BIT(0)
@@ -31,10 +32,36 @@
 
 #define CTR_I2C_TIMEOUT	msecs_to_jiffies(100)
 
+/* Same budget as CTR_I2C_TIMEOUT, expressed for the polling path. */
+#define CTR_I2C_POLL_TIMEOUT_US	(100 * 1000)
+#define CTR_I2C_POLL_STEP_US	(10)
+
+/* How long the sleeping path spins before it sleeps at all. */
+#define CTR_I2C_SPIN_US		(200)
+
+/* N3DS_I2C_NACK_RETRY: attempts per transfer, as libn3ds and GodMode9 use. */
+#define CTR_I2C_NACK_TRIES	8
+
 struct ctr_i2c {
 	unsigned irq;
 	void __iomem *base;
 
+	/*
+	 * Set for the duration of a ->master_xfer_atomic() transfer. The i2c
+	 * core only ever calls that variant with the bus lock held (it uses
+	 * i2c_trylock_bus() in atomic mode), so one flag on the adapter is
+	 * enough -- transfers on this bus never overlap.
+	 */
+	bool atomic;
