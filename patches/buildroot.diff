diff --git a/board/nintendo3ds/rootfs_overlay/system/etc/wifi/wpa_supplicant.conf b/board/nintendo3ds/rootfs_overlay/system/etc/wifi/wpa_supplicant.conf
new file mode 100644
index 0000000000000000000000000000000000000000..7d9da81cd97aab9f46785153471b5b8e99c277e3
--- /dev/null
+++ b/board/nintendo3ds/rootfs_overlay/system/etc/wifi/wpa_supplicant.conf
@@ -0,0 +1,7 @@
+# Buildroot's musl /etc/group has no Android "wifi" name.  Use Android's
+# stable AID_WIFI value so the root-run supplicant chowns its 0770 control
+# socket to the same supplemental group carried by system_server.
+ctrl_interface=DIR=/data/system/wpa_supplicant GROUP=1010
+update_config=1
+ap_scan=1
+fast_reauth=1
diff --git a/board/nintendo3ds/rootfs_overlay/system/lib/libjni_latinime.so b/board/nintendo3ds/rootfs_overlay/system/lib/libjni_latinime.so
new file mode 100644
index 0000000000000000000000000000000000000000..671713056e622a6428d5d9bd0b7ad0af5416d35d
--- /dev/null
+++ b/board/nintendo3ds/rootfs_overlay/system/lib/libjni_latinime.so
@@ -0,0 +1,3 @@
+N3DS_STATIC_JNI_LIBS placeholder: libjni_latinime is linked into
+/system/bin/app_process and found by dalvik/vm/Native.c; this file only
+lets PathClassLoader.findLibrary() resolve the name.
diff --git a/board/nintendo3ds/rootfs_overlay/system/usr/keylayout/hid_buttons.kl b/board/nintendo3ds/rootfs_overlay/system/usr/keylayout/hid_buttons.kl
new file mode 100755
index 0000000000000000000000000000000000000000..758c95e102c05b6cdedaf5bd418b693775899602
--- /dev/null
+++ b/board/nintendo3ds/rootfs_overlay/system/usr/keylayout/hid_buttons.kl
@@ -0,0 +1,6 @@
+# Source buttons are consumed by 3ds-navkey; START remains kernel power.
+# BTN_A (304) translated to KEY_ENTER by 3ds-navkey
+# BTN_B (305) translated to KEY_PROG1 by 3ds-navkey
+# BTN_Y (308) translated to KEY_BACK by 3ds-navkey
+# BTN_SELECT (314) becomes a timed synthetic KEY_POWER hold in 3ds-navkey
+# BTN_START (315) consumed by 3ds-pwrkey
diff --git a/board/nintendo3ds/rootfs_overlay/system/usr/keylayout/mcu_buttons.kl b/board/nintendo3ds/rootfs_overlay/system/usr/keylayout/mcu_buttons.kl
