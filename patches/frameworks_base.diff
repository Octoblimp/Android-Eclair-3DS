diff --git a/include/media/n3ds_openmax/OMX_Core.h b/include/media/n3ds_openmax/OMX_Core.h
new file mode 100755
index 0000000000000000000000000000000000000000..b0bad6fdb7fb68457ebf5ab70d399c59963248f3
--- /dev/null
+++ b/include/media/n3ds_openmax/OMX_Core.h
@@ -0,0 +1,63 @@
+/*
+ * Minimal OpenMAX IL declarations -- just enough for IOMX.h to compile.
+ *
+ * frameworks/base/include/media/IOMX.h is part of the IMediaPlayerService
+ * binder interface, so it has to compile even though there is no OpenMAX
+ * component, no OpenCORE and no codec anywhere in this image. It uses exactly
+ * eight OpenMAX names; they are declared here with their Khronos IL 1.1.2
+ * values so that dropping the real headers in later changes nothing.
+ *
+ * Nothing implements any of this. MediaPlayerService::getOMX() returns NULL
+ * (see the N3DS_WAV_ONLY block there) and IOMX has no server side.
+ */
+
+#ifndef N3DS_OMX_CORE_STUB_H_
+#define N3DS_OMX_CORE_STUB_H_
+
+#include <stdint.h>
+
+typedef uint32_t OMX_U32;
+typedef int32_t  OMX_S32;
+typedef int64_t  OMX_S64;
+typedef void*    OMX_PTR;
+typedef OMX_S64  OMX_TICKS;
+
+typedef enum OMX_COMMANDTYPE {
+    OMX_CommandStateSet,
+    OMX_CommandFlush,
+    OMX_CommandPortDisable,
+    OMX_CommandPortEnable,
+    OMX_CommandMarkBuffer,
+    OMX_CommandKhronosExtensions = 0x6F000000,
+    OMX_CommandVendorStartUnused = 0x7F000000,
+    OMX_CommandMax = 0X7FFFFFFF
+} OMX_COMMANDTYPE;
+
+typedef enum OMX_EVENTTYPE {
+    OMX_EventCmdComplete,
+    OMX_EventError,
+    OMX_EventMark,
+    OMX_EventPortSettingsChanged,
+    OMX_EventBufferFlag,
+    OMX_EventResourcesAcquired,
+    OMX_EventComponentResumed,
+    OMX_EventDynamicResourcesAvailable,
+    OMX_EventPortFormatDetected,
+    OMX_EventKhronosExtensions = 0x6F000000,
+    OMX_EventVendorStartUnused = 0x7F000000,
+    OMX_EventMax = 0x7FFFFFFF
+} OMX_EVENTTYPE;
+
+typedef enum OMX_INDEXTYPE {
+    OMX_IndexComponentStartUnused = 0x01000000,
+    OMX_IndexParamPriorityMgmt,
+    OMX_IndexParamAudioInit,
+    OMX_IndexParamImageInit,
+    OMX_IndexParamVideoInit,
+    OMX_IndexParamOtherInit,
+    OMX_IndexKhronosExtensions = 0x6F000000,
+    OMX_IndexVendorStartUnused = 0x7F000000,
+    OMX_IndexMax = 0x7FFFFFFF
+} OMX_INDEXTYPE;
+
+#endif  /* N3DS_OMX_CORE_STUB_H_ */
