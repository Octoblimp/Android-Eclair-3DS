diff --git a/cmds/bootanimation/DisplayTarget.cpp b/cmds/bootanimation/DisplayTarget.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a1d246d2f86d7ce071915cb7bc8902325e451ac1
--- /dev/null
+++ b/cmds/bootanimation/DisplayTarget.cpp
@@ -0,0 +1,229 @@
+/*
+ * DisplayTarget.cpp -- see DisplayTarget.h
+ */
+
+#define LOG_TAG "BootAnimation"
+
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <sys/mman.h>
+#include <sys/ioctl.h>
+#include <linux/fb.h>
+
+#include <utils/Log.h>
+
+#include "DisplayTarget.h"
+
+namespace android {
+
+DisplayTarget::DisplayTarget()
+    : mFd(-1), mFb(NULL), mFbSize(0), mMap(NULL), mMapSize(0),
+      mFbXres(0), mFbYres(0), mFbStride(0), mWidth(0), mHeight(0),
+      mCanvas(NULL)
+{
+}
+
+DisplayTarget::~DisplayTarget()
+{
+    close();
+}
+
+bool DisplayTarget::open(const char* device)
+{
+    struct fb_var_screeninfo vi;
+    struct fb_fix_screeninfo fi;
+
+    mFd = ::open(device, O_RDWR);
+    if (mFd < 0) {
+        LOGE("cannot open %s: %s", device, strerror(errno));
+        return false;
+    }
+
+    if (ioctl(mFd, FBIOGET_VSCREENINFO, &vi) < 0 ||
+        ioctl(mFd, FBIOGET_FSCREENINFO, &fi) < 0) {
+        LOGE("cannot query %s: %s", device, strerror(errno));
+        close();
+        return false;
+    }
+
+    if (vi.bits_per_pixel != 24) {
+        LOGE("%s is %d bpp, expected 24", device, vi.bits_per_pixel);
+        close();
+        return false;
+    }
+
+    mFbXres   = vi.xres;
+    mFbYres   = vi.yres;
+    mFbStride = fi.line_length ? fi.line_length : (int)(vi.xres * 3);
+    mFbSize   = (size_t)mFbStride * mFbYres;
+
+    /* N3DS_FB1_PAGE_OFFSET: fb1's scanout (smem_start 0x18119400) is not
+     * page aligned, and fb_mmap() maps from the start of its page, so offset
+     * 0 of the mapping is 1024 bytes BEFORE the first scanned-out byte.
+     * 1024 = 720 + 3*101 + 1 -- one row, 101 pixels and a byte -- which is
+     * the whole of what fbtest measured as an 80-100 row "scanout shift" and
+     * a permuted set of colour channels.  Point mFb at smem_start instead. */
+    const size_t pageMask = (size_t)getpagesize() - 1;
+    const size_t pageOffset = (size_t)(fi.smem_start & pageMask);
+    mMapSize = pageOffset + mFbSize;
+    mMap = mmap(NULL, mMapSize, PROT_READ | PROT_WRITE, MAP_SHARED, mFd, 0);
+    if (mMap == MAP_FAILED) {
+        LOGE("cannot mmap %s: %s", device, strerror(errno));
+        mMap = NULL;
+        close();
+        return false;
+    }
+    mFb = (uint8_t*)mMap + pageOffset;
+
+    /* The panel is the framebuffer rotated 90 degrees, so the canvas is the
+     * transpose of the framebuffer's geometry. */
+    mWidth  = mFbYres;
+    mHeight = mFbXres;
+
+    mCanvas = (uint8_t*)malloc((size_t)mWidth * mHeight * 3);
+    if (!mCanvas) {
+        LOGE("cannot allocate %dx%d canvas", mWidth, mHeight);
+        close();
+        return false;
+    }
+    memset(mCanvas, 0, (size_t)mWidth * mHeight * 3);
+
+    LOGI("%s: %dx%d framebuffer, %dx%d canvas, stride %d, scanout 0x%08lx "
+         "(+0x%zx into its page, N3DS_FB1_PAGE_OFFSET)",
+         device, mFbXres, mFbYres, mWidth, mHeight, mFbStride,
+         (unsigned long)fi.smem_start, pageOffset);
+    return true;
+}
+
+void DisplayTarget::close()
+{
+    if (mCanvas) {
+        free(mCanvas);
+        mCanvas = NULL;
+    }
+    if (mMap) {
+        if (mFb && mFbSize > 0) {
+            memset(mFb, 0, mFbSize);
+        }
+        munmap(mMap, mMapSize);
+        mMap = NULL;
+        mFb = NULL;
+    }
+    if (mFd >= 0) {
+        ::close(mFd);
+        mFd = -1;
+    }
+}
+
+void DisplayTarget::clear()
+{
+    if (mCanvas)
+        memset(mCanvas, 0, (size_t)mWidth * mHeight * 3);
+}
+
+void DisplayTarget::draw(const uint8_t* rgba, int w, int h, int dx, int dy)
+{
+    if (!mCanvas || !rgba)
+        return;
+
+    for (int y = 0; y < h; y++) {
+        const int cy = dy + y;
+        if (cy < 0 || cy >= mHeight)
+            continue;
+
+        const uint8_t* src = rgba + (size_t)y * w * 4;
+        uint8_t* dst = mCanvas + ((size_t)cy * mWidth + dx) * 3;
+
+        for (int x = 0; x < w; x++) {
+            const int cx = dx + x;
+            if (cx < 0 || cx >= mWidth) {
+                dst += 3;
+                continue;
+            }
+            dst[0] = src[x * 4 + 2];   /* b */
+            dst[1] = src[x * 4 + 1];   /* g */
+            dst[2] = src[x * 4 + 0];   /* r */
+            dst += 3;
+        }
+    }
+}
+
+void DisplayTarget::blend(const uint8_t* rgba, int w, int h, int dx, int dy)
+{
+    if (!mCanvas || !rgba)
+        return;
+
+    for (int y = 0; y < h; y++) {
+        const int cy = dy + y;
+        if (cy < 0 || cy >= mHeight)
+            continue;
+
+        const uint8_t* src = rgba + (size_t)y * w * 4;
+        uint8_t* dst = mCanvas + ((size_t)cy * mWidth + dx) * 3;
+
+        for (int x = 0; x < w; x++) {
+            const int cx = dx + x;
+            if (cx < 0 || cx >= mWidth) {
+                dst += 3;
+                continue;
+            }
+            const int a  = src[x * 4 + 3];
+            if (a == 255) {
+                dst[0] = src[x * 4 + 2];
+                dst[1] = src[x * 4 + 1];
+                dst[2] = src[x * 4 + 0];
+            } else if (a != 0) {
+                const int ia = 255 - a;
+                dst[0] = (uint8_t)((src[x * 4 + 2] * a + dst[0] * ia) / 255);
+                dst[1] = (uint8_t)((src[x * 4 + 1] * a + dst[1] * ia) / 255);
+                dst[2] = (uint8_t)((src[x * 4 + 0] * a + dst[2] * ia) / 255);
+            }
+            dst += 3;
+        }
+    }
+}
+
+void DisplayTarget::present()
+{
+    if (!mCanvas || !mFb)
+        return;
+
+    /* Canvas pixel (x, y) lands at framebuffer (X, x), where X indexes the
+     * pixel within a framebuffer line and therefore selects the panel *row*:
+     * X = fb_xres - 1 - y, the same transform the kernel uses in
+     * nintendo3ds_bottom_lcd_draw_pixel() and gralloc's n3ds_blit().
+     *
+     * This used to add an 80-100 row "scanout shift" measured with fbtest on
+     * 2026-08-03.  There is no shift: mFb used to point 1024 bytes before the
+     * scanout (N3DS_FB1_PAGE_OFFSET, see open()), and that misalignment is
+     * what the photographs showed.
+     *
+     * Deliberately single-buffered: the panel's VBlank-latched flip belongs
+     * exclusively to SurfaceFlinger's gralloc (FB_BOT_1/FB_BOT_2 via
+     * /dev/ctr_lcd). A second independent flipper in the boot animation
+     * races gralloc -- each gets the other's stale view of which buffer PDC1
+     * is scanning out, blits into the live buffer mid-frame and tears it, and
+     * the splash flashes erratically. That is what happened on 2026-08-12,
+     * so this player only ever draws into the buffer PDC1 scans out.
+     */
+    const int span = mFbXres;
+
+    for (int y = 0; y < mHeight; y++) {
+        const uint8_t* src = mCanvas + (size_t)y * mWidth * 3;
+        const int fbx = span - 1 - y;
+        uint8_t* dst = mFb + (size_t)fbx * 3;
+
+        for (int x = 0; x < mWidth; x++) {
+            dst[0] = src[0];
+            dst[1] = src[1];
+            dst[2] = src[2];
+            src += 3;
+            dst += mFbStride;
+        }
+    }
+}
+
+} /* namespace android */
diff --git a/cmds/bootanimation/DisplayTarget.h b/cmds/bootanimation/DisplayTarget.h
new file mode 100644
index 0000000000000000000000000000000000000000..ec2214aa9ee3e9c0fdbcf8231277679c303bcf09
--- /dev/null
+++ b/cmds/bootanimation/DisplayTarget.h
@@ -0,0 +1,82 @@
+/*
+ * DisplayTarget.h
+ *
+ * Framebuffer output for the boot animation.
+ *
+ * BootAnimation.cpp originally rendered through SurfaceFlinger and OpenGL ES:
+ * it created a Surface, made an EGL context current on it and drew each frame
+ * with glDrawTexiOES(). Neither SurfaceFlinger nor an EGL/GLES driver exists
+ * on this port (there is no GPU driver at all), so drawing goes straight to
+ * the bottom screen's framebuffer instead.
+ *
+ * Two hardware details are handled here so the rest of the animation code can
+ * work in ordinary landscape screen coordinates:
+ *
+ *   - The bottom LCD is 320x240, but its framebuffer is the same surface
+ *     rotated 90 degrees: 240 pixels across by 320 down. present() applies the
+ *     rotation, matching the addressing in the kernel's
+ *     arch/arm/mach-ctr/bottom_lcd.c.
+ *   - The pixel format is 24bpp r8g8b8, i.e. blue in the first byte, then
+ *     green, then red -- not the RGB_565 that PIXEL_FORMAT_RGB_565 asked
+ *     SurfaceFlinger for upstream.
+ *
+ * Frames are composed into an off-screen canvas and pushed out by present(),
+ * which keeps blending simple and avoids showing half-drawn frames.
+ */
+
+#ifndef ANDROID_BOOTANIM_DISPLAYTARGET_H
+#define ANDROID_BOOTANIM_DISPLAYTARGET_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+namespace android {
+
+/* N3DS_FB1_PAGE_OFFSET: there is no scanout shift.  What fbtest measured as
+ * an 80-100 row shift (and a permuted set of colour channels) was fb1's
+ * scanout starting 1024 bytes into the page mmap() hands back -- see
+ * DisplayTarget::open().  The old PANEL_Y_OFFSET_DEFAULT / BOOTANIM_PANEL_YOFF
+ * / sd:/linux/panel_yoff.txt compensation is gone on purpose. */
+
+class DisplayTarget {
+public:
+                DisplayTarget();
+                ~DisplayTarget();
+
+    bool        open(const char* device);
+    void        close();
+
+    /* Canvas geometry, in landscape screen coordinates. */
+    int         width()  const { return mWidth; }
+    int         height() const { return mHeight; }
+
+    void        clear();
+
+    /* Copy an RGBA image over the canvas, ignoring its alpha. */
+    void        draw(const uint8_t* rgba, int w, int h, int dx, int dy);
+
+    /* Composite an RGBA image onto the canvas with source-over blending,
+     * the software equivalent of glBlendFunc(GL_SRC_ALPHA,
+     * GL_ONE_MINUS_SRC_ALPHA). */
+    void        blend(const uint8_t* rgba, int w, int h, int dx, int dy);
+
+    /* Push the canvas to the panel. */
+    void        present();
+
+private:
+    int         mFd;
+    uint8_t*    mFb;          /* first scanned-out byte, mFbSize long */
+    size_t      mFbSize;
+    void*       mMap;         /* page-aligned mmap containing mFb     */
+    size_t      mMapSize;
+    int         mFbXres;      /* framebuffer geometry (portrait)      */
+    int         mFbYres;
+    int         mFbStride;
+    int         mWidth;       /* canvas geometry (landscape)          */
+    int         mHeight;
+    uint8_t*    mCanvas;      /* mWidth * mHeight * 3, b,g,r          */
+};
+
+} /* namespace android */
+
+#endif /* ANDROID_BOOTANIM_DISPLAYTARGET_H */
diff --git a/cmds/bootanimation/PngDecode.cpp b/cmds/bootanimation/PngDecode.cpp
new file mode 100755
index 0000000000000000000000000000000000000000..023d85ea974d16e7f7f555b8dacbbc6fdf0e2f18
--- /dev/null
+++ b/cmds/bootanimation/PngDecode.cpp
@@ -0,0 +1,289 @@
+/*
+ * PngDecode.cpp -- see PngDecode.h
+ */
+
+#define LOG_TAG "BootAnimation"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <utils/Log.h>
+#include <zlib.h>
+
+#include "PngDecode.h"
+
+namespace android {
+
+static const uint8_t kPngSignature[8] = { 137, 'P', 'N', 'G', 13, 10, 26, 10 };
+
+static inline uint32_t rd32(const uint8_t* p) {
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+           ((uint32_t)p[2] << 8)  |  (uint32_t)p[3];
+}
+
+static inline int paeth(int a, int b, int c) {
+    int p  = a + b - c;
+    int pa = p > a ? p - a : a - p;
+    int pb = p > b ? p - b : b - p;
+    int pc = p > c ? p - c : c - p;
+    if (pa <= pb && pa <= pc) return a;
+    if (pb <= pc) return b;
+    return c;
+}
+
+/* Reverse the per-scanline filters, in place, over the raw inflated stream.
+ * "stride" is the number of bytes in one unfiltered scanline and "bpp" the
+ * number of bytes per pixel (the filter's left-neighbour distance). */
+static bool unfilter(uint8_t* raw, int height, int stride, int bpp)
+{
+    uint8_t* prev = NULL;
+    uint8_t* line = raw;
+
+    for (int y = 0; y < height; y++) {
+        const int filter = line[0];
+        uint8_t* cur = line + 1;
+
+        switch (filter) {
+        case 0: /* None */
+            break;
+        case 1: /* Sub */
+            for (int i = bpp; i < stride; i++)
+                cur[i] = (uint8_t)(cur[i] + cur[i - bpp]);
+            break;
+        case 2: /* Up */
+            if (prev)
+                for (int i = 0; i < stride; i++)
+                    cur[i] = (uint8_t)(cur[i] + prev[i]);
+            break;
+        case 3: /* Average */
+            for (int i = 0; i < stride; i++) {
+                int a = (i >= bpp) ? cur[i - bpp] : 0;
+                int b = prev ? prev[i] : 0;
+                cur[i] = (uint8_t)(cur[i] + ((a + b) >> 1));
+            }
+            break;
+        case 4: /* Paeth */
+            for (int i = 0; i < stride; i++) {
+                int a = (i >= bpp) ? cur[i - bpp] : 0;
+                int b = prev ? prev[i] : 0;
+                int c = (prev && i >= bpp) ? prev[i - bpp] : 0;
+                cur[i] = (uint8_t)(cur[i] + paeth(a, b, c));
+            }
+            break;
+        default:
+            LOGE("PNG: bad filter type %d on row %d", filter, y);
+            return false;
+        }
+
+        prev = cur;
+        line += stride + 1;
+    }
+    return true;
+}
+
+bool decodePngImage(const void* data, size_t len, PngImage* img)
+{
+    const uint8_t* p = (const uint8_t*)data;
+
+    img->width = img->height = 0;
+    img->pixels = NULL;
+
+    if (len < 8 || memcmp(p, kPngSignature, 8) != 0) {
+        LOGE("PNG: bad signature");
+        return false;
+    }
+
+    uint32_t width = 0, height = 0;
+    int depth = 0, colour = 0, interlace = 0;
+    bool haveIhdr = false;
+
+    uint8_t  palette[256 * 3];
+    uint8_t  palAlpha[256];
+    int      palCount = 0;
+    memset(palAlpha, 0xFF, sizeof(palAlpha));
+
+    uint8_t* idat = NULL;
+    size_t   idatLen = 0;
+
+    size_t off = 8;
+    bool ok = false;
+
+    while (off + 8 <= len) {
+        const uint32_t clen = rd32(p + off);
+        const uint8_t* type = p + off + 4;
+        const uint8_t* body = p + off + 8;
+
+        if (off + 12 + (size_t)clen > len) {
+            LOGE("PNG: truncated chunk");
+            goto done;
+        }
+
+        if (!memcmp(type, "IHDR", 4)) {
+            if (clen < 13) goto done;
+            width     = rd32(body);
+            height    = rd32(body + 4);
+            depth     = body[8];
+            colour    = body[9];
+            interlace = body[12];
+            haveIhdr  = true;
+
+            if (depth != 8) {
+                LOGE("PNG: unsupported bit depth %d (only 8)", depth);
+                goto done;
+            }
+            if (interlace != 0) {
+                LOGE("PNG: interlaced images are not supported");
+                goto done;
+            }
+            if (width == 0 || height == 0 || width > 4096 || height > 4096) {
+                LOGE("PNG: implausible dimensions %ux%u", width, height);
+                goto done;
+            }
+        } else if (!memcmp(type, "PLTE", 4)) {
+            palCount = clen / 3;
+            if (palCount > 256) palCount = 256;
+            memcpy(palette, body, palCount * 3);
+        } else if (!memcmp(type, "tRNS", 4)) {
+            /* Only the palette form is handled; the colour-key forms are not
+             * used by any asset here. */
+            if (colour == 3) {
+                size_t n = clen > 256 ? 256 : clen;
+                memcpy(palAlpha, body, n);
+            }
+        } else if (!memcmp(type, "IDAT", 4)) {
+            uint8_t* grown = (uint8_t*)realloc(idat, idatLen + clen);
+            if (!grown) goto done;
+            idat = grown;
+            memcpy(idat + idatLen, body, clen);
+            idatLen += clen;
+        } else if (!memcmp(type, "IEND", 4)) {
+            break;
+        }
+
+        off += 12 + clen;
+    }
+
+    if (!haveIhdr || !idat) {
+        LOGE("PNG: missing IHDR or IDAT");
+        goto done;
+    }
+
+    {
+        int channels;
+        switch (colour) {
+        case 0: channels = 1; break;   /* grey        */
+        case 2: channels = 3; break;   /* RGB         */
+        case 3: channels = 1; break;   /* palette idx */
+        case 4: channels = 2; break;   /* grey+alpha  */
+        case 6: channels = 4; break;   /* RGBA        */
+        default:
+            LOGE("PNG: unsupported colour type %d", colour);
+            goto done;
+        }
+        if (colour == 3 && palCount == 0) {
+            LOGE("PNG: palette image with no PLTE");
+            goto done;
+        }
+
+        const int stride  = (int)width * channels;
+        const size_t rawLen = (size_t)height * (stride + 1);
+
+        uint8_t* raw = (uint8_t*)malloc(rawLen);
+        if (!raw) goto done;
+
+        z_stream zs;
+        memset(&zs, 0, sizeof(zs));
+        zs.next_in   = (Bytef*)idat;
+        zs.avail_in  = (uInt)idatLen;
+        zs.next_out  = (Bytef*)raw;
+        zs.avail_out = (uInt)rawLen;
+
+        if (inflateInit(&zs) != Z_OK) {
+            free(raw);
+            goto done;
+        }
+        int zr = inflate(&zs, Z_FINISH);
+        inflateEnd(&zs);
+
+        if (zr != Z_STREAM_END || zs.total_out != rawLen) {
+            LOGE("PNG: inflate failed (%d, got %lu of %lu bytes)",
+                 zr, (unsigned long)zs.total_out, (unsigned long)rawLen);
+            free(raw);
+            goto done;
+        }
+
+        if (!unfilter(raw, (int)height, stride, channels)) {
+            free(raw);
+            goto done;
+        }
+
+        uint8_t* out = (uint8_t*)malloc((size_t)width * height * 4);
+        if (!out) {
+            free(raw);
+            goto done;
+        }
+
+        for (uint32_t y = 0; y < height; y++) {
+            const uint8_t* src = raw + (size_t)y * (stride + 1) + 1;
+            uint8_t* dst = out + (size_t)y * width * 4;
+
+            for (uint32_t x = 0; x < width; x++) {
+                uint8_t r, g, b, a = 0xFF;
+                switch (colour) {
+                case 0:
+                    r = g = b = src[x];
+                    break;
+                case 2:
+                    r = src[x * 3 + 0];
+                    g = src[x * 3 + 1];
+                    b = src[x * 3 + 2];
+                    break;
+                case 3: {
+                    int idx = src[x];
+                    if (idx >= palCount) idx = 0;
+                    r = palette[idx * 3 + 0];
+                    g = palette[idx * 3 + 1];
+                    b = palette[idx * 3 + 2];
+                    a = palAlpha[idx];
+                    break;
+                }
+                case 4:
+                    r = g = b = src[x * 2 + 0];
+                    a = src[x * 2 + 1];
+                    break;
+                default: /* 6 */
+                    r = src[x * 4 + 0];
+                    g = src[x * 4 + 1];
+                    b = src[x * 4 + 2];
+                    a = src[x * 4 + 3];
+                    break;
+                }
+                dst[x * 4 + 0] = r;
+                dst[x * 4 + 1] = g;
+                dst[x * 4 + 2] = b;
+                dst[x * 4 + 3] = a;
+            }
+        }
+
+        free(raw);
+
+        img->width  = (int)width;
+        img->height = (int)height;
+        img->pixels = out;
+        ok = true;
+    }
+
+done:
+    free(idat);
+    return ok;
+}
+
+void freePngImage(PngImage* img)
+{
+    if (img && img->pixels) {
+        free(img->pixels);
+        img->pixels = NULL;
+    }
+}
+
+} /* namespace android */
diff --git a/cmds/bootanimation/PngDecode.h b/cmds/bootanimation/PngDecode.h
new file mode 100755
index 0000000000000000000000000000000000000000..f9bc2e65714c1f4072023a1338df001e3182c06a
--- /dev/null
+++ b/cmds/bootanimation/PngDecode.h
@@ -0,0 +1,43 @@
+/*
+ * PngDecode.h
+ *
+ * Minimal PNG decoder, standing in for Skia's SkImageDecoder.
+ *
+ * BootAnimation.cpp originally called SkImageDecoder::DecodeMemory() to turn
+ * the boot animation's PNG frames into SkBitmaps. Skia is a very large
+ * dependency (and pulls in libcorecg, expat, freetype, ...), none of which is
+ * ported yet, so this decodes the specific subset of PNG that the boot
+ * animation assets and generated frames actually use:
+ *
+ *   - bit depth 8
+ *   - colour types 0 (grey), 2 (RGB), 3 (palette, with optional tRNS),
+ *     4 (grey+alpha) and 6 (RGBA)
+ *   - no interlacing
+ *
+ * Anything outside that is rejected rather than mis-decoded. Output is always
+ * 8888 RGBA, which is what the compositor in BootAnimation.cpp expects.
+ */
+
+#ifndef ANDROID_BOOTANIM_PNGDECODE_H
+#define ANDROID_BOOTANIM_PNGDECODE_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+namespace android {
+
+struct PngImage {
+    int      width;
+    int      height;
+    uint8_t* pixels;   /* width * height * 4, RGBA */
+};
+
+/* Returns true on success; on success the caller owns img->pixels and must
+ * release it with freePngImage(). */
+bool decodePngImage(const void* data, size_t len, PngImage* img);
+
+void freePngImage(PngImage* img);
+
+} /* namespace android */
+
+#endif /* ANDROID_BOOTANIM_PNGDECODE_H */
