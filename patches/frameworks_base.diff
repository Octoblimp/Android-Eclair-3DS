diff --git a/opengl/libagl/fixed_asm.S b/opengl/libagl/fixed_asm.S
index 6cbc56fa887c5179cccad01cf3a90957b10c107f..0c7b1331475be10e2d392003e35dab032f39e801 100644
--- a/opengl/libagl/fixed_asm.S
+++ b/opengl/libagl/fixed_asm.S
@@ -22,6 +22,25 @@
     .global gglFloatToFixed
     .global gglFloatToFixedFast
 
+/*
+ * N3DS_LIBAGL_HARDFLOAT_FLOAT_TO_FIXED: fp.h declares
+ *     extern "C" GLfixed gglFloatToFixed(float f);
+ * and the rest of libagl is compiled with -mfloat-abi=hard, so every C++
+ * caller passes f in s0 (matrix.o: "vmov s0, r3 ; bl gglFloatToFixed").
+ * These routines were written for the soft-float ABI and read f from r0,
+ * which at the matrix call sites holds the float bits shifted left by one
+ * (left over from isZerof()).  1.0f therefore converted to 0x7fffffff, so
