+/*
+ * See WavPlayer.h for why this file exists.
+ *
+ * The parser is deliberately strict about what it accepts and loud about what
+ * it rejects: every sound in this image is produced by our own build-time
+ * ffmpeg run, so a file that does not parse is a build bug, not a user file,
+ * and silently returning "no sound" would hide it.
+ */
+
+//#define LOG_NDEBUG 0
+#define LOG_TAG "WavPlayer"
+#include "utils/Log.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <assert.h>
+#include <limits.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <sched.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+
+#include "WavPlayer.h"
+
+#ifdef HAVE_GETTID
+static pid_t myTid() { return gettid(); }
+#else
+static pid_t myTid() { return getpid(); }
+#endif
+
+namespace android {
+
+// Same codes VorbisPlayer uses, for the same reasons.
+static status_t ERROR_NOT_OPEN = -1;
+static status_t ERROR_OPEN_FAILED = -2;
+static status_t ERROR_ALLOCATE_FAILED = -4;
+static status_t ERROR_NOT_SUPPORTED = -8;
+static status_t STATE_INIT = 0;
+static status_t STATE_ERROR = 1;
+static status_t STATE_OPEN = 2;
+
+#define AUDIOBUFFER_SIZE 4096
+
+#define FOURCC(a,b,c,d) \
+    ((uint32_t)(a) | ((uint32_t)(b) << 8) | ((uint32_t)(c) << 16) | ((uint32_t)(d) << 24))
+
+static const uint32_t kRIFF = FOURCC('R','I','F','F');
+static const uint32_t kWAVE = FOURCC('W','A','V','E');
+static const uint32_t kFMT  = FOURCC('f','m','t',' ');
+static const uint32_t kDATA = FOURCC('d','a','t','a');
+
+#define WAVE_FORMAT_PCM        0x0001
+#define WAVE_FORMAT_EXTENSIBLE 0xFFFE
+
+WavPlayer::WavPlayer() :
+    mFile(NULL), mOffset(0), mLength(0),
+    mSampleRate(0), mChannels(0), mBitsPerSample(0),
+    mDataStart(0), mDataBytes(0), mDataPos(0),
+    mAudioBuffer(NULL), mPlayTime(-1), mDuration(-1), mState(STATE_ERROR),
+    mStreamType(AudioSystem::MUSIC), mLoop(false), mAndroidLoop(false),
+    mExit(false), mPaused(false), mRender(false), mRenderTid(-1)
+{
+    LOGV("constructor\n");
+}
+
+void WavPlayer::onFirstRef()
+{
+    LOGV("onFirstRef\n");
+    Mutex::Autolock l(mMutex);
+    createThreadEtc(renderThread, this, "wav decoder", ANDROID_PRIORITY_AUDIO);
+    mCondition.wait(mMutex);
+    if (mRenderTid > 0) {
+        LOGV("render thread(%d) started", mRenderTid);
+        mState = STATE_INIT;
+    }
+}
+
+status_t WavPlayer::initCheck()
+{
+    if (mState != STATE_ERROR) return NO_ERROR;
+    return ERROR_NOT_OPEN;
+}
+
+WavPlayer::~WavPlayer()
+{
+    LOGV("WavPlayer destructor\n");
+    release();
+}
+
+status_t WavPlayer::setDataSource(const char* path)
+{
+    Mutex::Autolock l(mMutex);
+    return setdatasource(path, -1, 0, 0x7ffffffffffffffLL);
+}
+
+status_t WavPlayer::setDataSource(int fd, int64_t offset, int64_t length)
+{
+    Mutex::Autolock l(mMutex);
+    return setdatasource(NULL, fd, offset, length);
+}
+
+status_t WavPlayer::setdatasource(const char *path, int fd, int64_t offset, int64_t length)
+{
+    LOGV("setDataSource url=%s, fd=%d\n", path, fd);
+
+    // Make sure we're in the right state to open a new datasource.
+    if (mState != STATE_INIT && mState != STATE_ERROR) {
+        // Already playing something; the caller should have reset() first.
+        return ERROR_NOT_OPEN;
+    }
+    reset_nosync();
+
+    if (path) {
+        mFile = fopen(path, "r");
+        if (mFile == NULL) {
+            LOGE("fopen('%s') failed: %d", path, errno);
+            return ERROR_OPEN_FAILED;
+        }
+        struct stat sb;
+        if (fstat(fileno(mFile), &sb) != 0) {
+            LOGE("fstat('%s') failed: %d", path, errno);
+            fclose(mFile);
+            mFile = NULL;
+            return ERROR_OPEN_FAILED;
+        }
+        mOffset = 0;
+        mLength = sb.st_size;
+    } else {
+        // dup() because the caller owns the fd it handed us and will close it
+        // as soon as setDataSource returns.
+        int dupfd = dup(fd);
+        if (dupfd < 0) {
+            LOGE("dup(%d) failed: %d", fd, errno);
+            return ERROR_OPEN_FAILED;
+        }
+        mFile = fdopen(dupfd, "r");
+        if (mFile == NULL) {
+            LOGE("fdopen(%d) failed: %d", dupfd, errno);
+            close(dupfd);
+            return ERROR_OPEN_FAILED;
+        }
+        mOffset = offset;
+        mLength = length;
+    }
+
+    status_t err = parseHeader();
+    if (err != NO_ERROR) {
+        fclose(mFile);
+        mFile = NULL;
+        mState = STATE_ERROR;
+        return err;
+    }
+
+    mState = STATE_OPEN;
+    return NO_ERROR;
+}
+
+/*
+ * Walks the RIFF chunk list looking for "fmt " and "data".  Chunks are
+ * word-aligned with an implicit pad byte on odd sizes; ffmpeg emits a LIST
+ * chunk full of metadata before the data chunk often enough that skipping
+ * unknown chunks properly is not optional.
+ */
+status_t WavPlayer::parseHeader()
+{
+    uint8_t hdr[12];
+
+    if (fseek(mFile, (long)mOffset, SEEK_SET) != 0) {
+        LOGE("seek to RIFF at %lld failed", mOffset);
+        return ERROR_OPEN_FAILED;
+    }
+    if (fread(hdr, 1, 12, mFile) != 12) {
+        LOGE("short read on RIFF header");
+        return ERROR_OPEN_FAILED;
+    }
+
+    uint32_t riff = *(uint32_t*)(hdr + 0);
+    uint32_t wave = *(uint32_t*)(hdr + 8);
+    if (riff != kRIFF || wave != kWAVE) {
+        LOGE("not a RIFF/WAVE file (%08x/%08x)", riff, wave);
+        return ERROR_NOT_SUPPORTED;
+    }
+
+    int64_t pos = mOffset + 12;
+    int64_t end = mOffset + mLength;
+    bool haveFmt = false;
+
+    while (pos + 8 <= end) {
+        uint8_t ch[8];
+        if (fseek(mFile, (long)pos, SEEK_SET) != 0) break;
+        if (fread(ch, 1, 8, mFile) != 8) break;
+
+        uint32_t id   = *(uint32_t*)(ch + 0);
+        uint32_t size = *(uint32_t*)(ch + 4);
+        int64_t body  = pos + 8;
+
+        if (id == kFMT) {
+            uint8_t fmt[16];
+            if (size < 16 || fread(fmt, 1, 16, mFile) != 16) {
+                LOGE("truncated fmt chunk");
+                return ERROR_NOT_SUPPORTED;
+            }
+            uint16_t tag = *(uint16_t*)(fmt + 0);
+            mChannels      = *(uint16_t*)(fmt + 2);
+            mSampleRate    = *(uint32_t*)(fmt + 4);
+            mBitsPerSample = *(uint16_t*)(fmt + 14);
+
+            if (tag != WAVE_FORMAT_PCM && tag != WAVE_FORMAT_EXTENSIBLE) {
+                LOGE("format tag %u is not PCM; the build transcodes every "
+                     "system sound to PCM, so this file is wrong", tag);
+                return ERROR_NOT_SUPPORTED;
+            }
+            if (mBitsPerSample != 16) {
+                LOGE("%d-bit PCM is not supported, only 16", mBitsPerSample);
+                return ERROR_NOT_SUPPORTED;
+            }
+            if (mChannels != 1 && mChannels != 2) {
+                LOGE("%d channels is not supported, only 1 or 2", mChannels);
+                return ERROR_NOT_SUPPORTED;
+            }
+            if (mSampleRate == 0) {
+                LOGE("sample rate is zero");
+                return ERROR_NOT_SUPPORTED;
+            }
+            haveFmt = true;
+        } else if (id == kDATA) {
+            if (!haveFmt) {
+                LOGE("data chunk before fmt chunk");
+                return ERROR_NOT_SUPPORTED;
+            }
+            mDataStart = body;
+            mDataBytes = size;
+            // A streamed WAV can declare size 0 or 0xffffffff; clamp to what
+            // is actually there so the render loop terminates.
+            if (mDataBytes <= 0 || mDataStart + mDataBytes > end) {
+                mDataBytes = end - mDataStart;
+            }
+            mDataPos = 0;
+            mDuration = bytesToMsec(mDataBytes);
+            LOGV("%u Hz, %d ch, %lld bytes, %d ms",
+                 mSampleRate, mChannels, mDataBytes, mDuration);
+            return NO_ERROR;
+        }
+
+        pos = body + size + (size & 1);   // chunks are word aligned
+    }
+
+    LOGE("no data chunk found");
+    return ERROR_NOT_SUPPORTED;
+}
+
+int WavPlayer::bytesToMsec(int64_t bytes) const
+{
+    int frameSize = mChannels * (mBitsPerSample / 8);
+    if (frameSize <= 0 || mSampleRate == 0) return 0;
+    return (int)((bytes / frameSize) * 1000LL / (int64_t)mSampleRate);
+}
+
+long WavPlayer::readPcm(char* buf, long n)
+{
+    int64_t remain = mDataBytes - mDataPos;
+    if (remain <= 0) return 0;
+    if ((int64_t)n > remain) n = (long)remain;
+
+    size_t got = fread(buf, 1, (size_t)n, mFile);
+    if (got == 0) {
+        if (ferror(mFile)) {
+            LOGE("read error at %lld", mDataPos);
+            return -1;
+        }
+        // Short file: the declared data size lied.  Treat as end of stream.
+        mDataPos = mDataBytes;
+        return 0;
+    }
+    mDataPos += got;
+    return (long)got;
+}
+
+status_t WavPlayer::seekBytes(int64_t dataOffset)
+{
+    int frameSize = mChannels * (mBitsPerSample / 8);
+    if (frameSize > 0) dataOffset -= dataOffset % frameSize;  // never split a frame
+    if (dataOffset < 0) dataOffset = 0;
+    if (dataOffset > mDataBytes) dataOffset = mDataBytes;
+    if (fseek(mFile, (long)(mDataStart + dataOffset), SEEK_SET) != 0) {
+        return ERROR_NOT_OPEN;
+    }
+    mDataPos = dataOffset;
+    return NO_ERROR;
+}
+
+status_t WavPlayer::prepare()
+{
+    LOGV("prepare\n");
+    if (mState != STATE_OPEN) {
+        return ERROR_NOT_OPEN;
+    }
+    return NO_ERROR;
+}
+
+status_t WavPlayer::prepareAsync()
+{
+    LOGV("prepareAsync\n");
+    // Deliberately not holding the lock: sendEvent calls back into the client
+    // and the state is not changing here.  Same as VorbisPlayer.
+    if (mState != STATE_OPEN) {
+        sendEvent(MEDIA_ERROR);
+        return NO_ERROR;
+    }
+    sendEvent(MEDIA_PREPARED);
+    return NO_ERROR;
+}
+
+status_t WavPlayer::start()
+{
+    LOGV("start\n");
+    Mutex::Autolock l(mMutex);
+    if (mState != STATE_OPEN) {
+        return ERROR_NOT_OPEN;
+    }
+    mPaused = false;
+    mRender = true;
+    mCondition.signal();
+    return NO_ERROR;
+}
+
+status_t WavPlayer::stop()
+{
+    LOGV("stop\n");
+    Mutex::Autolock l(mMutex);
+    if (mState != STATE_OPEN) {
+        return ERROR_NOT_OPEN;
+    }
+    mPaused = true;
+    mRender = false;
+    return NO_ERROR;
+}
+
+status_t WavPlayer::seekTo(int position)
+{
+    LOGV("seekTo %d\n", position);
+    Mutex::Autolock l(mMutex);
+    if (mState != STATE_OPEN) {
+        return ERROR_NOT_OPEN;
+    }
+    int frameSize = mChannels * (mBitsPerSample / 8);
+    int64_t off = ((int64_t)position * (int64_t)mSampleRate / 1000LL) * frameSize;
+    status_t err = seekBytes(off);
+    if (err != NO_ERROR) return err;
+    sendEvent(MEDIA_SEEK_COMPLETE);
+    return NO_ERROR;
+}
+
+status_t WavPlayer::pause()
+{
+    LOGV("pause\n");
+    Mutex::Autolock l(mMutex);
+    if (mState != STATE_OPEN) {
+        return ERROR_NOT_OPEN;
+    }
+    mPaused = true;
+    return NO_ERROR;
+}
+
+bool WavPlayer::isPlaying()
+{
+    if (mState == STATE_OPEN) {
+        return mRender;
+    }
+    return false;
+}
+
+status_t WavPlayer::getCurrentPosition(int* position)
+{
+    Mutex::Autolock l(mMutex);
+    if (mState != STATE_OPEN) {
+        LOGE("getCurrentPosition(): file not open");
+        return ERROR_NOT_OPEN;
+    }
+    *position = bytesToMsec(mDataPos);
+    return NO_ERROR;
+}
+
+status_t WavPlayer::getDuration(int* duration)
+{
+    Mutex::Autolock l(mMutex);
+    if (mState != STATE_OPEN) {
+        return ERROR_NOT_OPEN;
+    }
+    *duration = mDuration;
+    return NO_ERROR;
+}
+
+status_t WavPlayer::release()
+{
+    LOGV("release\n");
+    Mutex::Autolock l(mMutex);
+    reset_nosync();
+
+    // Wait for the render thread to exit.
+    if (mRenderTid > 0) {
+        mExit = true;
+        mCondition.signal();
+        mCondition.wait(mMutex);
+    }
+    return NO_ERROR;
+}
+
+status_t WavPlayer::reset()
+{
+    LOGV("reset\n");
+    Mutex::Autolock l(mMutex);
+    return reset_nosync();
+}
+
+// always call with lock held
+status_t WavPlayer::reset_nosync()
+{
+    if (mFile != NULL) {
+        fclose(mFile);
+        mFile = NULL;
+    }
+    mState = STATE_ERROR;
+
+    mSampleRate = 0;
+    mChannels = 0;
+    mBitsPerSample = 0;
+    mDataStart = 0;
+    mDataBytes = 0;
+    mDataPos = 0;
+    mPlayTime = -1;
+    mDuration = -1;
+    mLoop = false;
+    mAndroidLoop = false;
+    mPaused = false;
+    mRender = false;
+    return NO_ERROR;
+}
+
+status_t WavPlayer::setLooping(int loop)
+{
+    LOGV("setLooping\n");
+    Mutex::Autolock l(mMutex);
+    mLoop = (loop != 0);
+    return NO_ERROR;
+}
+
+status_t WavPlayer::createOutputTrack()
+{
+    LOGV("Create AudioSink: rate=%u, channels=%d\n", mSampleRate, mChannels);
+    if (mAudioSink->open(mSampleRate, mChannels, AudioSystem::PCM_16_BIT,
+                         DEFAULT_AUDIOSINK_BUFFERCOUNT) != NO_ERROR) {
+        LOGE("mAudioSink open failed");
+        return ERROR_OPEN_FAILED;
+    }
+    return NO_ERROR;
+}
+
+int WavPlayer::renderThread(void* p)
+{
+    return ((WavPlayer*)p)->render();
+}
+
+int WavPlayer::render()
+{
+    int result = -1;
+    int temp;
+    bool audioStarted = false;
+
+    LOGV("render\n");
+
+    mAudioBuffer = new char[AUDIOBUFFER_SIZE];
+    if (!mAudioBuffer) {
+        LOGE("mAudioBuffer allocate failed\n");
+        goto threadExit;
+    }
+
+    // Let the main thread know we are ready.
+    {
+        Mutex::Autolock l(mMutex);
+        mRenderTid = myTid();
+        mCondition.signal();
+    }
+
+    while (1) {
+        long numread = 0;
+        {
+            Mutex::Autolock l(mMutex);
+
+            if (mPaused) {
+                if (mAudioSink->ready()) mAudioSink->pause();
+                mRender = false;
+                audioStarted = false;
+            }
+
+            if (!mExit && !mRender) {
+                LOGV("render - signal wait\n");
+                mCondition.wait(mMutex);
+                LOGV("render - signal rx'd\n");
+            }
+            if (mExit) break;
+
+            // start() may have been followed immediately by stop()/reset()
+            // before this thread got scheduled.
+            if (!mRender) continue;
+
+            numread = readPcm(mAudioBuffer, AUDIOBUFFER_SIZE);
+            if (numread == 0) {
+                if (mLoop || mAndroidLoop) {
+                    seekBytes(0);
+                    numread = readPcm(mAudioBuffer, AUDIOBUFFER_SIZE);
+                } else {
+                    mAudioSink->stop();
+                    audioStarted = false;
+                    mRender = false;
+                    mPaused = true;
+                    int64_t endpos = mDataPos;
+
+                    LOGV("send MEDIA_PLAYBACK_COMPLETE");
+                    sendEvent(MEDIA_PLAYBACK_COMPLETE);
+
+                    // Wait until we are started again.
+                    mCondition.wait(mMutex);
+                    if (mExit) break;
+
+                    // If nobody seeked in the meantime, restart from the top.
+                    if (mState == STATE_OPEN) {
+                        if (mDataPos == endpos) {
+                            seekBytes(0);
+                        }
+                        numread = readPcm(mAudioBuffer, AUDIOBUFFER_SIZE);
+                    }
+                }
+            }
+        }
+
+        if (numread < 0) {
+            LOGE("Error reading PCM");
+            sendEvent(MEDIA_ERROR);
+            break;
+        }
+        if (numread == 0) {
+            // Looping an empty file, or reset raced us.  Go back and wait.
+            continue;
+        }
+
+        if (!mAudioSink->ready()) {
+            LOGV("render - create output track\n");
+            if (createOutputTrack() != NO_ERROR)
+                break;
+        }
+
+        if ((temp = mAudioSink->write(mAudioBuffer, numread)) < 0) {
+            LOGE("Error in writing:%d", temp);
+            result = temp;
+            break;
+        }
+
+        if (!audioStarted && !mPaused && !mExit) {
+            LOGV("render - starting audio\n");
+            mAudioSink->start();
+            audioStarted = true;
+        }
+    }
+
+threadExit:
+    mAudioSink.clear();
+    if (mAudioBuffer) {
+        delete [] mAudioBuffer;
+        mAudioBuffer = NULL;
+    }
+
+    // Tell release() we are gone.
+    {
+        Mutex::Autolock l(mMutex);
+        mRenderTid = -1;
+        mCondition.signal();
+    }
+    return result;
+}
+
+}; // namespace android
diff --git a/media/libmediaplayerservice/WavPlayer.h b/media/libmediaplayerservice/WavPlayer.h
new file mode 100755
index 0000000000000000000000000000000000000000..d5324b9c48f28aabccac8f561a64c2c3cacdbb2c
--- /dev/null
+++ b/media/libmediaplayerservice/WavPlayer.h
@@ -0,0 +1,108 @@
+/*
+ * WavPlayer -- the only decoder this image has.
+ *
+ * Eclair's MediaPlayerService can create four players: PVPlayer (OpenCORE),
+ * MidiFile (libsonivox/EAS), VorbisPlayer (libvorbisidec/tremolo) and
+ * StagefrightPlayer.  None of the four are in this tree -- no external/opencore,
+ * no external/tremolo, no external/sonivox -- so out of the box MediaPlayer
+ * here cannot decode a single byte of anything.  That takes out notification
+ * sounds, UI feedback sounds, SMS alerts, ringtones and SoundPool, all of
+ * which are just "MediaPlayer on a file in /system/media/audio".
+ *
+ * Rather than port a codec, the assets are transcoded to RIFF/WAVE PCM at
+ * build time (see scripts/build_audio_assets.sh, which runs ffmpeg over
+ * frameworks/base/data/sounds) and decoded by this, which is a file read.
+ * AudioFlinger's AudioMixer resamples whatever rate the file declares, so the
+ * assets ship at 22050 Hz mono to keep the image small and still come out at
+ * the CSND driver's 44100 Hz stereo.
+ *
+ * Structurally this is VorbisPlayer with the ov_* calls replaced by fread():
+ * same state machine, same render thread, same mAudioSink contract.  Using
+ * mAudioSink rather than a private AudioTrack is what makes
+ * MediaPlayerService::decode() work, and decode() is how SoundPool -- and
+ * therefore every UI sound -- loads a sample.
+ */
+
+#ifndef ANDROID_WAVPLAYER_H
+#define ANDROID_WAVPLAYER_H
+
+#include <stdio.h>
+#include <utils/threads.h>
+
+#include <media/MediaPlayerInterface.h>
+#include <media/AudioTrack.h>
+
+namespace android {
+
+class WavPlayer : public MediaPlayerInterface {
+public:
+                        WavPlayer();
+                        ~WavPlayer();
+
+    virtual void        onFirstRef();
+    virtual status_t    initCheck();
+    virtual status_t    setDataSource(const char* path);
+    virtual status_t    setDataSource(int fd, int64_t offset, int64_t length);
+    virtual status_t    setVideoSurface(const sp<ISurface>& surface) { return UNKNOWN_ERROR; }
+    virtual status_t    prepare();
+    virtual status_t    prepareAsync();
+    virtual status_t    start();
+    virtual status_t    stop();
+    virtual status_t    seekTo(int msec);
+    virtual status_t    pause();
+    virtual bool        isPlaying();
+    virtual status_t    getCurrentPosition(int* msec);
+    virtual status_t    getDuration(int* msec);
+    virtual status_t    release();
+    virtual status_t    reset();
+    virtual status_t    setLooping(int loop);
+    virtual player_type playerType() { return N3DS_WAV_PLAYER; }
+    virtual status_t    invoke(const Parcel& request, Parcel *reply) { return INVALID_OPERATION; }
+
+private:
+            status_t    setdatasource(const char *path, int fd, int64_t offset, int64_t length);
+            status_t    parseHeader();
+            status_t    reset_nosync();
+            status_t    createOutputTrack();
+    static  int         renderThread(void*);
+            int         render();
+
+            // Bytes read out of the data chunk so far, as milliseconds.
+            int         bytesToMsec(int64_t bytes) const;
+            // Reads up to n bytes of the data chunk, never past its end.
+            // Returns 0 at end of data, negative on I/O error.
+            long        readPcm(char* buf, long n);
+            status_t    seekBytes(int64_t dataOffset);
+
+    Mutex               mMutex;
+    Condition           mCondition;
+    FILE*               mFile;
+    int64_t             mOffset;        // start of the RIFF within mFile
+    int64_t             mLength;        // bytes of the RIFF within mFile
+
+    // Parsed from the fmt chunk.
+    uint32_t            mSampleRate;
+    int                 mChannels;
+    int                 mBitsPerSample;
+
+    // Parsed from the data chunk.
+    int64_t             mDataStart;     // absolute offset in mFile
+    int64_t             mDataBytes;
+    int64_t             mDataPos;       // bytes consumed out of mDataBytes
+
+    char*               mAudioBuffer;
+    int                 mPlayTime;
+    int                 mDuration;
+    status_t            mState;
+    int                 mStreamType;
+    bool                mLoop;
+    bool                mAndroidLoop;
+    volatile bool       mExit;
+    bool                mPaused;
+    volatile bool       mRender;
+    pid_t               mRenderTid;
+};
+
+}; // namespace android
+
+#endif // ANDROID_WAVPLAYER_H
diff --git a/media/libmediaplayerservice/WavRecorder.cpp b/media/libmediaplayerservice/WavRecorder.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..732bdaff1b8499a744035380783ac1247591bb10
--- /dev/null
+++ b/media/libmediaplayerservice/WavRecorder.cpp
@@ -0,0 +1,548 @@
+/*
+ * WavRecorder -- see WavRecorder.h for why this exists and what it will not do.
+ */
+
+//#define LOG_NDEBUG 0
+#define LOG_TAG "WavRecorder"
+#include <utils/Log.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include <media/AudioSystem.h>
+#include <media/mediarecorder.h>
+
+#include "WavRecorder.h"
+
+namespace android {
+
+/* RIFF/WAVE is little-endian and so is the ARM11 here, but writing the
+ * header a byte at a time costs nothing and says what the bytes are. */
+static void put16(uint8_t* p, uint32_t v)
+{
+    p[0] = (uint8_t)(v & 0xff);
+    p[1] = (uint8_t)((v >> 8) & 0xff);
+}
+
+static void put32(uint8_t* p, uint32_t v)
+{
+    p[0] = (uint8_t)(v & 0xff);
+    p[1] = (uint8_t)((v >> 8) & 0xff);
+    p[2] = (uint8_t)((v >> 16) & 0xff);
+    p[3] = (uint8_t)((v >> 24) & 0xff);
+}
+
+static const size_t kHeaderBytes = 44;
+
+/* Definitions for the in-class constants. They are constant expressions
+ * already, but a varargs LOG call odr-uses them and then the linker wants
+ * an object to point at. */
+const uint32_t WavRecorder::kSampleRate;
+const int      WavRecorder::kChannelCount;
+const int      WavRecorder::kBytesPerFrame;
+
+WavRecorder::WavRecorder(pid_t pid)
+    : mPid(pid),
+      mAudioSource(AUDIO_SOURCE_DEFAULT),
+      mOutputFormat(OUTPUT_FORMAT_DEFAULT),
+      mAudioEncoder(AUDIO_ENCODER_DEFAULT),
+      mSourceSet(false),
+      mFd(-1),
+      mFileOffset(0),
+      mDataBytes(0),
+      mRecord(NULL),
+      mRecording(false),
+      mMaxAmplitude(0)
+{
+    LOGV("WavRecorder for pid %d", pid);
+}
+
+WavRecorder::~WavRecorder()
+{
+    reset();
+}
+
+// ---------------------------------------------------------------------------
+// configuration
+
+status_t WavRecorder::setAudioSource(int as)
+{
+    LOGV("setAudioSource(%d)", as);
+    if (as < AUDIO_SOURCE_DEFAULT || as >= AUDIO_SOURCE_LIST_END) {
+        LOGE("invalid audio source %d", as);
+        return BAD_VALUE;
+    }
+    Mutex::Autolock lock(mLock);
+    if (mRecording) return INVALID_OPERATION;
+    /*
+     * Every source maps to the one microphone. VOICE_UPLINK/DOWNLINK/CALL
+     * would need a modem to tap and there is none; taking them as MIC is
+     * better than failing, because 3DSTelco's in-call recorder asks for
+     * VOICE_CALL and would otherwise get nothing rather than one side of the
+     * conversation.
+     */
+    mAudioSource = as;
+    mSourceSet = true;
+    return NO_ERROR;
+}
+
+status_t WavRecorder::setOutputFormat(int of)
+{
+    LOGV("setOutputFormat(%d)", of);
+    if (of < OUTPUT_FORMAT_DEFAULT || of >= OUTPUT_FORMAT_LIST_END) {
+        LOGE("invalid output format %d", of);
+        return BAD_VALUE;
+    }
+    Mutex::Autolock lock(mLock);
+    if (mRecording) return INVALID_OPERATION;
+    mOutputFormat = of;
+    return NO_ERROR;
+}
+
+status_t WavRecorder::setAudioEncoder(int ae)
+{
+    LOGV("setAudioEncoder(%d)", ae);
+    if (ae < AUDIO_ENCODER_DEFAULT || ae >= AUDIO_ENCODER_LIST_END) {
+        LOGE("invalid audio encoder %d", ae);
+        return BAD_VALUE;
+    }
+    Mutex::Autolock lock(mLock);
+    if (mRecording) return INVALID_OPERATION;
+    mAudioEncoder = ae;
+    return NO_ERROR;
+}
+
+status_t WavRecorder::setOutputFile(const char* path)
+{
+    LOGV("setOutputFile(%s)", path);
+    if (path == NULL) return BAD_VALUE;
+    int fd = ::open(path, O_CREAT | O_TRUNC | O_RDWR, 0644);
+    if (fd < 0) {
+        LOGE("cannot open %s: %s", path, strerror(errno));
+        return -errno;
+    }
+    status_t status = setOutputFile(fd, 0, 0);
+    ::close(fd);            /* setOutputFile(fd,...) keeps its own dup */
+    return status;
+}
+
+status_t WavRecorder::setOutputFile(int fd, int64_t offset, int64_t length)
+{
+    LOGV("setOutputFile(fd=%d, offset=%lld, length=%lld)", fd, offset, length);
+    Mutex::Autolock lock(mLock);
+    if (mRecording) return INVALID_OPERATION;
+
+    /*
+     * The caller's fd belongs to the caller and is closed as soon as this
+     * binder transaction returns, so it has to be duplicated rather than
+     * kept. Upstream's MediaRecorderClient does the same thing one layer
+     * further down.
+     */
+    int own = ::dup(fd);
+    if (own < 0) {
+        LOGE("dup of caller fd failed: %s", strerror(errno));
+        return -errno;
+    }
+    closeOutput_l();
+    mFd = own;
+    mFileOffset = offset;
+    mDataBytes = 0;
+    /* `length` is a maximum the caller is prepared to accept; nothing in this
+     * image passes a non-zero one, and honouring it would need a size cap in
+     * the capture loop, so it is refused rather than silently ignored. */
+    if (length != 0) {
+        LOGW("setOutputFile: length limit %lld not supported, recording is unbounded",
+             length);
+    }
+    return NO_ERROR;
+}
+
+status_t WavRecorder::setParameters(const String8& params)
+{
+    /*
+     * Eclair has no setAudioSamplingRate()/setAudioChannels() API -- those
+     * arrived in Froyo and travel through here as "audio-param-*" strings.
+     * There is exactly one capture format this hardware path will open, so
+     * a request for anything else is reported rather than quietly ignored:
+     * a caller asking for 44100 needs to know it is getting 8000.
+     */
+    LOGV("setParameters(%s)", params.string());
+    const char* s = params.string();
+    const char* rate = strstr(s, "audio-param-sampling-rate=");
+    if (rate != NULL) {
+        int asked = atoi(rate + strlen("audio-param-sampling-rate="));
+        if (asked > 0 && (uint32_t)asked != kSampleRate) {
+            LOGW("sampling rate %d requested; this hardware records at %u Hz only",
+                 asked, kSampleRate);
+        }
+    }
+    const char* chans = strstr(s, "audio-param-number-of-channels=");
+    if (chans != NULL) {
+        int asked = atoi(chans + strlen("audio-param-number-of-channels="));
+        if (asked > 0 && asked != kChannelCount) {
+            LOGW("%d channels requested; this hardware records mono only", asked);
+        }
+    }
+    return NO_ERROR;
+}
+
+status_t WavRecorder::setListener(const sp<IMediaPlayerClient>& listener)
+{
+    Mutex::Autolock lock(mLock);
+    mListener = listener;
+    return NO_ERROR;
+}
+
+// ---------------------------------------------------------------------------
+// no video, and no pretending there is
+
+status_t WavRecorder::setCamera(const sp<ICamera>& camera)
+{
+    LOGE("setCamera: this build records audio only");
+    return INVALID_OPERATION;
+}
+
+status_t WavRecorder::setPreviewSurface(const sp<ISurface>& surface)
+{
+    LOGE("setPreviewSurface: this build records audio only");
+    return INVALID_OPERATION;
+}
+
+status_t WavRecorder::setVideoSource(int vs)
+{
+    LOGE("setVideoSource(%d): this build records audio only", vs);
+    return INVALID_OPERATION;
+}
+
+status_t WavRecorder::setVideoEncoder(int ve)
+{
+    LOGE("setVideoEncoder(%d): this build records audio only", ve);
+    return INVALID_OPERATION;
+}
+
+status_t WavRecorder::setVideoSize(int width, int height)
+{
+    LOGE("setVideoSize: this build records audio only");
+    return INVALID_OPERATION;
+}
+
+status_t WavRecorder::setVideoFrameRate(int frames_per_second)
+{
+    LOGE("setVideoFrameRate: this build records audio only");
+    return INVALID_OPERATION;
+}
+
+// ---------------------------------------------------------------------------
+// the recording itself
+
+status_t WavRecorder::prepare()
+{
+    Mutex::Autolock lock(mLock);
+    if (mRecording) return INVALID_OPERATION;
+    if (!mSourceSet) {
+        LOGE("prepare: no audio source set");
+        return INVALID_OPERATION;
+    }
+    if (mFd < 0) {
+        LOGE("prepare: no output file set");
+        return INVALID_OPERATION;
+    }
+    /* Reserve the header now so start() can go straight to capturing, and so
+     * a caller that prepares and never starts still gets a valid empty WAV
+     * rather than a zero-length file. */
+    return writeHeader_l(0);
+}
+
+status_t WavRecorder::start()
+{
+    Mutex::Autolock lock(mLock);
+    if (mRecording) return INVALID_OPERATION;
+    if (mFd < 0) {
+        LOGE("start: not prepared");
+        return INVALID_OPERATION;
+    }
+
+    if (mOutputFormat != OUTPUT_FORMAT_DEFAULT) {
+        /* Said once per recording, not once per frame. See WavRecorder.h. */
+        LOGI("output format %d requested; writing RIFF/WAVE PCM %u Hz mono, "
+             "which is the only container this image can also play back",
+             mOutputFormat, kSampleRate);
+    }
+
+    /*
+     * frameCount 0 lets AudioRecord ask AudioFlinger for the minimum, which
+     * on AudioHardwareGeneric is the 320-byte input buffer doubled. That is
+     * 40 ms of slack and an SD write can easily outlast it, so ask for a
+     * second outright -- an overrun here is a hole in the recording, and the
+     * memory is a dma-less heap allocation in mediaserver.
+     */
+    const int frameCount = (int)kSampleRate;   /* 1.0 s */
+
+    AudioRecord* record = new AudioRecord(
+            mAudioSource, kSampleRate, AudioSystem::PCM_16_BIT,
+            AudioSystem::CHANNEL_IN_MONO, frameCount);
+    status_t status = record->initCheck();
+    if (status != NO_ERROR) {
+        LOGE("AudioRecord would not open %u Hz mono: %d", kSampleRate, status);
+        delete record;
+        return status;
+    }
+    status = record->start();
+    if (status != NO_ERROR) {
+        LOGE("AudioRecord would not start: %d", status);
+        delete record;
+        return status;
+    }
+
+    mRecord = record;
+    mMaxAmplitude = 0;
+    mRecording = true;
+
+    mThread = new CaptureThread(this);
+    status = mThread->run("WavRecorder", ANDROID_PRIORITY_AUDIO);
+    if (status != NO_ERROR) {
+        LOGE("capture thread would not start: %d", status);
+        mRecording = false;
+        mThread.clear();
+        record->stop();
+        delete record;
+        mRecord = NULL;
+        return status;
+    }
+    LOGI("recording %u Hz mono 16-bit from source %d", kSampleRate, mAudioSource);
+    return NO_ERROR;
+}
+
+status_t WavRecorder::stop()
+{
+    LOGV("stop");
+    sp<CaptureThread> thread;
+    {
+        Mutex::Autolock lock(mLock);
+        if (!mRecording) return INVALID_OPERATION;
+        mRecording = false;
+        thread = mThread;
+    }
+    /*
+     * Outside the lock. The capture thread takes mLock on every buffer to
+     * update mDataBytes and mMaxAmplitude, so joining it while holding the
+     * lock deadlocks the caller against its own recorder.
+     */
+    if (thread != 0) thread->requestExitAndWait();
+
+    Mutex::Autolock lock(mLock);
+    mThread.clear();
+    if (mRecord != NULL) {
+        /* Safe now and only now: the capture thread has been joined. */
+        mRecord->stop();
+        delete mRecord;
+        mRecord = NULL;
+    }
+    status_t status = writeHeader_l(mDataBytes);
+    LOGI("recorded %llu bytes (%llu ms), peak %d",
+         mDataBytes,
+         mDataBytes / (kBytesPerFrame * kChannelCount) * 1000 / kSampleRate,
+         mMaxAmplitude);
+    return status;
+}
+
+void WavRecorder::stopLocked()
+{
+    /* Caller holds mLock, and has already joined the capture thread. That
+     * second half is not optional: the loop carries a bare AudioRecord*
+     * across read(), so there is no other moment at which deleting it is
+     * safe. stop() is the ordered version; reset() does the join itself. */
+    mRecording = false;
+    if (mRecord != NULL) {
+        mRecord->stop();
+        delete mRecord;
+        mRecord = NULL;
+    }
+}
+
+status_t WavRecorder::reset()
+{
+    LOGV("reset");
+    if (mRecording) stop();
+
+    /*
+     * mRecording is false by now, but the thread is not necessarily gone:
+     * captureLoop() returns false on a read or write error without
+     * clearing the flag, so the stop() above can have answered
+     * INVALID_OPERATION and joined nothing. Join here before anything
+     * deletes the AudioRecord the loop is holding a bare pointer to.
+     */
+    sp<CaptureThread> thread;
+    {
+        Mutex::Autolock lock(mLock);
+        thread = mThread;
+    }
+    if (thread != 0) thread->requestExitAndWait();
+
+    Mutex::Autolock lock(mLock);
+    stopLocked();
+    mThread.clear();
+    closeOutput_l();
+    mAudioSource = AUDIO_SOURCE_DEFAULT;
+    mOutputFormat = OUTPUT_FORMAT_DEFAULT;
+    mAudioEncoder = AUDIO_ENCODER_DEFAULT;
+    mSourceSet = false;
+    mDataBytes = 0;
+    mMaxAmplitude = 0;
+    return NO_ERROR;
+}
+
+status_t WavRecorder::init()
+{
+    return NO_ERROR;
+}
+
+status_t WavRecorder::close()
+{
+    Mutex::Autolock lock(mLock);
+    closeOutput_l();
+    return NO_ERROR;
+}
+
+status_t WavRecorder::release()
+{
+    return reset();
+}
+
+status_t WavRecorder::getMaxAmplitude(int* max)
+{
+    if (max == NULL) return BAD_VALUE;
+    Mutex::Autolock lock(mLock);
+    *max = mMaxAmplitude;
+    mMaxAmplitude = 0;          /* documented as "since the last call" */
+    return NO_ERROR;
+}
+
+// ---------------------------------------------------------------------------
+
+bool WavRecorder::captureLoop()
+{
+    /* One buffer is 100 ms, matched to nothing in particular except that it
+     * is long enough to keep SD writes rare and short enough that stop()
+     * returns promptly. */
+    const size_t frames = kSampleRate / 10;
+    int16_t buffer[frames];
+
+    if (!mRecording) return false;
+
+    AudioRecord* record;
+    {
+        Mutex::Autolock lock(mLock);
+        record = mRecord;
+    }
+    if (record == NULL) return false;
+
+    ssize_t got = record->read(buffer, sizeof(buffer));
+    if (got < 0) {
+        LOGE("AudioRecord::read failed: %d", (int)got);
+        notifyError(MEDIA_RECORDER_ERROR_UNKNOWN);
+        return false;
+    }
+    if (got == 0) return mRecording;
+
+    size_t count = (size_t)got / sizeof(int16_t);
+    int peak = 0;
+    for (size_t i = 0; i < count; i++) {
+        int sample = buffer[i];
+        if (sample < 0) sample = -sample;
+        if (sample > peak) peak = sample;
+    }
+
+    Mutex::Autolock lock(mLock);
+    if (!mRecording || mFd < 0) return false;
+    if (peak > mMaxAmplitude) mMaxAmplitude = peak;
+
+    const uint8_t* p = (const uint8_t*)buffer;
+    size_t left = (size_t)got;
+    while (left > 0) {
+        ssize_t written = ::write(mFd, p, left);
+        if (written <= 0) {
+            if (written < 0 && errno == EINTR) continue;
+            LOGE("write to recording failed: %s", strerror(errno));
+            notifyError(MEDIA_RECORDER_ERROR_UNKNOWN);
+            return false;
+        }
+        p += written;
+        left -= (size_t)written;
+        mDataBytes += (uint64_t)written;
+    }
+    return mRecording;
+}
+
+status_t WavRecorder::writeHeader_l(uint64_t dataBytes)
+{
+    if (mFd < 0) return INVALID_OPERATION;
+
+    const uint32_t byteRate = kSampleRate * kChannelCount * kBytesPerFrame;
+    uint8_t header[kHeaderBytes];
+    memcpy(header, "RIFF", 4);
+    put32(header + 4, (uint32_t)(36 + dataBytes));
+    memcpy(header + 8, "WAVEfmt ", 8);
+    put32(header + 16, 16);                     /* fmt chunk size */
+    put16(header + 20, 1);                      /* PCM */
+    put16(header + 22, kChannelCount);
+    put32(header + 24, kSampleRate);
+    put32(header + 28, byteRate);
+    put16(header + 32, kChannelCount * kBytesPerFrame);   /* block align */
+    put16(header + 34, kBytesPerFrame * 8);               /* bits per sample */
+    memcpy(header + 36, "data", 4);
+    put32(header + 40, (uint32_t)dataBytes);
+
+    off_t where = ::lseek(mFd, (off_t)mFileOffset, SEEK_SET);
+    if (where < 0) {
+        LOGE("cannot seek to header: %s", strerror(errno));
+        return -errno;
+    }
+    size_t left = sizeof(header);
+    const uint8_t* p = header;
+    while (left > 0) {
+        ssize_t written = ::write(mFd, p, left);
+        if (written <= 0) {
+            if (written < 0 && errno == EINTR) continue;
+            LOGE("cannot write header: %s", strerror(errno));
+            return -errno;
+        }
+        p += written;
+        left -= (size_t)written;
+    }
+    /* Back to the end so the capture loop appends rather than overwriting
+     * the first 44 bytes of audio with more audio. */
+    if (::lseek(mFd, (off_t)(mFileOffset + kHeaderBytes + dataBytes), SEEK_SET) < 0) {
+        LOGE("cannot seek past header: %s", strerror(errno));
+        return -errno;
+    }
+    return NO_ERROR;
+}
+
+void WavRecorder::closeOutput_l()
+{
+    if (mFd >= 0) {
+        ::close(mFd);
+        mFd = -1;
+    }
+    mFileOffset = 0;
+}
+
+void WavRecorder::notifyError(int what)
+{
+    /* mLock may or may not be held here, so the listener is read without it.
+     * A racing setListener() is harmless: sp<> assignment is atomic enough
+     * for this and the worst case is one notification going to the previous
+     * listener. */
+    sp<IMediaPlayerClient> listener = mListener;
+    if (listener != 0) {
+        listener->notify(MEDIA_RECORDER_EVENT_ERROR, what, 0);
+    }
+}
+
+}; // namespace android
diff --git a/media/libmediaplayerservice/WavRecorder.h b/media/libmediaplayerservice/WavRecorder.h
new file mode 100644
index 0000000000000000000000000000000000000000..9e8b69d331bb83a56e11261d342e98c41ef1a2b6
--- /dev/null
+++ b/media/libmediaplayerservice/WavRecorder.h
@@ -0,0 +1,155 @@
+/*
+ * WavRecorder -- the only encoder this image has.
+ *
+ * The mirror of WavPlayer, and for the same reason.  Eclair's
+ * MediaPlayerService answers createMediaRecorder() with a MediaRecorderClient,
+ * which is a front end for PVMediaRecorder out of external/opencore.  There is
+ * no external/opencore in this tree, so that call returned NULL and every
+ * MediaRecorder this system could construct was dead on arrival.
+ *
+ * WavPlayer solved the playback half by refusing to carry a codec: the assets
+ * are transcoded to RIFF/WAVE PCM at build time and "decoding" is a file read.
+ * This is the same trade going the other way.  Capture comes straight off
+ * AudioFlinger through an AudioRecord and lands on disk as RIFF/WAVE PCM, so
+ * "encoding" is a file write.
+ *
+ * Two consequences worth stating plainly, because they are visible from an
+ * app:
+ *
+ *  - The output is always RIFF/WAVE, whatever setOutputFormat() was told.
+ *    Refusing THREE_GPP would be more honest in the abstract and useless in
+ *    practice: every app that records asks for THREE_GPP/AMR_NB by default,
+ *    so refusing it means MediaRecorder never works for anybody.  A file
+ *    written here also plays back here -- WavPlayer sniffs the RIFF header
+ *    rather than the file name -- so a recording made on this handheld
+ *    round-trips on this handheld, which is where these files live.  The
+ *    format actually asked for is logged once per recording.
+ *
+ *  - The capture format is fixed at 8000 Hz mono 16-bit, and setParameters()
+ *    will not move it.  That is not a simplification, it is the hardware
+ *    path: AudioHardwareBase::getInputBufferSize() answers only for exactly
+ *    8000/PCM_16_BIT/1 channel, and AudioStreamInGeneric::set() rejects
+ *    anything else outright.  Asking for 44100 here would fail inside
+ *    AudioFlinger with "Error opening input channel", several layers below
+ *    where the caller could understand it.
+ *
+ * There is no video path at all.  setCamera(), setPreviewSurface(),
+ * setVideoSource(), setVideoEncoder(), setVideoSize() and setVideoFrameRate()
+ * all return INVALID_OPERATION rather than pretending.
+ *
+ * What comes out of the microphone is a separate question from whether any of
+ * this works: ctr_csnd powers the ADC and MICBIAS and paces reads correctly,
+ * but the MIC block at 0x10162000 is undocumented and no sample register in it
+ * has been identified, so today the samples are silence.  This class is the
+ * piece that turns "MediaRecorder cannot be constructed" into "MediaRecorder
+ * records", and it starts producing real audio the moment that block is
+ * decoded, with no change here.
+ */
+
+#ifndef ANDROID_WAVRECORDER_H
+#define ANDROID_WAVRECORDER_H
+
+#include <media/IMediaRecorder.h>
+#include <media/AudioRecord.h>
+#include <utils/String8.h>
+#include <utils/threads.h>
+
+namespace android {
+
+class ISurface;
+class ICamera;
+class IMediaPlayerClient;
+
+class WavRecorder : public BnMediaRecorder
+{
+public:
+    /* The only capture format AudioHardwareGeneric will open. */
+    static const uint32_t   kSampleRate   = 8000;
+    static const int        kChannelCount = 1;
+    static const int        kBytesPerFrame = 2;
+
+    virtual status_t    setCamera(const sp<ICamera>& camera);
+    virtual status_t    setPreviewSurface(const sp<ISurface>& surface);
+    virtual status_t    setVideoSource(int vs);
+    virtual status_t    setAudioSource(int as);
+    virtual status_t    setOutputFormat(int of);
+    virtual status_t    setVideoEncoder(int ve);
+    virtual status_t    setAudioEncoder(int ae);
+    virtual status_t    setOutputFile(const char* path);
+    virtual status_t    setOutputFile(int fd, int64_t offset, int64_t length);
+    virtual status_t    setVideoSize(int width, int height);
+    virtual status_t    setVideoFrameRate(int frames_per_second);
+    virtual status_t    setParameters(const String8& params);
+    virtual status_t    setListener(const sp<IMediaPlayerClient>& listener);
+    virtual status_t    prepare();
+    virtual status_t    getMaxAmplitude(int* max);
+    virtual status_t    start();
+    virtual status_t    stop();
+    virtual status_t    reset();
+    virtual status_t    init();
+    virtual status_t    close();
+    virtual status_t    release();
+
+private:
+    friend class MediaPlayerService;   // for the private constructor
+
+                        WavRecorder(pid_t pid);
+    virtual             ~WavRecorder();
+
+    /*
+     * The capture loop. A plain thread rather than an AudioRecord callback:
+     * the callback flavour runs on AudioFlinger's client thread and a blocking
+     * write() to an SD card from there would stall the record track itself.
+     */
+    class CaptureThread : public Thread {
+    public:
+        CaptureThread(WavRecorder* owner) : Thread(false), mOwner(owner) {}
+    private:
+        virtual bool threadLoop() { return mOwner->captureLoop(); }
+        WavRecorder* mOwner;
+    };
+
+            bool        captureLoop();
+            status_t    writeHeader_l(uint64_t dataBytes);
+            void        closeOutput_l();
+            void        stopLocked();
+            void        notifyError(int what);
+
+    pid_t               mPid;
+    Mutex               mLock;
+
+    int                 mAudioSource;
+    int                 mOutputFormat;
+    int                 mAudioEncoder;
+    bool                mSourceSet;
+
+    /* Output. mFd is owned here and always closed here. */
+    int                 mFd;
+    int64_t             mFileOffset;    /* where the RIFF header starts */
+    uint64_t            mDataBytes;     /* payload written so far */
+
+    /*
+     * A raw pointer, not an sp<>. Eclair's AudioRecord is a plain class
+     * with no incStrong/decStrong, so there is nothing for sp<> to hold
+     * on to. Its lifetime is bounded by the capture thread instead:
+     * nothing deletes it until requestExitAndWait() has returned, so the
+     * loop can copy the pointer under the lock and then read() outside
+     * it without racing a free.
+     */
+    AudioRecord*        mRecord;
+    sp<CaptureThread>   mThread;
+    volatile bool       mRecording;
+
+    /* getMaxAmplitude() is documented as "since the last call", so the peak
+     * is reset by the read rather than by the recording. */
+    int                 mMaxAmplitude;
+
+    sp<IMediaPlayerClient> mListener;
+
+                        WavRecorder(const WavRecorder&);
+    WavRecorder&        operator=(const WavRecorder&);
+};
+
+}; // namespace android
+
+#endif // ANDROID_WAVRECORDER_H
diff --git a/media/mediaserver/main_mediaserver_n3ds.cpp b/media/mediaserver/main_mediaserver_n3ds.cpp
new file mode 100755
index 0000000000000000000000000000000000000000..d337a1619c9f99139dcd47943cecd5ca20ecfe5c
--- /dev/null
+++ b/media/mediaserver/main_mediaserver_n3ds.cpp
@@ -0,0 +1,61 @@
+/*
+ * mediaserver for the 3DS: AudioFlinger, MediaPlayerService, CameraService,
+ * AudioPolicyService -- the same four services, in the same order, as
+ * upstream's main_mediaserver.cpp next to this file.
+ *
+ * The order matters. AudioPolicyService's constructor builds an
+ * AudioPolicyManagerGeneric, whose constructor immediately calls
+ * openOutput(), which reaches AudioFlinger over binder. If it is instantiated
+ * before AudioFlinger has published "media.audio_flinger" it blocks in
+ * get_audio_flinger()'s retry loop for as long as the process is alive.
+ *
+ * This file existed for a while as camera-only, because there was no audio
+ * stack to host: no libmedia, no audio HAL, no codec. Three of those are now
+ * fixed -- AudioHardwareGeneric drives /dev/eac (ctr_csnd, 44100/stereo/S16,
+ * hardware-confirmed) and scripts/build_audio_stack.sh builds libmedia,
+ * libaudioflinger, libmediaplayerservice and libsoundpool. The codec is still
+ * missing and always will be: there is no OpenCORE, no tremolo and no sonivox
+ * in this tree, so MediaPlayerService hosts exactly one player, WavPlayer,
+ * and every shipped sound asset is transcoded to RIFF/WAVE at build time.
+ * See WavPlayer.h.
+ *
+ * It is kept rather than folded back into upstream's main only because
+ * upstream's also starts the AudioDumpInterface and the A2DP interface, and
+ * neither of those archives is built here.
+ */
+
+#include <sys/types.h>
+#include <unistd.h>
+#include <grp.h>
+
+#include <binder/IPCThreadState.h>
+#include <binder/ProcessState.h>
+#include <binder/IServiceManager.h>
+#include <utils/Log.h>
+
+// CameraService.h opens with a malformed forward declaration,
+// class android::MemoryHeapBase;, which only compiles where the real
+// header has already been seen. Upstream never notices because its main
+// includes AudioFlinger.h first. Include it explicitly instead.
+#include <binder/MemoryHeapBase.h>
+#include <CameraService.h>
+
+#include <AudioFlinger.h>
+#include <AudioPolicyService.h>
+#include <MediaPlayerService.h>
+
+using namespace android;
+
+int main(int argc, char** argv)
+{
+    sp<ProcessState> proc(ProcessState::self());
+    sp<IServiceManager> sm = defaultServiceManager();
+    LOGI("ServiceManager: %p", sm.get());
+    AudioFlinger::instantiate();
+    MediaPlayerService::instantiate();
+    CameraService::instantiate();
+    AudioPolicyService::instantiate();
+    ProcessState::self()->startThreadPool();
+    IPCThreadState::self()->joinThreadPool();
+    return 0;
+}
