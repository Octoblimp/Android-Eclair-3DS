+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package android.webkit;
+
+import java.io.FileInputStream;
+import java.io.IOException;
+
+/**
+ * N3DS_WEB_PROFILE: WebKit's memory budgets on the two handhelds.
+ *
+ * Eclair sized everything for a 192 MB+ phone with swap-free but
+ * disk-backed /data.  Here /data is RAM, so the HTTP "disk" cache is a
+ * second RAM cache, and the Old 3DS family has only 128 MB in total.
+ * Loading theoldnet.com used up RAM until program code was evicted and
+ * re-read from the SD card, which ended in I/O errors.
+ *
+ * The New 3DS family ("nintendo,ktr" in the device tree, 256 MB) gets the
+ * larger budgets; everything else is treated as an Old 3DS.
+ *
+ * @hide
+ */
+public final class N3dsWebProfile {
+    /** True on the Old 3DS / 2DS family (128 MB). */
+    public static final boolean LOW_MEMORY = !isNew3ds();
+
+    /** WebCore memory cache; decoded images get twice this (JavaBridge.cpp). */
+    public static final int WEBCORE_CACHE_BYTES =
+            LOW_MEMORY ? 1536 * 1024 : 3 * 1024 * 1024;
+    /** HTTP cache, held in RAM because /data is RAM. */
+    public static final long HTTP_CACHE_BYTES =
+            LOW_MEMORY ? 1024 * 1024 : 2 * 1024 * 1024;
+    /** A response larger than this is never written to the HTTP cache. */
+    public static final long HTTP_CACHE_ENTRY_BYTES =
+            LOW_MEMORY ? 192 * 1024 : 384 * 1024;
+    /** Parallel HTTP connections (stock Eclair: 4). */
+    public static final int CONNECTIONS = LOW_MEMORY ? 2 : 3;
+    /** Browser tabs (stock Eclair: 8). */
+    public static final int MAX_TABS = LOW_MEMORY ? 2 : 4;
+
+    private N3dsWebProfile() {}
+
+    private static boolean isNew3ds() {
+        String compatible = read("/proc/device-tree/compatible", 256);
+        if (compatible != null) {
+            return compatible.indexOf("nintendo,ktr") >= 0;
+        }
+        // No device tree: fall back to RAM size (New 3DS reports ~240 MB).
+        String meminfo = read("/proc/meminfo", 128);
+        if (meminfo != null && meminfo.startsWith("MemTotal:")) {
+            String digits = meminfo.substring(9).trim();
+            int end = 0;
+            while (end < digits.length() && Character.isDigit(digits.charAt(end))) end++;
+            try {
+                return Long.parseLong(digits.substring(0, end)) > 180 * 1024;
+            } catch (NumberFormatException e) {
+                // fall through
+            }
+        }
+        return false;
+    }
+
+    private static String read(String path, int max) {
+        FileInputStream in = null;
+        try {
+            in = new FileInputStream(path);
+            byte[] buffer = new byte[max];
+            int total = 0;
+            int n;
+            while (total < max && (n = in.read(buffer, total, max - total)) > 0) {
+                total += n;
+            }
+            // device-tree strings are NUL-separated
+            return new String(buffer, 0, total, "ISO-8859-1").replace('\0', ' ');
+        } catch (IOException e) {
+            return null;
+        } finally {
+            if (in != null) {
+                try { in.close(); } catch (IOException e) { }
+            }
+        }
+    }
+}
