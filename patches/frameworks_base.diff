+            }
+            n3ds_restore_tree(s, d, uid, gid, depth + 1, restored, skipped);
+        } else if (S_ISREG(st.st_mode)) {
+            if (n3ds_restore_file(s, d, name, uid, gid) == 0)
+                (*restored)++;
+            else
+                (*skipped)++;
+        }
