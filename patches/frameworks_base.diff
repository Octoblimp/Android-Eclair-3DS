+    char buffer[SIZE];
+    String8 result;
+
+    snprintf(buffer, SIZE, "\nAudioPolicyManagerGeneric Dump: %p\n", this);
+    result.append(buffer);
+    snprintf(buffer, SIZE, " Hardware Output: %d\n", mHardwareOutput);
+    result.append(buffer);
+    snprintf(buffer, SIZE, " Phone state: %d\n", mPhoneState);
+    result.append(buffer);
+    snprintf(buffer, SIZE, " Ringer mode: %d\n", mRingerMode);
+    result.append(buffer);
+    snprintf(buffer, SIZE, " Available output devices: %08x\n", mAvailableOutputDevices);
+    result.append(buffer);
+    snprintf(buffer, SIZE, " Available input devices: %08x\n", mAvailableInputDevices);
+    result.append(buffer);
+    for (int i = 0; i < AudioSystem::NUM_FORCE_USE; i++) {
+        snprintf(buffer, SIZE, " Force use for %d: %d\n", i, mForceUse[i]);
+        result.append(buffer);
+    }
+
+    snprintf(buffer, SIZE, "\nOutputs dump:\n");
+    result.append(buffer);
+    for (size_t i = 0; i < mOutputs.size(); i++) {
+        AudioOutputDescriptor *out = mOutputs.valueAt(i);
+        snprintf(buffer, SIZE, " Output %d: rate %d fmt %d chan %08x latency %d dev %08x refs %d\n",
+                 mOutputs.keyAt(i), out->mSamplingRate, out->mFormat, out->mChannels,
+                 out->mLatency, out->mDevice, out->refCount());
+        result.append(buffer);
+    }
+
+    snprintf(buffer, SIZE, "\nInputs dump:\n");
+    result.append(buffer);
+    for (size_t i = 0; i < mInputs.size(); i++) {
+        AudioInputDescriptor *in = mInputs.valueAt(i);
+        snprintf(buffer, SIZE, " Input %d: rate %d fmt %d chan %08x dev %08x refs %d\n",
+                 mInputs.keyAt(i), in->mSamplingRate, in->mFormat, in->mChannels,
+                 in->mDevice, in->mRefCount);
+        result.append(buffer);
+    }
+
+    snprintf(buffer, SIZE, "\nStreams dump:\n");
+    result.append(buffer);
+    snprintf(buffer, SIZE, " Stream  Min  Max  Cur  Mute\n");
+    result.append(buffer);
+    for (int i = 0; i < AudioSystem::NUM_STREAM_TYPES; i++) {
+        snprintf(buffer, SIZE, " %6d %4d %4d %4d %5d\n", i, mStreams[i].mIndexMin,
+                 mStreams[i].mIndexMax, mStreams[i].mIndexCur, mStreams[i].mMuteCount);
+        result.append(buffer);
+    }
+
