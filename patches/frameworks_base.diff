+ * N3DS_NETWORK_TIME (#325): Settings > Date &amp; time > Automatic, made real.
+ *
+ * Eclair's "Automatic" checkbox (Settings.System.AUTO_TIME, on by default)
+ * only ever meant "take time and zone from the cell network's NITZ".  This
+ * console has no radio, so the box was ticked and nothing was behind it:
+ * the clock was whatever the kernel read out of the MCU RTC at boot, and the
+ * zone was whatever persist.sys.timezone happened to hold (empty = GMT).
+ *
+ * The MCU RTC is not UTC.  Horizon keeps the user's clock as an offset in
+ * its config save, on top of a free-running RTC, so Linux boots with a raw
+ * counter that on the #324 test unit read 12 hours behind the wall clock.
+ *
+ * With AUTO_TIME on and a network up, this service
+ *   - takes the time from NTP (SntpClient, UDP 123), and
+ *   - takes the zone from an IP geolocation lookup,
+ * then re-checks every six hours and on every connectivity change.
+ *
+ * Setting the time goes through SystemClock.setCurrentTimeMillis(), the same
+ * call Settings makes, so AlarmManager hears about the change through
+ * /dev/alarm exactly as it does for a manual change -- and, like a manual
+ * change, drivers/rtc/alarm.c writes the result into the MCU RTC.  The RTC
+ * therefore ends up holding UTC, which is what Linux assumes it holds, and
+ * the next boot starts on the right time before the network is up.
+ *
+ * An empty zone defaults to America/Chicago whatever AUTO_TIME says: GMT is
+ * never what anyone using this console wants, and Automatic disables the
+ * zone picker, so a zone nobody can change must at least be a plausible one.
+ *
+ * Everything runs on one HandlerThread; nothing here blocks system_server's
+ * main looper, and every failure is logged and retried rather than thrown.
+ */
+final class N3dsNetworkTimeService {
+    private static final String TAG = "N3dsNetworkTime";
+
+    private static final String[] NTP_SERVERS = {
+        "pool.ntp.org", "time.google.com", "time.cloudflare.com",
+    };
+    private static final int NTP_TIMEOUT_MS = 10000;
+
+    /** Plain HTTP on purpose: Eclair's TLS stack predates every modern cipher. */
+    private static final String ZONE_LOOKUP = "http://ip-api.com/json/?fields=status,timezone";
+    private static final int ZONE_TIMEOUT_MS = 10000;
+
+    static final String DEFAULT_TIME_ZONE = "America/Chicago";
+    private static final String TIMEZONE_PROPERTY = "persist.sys.timezone";
+
+    /** A skew below this is NTP noise, not a wrong clock; leave it alone. */
+    private static final long MIN_CORRECTION_MS = 2000;
+    /** Corrections bigger than this need a second server's agreement... */
+    private static final long CROSSCHECK_SKEW_MS = 10L * 60 * 1000;
+    /** ...to within this much. */
+    private static final long CROSSCHECK_AGREE_MS = 10000;
+    private static final long RESYNC_MS = 6L * 60 * 60 * 1000;
+    private static final long RETRY_MS = 60L * 1000;
+    /** Wi-Fi reports "connected" a moment before DHCP and DNS are usable. */
+    private static final long SETTLE_MS = 5000;
+
+    private final Context mContext;
+    private Handler mHandler;
+
+    private final Runnable mSync = new Runnable() {
+        public void run() {
+            sync();
+        }
+    };
+
+    static void start(Context context) {
+        new N3dsNetworkTimeService(context).begin();
+    }
+
+    private N3dsNetworkTimeService(Context context) {
+        mContext = context;
+    }
+
+    private void begin() {
+        HandlerThread thread = new HandlerThread(TAG);
+        thread.start();
+        mHandler = new Handler(thread.getLooper());
+
+        mHandler.post(new Runnable() {
+            public void run() {
+                applyDefaultTimeZone();
+            }
+        });
+
+        mContext.registerReceiver(new BroadcastReceiver() {
+            public void onReceive(Context context, Intent intent) {
+                schedule(SETTLE_MS);
+            }
+        }, new IntentFilter(ConnectivityManager.CONNECTIVITY_ACTION), null, mHandler);
+
+        mContext.getContentResolver().registerContentObserver(
+                Settings.System.getUriFor(Settings.System.AUTO_TIME), false,
+                new ContentObserver(mHandler) {
+                    public void onChange(boolean selfChange) {
+                        Log.i(TAG, "N3DS_NETWORK_TIME automatic=" + automatic());
+                        schedule(0);
+                    }
+                });
+
+        schedule(SETTLE_MS);
+        Log.i(TAG, "N3DS_NETWORK_TIME started, automatic=" + automatic());
+    }
+
+    private void schedule(long delayMs) {
+        mHandler.removeCallbacks(mSync);
+        mHandler.postDelayed(mSync, delayMs);
+    }
+
+    private boolean automatic() {
+        return Settings.System.getInt(mContext.getContentResolver(),
+                Settings.System.AUTO_TIME, 1) != 0;
+    }
+
+    private boolean online() {
+        ConnectivityManager cm = (ConnectivityManager)
+                mContext.getSystemService(Context.CONNECTIVITY_SERVICE);
+        NetworkInfo info = cm == null ? null : cm.getActiveNetworkInfo();
+        return info != null && info.isConnected();
+    }
+
+    private void sync() {
+        if (!automatic()) {
+            return;
+        }
+        if (!online()) {
+            // CONNECTIVITY_ACTION reschedules us when a network comes up.
+            return;
+        }
+        boolean timeOk = false;
+        try {
+            timeOk = syncTime();
+        } catch (Throwable error) {
+            Log.w(TAG, "NTP sync failed", error);
+        }
+        try {
+            syncTimeZone();
+        } catch (Throwable error) {
+            Log.w(TAG, "time zone lookup failed", error);
+        }
+        schedule(timeOk ? RESYNC_MS : RETRY_MS);
+    }
+
+    private boolean syncTime() {
+        for (int i = 0; i < NTP_SERVERS.length; i++) {
+            String server = NTP_SERVERS[i];
+            Long base = queryNtp(server);
+            if (base == null) {
+                continue;
+            }
+            long skew = base + SystemClock.elapsedRealtime() - System.currentTimeMillis();
+            if (Math.abs(skew) < MIN_CORRECTION_MS) {
+                Log.i(TAG, "N3DS_NETWORK_TIME clock already right (" + server
+                        + ", skew " + skew + " ms)");
+                return true;
+            }
+            // N3DS_NETWORK_TIME_CROSSCHECK: a big jump is only made when a second,
+            // independent server agrees. Eclair's SntpClient once doubled every
+            // offset and moved this clock 14 h on a single answer.
+            if (Math.abs(skew) > CROSSCHECK_SKEW_MS) {
+                String witness = "no other server";
+                Long other = null;
+                for (int j = i + 1; j < NTP_SERVERS.length && other == null; j++) {
+                    witness = NTP_SERVERS[j];
+                    other = queryNtp(witness);
+                }
+                if (other == null || Math.abs(other - base) > CROSSCHECK_AGREE_MS) {
+                    Log.w(TAG, "N3DS_NETWORK_TIME_CROSSCHECK not moving the clock " + skew + " ms: "
+                            + server + " and " + witness + " disagree");
+                    return false;
+                }
+            }
+            long now = base + SystemClock.elapsedRealtime();
+            boolean set = SystemClock.setCurrentTimeMillis(now);
+            Log.i(TAG, "N3DS_NETWORK_TIME set from " + server + ", skew " + skew
+                    + " ms, ok=" + set);
+            return set;
+        }
+        return false;
+    }
+
+    /**
+     * UTC minus {@link SystemClock#elapsedRealtime()} according to {@code server},
+     * so the time can be read out later without going stale; null if no answer.
+     */
+    private Long queryNtp(String server) {
+        SntpClient client = new SntpClient();
+        if (!client.requestTime(server, NTP_TIMEOUT_MS)) {
+            Log.w(TAG, "N3DS_NETWORK_TIME no answer from " + server);
+            return null;
+        }
+        return Long.valueOf(client.getNtpTime() - client.getNtpTimeReference());
+    }
+
+    private void syncTimeZone() throws Exception {
+        String zone = lookUpTimeZone();
+        if (zone == null) {
+            return;
+        }
+        String current = SystemProperties.get(TIMEZONE_PROPERTY, "");
+        if (zone.equals(current)) {
+            return;
+        }
+        Log.i(TAG, "N3DS_NETWORK_TIME zone " + current + " -> " + zone);
+        setTimeZone(zone);
+    }
+
+    private String lookUpTimeZone() throws Exception {
+        HttpURLConnection connection = (HttpURLConnection) new URL(ZONE_LOOKUP).openConnection();
+        connection.setConnectTimeout(ZONE_TIMEOUT_MS);
+        connection.setReadTimeout(ZONE_TIMEOUT_MS);
+        connection.setUseCaches(false);
+        try {
+            if (connection.getResponseCode() != HttpURLConnection.HTTP_OK) {
+                Log.w(TAG, "zone lookup returned HTTP " + connection.getResponseCode());
+                return null;
+            }
+            InputStream in = connection.getInputStream();
+            byte[] buffer = new byte[2048];
+            int length = 0;
+            int n;
+            while (length < buffer.length
+                    && (n = in.read(buffer, length, buffer.length - length)) > 0) {
+                length += n;
+            }
+            JSONObject reply = new JSONObject(new String(buffer, 0, length, "UTF-8"));
+            String zone = reply.optString("timezone", "");
+            if (!"success".equals(reply.optString("status", "")) || TextUtils.isEmpty(zone)) {
+                Log.w(TAG, "zone lookup gave no zone");
+                return null;
+            }
+            // TimeZone.getTimeZone() answers GMT for an ID it does not know;
+            // a zone missing from this image's zoneinfo is no zone at all.
+            if (!zone.equals(TimeZone.getTimeZone(zone).getID())) {
+                Log.w(TAG, "zone lookup named " + zone + ", which this image does not have");
+                return null;
+            }
+            return zone;
+        } finally {
+            connection.disconnect();
+        }
+    }
+
+    private void applyDefaultTimeZone() {
+        String current = SystemProperties.get(TIMEZONE_PROPERTY, "");
+        // N3DS_TZ_GMT_IS_UNSET: before build #327 no zoneinfo shipped, so every
+        // zone resolved to "GMT" and AlarmManager persisted that. The Settings
+        // picker cannot choose plain GMT, so it only ever means "never set".
+        if (TextUtils.isEmpty(current) || "GMT".equals(current)) {
+            Log.i(TAG, "N3DS_TZ_GMT_IS_UNSET zone '" + current + "'; defaulting to "
+                    + DEFAULT_TIME_ZONE);
+            setTimeZone(DEFAULT_TIME_ZONE);
+        }
+    }
+
+    private void setTimeZone(String zone) {
+        AlarmManager alarms = (AlarmManager) mContext.getSystemService(Context.ALARM_SERVICE);
+        if (alarms != null) {
+            alarms.setTimeZone(zone);
+        }
+    }
+}
