+            bool edge = edgeRow || col < scale || col >= mWidth - scale;
+            line[col] = edge ? kBorderColor : kBgColor;
+        }
+    }
+
+    int textH = (kNumLines + 2) * lineH;
+    int y = (mHeight - textH) / 2;
+    if (y < 2 * scale)
+        y = 2 * scale;
+
+    for (int i = 0; i < kNumLines; i++) {
+        int w = (int)strlen(kLines[i]) * (kFontW + 1) * scale;
+        drawText(dst, (mWidth - w) / 2, y, kLines[i], scale,
+                 i == 0 ? kTitleColor : kBodyColor);
+        y += lineH;
+    }
+
