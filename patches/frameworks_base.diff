+#ifdef HAVE_ANDROID_OS
+// N3DS_POWEROFF_SAFETY_BARRIER: this native is also reached from the SELECT
+// long-press route -- ctr_navkey.c synthesizes a KEY_POWER press, which
+// PhoneWindowManager/GlobalActions/ShutdownThread carry straight to
+// Power.shutdown() -- not only from the physical START button. START's own
+// route goes through the kernel's orderly_poweroff(true), which execs
+// whatever /proc/sys/kernel/poweroff_cmd points at; init.rc's "on init"
+// writes /etc/ctr_poweroff.sh there, and that script now runs a real
+// checked barrier before it ever calls poweroff -f itself (bounded
+// /proc-polling for SD-card writers to actually exit, NUL-byte/truncation
+// checks on the logs left on the card, a dmesg FAT/block-I/O-error check,
+// and a verified, /proc/mounts-checked unmount -- see that script).
+//
+// Calling reboot(RB_POWER_OFF) directly here, as this used to, skipped all
+// of that: the SELECT route could still cut power mid-write to the FAT
+// volume even after ctr_poweroff.sh was hardened, because it never ran.
+// Route through the identical hook instead, so both buttons share one
+// barrier rather than needing two kept in sync by hand.
+static bool run_poweroff_cmd()
+{
+    int fd = open("/proc/sys/kernel/poweroff_cmd", O_RDONLY);
+    if (fd < 0) {
+        return false;
+    }
+
+    char cmd[256];
+    ssize_t n = read(fd, cmd, sizeof(cmd) - 1);
+    close(fd);
+    if (n <= 0) {
+        return false;
+    }
+    cmd[n] = '\0';
+    // The sysctl file's content commonly carries a trailing newline.
+    while (n > 0 && (cmd[n - 1] == '\n' || cmd[n - 1] == '\r')) {
+        cmd[--n] = '\0';
+    }
+    if (cmd[0] == '\0') {
+        return false;
+    }
+
+    pid_t pid = fork();
+    if (pid < 0) {
+        return false;
+    }
+    if (pid == 0) {
+        // Child: exec the exact same script the kernel's orderly_poweroff()
+        // would have run for the START button.
+        execl(cmd, cmd, (char *) NULL);
+        _exit(127);
+    }
+
+    int status = 0;
+    if (waitpid(pid, &status, 0) < 0) {
+        return false;
+    }
+    // ctr_poweroff.sh already calls reboot(RB_POWER_OFF) itself once every
+    // one of its own safety checks passes -- so control returning here at
+    // all, successful exit or not, means the checked path did NOT cut
+    // power. Most likely it deliberately aborted because something looked
+    // unsafe (see its own comments) -- and falling through to a raw
+    // reboot() in that case would defeat the entire point of routing
+    // through it. Only treat the hook itself as unusable (and fall back)
+    // when it could not even be exec'd -- rc 127 is _exit(127) above, or
+    // the shell's own "command not found" convention if execl somehow
+    // still landed on a shell.
+    if (WIFEXITED(status) && WEXITSTATUS(status) == 127) {
+        return false;
+    }
+    return true;
+}
+#endif
+
 static void android_os_Power_shutdown(JNIEnv *env, jobject clazz)
 {
     sync();
 #ifdef HAVE_ANDROID_OS
-    reboot(RB_POWER_OFF);
+    if (!run_poweroff_cmd()) {
+        reboot(RB_POWER_OFF);
+    }
 #endif
 }
 
