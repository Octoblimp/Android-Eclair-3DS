diff --git a/cmds/bootanimation/fbtest.cpp b/cmds/bootanimation/fbtest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..599abbf4bc06b8237596e6df93f4db63a5366795
--- /dev/null
+++ b/cmds/bootanimation/fbtest.cpp
@@ -0,0 +1,117 @@
+/*
+ * fbtest.cpp -- one-shot fb1 orientation probe.
+ *
+ * Why this exists: the boot animation's frames are provably 320x240 with the
+ * logo centred to the pixel, BootAnimation draws them at (0,0), and
+ * DisplayTarget::present() maps the canvas bijectively onto the framebuffer.
+ * No pure rotation or reflection can move a centred object to an edge, yet on
+ * hardware the wordmark lands bottom-aligned and upside down. So one of the
+ * assumptions about the fb -> panel scanout is wrong, and that is the one link
+ * that cannot be checked from source.
+ *
+ * This paints an asymmetric pattern through the *same* DisplayTarget code the
+ * animation uses, so a single photo reads off the whole transform:
+ *
+ *   RED    band along the canvas TOP edge
+ *   GREEN  band along the canvas BOTTOM edge
+ *   BLUE   band along the canvas LEFT edge
+ *   WHITE  band along the canvas RIGHT edge
+ *   YELLOW square at canvas (0,0)          <- origin marker
+ *   CYAN   square at canvas (W-1, 0)       <- disambiguates mirroring
+ *   MAGENTA square at the canvas CENTRE    <- shows any offset/clipping
+ *   everything else BLACK
+ *
+ * Read it as: whichever panel edge is red is where canvas-y=0 went; the yellow
+ * corner says where canvas (0,0) went; and if the magenta square is not dead
+ * centre on the panel, the mapping has an offset or is clipping rather than
+ * being a rotation at all. Any part of the panel showing noise instead of
+ * black is a region present() never writes.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "DisplayTarget.h"
+
+using namespace android;
+
+static uint8_t* gBuf;
+static int gW, gH;
+
+static void put(int x, int y, uint8_t r, uint8_t g, uint8_t b)
+{
+    if (x < 0 || y < 0 || x >= gW || y >= gH)
+        return;
+    uint8_t* p = gBuf + ((size_t)y * gW + x) * 4;
+    p[0] = r; p[1] = g; p[2] = b; p[3] = 255;
+}
+
+static void box(int x0, int y0, int w, int h, uint8_t r, uint8_t g, uint8_t b)
+{
+    for (int y = y0; y < y0 + h; y++)
+        for (int x = x0; x < x0 + w; x++)
+            put(x, y, r, g, b);
+}
+
+int main(void)
+{
+    DisplayTarget d;
+
+    if (!d.open("/dev/graphics/fb1")) {
+        printf("fbtest: cannot open /dev/graphics/fb1\n");
+        return 1;
+    }
+
+    gW = d.width();
+    gH = d.height();
+    printf("fbtest: canvas %dx%d\n", gW, gH);
+
+    gBuf = (uint8_t*)calloc((size_t)gW * gH, 4);
+    if (!gBuf) {
+        printf("fbtest: out of memory\n");
+        return 1;
+    }
+    for (int y = 0; y < gH; y++)          /* opaque black background */
+        for (int x = 0; x < gW; x++)
+            put(x, y, 0, 0, 0);
+
+    const int T = 12;                     /* band thickness */
+
+    box(0,        0,        gW, T,  255,   0,   0);   /* top    RED   */
+    box(0,        gH - T,   gW, T,    0, 255,   0);   /* bottom GREEN */
+    box(0,        0,        T,  gH,   0,   0, 255);   /* left   BLUE  */
+    box(gW - T,   0,        T,  gH, 255, 255, 255);   /* right  WHITE */
+
+    box(0,        0,        24, 24, 255, 255,   0);   /* origin YELLOW */
+    box(gW - 16,  0,        16, 16,   0, 255, 255);   /* top-right CYAN */
+
+    box(gW / 2 - 24, gH / 2 - 24, 48, 48, 255, 0, 255); /* centre MAGENTA */
+
+    /* Row ruler. The 80-row scanout shift was found by measuring a square off
+     * a photograph, which is good to maybe +/-10 rows. These ticks make any
+     * residual countable instead: a tick every 20 rows along the left edge,
+     * double-length every 100, so the row a feature actually lands on can be
+     * read directly rather than estimated from the screen height. */
+    for (int y = 0; y < gH; y += 20) {
+        const int len = (y % 100 == 0) ? 32 : 16;
+        box(T, y, len, 2, 255, 255, 255);
+    }
+
+    d.draw(gBuf, gW, gH, 0, 0);
+    d.present();
+
+    printf("fbtest: pattern up -- red=canvas top, green=bottom, blue=left, "
+           "white=right, yellow=(0,0), magenta=centre\n");
+    printf("fbtest: ruler ticks every 20 rows on the left edge, long every 100\n");
+    printf("fbtest: if correct, the magenta square is dead centre and the red "
+           "and green bands are on opposite edges (not adjacent)\n");
+    printf("fbtest: holding 40s, photograph the bottom screen now\n");
+    fflush(stdout);
+
+    sleep(40);
+
+    printf("fbtest: done\n");
+    return 0;
+}
diff --git a/cmds/installd/commands.c b/cmds/installd/commands.c
index 70a1206b11ecbad1cafaa8da22aa45d79101e5e1..748c62de16017e4ffa3a11f3f6e65cd2e59fc106 100644
--- a/cmds/installd/commands.c
+++ b/cmds/installd/commands.c
@@ -15,6 +15,195 @@
 */
 
 #include "installd.h"
+#include <string.h>
+
+/* N3DS_APPDATA_RESTORE: /data is RAM on this port, so PackageManager asks for
+ * a new data directory for every package at every boot.  The prefs_sync
+ * service (/etc/android_prefs_init.sh) mirrors the files apps keep there --
+ * shared_prefs, databases, files -- to the SD card.  install() refills the
+ * new directory from that mirror, owned by the uid the package was given
+ * this boot.  The mirror records no owners, so a build that shifts the uid
+ * assignment cannot strand the data or trip PackageManager's uid check.
+ * android_prefs_init.sh moves the mirror aside before Android starts when
+ * three boots in a row never completed, so a bad restored file cannot
+ * boot-loop the device. */
+#define N3DS_APPDATA_DIR    "/mnt/sd/linux/android/persistent/appdata"
+#define N3DS_APPDATA_TRASH  "/mnt/sd/linux/android/persistent/appdata.removed"
+#define N3DS_PATH_MAX       512
+#define N3DS_MAX_DEPTH      4
+#define N3DS_MAX_FILE_BYTES (8 * 1024 * 1024)
+
+static char n3ds_copy_buf[16384];
+
+static int n3ds_write_all(int fd, const char *buf, ssize_t len)
+{
+    ssize_t n;
+
+    while (len > 0) {
+        n = write(fd, buf, len);
+        if (n < 0) {
+            if (errno == EINTR)
+                continue;
+            return -1;
+        }
+        buf += n;
+        len -= n;
+    }
+    return 0;
+}
+
+/* A torn copy of a database would make its provider throw at every boot, so
+ * a ".db" file is restored only with a valid SQLite header. */
+static int n3ds_header_ok(const char *name, int fd)
+{
+    static const char magic[16] = "SQLite format 3";
+    char head[16];
+    size_t len = strlen(name);
+    ssize_t n;
+
+    if (len < 3 || strcmp(name + len - 3, ".db") != 0)
+        return 1;
+    n = read(fd, head, sizeof(head));
+    if (lseek(fd, 0, SEEK_SET) != 0)
+        return 0;
+    return n == (ssize_t) sizeof(head) && memcmp(head, magic, sizeof(head)) == 0;
+}
+
+static int n3ds_restore_file(const char *src, const char *dst, const char *name,
+                             uid_t uid, gid_t gid)
+{
+    char tmp[N3DS_PATH_MAX];
+    struct stat st;
+    struct utimbuf times;
+    int in, out, ok = 0;
+    ssize_t n;
+
+    if (snprintf(tmp, sizeof(tmp), "%s.n3ds-restore", dst) >= (int) sizeof(tmp))
+        return -1;
+    in = open(src, O_RDONLY);
+    if (in < 0)
+        return -1;
+    if (fstat(in, &st) < 0 || !S_ISREG(st.st_mode) ||
+            st.st_size > N3DS_MAX_FILE_BYTES || !n3ds_header_ok(name, in)) {
+        close(in);
+        return -1;
+    }
+    out = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0660);
+    if (out < 0) {
+        close(in);
+        return -1;
+    }
+    for (;;) {
+        n = read(in, n3ds_copy_buf, sizeof(n3ds_copy_buf));
+        if (n == 0) {
+            ok = 1;
+            break;
+        }
+        if (n < 0) {
+            if (errno == EINTR)
+                continue;
+            break;
+        }
+        if (n3ds_write_all(out, n3ds_copy_buf, n) < 0)
+            break;
+    }
+    close(in);
+    if (close(out) < 0)
+        ok = 0;
+    if (ok && chown(tmp, uid, gid) == 0 && chmod(tmp, 0660) == 0) {
+        /* Keep the saved mtime: older than prefs_sync's boot stamp, so the
+         * saver does not copy an unchanged file straight back. */
+        times.actime = st.st_atime;
+        times.modtime = st.st_mtime;
+        utime(tmp, &times);
+        if (rename(tmp, dst) == 0)
+            return 0;
+    }
+    unlink(tmp);
