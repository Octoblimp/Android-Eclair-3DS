+// ---------------------------------------------------------------------------
+// Deferred GL/EGL deletion.  See the comment on DeferredGLDelete in
+// SurfaceFlinger.h for why this exists; the short version is that a
+// glDeleteTextures() from a binder thread is a NULL dereference in libagl and
+// it killed SurfaceFlinger every time the camera stopped preview.
+// ---------------------------------------------------------------------------
+
+Mutex                                   DeferredGLDelete::sLock;
+android_thread_id_t                     DeferredGLDelete::sMainThread = 0;
+Vector<GLuint>                          DeferredGLDelete::sTextures;
+Vector<DeferredGLDelete::DoomedImage>   DeferredGLDelete::sImages;
+
+void DeferredGLDelete::setMainThread()
+{
+    Mutex::Autolock _l(sLock);
+    sMainThread = androidGetThreadId();
+}
+
+bool DeferredGLDelete::onMainThread()
+{
+    Mutex::Autolock _l(sLock);
+    return sMainThread != 0 && androidGetThreadId() == sMainThread;
+}
+
+void DeferredGLDelete::deleteTexture(GLuint name)
+{
+    if (name == -1U)
+        return;
+    if (onMainThread()) {
+        glDeleteTextures(1, &name);
+        return;
+    }
+    Mutex::Autolock _l(sLock);
+    sTextures.add(name);
+}
+
+void DeferredGLDelete::deleteImage(EGLDisplay dpy, EGLImageKHR image)
+{
+    if (image == EGL_NO_IMAGE_KHR)
+        return;
+    if (onMainThread()) {
+        eglDestroyImageKHR(dpy, image);
+        return;
+    }
+    DoomedImage doomed;
+    doomed.dpy = dpy;
+    doomed.image = image;
+    Mutex::Autolock _l(sLock);
+    sImages.add(doomed);
+}
+
+void DeferredGLDelete::reap()
+{
+    Vector<GLuint> textures;
+    Vector<DoomedImage> images;
+    {   // Swap the queues out under the lock and do the GL work outside it:
+        // a binder thread must never block on a frame.
+        Mutex::Autolock _l(sLock);
+        if (sTextures.isEmpty() && sImages.isEmpty())
+            return;
+        textures = sTextures;
+        images = sImages;
+        sTextures.clear();
+        sImages.clear();
+    }
+    for (size_t i = 0 ; i < textures.size() ; i++) {
+        GLuint name = textures[i];
+        glDeleteTextures(1, &name);
+    }
+    for (size_t i = 0 ; i < images.size() ; i++) {
+        eglDestroyImageKHR(images[i].dpy, images[i].image);
+    }
+}
