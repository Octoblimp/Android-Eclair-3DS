+static void n3ds_restore_tree(const char *src, const char *dst, uid_t uid,
+                              gid_t gid, int depth, int *restored, int *skipped)
+{
+    char s[N3DS_PATH_MAX];
+    char d[N3DS_PATH_MAX];
+    struct dirent *de;
+    struct stat st;
+    const char *name;
+    DIR *dir;
+
+    dir = opendir(src);
+    if (dir == NULL)
+        return;
+    while ((de = readdir(dir)) != NULL) {
+        name = de->d_name;
+        /* ".", "..", and the saver's ".<name>.n3ds-save" temporaries */
+        if (name[0] == '.')
+            continue;
+        if (depth == 0 && (!strcmp(name, "lib") || !strcmp(name, "cache")))
+            continue;
+        if (snprintf(s, sizeof(s), "%s/%s", src, name) >= (int) sizeof(s) ||
+                snprintf(d, sizeof(d), "%s/%s", dst, name) >= (int) sizeof(d) ||
+                lstat(s, &st) < 0) {
+            (*skipped)++;
+            continue;
+        }
+        if (S_ISDIR(st.st_mode)) {
+            if (depth >= N3DS_MAX_DEPTH ||
+                    (mkdir(d, 0771) < 0 && errno != EEXIST) ||
+                    chown(d, uid, gid) < 0 || chmod(d, 0771) < 0) {
+                (*skipped)++;
