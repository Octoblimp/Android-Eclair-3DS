+/* Runs args[1..nargs-1] as a command and blocks until it exits, unlike a
+ * "service" which is fire-and-forget. Needed so an "on boot" action can
+ * force ordering against class_start (e.g. "exec /etc/setup_swap.sh"
+ * before the VM-heavy default-class services start) -- init.rc has no
+ * other builtin that forks+waits. This was previously a stub returning
+ * -1 unconditionally (upstream real AOSP init didn't have "exec" yet at
+ * this vintage; the keyword table here already had a slot reserved for
+ * it). args has exactly nargs entries with NO trailing NULL (see
+ * parser.c's parse_line_action: a plain memcpy of the tokenized line),
+ * so a NULL-terminated argv for execv() has to be built locally rather
+ * than just pointing into args+1.
+ */
 int do_exec(int nargs, char **args)
 {
+    char *argv[16];
+    int i, n;
+    pid_t pid;
+    int status;
+
+    n = nargs - 1;              /* number of real argv entries */
+    if (n < 1 || n >= (int)(sizeof(argv) / sizeof(argv[0]))) {
+        return -1;
+    }
+    for (i = 0; i < n; i++) {
+        argv[i] = args[i + 1];
+    }
+    argv[n] = NULL;
+
+    pid = fork();
+    if (pid < 0) {
+        return -1;
+    }
+    if (pid == 0) {
+        execv(argv[0], argv);
+        _exit(127);
+    }
+
+    if (waitpid(pid, &status, 0) < 0) {
+        return -1;
+    }
+    if (WIFEXITED(status) && WEXITSTATUS(status) == 0) {
+        return 0;
+    }
     return -1;
 }
 
