diff --git a/src/com/android/settings/PlatLogoActivity.java b/src/com/android/settings/PlatLogoActivity.java
new file mode 100644
index 0000000000000000000000000000000000000000..887033f3432f1d385fbcc2a150bd179e4e053a8e
--- /dev/null
+++ b/src/com/android/settings/PlatLogoActivity.java
@@ -0,0 +1,233 @@
+/*
+ * Copyright (C) 2010 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings;
+
+import android.app.Activity;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.os.Bundle;
+import android.os.SystemClock;
+import android.util.Log;
+import android.view.KeyEvent;
+import android.view.MotionEvent;
+import android.view.View;
+
+/**
+ * N3DS_BUGDROID (#328): the screen behind three quick taps on
+ * Settings > About phone > Firmware version. Eclair never put an easter egg
+ * there, so this one is the Android robot: it bobs and blinks on its own,
+ * and every tap (or the A button) makes it hop with its arms up and its
+ * antennae wiggling. Back leaves.
+ *
+ * Everything is drawn with Canvas in code; no artwork is shipped. The
+ * drawing lives in static methods so test_bugdroid_qemu.sh can render
+ * frames under qemu-arm and check the pixels.
+ */
+public class PlatLogoActivity extends Activity {
+    private static final String TAG = "PlatLogoActivity";
+
+    /** The robot's grid: 160 wide, 200 tall, plus headroom for the hop. */
+    public static final float GRID_W = 160f;
+    public static final float ROBOT_H = 200f;
+    public static final float HOP_HEIGHT = 46f;
+    public static final float GRID_H = ROBOT_H + HOP_HEIGHT;
+    /** One hop, take-off to landing. */
+    public static final long HOP_MS = 650L;
+    public static final int GREEN = 0xffa4c639;
+    public static final int BACKGROUND = 0xff000000;
+    public static final int SHADOW = 0xff2a2a2a;
+
+    /** Square shoulders, rounded bottom corners (TL, TR, BR, BL x/y radii). */
+    private static final float[] BODY_CORNERS = {
+            0f, 0f, 0f, 0f, 14f, 14f, 14f, 14f };
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        Log.i(TAG, "N3DS_BUGDROID");
+        setContentView(new BugdroidView(this));
+    }
+
+    /** How high the robot is off the floor, sinceTapMs after a tap. */
+    public static float hopHeight(long sinceTapMs) {
+        if (sinceTapMs < 0 || sinceTapMs >= HOP_MS) return 0f;
+        final float p = sinceTapMs / (float) HOP_MS;
+        return HOP_HEIGHT * 4f * p * (1f - p);
+    }
+
+    /** The idle bob between hops: two grid units, once every 1.6 s. */
+    public static float bob(long elapsedMs) {
+        return (float) Math.sin(elapsedMs * 2.0 * Math.PI / 1600.0) * 2f;
+    }
+
+    /** Eyes shut for 140 ms every 3.2 s, never mid-hop. */
+    public static boolean eyesOpen(long elapsedMs, long sinceTapMs) {
+        if (sinceTapMs >= 0 && sinceTapMs < HOP_MS) return true;
+        return (elapsedMs % 3200L) >= 140L;
+    }
+
+    /** Screen pixels per grid unit: the whole grid fits, with a margin. */
+    public static float scaleFor(int width, int height) {
+        return Math.min(width / GRID_W, height / GRID_H) * 0.9f;
+    }
+
+    /**
+     * One frame: the robot on a black floor, scaled to fit width x height.
+     * sinceTapMs is the time since the last tap, or -1 for none.
+     */
+    public static void drawFrame(Canvas canvas, int width, int height,
+            long elapsedMs, long sinceTapMs, Paints p) {
+        canvas.drawColor(BACKGROUND);
+        if (width <= 0 || height <= 0) return;
+        final float scale = scaleFor(width, height);
+        final float hop = hopHeight(sinceTapMs);
+        final float lift = hop > 0f ? hop : bob(elapsedMs);
+        final float hopFraction = hop / HOP_HEIGHT;
+
+        canvas.save();
+        canvas.translate((width - GRID_W * scale) / 2f, (height - GRID_H * scale) / 2f);
+        canvas.scale(scale, scale);
+
+        // The shadow on the floor shrinks as the robot rises.
+        final float shadowHalf = 52f * (1f - 0.55f * hopFraction);
+        p.rect.set(80f - shadowHalf, GRID_H - 9f, 80f + shadowHalf, GRID_H - 1f);
+        canvas.drawOval(p.rect, p.shadow);
+
+        canvas.translate(0f, HOP_HEIGHT - lift);
+        drawRobot(canvas, hopFraction, eyesOpen(elapsedMs, sinceTapMs), p);
+        canvas.restore();
+    }
+
+    /**
+     * The robot in its 160 x 200 grid. armsUp runs from 0 (arms at its
+     * sides) to 1 (arms raised for the top of a hop).
+     */
+    public static void drawRobot(Canvas canvas, float armsUp, boolean eyesOpen, Paints p) {
+        // Antennae, wiggling with the hop.
+        final float wiggle = armsUp * 10f;
+        canvas.drawLine(54f, 32f, 44f - wiggle, 14f, p.line);
+        canvas.drawLine(106f, 32f, 116f + wiggle, 14f, p.line);
+
+        // Head: the top half of a circle, with two eyes.
+        p.rect.set(30f, 24f, 130f, 124f);
+        canvas.drawArc(p.rect, 180f, 180f, true, p.fill);
+        if (eyesOpen) {
+            canvas.drawCircle(58f, 50f, 5f, p.eye);
+            canvas.drawCircle(102f, 50f, 5f, p.eye);
+        } else {
+            canvas.drawRect(52f, 49f, 64f, 52f, p.eye);
+            canvas.drawRect(96f, 49f, 108f, 52f, p.eye);
+        }
+
+        // Body: square top, rounded bottom corners.
+        p.path.reset();
+        p.rect.set(30f, 78f, 130f, 168f);
+        p.path.addRoundRect(p.rect, BODY_CORNERS, Path.Direction.CW);
+        canvas.drawPath(p.path, p.fill);
+
+        // Arms, swung out and up around the shoulders.
+        final float swing = armsUp * 150f;
+        canvas.save();
+        canvas.rotate(swing, 15f, 91f);
+        p.rect.set(4f, 80f, 26f, 146f);
+        canvas.drawRoundRect(p.rect, 11f, 11f, p.fill);
+        canvas.restore();
+        canvas.save();
+        canvas.rotate(-swing, 145f, 91f);
+        p.rect.set(134f, 80f, 156f, 146f);
+        canvas.drawRoundRect(p.rect, 11f, 11f, p.fill);
+        canvas.restore();
+
+        // Legs.
+        p.rect.set(50f, 150f, 72f, 196f);
+        canvas.drawRoundRect(p.rect, 11f, 11f, p.fill);
+        p.rect.set(88f, 150f, 110f, 196f);
+        canvas.drawRoundRect(p.rect, 11f, 11f, p.fill);
+    }
+
+    /** The paints and scratch shapes one view reuses every frame. */
+    public static final class Paints {
+        final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        final Paint line = new Paint(Paint.ANTI_ALIAS_FLAG);
+        final Paint eye = new Paint(Paint.ANTI_ALIAS_FLAG);
+        final Paint shadow = new Paint(Paint.ANTI_ALIAS_FLAG);
+        final RectF rect = new RectF();
+        final Path path = new Path();
+
+        public Paints() {
+            fill.setColor(GREEN);
+            fill.setStyle(Paint.Style.FILL);
+            line.setColor(GREEN);
+            line.setStyle(Paint.Style.STROKE);
+            line.setStrokeWidth(4f);
+            line.setStrokeCap(Paint.Cap.ROUND);
+            eye.setColor(BACKGROUND);
+            eye.setStyle(Paint.Style.FILL);
+            shadow.setColor(SHADOW);
+            shadow.setStyle(Paint.Style.FILL);
+        }
+    }
+
+    static final class BugdroidView extends View {
+        private final Paints mPaints = new Paints();
+        private final long mStart = SystemClock.uptimeMillis();
+        private long mTapAt = -1L;
+
+        BugdroidView(Context context) {
+            super(context);
+            setBackgroundColor(Color.BLACK);
+            setFocusable(true);
+            setFocusableInTouchMode(true);
+        }
+
+        private void hop() {
+            mTapAt = SystemClock.uptimeMillis();
+            invalidate();
+        }
+
+        @Override
+        public boolean onTouchEvent(MotionEvent event) {
+            if (event.getAction() == MotionEvent.ACTION_DOWN) {
+                hop();
+            }
+            return true;
+        }
+
+        @Override
+        public boolean onKeyDown(int keyCode, KeyEvent event) {
+            if (keyCode == KeyEvent.KEYCODE_DPAD_CENTER
+                    || keyCode == KeyEvent.KEYCODE_ENTER) {
+                if (event.getRepeatCount() == 0) hop();
+                return true;
+            }
+            return super.onKeyDown(keyCode, event);
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            final long now = SystemClock.uptimeMillis();
+            final long sinceTap = mTapAt < 0 ? -1L : now - mTapAt;
+            drawFrame(canvas, getWidth(), getHeight(), now - mStart, sinceTap, mPaints);
+            // About 30 frames a second is plenty for a bob and a hop.
+            postInvalidateDelayed(33);
+        }
+    }
+}
