+    int has_text_relocs = 0;
 
     INFO("[ %5d linking %s ]\n", pid, si->name);
     DEBUG("%5d si->base = 0x%08x si->flags = 0x%08x\n", pid,
@@ -1692,11 +1693,31 @@ static int link_image(soinfo *si, unsigned wr_offset)
             si->preinit_array_count = ((unsigned)*d) / sizeof(Elf32_Addr);
             break;
         case DT_TEXTREL:
-            /* TODO: make use of this. */
-            /* this means that we might have to write into where the text
-             * segment was loaded during relocation... Do something with
-             * it.
+            /* Upstream left this as "TODO: make use of this" and only
+             * printed a debug line, which is a latent crash for the MAIN
+             * EXECUTABLE specifically.
+             *
+             * Shared libraries are fine without it: the linker maps them
+             * itself and load_library() leaves them PROT_WRITE while it
+             * relocates. The executable is mapped by the KERNEL, from the
+             * program headers, so its text lands read-only (R E) and
+             * nobody ever makes it writable.
+             *
+             * That matters because bionic's own crtbegin_dynamic.S puts
+             * four pointers -- __PREINIT_ARRAY__, __INIT_ARRAY__,
+             * __FINI_ARRAY__, __CTOR_LIST__ -- inline in .text right after
+             * _start, and even documents them as "a tiny trampoline that
+             * will get relocated by the dynamic linker before this code
+             * runs". Those emit four R_ARM_RELATIVE relocations into .text,
+             * and reloc_library() writes unconditionally
+             * (*reloc += si->base) even when si->base is 0. The result is a
+             * SIGSEGV with si_code=SEGV_ACCERR the moment the first
+             * dynamically linked executable starts.
+             *
+             * So: remember it here, and unprotect the range below. The
+             * matching re-protect at the end of link_image already exists.
              */
+            has_text_relocs = 1;
             DEBUG("%5d Text segment should be writable during relocation.\n",
                   pid);
             break;
@@ -1733,6 +1754,24 @@ static int link_image(soinfo *si, unsigned wr_offset)
         }
     }
 
+    /* Make the read-only segments temporarily writable if this object has
+     * text relocations. See the DT_TEXTREL case above for why this is
+     * required (and why upstream getting away without it was luck that
+     * runs out as soon as you launch a dynamically linked executable).
+     * The re-protect further down restores PROT_READ | PROT_EXEC. */
+    if (has_text_relocs &&
+        si->wrprotect_start != 0xffffffff && si->wrprotect_end != 0) {
+        DEBUG("%5d unprotecting %s text 0x%08x-0x%08x for relocation\n",
+              pid, si->name, si->wrprotect_start, si->wrprotect_end);
+        if (mprotect((void *)si->wrprotect_start,
+                     si->wrprotect_end - si->wrprotect_start,
+                     PROT_READ | PROT_WRITE | PROT_EXEC) < 0) {
+            DL_ERR("%5d can't unprotect text of '%s' for relocation: %s",
+                   pid, si->name, strerror(errno));
+            goto fail;
+        }
+    }
+
     if(si->plt_rel) {
         DEBUG("[ %5d relocating %s plt ]\n", pid, si->name );
         if(reloc_library(si, si->plt_rel, si->plt_rel_count))
