diff --git a/libc/netbsd/isc/android3ds_isc_stubs.c b/libc/netbsd/isc/android3ds_isc_stubs.c
new file mode 100644
index 0000000000000000000000000000000000000000..0de81a0bbc4d7d20b5f7a55ae6deb99dac676598
--- /dev/null
+++ b/libc/netbsd/isc/android3ds_isc_stubs.c
@@ -0,0 +1,69 @@
+/*
+ * android3ds: stubs for ISC eventlib/DST symbols that AOSP Eclair's bionic
+ * references but does not ship.
+ *
+ * bionic/libc/netbsd/isc/ contains only ev_timers.c and ev_streams.c. Both
+ * are derived from ISC BIND's eventlib and call into the rest of that
+ * library -- the timer heap (heap.c), the memory cluster allocator
+ * (memcluster.c), the assertion handler (assertions.c) and the FD selector
+ * (ev_select.c). None of those files exist anywhere in the Eclair tree.
+ * Likewise nameser/ns_print.c calls __dst_s_dns_key_id() from the DST
+ * crypto library, which Eclair also does not ship.
+ *
+ * This was invisible upstream because libc was a shared library: the
+ * unresolved symbols simply sat in libc.so's dynamic symbol table and were
+ * never called, since nothing in bionic reaches the eventlib code paths
+ * that need them (res_send.c only uses the pure-arithmetic evNowTime /
+ * evConsTime / evSubTime / evCmpTime helpers, which happen to live in the
+ * same translation units). Our userspace is statically linked, so the
+ * linker drags those objects in whole and every one of these references
+ * becomes a hard error.
+ *
+ * These are therefore deliberately abort-on-call stubs, not no-ops: if one
+ * of them is ever actually reached it means real eventlib functionality is
+ * being used and the genuine ISC sources need to be ported, and a loud
+ * crash is far better than silently wrong DNS/timer behaviour. Reaching
+ * them should be impossible on the paths bionic actually uses.
+ */
+
+#include <stdlib.h>
+#include <unistd.h>
+
+#define ANDROID3DS_ISC_STUB(name)                                             \
+    void name(void);                                                          \
+    void name(void)                                                           \
+    {                                                                         \
+        static const char msg[] =                                             \
+            "android3ds: unimplemented ISC eventlib stub called: " #name       \
+            " -- port the real bionic/netbsd isc sources\n";                   \
+        write(2, msg, sizeof(msg) - 1);                                       \
+        abort();                                                              \
+    }
+
+/* eventlib: assertion handler (REQUIRE/INSIST macros) */
+ANDROID3DS_ISC_STUB(__assertion_failed)
+
+/* eventlib: internal debug printf and the UNUSED() helper */
+ANDROID3DS_ISC_STUB(__evPrintf)
+ANDROID3DS_ISC_STUB(UNUSED)
+
+/* eventlib: file-descriptor selector (ev_select.c) */
+ANDROID3DS_ISC_STUB(__evSelectFD)
+ANDROID3DS_ISC_STUB(__evDeselectFD)
+
+/* eventlib: timer heap (heap.c) */
+ANDROID3DS_ISC_STUB(__heap_new)
+ANDROID3DS_ISC_STUB(__heap_free)
+ANDROID3DS_ISC_STUB(__heap_insert)
+ANDROID3DS_ISC_STUB(__heap_delete)
+ANDROID3DS_ISC_STUB(__heap_element)
+ANDROID3DS_ISC_STUB(__heap_increased)
+ANDROID3DS_ISC_STUB(__heap_decreased)
+ANDROID3DS_ISC_STUB(__heap_for_each)
+
+/* eventlib: memory cluster allocator (memcluster.c) */
+ANDROID3DS_ISC_STUB(__memget)
+ANDROID3DS_ISC_STUB(__memput)
+
+/* DST crypto library, used by nameser/ns_print.c for DNSSEC key IDs */
+ANDROID3DS_ISC_STUB(__dst_s_dns_key_id)
diff --git a/linker/linker.c b/linker/linker.c
index 80b5d00faf2b292abaa8cd965cc39ca16b0e8a16..7917dc925c2e11e49c8c174e2c1ddba4b984c542 100644
