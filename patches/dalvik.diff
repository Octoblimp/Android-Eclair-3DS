diff --git a/libnativehelper/android3ds_register_stub.c b/libnativehelper/android3ds_register_stub.c
new file mode 100644
index 0000000000000000000000000000000000000000..fd171cab0f57c8167c5ab2006148bfa8dafe01f0
--- /dev/null
+++ b/libnativehelper/android3ds_register_stub.c
@@ -0,0 +1,33 @@
+/*
+ * android3ds: placeholder for jniRegisterSystemMethods().
+ *
+ * The real implementation is Register.c in this same directory. It calls
+ * ~45 register_*() entry points that live in libjavacore -- the native half
+ * of the core Java class library (dalvik/libcore), which in turn needs ICU4C,
+ * OpenSSL, SQLite and expat. None of that is ported yet, so linking the real
+ * Register.o produces ~45 undefined references.
+ *
+ * This stub exists purely so dalvikvm can be linked and its startup path
+ * exercised end to end. It deliberately FAILS (returns -1) rather than
+ * pretending to succeed: with no core-library natives registered, the VM
+ * genuinely cannot run any Java code, and dvmStartup() aborting here with a
+ * clear message is the accurate outcome. Returning 0 would let the VM
+ * continue into a state where every java.lang.System call dies with a
+ * confusing UnsatisfiedLinkError instead.
+ *
+ * Delete this file the moment libjavacore builds -- link Register.c instead.
+ */
+
+#include "jni.h"
+
+#include <stdio.h>
+
+int jniRegisterSystemMethods(JNIEnv* env)
+{
+    fprintf(stderr,
+            "android3ds: jniRegisterSystemMethods() is a stub -- libjavacore "
+            "(dalvik/libcore + ICU/OpenSSL/SQLite/expat) is not ported yet, "
+            "so no core-library JNI natives can be registered and the VM "
+            "cannot run Java code.\n");
+    return -1;
+}
